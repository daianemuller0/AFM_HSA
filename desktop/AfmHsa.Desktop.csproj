<!-- A janela do AFM HSA: WinForms + WebView2 + o servidor (Kestrel) no MESMO
     processo — sem a janela preta, e fechar a janela encerra tudo. Mesma
     arquitetura do axiaisvent (desktop/). O Sdk é o Web de propósito: é ele
     que faz o wwwroot do sistema ir para a pasta publicada. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AfmHsa.Desktop</RootNamespace>
    <AssemblyName>AfmHsaApp</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- permite compilar/publicar o alvo Windows a partir de qualquer SO -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- a logo da Howden: no .exe, no atalho e na janela -->
    <ApplicationIcon>..\wwwroot\favicon.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="..\AfmHsa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Desktop.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
