<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AfmHsa</RootNamespace>
    <AssemblyName>AfmHsa</AssemblyName>
    <!-- Icone do executavel (mostrado no Windows Explorer e nos atalhos).
         Usa o logo Howden (mesmo do favicon do navegador). -->
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provider ADO.NET do DuckDB (inclui a lib nativa). Mesma versão usada no
         projeto Licencas_HSA — mantenha alinhado com a equipe de melhoria. -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.1.3" />
    <!-- Leitura de Excel (.xlsx) para as telas de importação -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <!-- Leitura de Excel antigo (.xls, formato BIFF/OLE2) na importação -->
    <PackageReference Include="ExcelDataReader" Version="3.6.0" />
    <!-- Habilita Windows-1252 no .NET (CSV exportado pelo Excel pt-BR e .xls antigos) -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Base de demonstração (mesmos dados do app original). É semeada na base
         Parquet na primeira execução, se a pasta estiver vazia. Copiada para a
         pasta de saída para o DbInitializer conseguir ler em runtime. -->
    <None Update="Data\seed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
