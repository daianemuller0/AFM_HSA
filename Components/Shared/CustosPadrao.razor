@* Os custos adicionais padrão (embalagens, engenharia, exportação, outros):
   toda proposta nova nasce com eles e dá para trocar o valor na própria proposta. *@
@using AfmHsa.Models
@inject CustosPadraoRepository Repo

<div class="panel">
    <div class="dash-title">Custos padrão</div>
    <div class="nota" style="margin:4px 0 12px">
        Toda proposta nova já nasce com estes custos (no pricing, somados ao custo dos itens). Na proposta, na etapa
        <strong>Preço → Custos adicionais</strong>, dá para trocar o valor só daquela proposta. Mudar aqui vale para as
        propostas novas e as próximas revisões; as já salvas não mudam.
    </div>

    <table class="grid custos-padrao">
        <thead><tr><th>Custo</th><th>Como calcula</th><th class="right">Valor padrão</th><th>Exemplo</th></tr></thead>
        <tbody>
            @foreach (var c in _edit)
            {
                var custo = c;
                <tr>
                    <td><strong>@CustosAdicionaisDaProposta.NomeDe(c.Codigo)</strong></td>
                    <td>
                        <div class="seg" role="group" aria-label="Como calcula @CustosAdicionaisDaProposta.NomeDe(c.Codigo)">
                            <button class="@(c.Tipo == CustoAdicional.Fixo ? "on" : "")" @onclick="() => TrocarTipo(custo, CustoAdicional.Fixo)">valor fixo (R$)</button>
                            <button class="@(c.Tipo == CustoAdicional.Percentual ? "on" : "")" @onclick="() => TrocarTipo(custo, CustoAdicional.Percentual)">% do custo dos itens</button>
                        </div>
                    </td>
                    <td class="right">
                        <input class="cell num custo-padrao-valor" type="number" min="0" step="0.01" aria-label="Valor padrão de @CustosAdicionaisDaProposta.NomeDe(c.Codigo)"
                               value="@ValorNaTela(c)" @onchange="e => MudarValor(custo, e)" />
                        <span class="nota">@(c.Tipo == CustoAdicional.Percentual ? "%" : "R$")</span>
                    </td>
                    <td class="nota">@Exemplo(c)</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="toolbar" style="margin-top:12px">
        <button class="btn-primary" @onclick="Salvar">Salvar custos padrão</button>
        <button class="btn-link" @onclick="Abrir">descartar mudanças</button>
        @if (_msg is not null) { <span class="side-ok">@_msg</span> }
    </div>
    <div class="nota">O valor fixo é em R$: vale nas propostas com custo em R$ (HSA). Nas de custo em outra moeda (HCHL, HPU), use % ou digite o valor na proposta.</div>
</div>

@code {
    private List<CustoAdicional> _edit = new();
    private string? _msg;
    private static readonly System.Globalization.CultureInfo Br = new("pt-BR");

    protected override void OnInitialized() => Abrir();

    private void Abrir()
    {
        _edit = Repo.Ler();
        _msg = null;
    }

    private static string ValorNaTela(CustoAdicional c) =>
        (c.Tipo == CustoAdicional.Percentual ? c.Padrao * 100m : c.Padrao).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void TrocarTipo(CustoAdicional c, string tipo)
    {
        if (c.Tipo == tipo) return;
        c.Tipo = tipo;
        c.Padrao = 0m;
        _msg = null;
    }

    private void MudarValor(CustoAdicional c, ChangeEventArgs e)
    {
        var t = (e.Value?.ToString() ?? "").Replace(",", ".");
        var v = decimal.TryParse(t, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) && d >= 0m ? d : 0m;
        c.Padrao = c.Tipo == CustoAdicional.Percentual ? Math.Min(v, 100m) / 100m : Math.Round(v, 2);
        _msg = null;
    }

    private static string Exemplo(CustoAdicional c) => c.Padrao == 0m ? "não entra (zero)"
        : c.Tipo == CustoAdicional.Percentual
            ? $"itens de R$ 10.000,00 → {(c.Padrao * 10000m).ToString("C2", Br)}"
            : $"{c.Padrao.ToString("C2", Br)} em toda proposta";

    private void Salvar()
    {
        Repo.Gravar(_edit);
        Abrir();
        _msg = "Custos padrão salvos: valem para as propostas novas.";
    }
}
