@inject NavigationManager Nav

<h1>Central de Inteligência</h1>
<p class="subtitle">Inteligência preditiva para identificar, priorizar e converter oportunidades de aftermarket.</p>

<div class="views">
    <a class="view @Cls("/dashboard")" href="/dashboard">Visão Executiva</a>
    <a class="view @Cls("/previsao")" href="/previsao">Previsão de Receita</a>
    <a class="view @Cls("/planejamento")" href="/planejamento">Planejamento Comercial</a>
</div>

@code {
    private string Cls(string path)
    {
        var rel = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        return rel == path ? "active" : "";
    }
}
