@* Cabeçalho + estado "em construção" reutilizado pelas telas de módulo da
   migração. Quando o módulo for implementado, o conteúdo real entra via
   <ChildContent> (ou a página passa a montar sua própria UI). *@

<div class="page-head">
    <div>
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="subtitle">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-actions">@Actions</div>
    }
</div>

@if (ChildContent is not null)
{
    @ChildContent
}
else
{
    <div class="panel empty-state">
        <div class="empty-ico">@((MarkupString)Icons.Svg(Icon))</div>
        <div class="empty-title">Módulo em construção</div>
        <p class="empty-text">
            Esta tela faz parte da migração do app para <strong>.NET 8 + Blazor Server</strong>.
            A estrutura já está no lugar; os dados virão da base em <strong>Parquet (DuckDB)</strong>
            na pasta de rede assim que este módulo for implementado.
        </p>
        <div class="empty-tag">@Title</div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Icon { get; set; } = "box";
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
