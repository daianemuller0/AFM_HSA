@code {
    // a versão do arquivo é a data dele: a cada atualização o navegador baixa o CSS/JS novo, em vez de usar o guardado
    [Inject] private IWebHostEnvironment Ambiente { get; set; } = default!;

    private string Versao(string arquivo)
    {
        var info = Ambiente.WebRootFileProvider.GetFileInfo(arquivo);
        return info.Exists ? info.LastModified.UtcTicks.ToString("x") : "1";
    }
}
