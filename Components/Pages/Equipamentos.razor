@page "/equipamentos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject EquipmentRepository Equipamentos
@inject PartRepository Pecas

<PageTitle>Equipamentos · AFM HSA</PageTitle>

<h1>Equipamentos</h1>
<p class="subtitle">@Filtrados.Count equipamento(s) no catálogo</p>

<div class="toolbar">
    <input class="cell" style="max-width:320px" placeholder="Buscar equipamento, modelo, fabricante…"
           @bind="_busca" @bind:event="oninput" />
</div>

<div style="overflow-x:auto">
<table class="grid">
    <thead>
        <tr>
            <th>Doc</th><th>Nome</th><th>Tipo</th><th>Modelo</th><th>Segmento</th>
            <th>Fabricante</th><th class="right">Peças</th><th class="right">Valor</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Filtrados)
        {
            <tr>
                <td>@e.DocNum</td>
                <td>@e.Nome</td>
                <td>@e.Tipo</td>
                <td class="nowrap">@e.Modelo</td>
                <td>@e.Segmento</td>
                <td>@e.Fabricante</td>
                <td class="right">@_partsCount.GetValueOrDefault(e.Id)</td>
                <td class="right nowrap">@Fmt.Brl(e.ValorCompleto)</td>
            </tr>
        }
        @if (Filtrados.Count == 0)
        {
            <tr><td colspan="8" class="empty">Nenhum equipamento encontrado.</td></tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<Equipment> _all = new();
    private Dictionary<string, int> _partsCount = new();
    private string _busca = "";

    protected override void OnInitialized()
    {
        _all = Equipamentos.All();
        _partsCount = Pecas.All()
            .GroupBy(p => p.EquipmentId)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private List<Equipment> Filtrados
    {
        get
        {
            IEnumerable<Equipment> q = _all;
            if (!string.IsNullOrWhiteSpace(_busca))
            {
                var b = _busca.Trim().ToLowerInvariant();
                q = q.Where(e => (e.Nome + e.Modelo + e.Tipo + e.Segmento + e.Fabricante + e.Aplicacao)
                    .ToLowerInvariant().Contains(b));
            }
            return q.OrderBy(e => e.Nome).ToList();
        }
    }
}
