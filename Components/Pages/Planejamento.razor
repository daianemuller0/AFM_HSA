@page "/planejamento"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntelligenceService Intel

<PageTitle>Planejamento · AFM HSA</PageTitle>

<h1>Planejamento</h1>
<p class="subtitle">Agenda de janelas de reposição por mês (próximos 12 meses).</p>

@if (_meses.Count == 0)
{
    <div class="panel empty-state"><div class="empty-title">Nada planejado</div>
        <p class="empty-text">Não há janelas de reposição nos próximos meses.</p></div>
}
else
{
    @foreach (var mes in _meses)
    {
        <div class="panel" style="margin-bottom:14px">
            <div class="dash-title">@mes.Label — @mes.Items.Count janela(s) · @Fmt.Brl0(mes.Total)</div>
            <table class="grid">
                <thead><tr><th>Cliente / Unidade</th><th>Item</th><th>Data</th><th>Urgência</th><th class="right">Potencial</th></tr></thead>
                <tbody>
                    @foreach (var o in mes.Items)
                    {
                        <tr>
                            <td>@Intel.UnitLabel(o.ClientUnitId)</td>
                            <td>@o.Item</td>
                            <td class="nowrap">@Fmt.Date(o.DataPrevista)</td>
                            <td><span class="badge @IntelligenceService.UrgClass(o.Urgencia)">@o.Urgencia</span></td>
                            <td class="right nowrap">@Fmt.Brl0(o.ValorEstimado)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private record MesGrupo(string Label, List<Opportunity> Items, decimal Total);
    private List<MesGrupo> _meses = new();

    protected override void OnInitialized()
    {
        var all = Intel.Opportunities().Where(o => o.DiasAteJanela >= 0 && o.DiasAteJanela <= 365).ToList();
        _meses = all
            .Where(o => o.DataPrevista.Length >= 7)
            .GroupBy(o => o.DataPrevista.Substring(0, 7))
            .OrderBy(g => g.Key)
            .Select(g => new MesGrupo(Mes(g.Key),
                g.OrderBy(o => o.DataPrevista, StringComparer.Ordinal).ToList(),
                g.Sum(o => o.ValorEstimado)))
            .ToList();
    }

    private static string Mes(string ym)
    {
        var p = ym.Split('-');
        return p.Length == 2 ? $"{p[1]}/{p[0]}" : ym;
    }
}
