@page "/planejamento"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntelligenceService Intel
@inject ClientUnitRepository Units
@inject SalespersonRepository Salespeople

<PageTitle>Planejamento · AFM HSA</PageTitle>

<IntelTabs />

<div class="kpis">
    <div class="kpi k-po"><div class="kpi-label">Janelas no horizonte</div><div class="kpi-value">@Filtradas.Count</div></div>
    <div class="kpi k-ren"><div class="kpi-label">Valor potencial técnico</div><div class="kpi-value" style="font-size:15px">@Fmt.Brl0(Filtradas.Sum(o => o.ValorEstimado))</div></div>
    <div class="kpi k-aten"><div class="kpi-label">Reposições — 30 dias</div><div class="kpi-value">@Filtradas.Count(o => o.DiasAteJanela >= 0 && o.DiasAteJanela <= 30)</div></div>
    <div class="kpi k-venc"><div class="kpi-label">Janelas críticas</div><div class="kpi-value">@Filtradas.Count(IsCritica)</div></div>
</div>

<div class="panel" style="margin-bottom:16px">
    <div class="filters" style="grid-template-columns:2fr 1fr 1fr 1fr 1fr">
        <input class="cell" placeholder="Buscar cliente ou item" @bind="_q" @bind:event="oninput" />
        <select class="cell" @bind="_vend">
            <option value="">Todos vendedores</option>
            @foreach (var s in _sps) { <option value="@s.Id">@s.Nome</option> }
        </select>
        <select class="cell" @bind="_seg">
            <option value="">Todos segmentos</option>
            @foreach (var s in _segmentos) { <option value="@s">@s</option> }
        </select>
        <select class="cell" @bind="_urg">
            <option value="">Toda criticidade</option>
            <option value="Crítica">Crítica</option><option value="Alta">Alta</option>
            <option value="Média">Média</option><option value="Baixa">Baixa</option>
        </select>
        <select class="cell" @bind="_temp">
            <option value="">Todo status</option>
            <option value="futura">Futura</option><option value="próxima">Próxima</option>
            <option value="vencida">Vencida</option><option value="expirada">Expirada</option><option value="histórica">Histórica</option>
        </select>
    </div>
</div>

<div style="overflow-x:auto">
<table class="grid">
    <thead>
        <tr>
            <th>Mês previsto</th><th>Cliente</th><th>Unidade</th><th>Equipamento</th>
            <th>Item / Conjunto</th><th class="right">Valor potencial</th><th>Vendedor</th>
            <th>Status da janela</th><th>Ação recomendada</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Grupos)
        {
            <tr style="background:rgba(12,35,64,.03)">
                <td class="nowrap" style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--secondary)">@g.Mes</td>
                <td style="font-size:12px;color:var(--muted)">@g.Items.Count janela(s) · @Fmt.Brl0(g.Items.Sum(o => o.ValorEstimado))</td>
                <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
            </tr>
            @foreach (var o in g.Items)
            {
                <tr>
                    <td class="nowrap">@Fmt.Date(o.DataPrevista)</td>
                    <td>@Intel.ClienteDaUnidade(o.ClientUnitId)</td>
                    <td>@Intel.UnitNome(o.ClientUnitId)</td>
                    <td class="nowrap">@Intel.EquipmentModel(o.EquipmentId)</td>
                    <td>@o.Item</td>
                    <td class="right nowrap">@Fmt.Brl0(o.ValorEstimado)</td>
                    <td class="nowrap">@Intel.SalespersonName(o.VendedorId)</td>
                    <td class="nowrap">
                        <span class="badge @TempClass(o.StatusTemporal)">@Cap(o.StatusTemporal)</span>
                        <span class="badge @IntelligenceService.UrgClass(o.Urgencia)">@o.Urgencia</span>
                    </td>
                    <td style="min-width:15rem;font-size:12.5px">
                        <a href="@($"/oportunidades/{o.Id}")">@o.ProximaAcao</a>
                        <a href="/visitas/nova" style="display:block;font-size:11.5px;margin-top:2px">+ criar viagem</a>
                    </td>
                </tr>
            }
        }
        @if (Filtradas.Count == 0)
        {
            <tr><td colspan="9" class="empty">Nenhuma janela de reposição para os filtros selecionados.</td></tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<Opportunity> _all = new();
    private List<Salesperson> _sps = new();
    private List<string> _segmentos = new();
    private string _q = "", _vend = "", _seg = "", _urg = "", _temp = "";

    protected override void OnInitialized()
    {
        _all = Intel.OpenOpportunities().Where(o => o.DiasAteJanela <= 730).ToList();
        _sps = Salespeople.All().Where(s => s.Id != "sp-mgr").ToList();
        _segmentos = Units.All().Select(u => u.Segmento).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s).ToList();
    }

    private static bool IsCritica(Opportunity o) =>
        o.Urgencia == "Crítica" || o.StatusTemporal is "vencida" or "expirada" or "histórica";

    private List<Opportunity> Filtradas
    {
        get
        {
            IEnumerable<Opportunity> q = _all;
            if (!string.IsNullOrWhiteSpace(_vend)) q = q.Where(o => o.VendedorId == _vend);
            if (!string.IsNullOrWhiteSpace(_seg)) q = q.Where(o => Intel.UnitSegmento(o.ClientUnitId) == _seg);
            if (!string.IsNullOrWhiteSpace(_urg)) q = q.Where(o => o.Urgencia == _urg);
            if (!string.IsNullOrWhiteSpace(_temp)) q = q.Where(o => o.StatusTemporal == _temp);
            if (!string.IsNullOrWhiteSpace(_q))
            {
                var b = _q.Trim().ToLowerInvariant();
                q = q.Where(o => (o.Item + Intel.ClienteDaUnidade(o.ClientUnitId)).ToLowerInvariant().Contains(b));
            }
            return q.OrderBy(o => o.DataPrevista, StringComparer.Ordinal).ToList();
        }
    }

    private record Grupo(string Mes, List<Opportunity> Items);
    private List<Grupo> Grupos
    {
        get
        {
            var grupos = new List<Grupo>();
            foreach (var o in Filtradas)
            {
                var mes = MesExtenso(o.DataPrevista);
                if (grupos.Count > 0 && grupos[^1].Mes == mes) grupos[^1].Items.Add(o);
                else grupos.Add(new Grupo(mes, new List<Opportunity> { o }));
            }
            return grupos;
        }
    }

    private static readonly string[] Meses =
        { "JAN", "FEV", "MAR", "ABR", "MAI", "JUN", "JUL", "AGO", "SET", "OUT", "NOV", "DEZ" };

    private static string MesExtenso(string iso)
    {
        if (iso.Length < 7) return iso;
        var p = iso.Split('-');
        if (p.Length < 2 || !int.TryParse(p[1], out var m) || m < 1 || m > 12) return iso[..7];
        return $"{Meses[m - 1]} DE {p[0]}";
    }

    private static string Cap(string s) => string.IsNullOrEmpty(s) ? "—" : char.ToUpperInvariant(s[0]) + s[1..];

    private static string TempClass(string t) => t switch
    {
        "vencida" or "expirada" or "histórica" => "st-vencida",
        "próxima" => "st-atencao",
        "futura" => "st-ok",
        _ => "st-plan",
    };
}
