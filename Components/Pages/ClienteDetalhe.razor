@page "/clientes/{Id}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ClientUnitRepository Units
@inject CompanyRepository Empresas
@inject SalespersonRepository Vendedores
@inject SegmentRepository Segmentos
@inject InstalledBaseRepository Base
@inject EquipmentRepository Equipamentos
@inject IntelligenceService Intel

<PageTitle>Cliente · AFM HSA</PageTitle>

@if (_u is null)
{
    <h1>Unidade</h1>
    <div class="panel empty-state"><div class="empty-title">Unidade não encontrada</div>
        <a class="btn-ghost" href="/clientes">Voltar</a></div>
}
else
{
    <div class="page-head">
        <div><h1>@NomeCliente(_u.CompanyId)</h1>
            <p class="subtitle">@_u.NomeUnidade · @_u.Cidade/@_u.Estado · @_u.Segmento@(string.IsNullOrWhiteSpace(_u.Cnpj) ? "" : $" · CNPJ {_u.Cnpj}")</p></div>
        <div class="page-actions">
            @if (!_editPlanta)
            {
                <button class="btn-ghost" @onclick="AbrirEditarPlanta">✎ Editar planta</button>
            }
            <a class="btn-ghost" href="/clientes">Voltar</a>
        </div>
    </div>

    @if (_msg is not null)
    {
        <div class="side-ok" style="margin-bottom:12px">@_msg</div>
    }

    @if (_editPlanta)
    {
        <div class="panel" style="margin-bottom:16px">
            <div class="dash-title">Editar dados da planta</div>
            <div class="form3">
                <label>Cliente *
                    <select class="cell" @bind="_pCompanyId">
                        <option value="">Selecione o cliente…</option>
                        @foreach (var c in _empresas)
                        {
                            <option value="@c.Id">@c.Nome</option>
                        }
                    </select>
                </label>
                <label>Nome da planta / unidade *
                    <input class="cell" @bind="_pu.NomeUnidade" />
                </label>
                <label>CNPJ
                    <input class="cell" placeholder="00.000.000/0000-00" maxlength="18"
                           @bind="_pu.Cnpj" @bind:after="FormatarCnpj" />
                </label>
                <label>Cidade
                    <input class="cell" @bind="_pu.Cidade" />
                </label>
                <label>UF
                    <input class="cell" maxlength="2" @bind="_pu.Estado" />
                </label>
                <label>Segmento *
                    <select class="cell" @bind="_pu.Segmento" @bind:after="SegmentoPlantaMudou">
                        <option value="">Selecione o segmento…</option>
                        @foreach (var g in _segs)
                        {
                            <option value="@g.Nome">@g.Nome</option>
                        }
                    </select>
                </label>
                <label>Vendedor responsável
                    <select class="cell" @bind="_pu.VendedorId">
                        <option value="">Sem vendedor definido</option>
                        @foreach (var v in _vendedores)
                        {
                            <option value="@v.Id">@v.Nome · @SegmentoTexto.Display(v.Segmentos)</option>
                        }
                    </select>
                    @if (_dicaVendedor is not null)
                    {
                        <span style="font-size:11.5px;color:var(--muted)">@_dicaVendedor</span>
                    }
                </label>
                <label>Região (opcional)
                    <input class="cell" @bind="_pu.Regiao" />
                </label>
            </div>
            @if (_pErro is not null) { <div class="alert-error" style="margin-top:12px">@_pErro</div> }
            <div class="toolbar" style="margin-top:14px;margin-bottom:0">
                <button class="btn-primary" @onclick="SalvarPlanta">Salvar alterações</button>
                <button class="btn-ghost" @onclick="() => _editPlanta = false">Cancelar</button>
            </div>
        </div>
    }

    <div class="kpis">
        <div class="kpi"><div class="kpi-label">Segmento</div><div class="kpi-value" style="font-size:16px">@Dash(_u.Segmento)</div></div>
        <div class="kpi"><div class="kpi-label">Vendedor responsável</div><div class="kpi-value" style="font-size:15px">@Intel.SalespersonName(_u.VendedorId)</div></div>
        <div class="kpi"><div class="kpi-label">Equipamentos</div><div class="kpi-value">@_base.Count</div></div>
        <div class="kpi k-ren"><div class="kpi-label">Valor potencial em aberto</div><div class="kpi-value" style="font-size:16px">@Fmt.Brl0(_opps.Sum(o => o.ValorEstimado))</div></div>
    </div>

    <div class="toolbar" style="margin-bottom:10px">
        <div class="dash-title" style="margin:0">Equipamentos instalados</div>
        <div style="flex:1"></div>
        @if (!_novoAberto)
        {
            <button class="btn-primary" @onclick="AbrirNovo">+ Cadastrar equipamento</button>
        }
    </div>

    <div class="toolbar" style="margin-bottom:12px">
        <span class="badge st-ok">@_base.Count(EmOperacao) em operação</span>
        <span class="badge st-plan">@_base.Count(b => !EmOperacao(b)) parado(s)</span>
        <span class="badge st-atencao">@_modelosCount modelo(s)</span>
        <div style="flex:1"></div>
        <input class="cell" style="max-width:240px" placeholder="Buscar tag, série, modelo…"
               @bind="_buscaEq" @bind:event="oninput" />
        <select class="cell" style="max-width:170px" @bind="_filtroSit">
            <option value="todos">Todas as situações</option>
            <option value="operando">Só em operação</option>
            <option value="parados">Só parados</option>
        </select>
    </div>

    @if (_novoAberto)
    {
        <div class="panel" style="margin-bottom:16px">
            <div class="dash-title">Cadastrar equipamento nesta planta</div>
            <div class="form3">
                <label>Equipamento *
                    <select class="cell" @bind="_equipId">
                        <option value="">Selecione do catálogo…</option>
                        @foreach (var e in _catalogo)
                        {
                            <option value="@e.Id">@NomeCatalogo(e)</option>
                        }
                        <option value="@NovoEquip">➕ Cadastrar novo equipamento…</option>
                    </select>
                </label>
                @if (_equipId == NovoEquip)
                {
                    <label>Tipo
                        <input class="cell" list="tipos" placeholder="Ex.: Exaustor" @bind="_novo.Tipo" />
                    </label>
                    <label>Modelo *
                        <input class="cell" placeholder="Ex.: ID-Fan 2400" @bind="_novo.Modelo" />
                    </label>
                    <label>Aplicação
                        <input class="cell" placeholder="Ex.: Forno de clínquer" @bind="_novo.Aplicacao" />
                    </label>
                    <label>Fabricante
                        <input class="cell" @bind="_novo.Fabricante" />
                    </label>
                    <label>Valor completo (R$)
                        <input class="cell num" type="number" step="0.01" @bind="_novo.ValorCompleto" />
                    </label>
                }
                <label>Criticidade
                    <select class="cell" @bind="_criticidade">
                        <option value="baixa">Baixa</option>
                        <option value="média">Média</option>
                        <option value="alta">Alta</option>
                        <option value="crítica">Crítica</option>
                    </select>
                </label>
                <label>Quantas unidades deste modelo?
                    <input class="cell num" type="number" min="1" max="50"
                           @bind="_qtd" @bind:after="AjustarUnidades" />
                </label>
            </div>
            <datalist id="tipos">
                @foreach (var t in _tipos) { <option value="@t" /> }
            </datalist>

            <div class="dash-title" style="margin-top:18px">Identificação de cada unidade</div>
            <p class="subtitle" style="margin-top:-8px">
                Equipamentos iguais se distinguem pela tag, pelo número de série e pelo ano —
                e cada um pode estar em operação ou parado.
            </p>
            <table class="grid" style="margin-bottom:10px">
                <thead><tr><th style="width:44px">#</th><th>Tag</th><th>Nº de série</th>
                    <th style="width:110px">Ano</th><th style="width:190px">Situação</th><th style="width:90px"></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < _unidades.Count; i++)
                    {
                        var idx = i;
                        var un = _unidades[i];
                        <tr>
                            <td>@(idx + 1)</td>
                            <td><input class="cell" placeholder="Ex.: VE-101" @bind="un.Tag" /></td>
                            <td><input class="cell" placeholder="Ex.: SN-48213" @bind="un.Serial" /></td>
                            <td><input class="cell num" type="number" placeholder="2013" @bind="un.Ano" /></td>
                            <td>
                                <select class="cell" @bind="un.EmOperacao">
                                    <option value="true">Em operação</option>
                                    <option value="false">Parado</option>
                                </select>
                            </td>
                            <td class="nowrap">
                                @if (_unidades.Count > 1)
                                {
                                    <button class="btn-link" style="color:#b91c1c"
                                            @onclick="() => RemoverUnidade(idx)">remover</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button class="btn-ghost" @onclick="AdicionarUnidade">+ Adicionar unidade</button>

            @if (_erro is not null) { <div class="alert-error" style="margin-top:12px">@_erro</div> }

            <div class="toolbar" style="margin-top:14px;margin-bottom:0">
                <button class="btn-primary" @onclick="SalvarEquipamento">Salvar equipamento</button>
                <button class="btn-ghost" @onclick="FecharNovo">Cancelar</button>
                <span style="font-size:12px;color:var(--muted)">Os campos com * são obrigatórios.</span>
            </div>
        </div>
    }

    <div style="overflow-x:auto">
    <table class="grid" style="margin-bottom:20px">
        <thead><tr><th>Tag</th><th>Nº de série</th><th style="width:90px">Ano</th>
            <th style="width:150px">Situação</th><th style="width:140px">Criticidade</th><th style="width:230px">Ações</th></tr></thead>
        <tbody>
            @foreach (var grupo in Agrupados)
            {
                <tr>
                    <td colspan="6" style="background:#f2f6fb;font-weight:600;color:var(--primary)">
                        @grupo.Key
                        <span style="font-weight:400;color:var(--muted)"> · @grupo.Count() unidade(s)</span>
                        @if (!string.IsNullOrWhiteSpace(AplicacaoDoGrupo(grupo.Key)))
                        {
                            <span style="font-weight:400;color:var(--muted)"> · @AplicacaoDoGrupo(grupo.Key)</span>
                        }
                        <a class="btn-link" style="float:right" href="@($"/equipamentos/{grupo.First().EquipmentId}")">ver equipamento →</a>
                    </td>
                </tr>
                @foreach (var b in grupo)
                {
                    var operando = EmOperacao(b);
                    if (_editId == b.Id)
                    {
                        <tr style="background:#fffdf5">
                            <td><input class="cell" placeholder="Tag" @bind="_eTag" /></td>
                            <td><input class="cell" placeholder="Nº de série" @bind="_eSerial" /></td>
                            <td><input class="cell num" type="number" @bind="_eAno" /></td>
                            <td>
                                <select class="cell" @bind="_eOperando">
                                    <option value="true">Em operação</option>
                                    <option value="false">Parado</option>
                                </select>
                            </td>
                            <td>
                                <select class="cell" @bind="_eCrit">
                                    <option value="baixa">Baixa</option>
                                    <option value="média">Média</option>
                                    <option value="alta">Alta</option>
                                    <option value="crítica">Crítica</option>
                                </select>
                            </td>
                            <td class="nowrap">
                                <button class="btn-link" style="font-weight:600" @onclick="() => SalvarEdicao(b)">salvar</button>
                                <button class="btn-link" style="color:var(--muted)" @onclick="() => _editId = null">cancelar</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr style="@(operando ? "" : "opacity:.6")">
                            <td class="nowrap"><strong>@Dash(b.Tag)</strong></td>
                            <td class="nowrap">@Dash(b.SerialNo)</td>
                            <td>@(b.AnoInstalacao > 0 ? b.AnoInstalacao.ToString() : "—")</td>
                            <td>
                                <span class="badge @(operando ? "st-ok" : "st-plan")">
                                    @(operando ? "Em operação" : "Parado")
                                </span>
                            </td>
                            <td><span class="badge @CritClass(b.Criticidade)">@Cap(b.Criticidade)</span></td>
                            <td class="nowrap">
                                <button class="btn-link" @onclick="() => AbrirEdicao(b)">editar</button>
                                <button class="btn-link" @onclick="() => AlternarOperacao(b)">
                                    @(operando ? "parar" : "reativar")
                                </button>
                                @if (_confirmarId == b.Id)
                                {
                                    <button class="btn-link" style="color:#b91c1c;font-weight:600"
                                            @onclick="() => ExcluirEquipamento(b)">excluir?</button>
                                    <button class="btn-link" style="color:var(--muted)"
                                            @onclick="() => _confirmarId = null">não</button>
                                }
                                else
                                {
                                    <button class="btn-link" style="color:#b91c1c"
                                            @onclick="() => _confirmarId = b.Id">excluir</button>
                                }
                            </td>
                        </tr>
                    }
                }
            }
            @if (!Agrupados.Any())
            {
                <tr><td colspan="6" class="empty">
                    @(_base.Count == 0
                        ? "Sem equipamentos instalados. Use \"Cadastrar equipamento\" para adicionar o primeiro."
                        : "Nenhum equipamento corresponde ao filtro.")
                </td></tr>
            }
        </tbody>
    </table>
    </div>

    <div class="dash-title">Oportunidades abertas</div>
    <table class="grid">
        <thead><tr><th>Data prevista</th><th>Peça / Conjunto</th><th class="right">Valor</th><th>Urgência</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var o in _opps)
            {
                <tr>
                    <td class="nowrap">@Fmt.Date(o.DataPrevista)</td>
                    <td>@o.Item</td>
                    <td class="right nowrap">@Fmt.Brl0(o.ValorEstimado)</td>
                    <td><span class="badge @IntelligenceService.UrgClass(o.Urgencia)">@o.Urgencia</span></td>
                    <td>@o.Status</td>
                    <td class="nowrap"><a class="btn-link" href="@($"/oportunidades/{o.Id}")">Abrir</a></td>
                </tr>
            }
            @if (_opps.Count == 0) { <tr><td colspan="6" class="empty">Sem oportunidades abertas.</td></tr> }
        </tbody>
    </table>
}

@code {
    private const string NovoEquip = "__novo__";

    [Parameter] public string? Id { get; set; }
    private ClientUnit? _u;
    private List<InstalledBase> _base = new();
    private List<Opportunity> _opps = new();
    private List<Equipment> _catalogo = new();
    private List<Company> _empresas = new();
    private List<Salesperson> _vendedores = new();
    private List<Segment> _segs = new();
    private List<string> _tipos = new();
    private Dictionary<string, Equipment> _equip = new();
    private Dictionary<string, string> _nomeEmpresa = new();
    private int _modelosCount;

    private string? _confirmarId;
    private string? _msg, _erro;

    // filtros da lista
    private string _buscaEq = "";
    private string _filtroSit = "todos";

    // edição de uma unidade
    private string? _editId;
    private string _eTag = "", _eSerial = "", _eCrit = "média";
    private int _eAno;
    private bool _eOperando = true;

    // edição da planta
    private bool _editPlanta;
    private ClientUnit _pu = new();
    private string _pCompanyId = "";
    private string? _pErro, _dicaVendedor;

    // cadastro de equipamento
    private bool _novoAberto;
    private string _equipId = "";
    private Equipment _novo = new();
    private int _qtd = 1;
    private string _criticidade = "média";

    /// <summary>Uma linha do formulário = uma unidade física do equipamento.</summary>
    private class UnidadeForm
    {
        public string Tag { get; set; } = "";
        public string Serial { get; set; } = "";
        public int Ano { get; set; }
        public bool EmOperacao { get; set; } = true;
    }
    private List<UnidadeForm> _unidades = new() { new UnidadeForm() };

    protected override void OnInitialized() => Carregar();

    private void Carregar()
    {
        _u = Units.All().FirstOrDefault(u => u.Id == Id);
        if (_u is null) return;
        _base = Base.All().Where(b => b.ClientUnitId == _u.Id).ToList();
        _catalogo = Equipamentos.All();
        _equip = _catalogo.ToDictionary(e => e.Id, e => e);
        _empresas = Empresas.All();
        _nomeEmpresa = _empresas.ToDictionary(c => c.Id, c => c.Nome);
        _vendedores = Vendedores.All().Where(v => v.Ativo).ToList();
        _segs = Segmentos.All();
        _tipos = _catalogo.Select(e => e.Tipo).Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct().OrderBy(t => t).ToList();
        _modelosCount = _base.Select(b => b.EquipmentId).Distinct().Count();
        _opps = Intel.OpenOpportunities().Where(o => o.ClientUnitId == _u.Id)
            .OrderBy(o => o.DataPrevista, StringComparer.Ordinal).ToList();
    }

    private string NomeCliente(string companyId) =>
        _nomeEmpresa.TryGetValue(companyId, out var n) ? n : "—";

    // ---- lista de equipamentos ------------------------------------------
    private List<InstalledBase> Filtrados
    {
        get
        {
            IEnumerable<InstalledBase> q = _base;
            if (_filtroSit == "operando") q = q.Where(EmOperacao);
            else if (_filtroSit == "parados") q = q.Where(b => !EmOperacao(b));

            if (!string.IsNullOrWhiteSpace(_buscaEq))
            {
                var s = _buscaEq.Trim().ToLowerInvariant();
                q = q.Where(b => (b.Tag + " " + b.SerialNo + " " + Modelo(b.EquipmentId))
                    .ToLowerInvariant().Contains(s));
            }
            return q.ToList();
        }
    }

    /// <summary>Agrupa por modelo — equipamentos iguais aparecem juntos.</summary>
    private IEnumerable<IGrouping<string, InstalledBase>> Agrupados =>
        Filtrados
            .OrderBy(b => Modelo(b.EquipmentId))
            .ThenBy(b => b.Tag, StringComparer.OrdinalIgnoreCase)
            .GroupBy(b => Modelo(b.EquipmentId));

    private string AplicacaoDoGrupo(string modelo)
    {
        var e = _catalogo.FirstOrDefault(x => x.Modelo == modelo);
        return e?.Aplicacao ?? "";
    }

    // ---- edição de uma unidade ------------------------------------------
    private void AbrirEdicao(InstalledBase b)
    {
        _editId = b.Id;
        _confirmarId = null;
        _msg = null;
        _eTag = b.Tag;
        _eSerial = b.SerialNo;
        _eAno = b.AnoInstalacao;
        _eCrit = string.IsNullOrWhiteSpace(b.Criticidade) ? "média" : b.Criticidade;
        _eOperando = EmOperacao(b);
    }

    private void SalvarEdicao(InstalledBase b)
    {
        var tag = (_eTag ?? "").Trim();
        if (tag.Length > 0 && _base.Any(x => x.Id != b.Id &&
            string.Equals((x.Tag ?? "").Trim(), tag, StringComparison.OrdinalIgnoreCase)))
        {
            _msg = $"Já existe outro equipamento com a tag \"{tag}\" nesta planta.";
            return;
        }

        b.Tag = tag;
        b.Designation = tag;
        b.SerialNo = (_eSerial ?? "").Trim();
        b.AnoInstalacao = _eAno;
        b.InstallYear = _eAno > 0 ? _eAno.ToString() : "";
        b.Criticidade = _eCrit;
        b.Status = _eOperando ? "ativo" : "inativo";
        b.OperatingStatus = _eOperando ? "Em operação" : "Parado";
        Base.Save(b);

        _editId = null;
        Intel.Invalidate();
        Carregar();
        _msg = $"Equipamento {(tag.Length > 0 ? tag : Modelo(b.EquipmentId))} atualizado.";
    }

    // ---- edição da planta ------------------------------------------------
    private void AbrirEditarPlanta()
    {
        if (_u is null) return;
        _editPlanta = true;
        _pErro = null; _msg = null; _dicaVendedor = null;
        _pCompanyId = _u.CompanyId;
        _pu = new ClientUnit
        {
            Id = _u.Id, CompanyId = _u.CompanyId, NomeUnidade = _u.NomeUnidade, Cnpj = _u.Cnpj,
            Cidade = _u.Cidade, Estado = _u.Estado, Segmento = _u.Segmento,
            Regiao = _u.Regiao, VendedorId = _u.VendedorId,
        };
    }

    private void FormatarCnpj() => _pu.Cnpj = Cnpj.Formatar(_pu.Cnpj);

    private void SegmentoPlantaMudou()
    {
        var seg = (_pu.Segmento ?? "").Trim();
        if (seg.Length == 0) { _dicaVendedor = null; return; }

        var doSegmento = _vendedores.Where(v => SegmentoTexto.Contem(v.Segmentos, seg)).ToList();
        if (doSegmento.Count == 0)
        {
            _dicaVendedor = $"Nenhum vendedor atende o segmento \"{seg}\". Escolha um manualmente.";
            return;
        }
        if (!doSegmento.Any(v => v.Id == _pu.VendedorId)) _pu.VendedorId = doSegmento[0].Id;
        _dicaVendedor = doSegmento.Count == 1
            ? $"Responsável pelo segmento \"{seg}\"."
            : $"{doSegmento.Count} vendedores atendem \"{seg}\" — confirme o responsável.";
    }

    private void SalvarPlanta()
    {
        _pErro = null;
        if (string.IsNullOrWhiteSpace(_pCompanyId))
        { _pErro = "Selecione o cliente."; return; }
        if (string.IsNullOrWhiteSpace(_pu.NomeUnidade))
        { _pErro = "Informe o nome da planta / unidade."; return; }
        if (string.IsNullOrWhiteSpace(_pu.Segmento))
        { _pErro = "Selecione o segmento da planta."; return; }
        if (!string.IsNullOrWhiteSpace(_pu.Cnpj) && !Cnpj.Valido(_pu.Cnpj))
        { _pErro = "CNPJ inválido. Confira os números ou deixe o campo em branco."; return; }

        _pu.CompanyId = _pCompanyId;
        _pu.NomeUnidade = _pu.NomeUnidade.Trim();
        _pu.Cnpj = Cnpj.Formatar(_pu.Cnpj);
        _pu.Cidade = (_pu.Cidade ?? "").Trim();
        _pu.Estado = (_pu.Estado ?? "").Trim().ToUpperInvariant();
        _pu.Regiao = (_pu.Regiao ?? "").Trim();
        Units.Save(_pu);

        _editPlanta = false;
        Intel.Invalidate();
        Carregar();
        _msg = "Dados da planta atualizados.";
    }

    // ---- cadastro de equipamento -----------------------------------------
    private static string NomeCatalogo(Equipment e)
    {
        var nome = string.IsNullOrWhiteSpace(e.Modelo) ? e.Nome : e.Modelo;
        return string.IsNullOrWhiteSpace(e.Tipo) ? nome : $"{e.Tipo} · {nome}";
    }

    private void AbrirNovo()
    {
        _novoAberto = true;
        _erro = null; _msg = null; _confirmarId = null; _editId = null;
        _equipId = ""; _novo = new Equipment();
        _qtd = 1; _criticidade = "média";
        _unidades = new List<UnidadeForm> { new UnidadeForm() };
    }

    private void FecharNovo()
    {
        _novoAberto = false;
        _erro = null;
    }

    /// <summary>Cresce ou encolhe a lista de unidades conforme a quantidade informada.</summary>
    private void AjustarUnidades()
    {
        if (_qtd < 1) _qtd = 1;
        if (_qtd > 50) _qtd = 50;
        while (_unidades.Count < _qtd) _unidades.Add(new UnidadeForm());
        while (_unidades.Count > _qtd) _unidades.RemoveAt(_unidades.Count - 1);
    }

    private void AdicionarUnidade()
    {
        _unidades.Add(new UnidadeForm());
        _qtd = _unidades.Count;
    }

    private void RemoverUnidade(int idx)
    {
        if (idx < 0 || idx >= _unidades.Count || _unidades.Count == 1) return;
        _unidades.RemoveAt(idx);
        _qtd = _unidades.Count;
    }

    private void SalvarEquipamento()
    {
        _erro = null;
        if (_u is null) return;

        if (string.IsNullOrWhiteSpace(_equipId))
        { _erro = "Selecione o equipamento (ou cadastre um novo)."; return; }
        if (_equipId == NovoEquip && string.IsNullOrWhiteSpace(_novo.Modelo))
        { _erro = "Informe o modelo do novo equipamento."; return; }

        var equipId = _equipId;
        if (_equipId == NovoEquip)
        {
            var e = new Equipment
            {
                Id = "eq-" + Guid.NewGuid().ToString("N")[..8],
                DocNum = (_catalogo.Count + 1).ToString("D2"),
                Tipo = (_novo.Tipo ?? "").Trim(),
                Modelo = _novo.Modelo.Trim(),
                Nome = $"{_novo.Tipo} {_novo.Modelo}".Trim(),
                Aplicacao = (_novo.Aplicacao ?? "").Trim(),
                Segmento = _u.Segmento,
                Fabricante = string.IsNullOrWhiteSpace(_novo.Fabricante) ? "Howden" : _novo.Fabricante.Trim(),
                ValorCompleto = _novo.ValorCompleto,
            };
            Equipamentos.Save(e);
            equipId = e.Id;
            _equip[e.Id] = e;
            _catalogo.Add(e);
        }

        var cat = _equip.TryGetValue(equipId, out var ce) ? ce : new Equipment();

        // tags repetidas atrapalham o controle — bloqueia antes de gravar
        var tags = _unidades.Select(u => (u.Tag ?? "").Trim())
            .Where(t => t.Length > 0).ToList();
        var dupInterna = tags.GroupBy(t => t, StringComparer.OrdinalIgnoreCase).FirstOrDefault(g => g.Count() > 1);
        if (dupInterna is not null)
        { _erro = $"A tag \"{dupInterna.Key}\" está repetida entre as unidades."; return; }
        var jaExiste = tags.FirstOrDefault(t =>
            _base.Any(b => string.Equals((b.Tag ?? "").Trim(), t, StringComparison.OrdinalIgnoreCase)));
        if (jaExiste is not null)
        { _erro = $"Já existe um equipamento com a tag \"{jaExiste}\" nesta planta."; return; }

        foreach (var un in _unidades)
        {
            var operando = un.EmOperacao;
            Base.Save(new InstalledBase
            {
                Id = "ib-" + Guid.NewGuid().ToString("N")[..8],
                ClientUnitId = _u.Id,
                EquipmentId = equipId,
                Quantidade = 1,
                AnoInstalacao = un.Ano,
                Criticidade = _criticidade,
                Status = operando ? "ativo" : "inativo",
                VendedorId = _u.VendedorId,
                Tag = (un.Tag ?? "").Trim(),
                SerialNo = (un.Serial ?? "").Trim(),
                // colunas da planilha-mestre que dá para derivar da planta e do equipamento
                PlantName = _u.NomeUnidade,
                SiteUnit = _u.NomeUnidade,
                City = _u.Cidade,
                State = _u.Estado,
                Industry = _u.Segmento,
                Client = NomeCliente(_u.CompanyId),
                Designation = (un.Tag ?? "").Trim(),
                ProductType = cat.Tipo,
                ModelFamily = cat.Modelo,
                Brand = cat.Fabricante,
                ApplicationType = cat.Aplicacao,
                FansPerBoiler = "1",
                InstallYear = un.Ano > 0 ? un.Ano.ToString() : "",
                OperatingStatus = operando ? "Em operação" : "Parado",
            });
        }

        var n = _unidades.Count;
        Intel.Invalidate();
        Carregar();
        _novoAberto = false;
        _msg = n == 1
            ? $"Equipamento \"{NomeCatalogo(cat)}\" cadastrado nesta planta."
            : $"{n} unidades de \"{NomeCatalogo(cat)}\" cadastradas nesta planta.";
    }

    /// <summary>Marca a unidade como parada ou de volta em operação.</summary>
    private void AlternarOperacao(InstalledBase b)
    {
        var operando = EmOperacao(b);
        b.Status = operando ? "inativo" : "ativo";
        b.OperatingStatus = operando ? "Parado" : "Em operação";
        Base.Save(b);
        Intel.Invalidate();
        Carregar();
        var quem = string.IsNullOrWhiteSpace(b.Tag) ? Modelo(b.EquipmentId) : b.Tag;
        _msg = operando ? $"{quem} marcado como parado." : $"{quem} reativado.";
    }

    private void ExcluirEquipamento(InstalledBase b)
    {
        Base.Delete(b.Id);
        _confirmarId = null;
        Intel.Invalidate();
        Carregar();
        var quem = string.IsNullOrWhiteSpace(b.Tag) ? Modelo(b.EquipmentId) : b.Tag;
        _msg = $"{quem} removido desta planta. O equipamento continua no catálogo.";
    }

    private static bool EmOperacao(InstalledBase b) =>
        !string.Equals(b.Status, "inativo", StringComparison.OrdinalIgnoreCase);

    private static string Dash(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private string Modelo(string id) => _equip.TryGetValue(id, out var e) ? e.Modelo : id;

    private static string Cap(string s) => string.IsNullOrEmpty(s) ? "—" : char.ToUpperInvariant(s[0]) + s[1..];
    private static string CritClass(string c) => c.ToLowerInvariant() switch
    {
        "crítica" => "st-vencida", "alta" => "st-critica", "média" => "st-atencao", "baixa" => "st-ok", _ => "st-plan",
    };
}
