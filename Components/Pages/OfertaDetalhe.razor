@page "/ofertas/{Id}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OfferRepository OffersRepo
@inject ClientUnitRepository Units
@inject SalespersonRepository Vendedores
@inject EquipmentRepository Equipamentos
@inject InstalledBaseRepository Base
@inject BomRepository Bom
@inject SalesRecordRepository Vendas
@inject DadosBancariosRepository Bancos
@inject IWebHostEnvironment Ambiente
@inject IJSRuntime JS

<PageTitle>Oferta · AFM HSA</PageTitle>

@if (_o is null)
{
    <h1>Oferta</h1>
    <div class="panel empty-state"><div class="empty-title">Oferta não encontrada</div>
        <a class="btn-ghost" href="/ofertas">Voltar</a></div>
}
else
{
    <div class="page-head no-print">
        <div><h1>Oferta @_o.OfferCode</h1><p class="subtitle">@_o.ClientName · @Cambio.Dinheiro(_o, _o.TotalAmount)</p></div>
        <div class="page-actions">
            <a class="btn-ghost" href="/ofertas">← Ofertas</a>
            <a class="btn-ghost" href="@($"/gerar-proposta/{_o.Id}")" title="Abre na Gerar Proposta, por etapas, para continuar ou corrigir">✎ Editar</a>
            <button class="btn-accent" @onclick="GerarWord" disabled="@_gerando"
                    title="Preenche o modelo de proposta comercial da equipe (Word)">@(_gerando ? "Gerando…" : "⬇ Proposta comercial (Word)")</button>
            <button class="btn-primary" @onclick="Imprimir">Imprimir / PDF</button>
        </div>
    </div>

    @if (_erroWord is not null)
    {
        <div class="alert-error no-print">@_erroWord</div>
    }

    @* Cabeçalho completo: controle comercial interno — não sai na impressão para o cliente *@
    <div class="panel no-print" style="margin-bottom:16px">
        <div class="dash-title">Cabeçalho <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">uso interno · não aparece no documento impresso</span></div>
        <div class="form3 cab-detalhe">
            @foreach (var (rot, val) in Cabecalho)
            {
                <div><div class="fact-label">@rot</div><div>@Dash(val)</div></div>
            }
        </div>
    </div>

    @if (_o.PricingCusto > 0)
    {
        <div class="panel no-print" style="margin-bottom:16px">
            <div class="dash-title">Pricing <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">uso interno · como estava ao salvar · não aparece no documento impresso</span></div>
            <div class="form3 cab-detalhe">
                @foreach (var (rot, val) in Pricing)
                {
                    <div><div class="fact-label">@rot</div><div>@Dash(val)</div></div>
                }
            </div>
        </div>
    }

    <div class="panel proposal-print">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid var(--primary);padding-bottom:14px;margin-bottom:16px">
            <div>
                <div style="font-size:22px;font-weight:700;color:var(--primary)">Howden</div>
                <div style="font-size:12px;color:var(--muted)">Aftermarket Intelligence · Chart Industries</div>
            </div>
            <div style="text-align:right;font-size:12.5px">
                <div><strong>Proposta:</strong> @_o.OfferCode@(string.IsNullOrWhiteSpace(_o.Revisao) ? "" : $" · Rev. {_o.Revisao}")</div>
                <div><strong>Data:</strong> @Fmt.Date(_o.OfferDate)</div>
                <div><strong>Ref.:</strong> @_o.OurReference</div>
            </div>
        </div>

        <div class="form3" style="margin-bottom:16px">
            <div><div class="fact-label">Cliente</div><div>@_o.ClientName</div></div>
            <div><div class="fact-label">A/C</div><div>@Dash(_o.AttentionTo)</div></div>
            <div><div class="fact-label">Cidade</div><div>@Dash(_o.City)</div></div>
            @if (_o.Plantas.Count > 0)
            {
                <div><div class="fact-label">@(_o.Plantas.Count > 1 ? "Plantas" : "Planta")</div><div>@string.Join(" · ", _o.Plantas.Select(PlantasDaProposta.Rotulo))</div></div>
            }
            <div><div class="fact-label">Projeto</div><div>@Dash(_o.Project)</div></div>
            <div><div class="fact-label">Preparado por</div><div>@Dash(_o.PreparedBy)</div></div>
            <div><div class="fact-label">Status</div><div>@_o.Status</div></div>
        </div>

        <p style="margin-bottom:14px">@_o.IntroText</p>

        <table class="grid" style="margin-bottom:16px">
            <thead><tr><th>Item</th><th>Descrição</th><th class="right">Qtd</th><th class="right">Unitário</th><th class="right">Total</th></tr></thead>
            <tbody>
                @for (int i = 0; i < _items.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@_items[i].Description</td>
                        <td class="right">@_items[i].Quantity</td>
                        <td class="right nowrap">@Cambio.Dinheiro(_o, _items[i].UnitPrice)</td>
                        <td class="right nowrap">@Cambio.Dinheiro(_o, _items[i].TotalPrice)</td>
                    </tr>
                }
                @if (_items.Count == 0) { <tr><td colspan="5" class="empty">Sem itens.</td></tr> }
                <tr class="side-item-total"><td colspan="4" class="right"><strong>Total</strong></td><td class="right nowrap"><strong>@Cambio.Dinheiro(_o, _o.TotalAmount)</strong></td></tr>
            </tbody>
        </table>

        <div class="side-item"><span><strong>Pagamento</strong></span><span>@_o.PaymentTerms</span></div>
        <p style="margin:10px 0 4px"><strong>Prazo de entrega:</strong> @_o.DeliveryTime</p>
        <p style="margin:4px 0"><strong>Validade:</strong> @_o.ValidityText</p>
        <p style="margin:10px 0 4px"><strong>Impostos:</strong> @_o.TaxText</p>

        <div style="margin-top:12px"><strong>Observações</strong>
            @foreach (var line in Linhas(_o.Observations))
            {
                <div style="font-size:12.5px;margin-top:4px">@line</div>
            }
        </div>

        <p style="margin-top:12px;font-size:12px;color:var(--muted)">@_o.SgiText</p>
        <p style="font-size:12px;color:var(--muted)">@_o.TermsText</p>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }
    private CommercialOffer? _o;
    private List<CommercialOfferItem> _items = new();

    private IEnumerable<(string, string)> Cabecalho => _o is null ? Array.Empty<(string, string)>() : new (string, string)[]
    {
        // na ordem do cabeçalho da planilha de pricing (colunas D, I e O)
        ("Nome do Cliente", _o.ClientName), ("PV", _o.Pv), ("Ano", _o.Ano), ("Número da Proposta", _o.OfferCode),
        ("Revisão", _o.Revisao), ("BU", _o.Bu), ("Elaborado por", _o.PreparedBy),
        ("NCM c/redução base ICMS", _o.NcmReducaoIcms),
        ("Segmento (margem)", _o.SegmentoMargem), ("Venda para", _o.VendaPara), ("Destino", _o.Destino),
        ("Estado", _o.Estado), ("Reforma", _o.Reforma),
        ("Prazo de Entrega", PricingDaProposta.PrazoEmDias(_o.PrazoEntrega) is > 0 and var dias ? $"{dias} dias" : _o.PrazoEntrega),
        ("Cliente com", _o.ClienteCom), ("Contém produto IC?", _o.ContemProdutoIc),
        ("Fiança/Seguro Garantia", _o.FiancaSeguro), ("Portal", _o.Portal),
        ("Rep 1", _o.Rep1), ("Rep 2", _o.Rep2), ("Categories", _o.Categories), ("Product", _o.Product),
        ("Market Segments", _o.MarketSegments), ("Data do Pricing", Fmt.Date(_o.OfferDate)),
        ("Importação", _o.ImportacaoModo switch { "total" => "Por total", "item" => "Por item", _ => "" }),
        ("Moeda / taxa da importação", _o.TaxaCambio > 0 ? $"{_o.Moeda} · R$ {_o.TaxaCambio.ToString("0.####", new System.Globalization.CultureInfo("pt-BR"))}" : ""),
        ("Custo em", Cambio.MoedaDoCusto(_o).Rotulo() + (Cambio.CompraDeFora(_o.Bu) ? $" (BU {_o.Bu}: preço de fora, sem importação)" : "")),
        ("Preço ao cliente em", !Cambio.Converte(_o) ? Cambio.MoedaDoPreco(_o).Rotulo()
            : $"{Cambio.MoedaDoPreco(_o).Rotulo()} · 1 {Cambio.MoedaDoPreco(_o).Rotulo()} = {Cambio.MoedaDoCusto(_o).Rotulo()} {Cambio.Normalizada(_o).ToString("N4", new System.Globalization.CultureInfo("pt-BR"))}"
              + (Cambio.Seguranca(_o) > 0 ? $" · segurança {Cambio.Seguranca(_o):0.##}%" : "")),
    };

    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");
    private static string Pct(decimal f) => (f * 100).ToString("0.##", PtBr) + "%";

    /// <summary>Valor na moeda do custo da proposta (R$ no Brasil; a estrangeira nas BUs de fora).</summary>
    private string Cu(decimal v) => _o is null ? Fmt.Brl(v) : Cambio.DinheiroDoCusto(_o, v);

    private IEnumerable<(string, string)> Pricing => _o is null ? Array.Empty<(string, string)>() : new (string, string)[]
    {
        ("Montar preço", _o.PricingModo == "preco" ? $"a partir do preço ({Cu(_o.PrecoMeta)})" : $"a partir da margem ({Pct(_o.MargemAlvo)})"),
        ("Risco adicional", Pct(_o.RiscoAdicional)), ("Margem de negociação", Pct(_o.MargemNegociacao)),
        ("Fiança / garantias", Textos.Igual(_o.FiancaSeguro, "Sim")
            ? $"{(_o.TipoGarantia.Length > 0 ? _o.TipoGarantia : "tipo não escolhido")} · " +
              $"{_o.EventosFianca.Count(ev => ev.Percentual > 0)} evento(s) de pagamento" +
              (_o.OutrasGarantias.Any(g => g.Percentual > 0) ? " · outras garantias: " + string.Join(", ", _o.OutrasGarantias.Where(g => g.Percentual > 0).Select(g => $"{g.Tipo} {Pct(g.Percentual)}")) : "")
            : "não"),
        ("Custo total (tabela de custo)", Cu(_o.PricingCusto)), ("Markup", _o.PricingMarkup.ToString("N4", PtBr)),
        ("Linhas de custo digitadas", string.Join(", ", _o.CustosPricing.Where(c => c.Valor != 0 || c.Variacao != 0)
            .Select(c => $"{CalculoPricing.LinhasDeCusto.FirstOrDefault(l => l.Codigo == c.Codigo)?.Nome ?? c.Codigo} {Cu(c.Valor)}" + (c.Variacao != 0 ? $" ({Pct(c.Variacao)})" : "")))),
        ("Venda líquida do pricing (sem impostos)", Cu(_o.PricingVendaLiquida)),
        ("Project Margin do pricing", Pct(_o.PricingMargem)),
        ("Preço ao cliente do pricing (com impostos)", _o.PricingPrecoImpostos > 0
            ? Cu(_o.PricingPrecoImpostos) + (Cambio.Converte(_o) ? " · " + Cambio.Dinheiro(_o, Cambio.ParaVenda(_o, _o.PricingPrecoImpostos)) : "") : "—"),
        ("Margem com os preços da proposta", MargemDosPrecos() is decimal m ? Pct(m) : ""),
    };

    /// <summary>Margem dos preços gravados, nos itens que tinham custo (importação ou Valor BR).</summary>
    private decimal? MargemDosPrecos()
    {
        if (_o is null) return null;
        var comCusto = _items
            .Select(i => (It: i, Custo: Cambio.CompraDeFora(_o.Bu) ? i.CustoUnitario : i.Importado ? i.CustoImportacao : i.Nacionalizado ? i.CustoReferencia : null))
            .Where(x => x.Custo is > 0).ToList();
        if (comCusto.Count == 0 || _o.CustosPricing.Any(c => c.Valor != 0)) return null;
        if (Textos.Simples(_o.Destino).Contains("back to back")) return null;
        var deFora = Cambio.CompraDeFora(_o.Bu);
        var comprados = comCusto.Where(x => deFora || !x.It.Importado).Sum(x => x.Custo!.Value * x.It.Quantity);
        var importados = comCusto.Where(x => !deFora && x.It.Importado).Sum(x => x.Custo!.Value * x.It.Quantity);
        var venda = Cambio.ParaCusto(_o, comCusto.Sum(x => x.It.UnitPrice * x.It.Quantity));
        return CalculoPricing.PeloPreco(PricingDaProposta.EntradaDe(_o, comprados, importados), venda).Margem;
    }

    protected override void OnInitialized()
    {
        if (Id is null) return;
        _o = OffersRepo.Get(Id);
        _items = OffersRepo.ItemsFor(Id);
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("appPrint");

    private bool _gerando;
    private string? _erroWord;

    /// <summary>A proposta comercial em Word, no modelo da equipe (Data/PropostaWord.cs).</summary>
    private async Task GerarWord()
    {
        if (_o is null) return;
        _gerando = true; _erroWord = null;
        try
        {
            var modelo = Path.Combine(Ambiente.ContentRootPath, PropostaWord.CaminhoDoModelo);
            if (!File.Exists(modelo)) { _erroWord = $"O modelo não está em {PropostaWord.CaminhoDoModelo}."; return; }

            var dados = PropostaWord.Dados(_o, _items, Units.All(), Vendedores.All(), Equipamentos.All(),
                Base.All(), Bom.All(), Vendas.All()) with { Faturamento = Bancos.ParaProposta(_o) };
            var bytes = PropostaWord.Gerar(dados, modelo);
            await JS.InvokeVoidAsync("appDownload", PropostaWord.NomeDoArquivo(_o),
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            _erroWord = "Não deu para gerar a proposta em Word: " + ex.Message;
        }
        finally { _gerando = false; }
    }

    private static string Dash(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    private static IEnumerable<string> Linhas(string s) =>
        (s ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim());
}
