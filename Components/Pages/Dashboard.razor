@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntelligenceService Intel
@inject NavigationManager Nav

<PageTitle>Central de Inteligência · AFM HSA</PageTitle>

<IntelTabs />

<div class="ci-filters">
    <select class="cell" @bind="_seg" aria-label="Filtro de segmento">
        <option value="">Todos os segmentos</option>
        @foreach (var s in _segOpts) { <option value="@s">@s</option> }
    </select>
    <select class="cell" @bind="_cli" aria-label="Filtro de cliente">
        <option value="">Todos os clientes</option>
        @foreach (var c in _cliOpts) { <option value="@c">@c</option> }
    </select>
    <select class="cell" @bind="_vend" aria-label="Filtro de vendedor">
        <option value="">Todos os vendedores</option>
        @foreach (var v in _vendOpts) { <option value="@v.Id">@v.Nome</option> }
    </select>
    <select class="cell" @bind="_crit" aria-label="Filtro de criticidade">
        <option value="">Toda criticidade</option>
        <option value="Crítica">Crítica</option><option value="Alta">Alta</option>
        <option value="Média">Média</option><option value="Baixa">Baixa</option>
    </select>
    <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)">De
        <input type="date" class="cell" @bind="_de" aria-label="Data de" /></label>
    <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)">Até
        <input type="date" class="cell" @bind="_ate" aria-label="Data até" /></label>
    @if (_de is not null || _ate is not null)
    {
        <button class="btn-ghost" style="padding:7px 12px" @onclick="LimparDatas">Limpar datas</button>
    }
    <div class="ci-meta">
        <span>Base: <b>@IntelligenceService.BaseDate.ToString("dd/MM/yyyy")</b></span>
        <span>Período: <b>@PeriodoLabel</b></span>
        <span>Moeda: <b>BRL (R$)</b></span>
    </div>
</div>

@{
    var open = Filtered;
    var dateActive = _de is not null || _ate is not null;
    var base12 = open.Where(o => o.DiasAteJanela >= 0 && (dateActive || o.DiasAteJanela <= 365)).ToList();
    var potencial = open.Sum(o => o.ValorEstimado);
    var receita = base12.Sum(o => o.ValorEstimado);
    var ponderada = base12.Sum(o => o.ValorEstimado * IntelligenceService.ConfFor(o.DiasAteJanela) / 100m);
    var janelas12 = base12.Count;
    var ticket = janelas12 > 0 ? receita / janelas12 : 0m;
    var risco = open.Where(o => o.StatusTemporal is "vencida" or "expirada" or "histórica").Sum(o => o.ValorEstimado);
    var criticas = open.Count(o => o.Urgencia == "Crítica");
}

<div class="ci-hero">
    <div class="ci-hero-main">
        <div class="ci-hero-kicker">Receita prevista — próximos 12 meses</div>
        <div class="ci-hero-value">@Fmt.Brl0(receita)</div>
        <div class="ci-hero-sub">@janelas12 janelas previstas · @Fmt.Brl0(ponderada) ponderados pela confiança</div>
    </div>
    <div class="ci-hero-cell"><div class="l">Janelas previstas</div><div class="v">@janelas12</div></div>
    <div class="ci-hero-cell"><div class="l">Receita ponderada</div><div class="v" style="font-size:17px" title="@Fmt.Brl0(ponderada)">@Fmt.BrlShort(ponderada)</div></div>
    <div class="ci-hero-cell"><div class="l">Ticket médio / janela</div><div class="v" style="font-size:17px" title="@Fmt.Brl0(ticket)">@Fmt.BrlShort(ticket)</div></div>
</div>

<div class="ci-kpis">
    <div class="ci-kpi" title="Soma do valor potencial técnico de todas as janelas de reposição identificadas no filtro atual.">
        <div class="ci-kpi-label">Potencial técnico identificado</div>
        <div class="ci-kpi-value" title="@Fmt.Brl0(potencial)">@Fmt.BrlShort(potencial)</div>
        <div class="ci-kpi-sub">@open.Count janelas identificadas</div>
    </div>
    <div class="ci-kpi ok" title="Receita esperada das janelas com data prevista nos próximos 12 meses.">
        <div class="ci-kpi-label">Receita prevista em 12 meses</div>
        <div class="ci-kpi-value" title="@Fmt.Brl0(receita)">@Fmt.BrlShort(receita)</div>
        <div class="ci-kpi-sub">@janelas12 janelas previstas</div>
    </div>
    <div class="ci-kpi" title="Receita prevista ajustada pelo nível de confiança de cada horizonte de prazo.">
        <div class="ci-kpi-label">Receita ponderada pela confiança</div>
        <div class="ci-kpi-value" title="@Fmt.Brl0(ponderada)">@Fmt.BrlShort(ponderada)</div>
        <div class="ci-kpi-sub">@(receita > 0 ? (int)Math.Round(100m * ponderada / receita) : 0)% da receita prevista</div>
    </div>
    <div class="ci-kpi risk" title="Valor das janelas já vencidas / expiradas — receita que se perde sem ação comercial.">
        <div class="ci-kpi-label">Receita em risco</div>
        <div class="ci-kpi-value" title="@Fmt.Brl0(risco)">@Fmt.BrlShort(risco)</div>
        <div class="ci-kpi-sub">janelas vencidas / expiradas</div>
    </div>
    <div class="ci-kpi warn" title="Janelas com criticidade comercial Crítica — exigem ação imediata.">
        <div class="ci-kpi-label">Janelas críticas</div>
        <div class="ci-kpi-value">@criticas</div>
        <div class="ci-kpi-sub">exigem ação imediata</div>
    </div>
    <div class="ci-kpi" title="Quantidade de janelas de reposição previstas nos próximos 12 meses.">
        <div class="ci-kpi-label">Janelas previstas em 12 meses</div>
        <div class="ci-kpi-value">@janelas12</div>
        <div class="ci-kpi-sub">ticket médio @Fmt.BrlShort(ticket)</div>
    </div>
</div>

<div class="ci-section-title">Conversão do potencial em receita</div>
<div class="panel">
    <div class="ci-pipe">
        <div class="ci-step"><div class="l">Potencial técnico</div><div class="v" title="@Fmt.Brl0(potencial)">@Fmt.BrlShort(potencial)</div><div class="s">@open.Count janelas</div></div>
        <div class="ci-step"><div class="l">Janelas identificadas</div><div class="v">@open.Count</div><div class="s">na base instalada</div></div>
        <div class="ci-step"><div class="l">Previstas 12 meses</div><div class="v">@janelas12</div><div class="s">com data no horizonte</div></div>
        <div class="ci-step"><div class="l">Receita prevista</div><div class="v" title="@Fmt.Brl0(receita)">@Fmt.BrlShort(receita)</div><div class="s">próximos 12 meses</div></div>
        <div class="ci-step"><div class="l">Receita ponderada</div><div class="v" title="@Fmt.Brl0(ponderada)">@Fmt.BrlShort(ponderada)</div><div class="s">ajustada pela confiança</div></div>
    </div>
    <p class="ci-muted-note" style="margin-top:12px">Como o sistema transforma a base instalada em receita: cada equipamento gera janelas técnicas de reposição, priorizadas por prazo e confiança até a receita ponderada.</p>
</div>

<div class="ci-section-title">Projeção de receita — próximos 12 meses</div>
<div class="panel">
    <div class="tabs" style="margin-bottom:12px">
        <button class="tab @(_tl == "receita" ? "active" : "")" @onclick='() => _tl = "receita"'>Receita</button>
        <button class="tab @(_tl == "janelas" ? "active" : "")" @onclick='() => _tl = "janelas"'>Quantidade de janelas</button>
    </div>
    @Timeline(base12)
</div>

<div class="ci-section-title">Atenção executiva — oportunidades que precisam de ação</div>
<div style="overflow-x:auto">
<table class="grid">
    <thead><tr><th>Prioridade</th><th>Cliente / Unidade</th><th>Equipamento / Item</th>
        <th class="right">Valor potencial</th><th>Data prevista</th><th class="right">Confiança</th><th>Responsável</th><th>Próxima ação</th><th></th></tr></thead>
    <tbody>
        @foreach (var o in Atencao(open))
        {
            <tr>
                <td><span class="badge @IntelligenceService.UrgClass(o.Urgencia)">@o.Urgencia</span></td>
                <td>@Intel.ClienteDaUnidade(o.ClientUnitId) — @Intel.UnitNome(o.ClientUnitId)</td>
                <td>@Intel.EquipmentModel(o.EquipmentId) · @o.Item</td>
                <td class="right nowrap" title="@Fmt.Brl0(o.ValorEstimado)">@Fmt.BrlShort(o.ValorEstimado)</td>
                <td class="nowrap">@Fmt.Date(o.DataPrevista)</td>
                <td class="right">@IntelligenceService.ConfFor(o.DiasAteJanela)%</td>
                <td class="nowrap">@Intel.SalespersonName(o.VendedorId)</td>
                <td class="truncate" style="max-width:220px" title="@o.ProximaAcao">@o.ProximaAcao</td>
                <td class="nowrap"><a class="btn-link" href="@($"/oportunidades/{o.Id}")">Ver detalhe</a></td>
            </tr>
        }
        @if (Atencao(open).Count == 0) { <tr><td colspan="9" class="empty">Nenhuma oportunidade no filtro atual.</td></tr> }
    </tbody>
</table>
</div>

<div class="ci-section-title">Distribuição da receita prevista</div>
<div class="dash-grid">
    <div class="panel"><div class="dash-title">Por cliente</div>@Dist(GroupVal(base12, o => Intel.ClienteDaUnidade(o.ClientUnitId)))</div>
    <div class="panel"><div class="dash-title">Por segmento</div>@Dist(GroupVal(base12, o => Intel.UnitSegmento(o.ClientUnitId)))</div>
    <div class="panel"><div class="dash-title">Por vendedor</div>@Dist(GroupVal(base12, o => Intel.SalespersonName(o.VendedorId)))</div>
    <div class="panel"><div class="dash-title">Por tipo de equipamento</div>@Dist(GroupVal(base12, o => Intel.EquipmentTipo(o.EquipmentId)))</div>
</div>

<div class="ci-section-title">Confiança da previsão por horizonte</div>
<div class="panel">
    <table class="grid">
        <thead><tr><th>Horizonte</th><th class="right">Janelas</th><th class="right">Receita prevista</th><th class="right">Confiança média</th><th class="right">Receita ponderada</th></tr></thead>
        <tbody>
            @foreach (var h in Horizontes(base12))
            {
                <tr><td>@h.Nome</td><td class="right">@h.Janelas</td><td class="right nowrap">@Fmt.Brl0(h.Receita)</td>
                    <td class="right"><span class="badge st-ok">@h.Conf%</span></td><td class="right nowrap">@Fmt.Brl0(h.Ponderada)</td></tr>
            }
        </tbody>
    </table>
    <p class="ci-muted-note" style="margin-top:10px">A receita ponderada considera o valor potencial e o nível de confiança associado ao horizonte de prazo da previsão.</p>
</div>

<div class="ci-section-title">Qualidade e cobertura do modelo</div>
<div class="panel">
    <div class="kpis">
        <div class="kpi"><div class="kpi-label">Séries avaliadas</div><div class="kpi-value">@_bt.Series</div></div>
        <div class="kpi"><div class="kpi-label">Dentro de ±1 mês</div><div class="kpi-value">@_bt.Pct1m%</div></div>
        <div class="kpi"><div class="kpi-label">Dentro de ±3 meses</div><div class="kpi-value">@_bt.Pct3m%</div></div>
        <div class="kpi"><div class="kpi-label">Erro médio (meses)</div><div class="kpi-value">@_bt.ErroMedioMeses.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</div></div>
    </div>
    <p class="ci-muted-note">As datas representam janelas comerciais recomendadas com base no histórico disponível, e não garantias de substituição em uma data exata. Avaliação por backtest sobre @_bt.Series séries com histórico suficiente.</p>
</div>

@code {
    private List<Opportunity> _openAll = new();
    private BacktestVM _bt = new();
    private List<string> _segOpts = new(), _cliOpts = new();
    private List<(string Id, string Nome)> _vendOpts = new();
    private string _seg = "", _cli = "", _vend = "", _crit = "", _tl = "receita";
    private DateOnly? _de, _ate;

    private string PeriodoLabel => (_de is null && _ate is null)
        ? "Próximos 12 meses"
        : $"{(_de?.ToString("dd/MM/yyyy") ?? "início")} — {(_ate?.ToString("dd/MM/yyyy") ?? "fim")}";

    private void LimparDatas() { _de = null; _ate = null; }

    protected override void OnInitialized()
    {
        _openAll = Intel.OpenOpportunities();
        _bt = Intel.Forecast().Backtest;
        _segOpts = _openAll.Select(o => Intel.UnitSegmento(o.ClientUnitId)).Where(s => s != "—" && !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s).ToList();
        _cliOpts = _openAll.Select(o => Intel.ClienteDaUnidade(o.ClientUnitId)).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s).ToList();
        _vendOpts = _openAll.Select(o => o.VendedorId).Distinct().Select(id => (id, Intel.SalespersonName(id))).OrderBy(x => x.Item2).ToList();
    }

    private List<Opportunity> Filtered
    {
        get
        {
            IEnumerable<Opportunity> q = _openAll;
            if (!string.IsNullOrEmpty(_seg)) q = q.Where(o => Intel.UnitSegmento(o.ClientUnitId) == _seg);
            if (!string.IsNullOrEmpty(_cli)) q = q.Where(o => Intel.ClienteDaUnidade(o.ClientUnitId) == _cli);
            if (!string.IsNullOrEmpty(_vend)) q = q.Where(o => o.VendedorId == _vend);
            if (!string.IsNullOrEmpty(_crit)) q = q.Where(o => o.Urgencia == _crit);
            if (_de is not null) { var d = _de.Value.ToString("yyyy-MM-dd"); q = q.Where(o => string.CompareOrdinal(o.DataPrevista, d) >= 0); }
            if (_ate is not null) { var a = _ate.Value.ToString("yyyy-MM-dd"); q = q.Where(o => string.CompareOrdinal(o.DataPrevista, a) <= 0); }
            return q.ToList();
        }
    }

    private static int Rank(string u) => u switch { "Crítica" => 4, "Alta" => 3, "Média" => 2, _ => 1 };

    private List<Opportunity> Atencao(List<Opportunity> open) =>
        open.OrderByDescending(o => Rank(o.Urgencia)).ThenByDescending(o => o.ValorEstimado).Take(8).ToList();

    private List<ChartItem> GroupVal(List<Opportunity> xs, Func<Opportunity, string> key) =>
        xs.GroupBy(key).Select(g => new ChartItem(g.Key, Math.Round(g.Sum(o => o.ValorEstimado))))
          .OrderByDescending(c => c.Valor).Take(8).ToList();

    private record Horizonte(string Nome, int Janelas, decimal Receita, int Conf, decimal Ponderada);
    private List<Horizonte> Horizontes(List<Opportunity> b)
    {
        Horizonte H(string nome, Func<Opportunity, bool> p, int conf)
        {
            var xs = b.Where(p).ToList();
            var rec = xs.Sum(o => o.ValorEstimado);
            return new Horizonte(nome, xs.Count, rec, conf, Math.Round(rec * conf / 100m));
        }
        return new()
        {
            H("Curto prazo (≤ 90 dias)", o => o.DiasAteJanela <= 90, 90),
            H("Médio prazo (91–180 dias)", o => o.DiasAteJanela > 90 && o.DiasAteJanela <= 180, 82),
            H("Longo prazo (> 180 dias)", o => o.DiasAteJanela > 180, 64),
        };
    }

    private RenderFragment Dist(List<ChartItem> dados) => builder =>
    {
        if (dados.Count == 0) { builder.AddMarkupContent(0, "<p class=\"empty\">Sem dados.</p>"); return; }
        var total = dados.Sum(x => x.Valor);
        var max = dados.Max(x => x.Valor);
        int seq = 1;
        foreach (var d in dados)
        {
            var pct = max <= 0 ? 0 : (int)Math.Round(100m * d.Valor / max);
            var share = total <= 0 ? 0 : (int)Math.Round(100m * d.Valor / total);
            builder.AddMarkupContent(seq++,
                $"<div class=\"bar-row\" title=\"{System.Net.WebUtility.HtmlEncode(d.Nome)}: {Fmt.Brl0(d.Valor)} ({share}%)\">" +
                $"<div class=\"bar-label\">{System.Net.WebUtility.HtmlEncode(d.Nome)}</div>" +
                $"<div class=\"bar-track\"><div class=\"bar\" style=\"width:{pct}%\"></div></div>" +
                $"<div class=\"bar-value\">{Fmt.BrlShort(d.Valor)} · {share}%</div></div>");
        }
    };

    private RenderFragment Timeline(List<Opportunity> b) => builder =>
    {
        var meses = b.Where(o => o.DataPrevista.Length >= 7)
            .GroupBy(o => o.DataPrevista[..7]).OrderBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => new
            {
                Label = MesLabel(g.Key),
                Receita = g.Sum(o => o.ValorEstimado),
                Janelas = g.Count(),
                Ponderada = g.Sum(o => o.ValorEstimado * IntelligenceService.ConfFor(o.DiasAteJanela) / 100m),
            }).ToList();
        if (meses.Count == 0) { builder.AddMarkupContent(0, "<p class=\"empty\">Sem janelas previstas no período.</p>"); return; }
        var porReceita = _tl == "receita";
        decimal max = porReceita ? meses.Max(m => m.Receita) : meses.Max(m => m.Janelas);
        int seq = 1;
        foreach (var m in meses)
        {
            decimal val = porReceita ? m.Receita : m.Janelas;
            var pct = max <= 0 ? 0 : (int)Math.Round(100m * val / max);
            var conf = m.Receita > 0 ? (int)Math.Round(100m * m.Ponderada / m.Receita) : 0;
            var tip = $"{m.Label} · Receita {Fmt.Brl0(m.Receita)} · Ponderada {Fmt.Brl0(m.Ponderada)} · {m.Janelas} janela(s) · confiança {conf}%";
            var label = porReceita ? Fmt.BrlShort(m.Receita) : $"{m.Janelas} janela(s)";
            builder.AddMarkupContent(seq++,
                $"<div class=\"bar-row\" title=\"{System.Net.WebUtility.HtmlEncode(tip)}\">" +
                $"<div class=\"bar-label\">{m.Label}</div>" +
                $"<div class=\"bar-track\"><div class=\"bar\" style=\"width:{pct}%\"></div></div>" +
                $"<div class=\"bar-value\">{label}</div></div>");
        }
    };

    private static string MesLabel(string ym)
    {
        var p = ym.Split('-');
        return p.Length == 2 ? $"{p[1]}/{p[0]}" : ym;
    }
}
