@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntelligenceService Intel
@inject VisitRepository VisitsRepo

<PageTitle>Central de Inteligência · AFM HSA</PageTitle>

<h1>Central de Inteligência</h1>
<p class="subtitle">Inteligência preditiva de aftermarket — base instalada, ciclos técnicos e janelas de reposição.</p>

<div class="kpis kpis-8">
    <a class="kpi click k-po" href="/oportunidades"><div class="kpi-label">Janelas detectadas</div><div class="kpi-value">@_vm.OportunidadesAbertas</div></a>
    <a class="kpi click k-ren" href="/oportunidades"><div class="kpi-label">Valor potencial</div><div class="kpi-value" style="font-size:15px">@Fmt.Brl0(_vm.ValorPotencial)</div></a>
    <a class="kpi click k-venc" href="/oportunidades"><div class="kpi-label">Críticas / vencidas</div><div class="kpi-value">@_vm.CriticasVencidas</div></a>
    <a class="kpi click k-aten" href="/oportunidades"><div class="kpi-label">Previstas — 30 dias</div><div class="kpi-value">@_vm.Prox30</div></a>
    <a class="kpi click k-aten" href="/oportunidades"><div class="kpi-label">Previstas — 90 dias</div><div class="kpi-value">@_vm.Prox90</div></a>
    <a class="kpi click k-venc" href="/base-instalada"><div class="kpi-label">Sem reposição (3a+)</div><div class="kpi-value">@_vm.SemVenda3a</div></a>
    <a class="kpi click" href="/visitas"><div class="kpi-label">Ações em campo</div><div class="kpi-value">@_vm.VisitasAgendadas</div></a>
    <a class="kpi click k-po" href="/pecas"><div class="kpi-label">Peças críticas</div><div class="kpi-value">@_vm.PecasCriticas</div></a>
</div>

<div class="dash-grid">
    <div class="panel"><div class="dash-title">Janelas de reposição por mês</div>@Barras(_vm.PorMes, false)</div>
    <div class="panel"><div class="dash-title">Histórico de aftermarket por ano</div>@Barras(_vm.SalesByYear, true)</div>
    <div class="panel"><div class="dash-title">Potencial por cliente</div>@Barras(_vm.PorCliente, true)</div>
    <div class="panel"><div class="dash-title">Potencial por vendedor</div>@Barras(_vm.PorVendedor, true)</div>
    <div class="panel"><div class="dash-title">Janelas por segmento</div>@Barras(_vm.PorSegmento, false)</div>
    <div class="panel"><div class="dash-title">Janelas por criticidade</div>@Barras(_vm.PorUrgencia, false)</div>
    <div class="panel"><div class="dash-title">Equipamentos por tipo</div>@Barras(_vm.PorTipo, false)</div>
    <div class="panel">
        <div class="dash-title">Próximas janelas críticas</div>
        @if (_vm.CriticasTop.Count == 0)
        {
            <p class="empty">Nenhuma janela crítica.</p>
        }
        else
        {
            @foreach (var o in _vm.CriticasTop)
            {
                <div class="alert-item">
                    <div style="flex:1">
                        <div style="font-weight:600">@Intel.UnitLabel(o.ClientUnitId)</div>
                        <div style="font-size:11.5px;color:var(--muted)">@o.Item</div>
                    </div>
                    <div style="text-align:right">
                        <div style="font-weight:600">@Fmt.Brl0(o.ValorEstimado)</div>
                        <div style="font-size:11.5px;color:#b91c1c">@(o.DiasAteJanela < 0 ? "Janela vencida" : $"{o.DiasAteJanela} dias")</div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private DashboardVM _vm = new();

    protected override void OnInitialized() => _vm = Intel.Dashboard(VisitsRepo.All());

    private RenderFragment Barras(List<ChartItem> dados, bool money) => builder =>
    {
        if (dados.Count == 0) { builder.AddMarkupContent(0, "<p class=\"empty\">Sem dados.</p>"); return; }
        var max = dados.Max(x => x.Valor);
        int seq = 1;
        foreach (var d in dados)
        {
            var pct = max <= 0 ? 0 : (int)Math.Round(100m * d.Valor / max);
            var val = money ? Fmt.Brl0(d.Valor) : Fmt.N0(d.Valor);
            builder.AddMarkupContent(seq++,
                $"<div class=\"bar-row\"><div class=\"bar-label\">{System.Net.WebUtility.HtmlEncode(d.Nome)}</div>" +
                $"<div class=\"bar-track\"><div class=\"bar\" style=\"width:{pct}%\"></div></div>" +
                $"<div class=\"bar-value\">{val}</div></div>");
        }
    };
}
