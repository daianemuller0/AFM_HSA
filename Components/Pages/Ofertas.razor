@page "/ofertas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OfferRepository OffersRepo
@inject ReferenciaDeCustoRepository RefsCusto
@inject ReferenciaVentiladorRepository RefsVentiladores
@inject AuthenticationStateProvider Auth
@inject FollowUpRepository FollowUpsRepo

<PageTitle>Propostas · AFM HSA</PageTitle>

<div class="page-head">
    <div><h1>Propostas</h1><p class="subtitle">@_all.Count proposta(s) · Total @Fmt.Brl0(_all.Sum(o => o.TotalReais))@(_all.Any(o => Cambio.Converte(o)) ? " (em R$, pela taxa de cada proposta)" : "")</p></div>
    <div class="page-actions"><a class="btn-primary" href="/gerar-proposta">+ Gerar Proposta</a></div>
</div>

@if (_msg is not null)
{
    <div class="alert-ok" style="margin-bottom:12px">@_msg</div>
}

@if (_adm && _qtdSobrescritas > 0)
{
    @* revisões que a troca do número gravou por cima (antes de a troca virar
       registro novo): continuam no histórico e voltam como registro próprio *@
    <div class="panel recuperar-revisoes" style="margin-bottom:12px">
        <div class="recuperar-cab">
            <span>🕘 <strong>@_qtdSobrescritas</strong> @(_qtdSobrescritas == 1 ? "revisão foi gravada por cima" : "revisões foram gravadas por cima") quando o número da revisão foi trocado. Elas continuam no histórico e podem voltar como registro próprio.</span>
            <span style="flex:1"></span>
            <button class="btn-ghost" disabled="@_recuperando" @onclick="VerSobrescritas">@(_carregandoSobrescritas ? "carregando…" : _verSobrescritas ? "esconder" : "ver quais")</button>
            <button class="btn-primary" disabled="@_recuperando" @onclick="RecuperarTodas">Recuperar todas</button>
        </div>
        @if (_verSobrescritas && _sobrescritas.Count > 0)
        {
            <table class="grid" style="margin-top:10px">
                <thead><tr><th>Código</th><th>Rev.</th><th>Cliente</th><th>Data</th><th>Status</th><th class="right">Itens</th><th class="right">Valor total líquido</th><th>Gravada por cima</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _sobrescritas)
                    {
                        var o = r.Oferta;
                        <tr>
                            <td class="nowrap">@o.OfferCode</td>
                            <td>@PropostaWord.Ou(o.Revisao, "0")</td>
                            <td>@o.ClientName</td>
                            <td class="nowrap">@Fmt.Date(o.OfferDate)</td>
                            <td><span class="badge score-badge">@o.Status</span></td>
                            <td class="right">@r.Itens.Count</td>
                            <td class="right nowrap">@Cambio.Dinheiro(o, o.TotalLiquido > 0m ? o.TotalLiquido : o.TotalAmount)</td>
                            <td class="nowrap">pela rev @PropostaWord.Ou(r.GravadaPorCimaPela, "0") em @r.SobrescritaEm.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="nowrap"><button class="btn-link" disabled="@_recuperando" @onclick="() => Recuperar(r)">recuperar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_all.Count == 0)
{
    <div class="panel empty-state"><div class="empty-title">Nenhuma proposta ainda</div>
        <p class="empty-text">Gere a primeira proposta comercial.</p>
        <a class="btn-primary" href="/gerar-proposta" style="margin-top:12px">+ Gerar Proposta</a></div>
}
else
{
    @if (_adm && _marcadas.Count > 0)
    {
        @* exclusão só do administrador, sempre com confirmação: apagar não tem volta *@
        <div class="panel excluir-barra" style="margin-bottom:12px">
            @if (!_confirmar)
            {
                <span><strong>@_marcadas.Count</strong> proposta(s) selecionada(s)</span>
                <button class="btn-ghost perigo" @onclick="() => _confirmar = true">🗑 Excluir selecionadas</button>
                <button class="btn-link" @onclick="Limpar">desmarcar</button>
            }
            else
            {
                <span class="custo-indisp">
                    Excluir <strong>@_marcadas.Count</strong> proposta(s) (@string.Join(", ", Selecionadas.Take(5).Select(Rotulo))@(_marcadas.Count > 5 ? "…" : ""))?
                    Os itens e as referências de preço gravadas por elas também saem. Não dá para desfazer.
                </span>
                <button class="btn-primary perigo" @onclick="Excluir">Sim, excluir</button>
                <button class="btn-link" @onclick="() => _confirmar = false">cancelar</button>
            }
        </div>
    }
    <div style="overflow-x:auto">
    <table class="grid">
        <thead><tr>
            @if (_adm)
            {
                <th style="width:28px"><input type="checkbox" title="Selecionar todas" checked="@(_marcadas.Count == _all.Count)" @onchange="MarcarTodas" /></th>
            }
            <th>Código</th><th>Rev.</th><th>Cliente</th><th>Data</th><th>Status</th><th class="right" title="Sem impostos, na moeda da proposta">Valor total líquido</th><th></th></tr></thead>
        <tbody>
            @foreach (var o in _all)
            {
                <tr class="@(_marcadas.Contains(o.Id) ? "linha-marcada" : "")">
                    @if (_adm)
                    {
                        <td><input type="checkbox" checked="@_marcadas.Contains(o.Id)" @onchange="e => Marcar(o.Id, e)" /></td>
                    }
                    <td class="nowrap">@o.OfferCode @SeloDeNota(o)</td>
                    <td class="nowrap">@Consolidacao.Revisao(o)</td>
                    <td>@o.ClientName</td>
                    <td class="nowrap">@Fmt.Date(o.OfferDate)</td>
                    <td class="nowrap">
                        @if (Consolidacao.Consolidada(o))
                        {
                            <span class="badge score-badge consolidada" title="@TituloDaConsolidacao(o)">✔ Consolidada</span>
                        }
                        else if (o.Status == "Enviada")
                        {
                            <span class="badge score-badge enviada">✈ Enviada</span>
                            <button class="btn-link" title="Voltar para em elaboração" @onclick="() => DesfazerEnviada(o)">desfazer</button>
                        }
                        else
                        {
                            <span class="badge score-badge">@o.Status</span>
                            <button class="btn-link" title="Registrar que a proposta saiu para o cliente (agenda o follow-up no fim da validade)" @onclick="() => MarcarEnviada(o)">✈ marcar enviada</button>
                        }
                        @if (!Consolidacao.Consolidada(o))
                        {
                            <a class="btn-mini btn-consolidar" title="A proposta foi vendida: consolidar para passar ao próximo setor (projeto, pedido, margem, valor, entrega e pagamento)" href="@($"/gerar-proposta/{o.Id}?consolidar=1")">✔ Consolidar</a>
                        }
                    </td>
                    <td class="right nowrap" title="@(o.TotalLiquido > 0m ? "Sem impostos" : "Gravada antes do total líquido: o valor no nível de impostos da proposta (salve de novo para atualizar)")">@Cambio.Dinheiro(o, o.TotalLiquido > 0m ? o.TotalLiquido : o.TotalAmount)</td>
                    <td class="nowrap">
                        <a class="btn-link" href="@($"/ofertas/{o.Id}")">abrir</a> · <a class="btn-link" href="@($"/gerar-proposta/{o.Id}")">editar</a>
                        @if (_adm)
                        {
                            <span> · </span><button class="btn-link perigo" title="Excluir esta proposta" @onclick="() => ExcluirUma(o.Id)">excluir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<CommercialOffer> _all = new();
    private bool _adm;
    private readonly HashSet<string> _marcadas = new();
    private bool _confirmar;
    private string? _msg;

    /// <summary>A proposta saiu para o cliente: status Enviada e o follow-up no fim da validade (por portal, sem follow-up).</summary>
    private async Task MarcarEnviada(CommercialOffer o)
    {
        var usuario = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
        o.Status = "Enviada";
        OffersRepo.Save(o);
        var f = FollowUpsRepo.MarcarEnviada(o, usuario, DateTime.Today);
        _msg = f is null
            ? $"{Rotulo(o)} marcada como enviada. Proposta por portal: sem follow-up nem e-mail de cobrança."
            : $"{Rotulo(o)} marcada como enviada. Follow-up agendado para {FollowUps.Data(f.Proxima?.Data)?.ToString("dd/MM/yyyy") ?? "—"} (fim da validade).";
        _all = OffersRepo.All();
    }

    private void DesfazerEnviada(CommercialOffer o)
    {
        o.Status = "Rascunho";
        OffersRepo.Save(o);
        _msg = $"{Rotulo(o)} voltou para em elaboração (sai do follow-up).";
        _all = OffersRepo.All();
    }
    private List<OfferRepository.RevisaoSobrescrita> _sobrescritas = new();
    private int _qtdSobrescritas;
    private bool _verSobrescritas, _recuperando, _carregandoSobrescritas;

    protected override async Task OnInitializedAsync()
    {
        _adm = Acessos.EhAdm((await Auth.GetAuthenticationStateAsync()).User);
        _all = OffersRepo.All();
    }

    /// <summary>
    /// Só para o administrador, e depois que a lista aparece: a busca leve
    /// (número e revisão de cada gravação), que só relê quando algo mudou.
    /// A lista completa (proposta e itens de cada revisão) só ao pedir.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_adm) return;
        try { _qtdSobrescritas = (await Task.Run(OffersRepo.RevisoesSobrescritasLeve)).Count; }
        catch (Exception) { _qtdSobrescritas = 0; }
        if (_qtdSobrescritas > 0) StateHasChanged();
    }

    private async Task CarregarSobrescritas()
    {
        _carregandoSobrescritas = true;
        StateHasChanged();
        try { _sobrescritas = await Task.Run(OffersRepo.RevisoesSobrescritas); }
        finally { _carregandoSobrescritas = false; }
        _qtdSobrescritas = _sobrescritas.Count;
    }

    private async Task VerSobrescritas()
    {
        if (_verSobrescritas) { _verSobrescritas = false; return; }
        if (_sobrescritas.Count == 0) await CarregarSobrescritas();
        _verSobrescritas = true;
    }

    private async Task Recuperar(OfferRepository.RevisaoSobrescrita r) => await RecuperarAs(new[] { r });

    private async Task RecuperarTodas()
    {
        if (_sobrescritas.Count == 0) await CarregarSobrescritas();
        await RecuperarAs(_sobrescritas.ToList());
    }

    private async Task RecuperarAs(IReadOnlyList<OfferRepository.RevisaoSobrescrita> lista)
    {
        if (_recuperando || lista.Count == 0) return;
        _recuperando = true;
        try
        {
            var usuario = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            foreach (var r in lista) OffersRepo.RecuperarRevisao(r, usuario);
            _msg = lista.Count == 1
                ? $"Revisão {PropostaWord.Ou(lista[0].Oferta.Revisao, "0")} da {lista[0].Oferta.OfferCode} recuperada: está na lista como registro próprio, com uma nota dizendo de onde veio."
                : $"{lista.Count} revisões recuperadas: estão na lista como registros próprios, cada uma com uma nota dizendo de onde veio.";
            _all = OffersRepo.All();
            _sobrescritas = new();
            _verSobrescritas = false;
            _qtdSobrescritas = (await Task.Run(OffersRepo.RevisoesSobrescritasLeve)).Count;
        }
        finally { _recuperando = false; }
    }

    private IEnumerable<CommercialOffer> Selecionadas => _all.Where(o => _marcadas.Contains(o.Id));

    private static string TituloDaConsolidacao(CommercialOffer o) =>
        $"Projeto {o.Pv} · pedido {o.NumeroPedido} · consolidada em {o.ConsolidadaEm}" + (o.ConsolidadaPor.Length > 0 ? $" por {o.ConsolidadaPor}" : "");

    private static string Rotulo(CommercialOffer o) => $"{o.OfferCode} rev. {Consolidacao.Revisao(o)}";

    private void Marcar(string id, ChangeEventArgs e)
    {
        if (e.Value is true) _marcadas.Add(id); else _marcadas.Remove(id);
        _confirmar = false; _msg = null;
    }

    private void MarcarTodas(ChangeEventArgs e)
    {
        _marcadas.Clear();
        if (e.Value is true) foreach (var o in _all) _marcadas.Add(o.Id);
        _confirmar = false; _msg = null;
    }

    private void Limpar() { _marcadas.Clear(); _confirmar = false; }

    /// <summary>O "excluir" da linha: seleciona só ela e pede a confirmação.</summary>
    private void ExcluirUma(string id)
    {
        _marcadas.Clear();
        _marcadas.Add(id);
        _confirmar = true;
        _msg = null;
    }

    private async Task Excluir()
    {
        // confere de novo na hora de apagar: só o administrador
        if (!Acessos.EhAdm((await Auth.GetAuthenticationStateAsync()).User) || _marcadas.Count == 0) return;
        var ids = _marcadas.ToList();
        OffersRepo.ApagarPropostas(ids);
        var refs = RefsCusto.ApagarDasPropostas(ids) + RefsVentiladores.ApagarDasPropostas(ids);
        _msg = $"{ids.Count} proposta(s) excluída(s)" + (refs > 0 ? $", com {refs} referência(s) de preço." : ".");
        _marcadas.Clear();
        _confirmar = false;
        _all = OffersRepo.All();
    }

    /// <summary>A nota aberta mais grave da proposta, na lista: ⛔ crítica, ⚠ atenção (o texto aparece ao passar o mouse).</summary>
    private static RenderFragment SeloDeNota(CommercialOffer o) => __builder =>
    {
        var abertas = o.Notas.Where(n => !n.Resolvida).ToList();
        var nota = abertas.FirstOrDefault(n => n.Nivel == NotaDaProposta.Critica) ?? abertas.FirstOrDefault(n => n.Nivel == NotaDaProposta.Atencao);
        if (nota is null) return;
        var critica = nota.Nivel == NotaDaProposta.Critica;
        <span class="selo-nota @(critica ? "critica" : "atencao")" title="@($"{(critica ? "Nota crítica" : "Atenção")}: {nota.Texto} — {nota.Autor}")">@(critica ? "⛔ nota crítica" : "⚠ atenção")</span>
    };
}
