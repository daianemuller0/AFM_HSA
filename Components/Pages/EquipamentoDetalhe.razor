@page "/equipamentos/{Id}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject EquipmentRepository Equipamentos
@inject PartRepository Pecas
@inject InstalledBaseRepository Base
@inject SalesRecordRepository Vendas
@inject ConstructionRepository Construcao
@inject BomRepository Bom
@inject ClientUnitRepository Unidades
@inject SalespersonRepository Vendedores
@inject ImportService Importer
@inject IntelligenceService Intel
@inject IJSRuntime JS

<PageTitle>Equipamento · AFM HSA</PageTitle>

@if (_e is null)
{
    <h1>Equipamento</h1>
    <div class="panel empty-state"><div class="empty-title">Equipamento não encontrado</div>
        <a class="btn-ghost" href="/clientes">Voltar</a></div>
}
else
{
    <div class="page-head">
        <div><h1>@_e.Nome</h1><p class="subtitle">Aplicação: @_e.Aplicacao</p></div>
        <div class="page-actions"><a class="btn-ghost" href="javascript:history.back()">Voltar</a></div>
    </div>

    <div class="kpis kpis-8">
        <div class="kpi"><div class="kpi-label">Segmento</div><div class="kpi-value" style="font-size:15px">@_e.Segmento</div></div>
        <div class="kpi"><div class="kpi-label">Fabricante</div><div class="kpi-value" style="font-size:12px">@_e.Fabricante</div></div>
        <div class="kpi"><div class="kpi-label">Qtd. instalada</div><div class="kpi-value">@_qtd</div></div>
        <div class="kpi k-venc"><div class="kpi-label">Peças críticas</div><div class="kpi-value">@_pecasCriticas</div></div>
        <div class="kpi k-ren"><div class="kpi-label">Valor completo</div><div class="kpi-value" style="font-size:14px">@Fmt.Brl0(_e.ValorCompleto)</div></div>
        <div class="kpi k-po"><div class="kpi-label">Valor potencial 24 meses</div><div class="kpi-value" style="font-size:14px">@Fmt.Brl0(_pot24)</div></div>
    </div>

    <div class="dash-title">Cliente / unidade onde está instalado</div>
    <table class="grid" style="margin-bottom:20px">
        <thead>
            <tr>
                <th>Cliente / Unidade</th><th>Tag</th><th>Nº de série</th>
                <th class="right">Qtd</th><th>Ano</th><th>Status</th><th>Criticidade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in _base)
            {
                <tr>
                    <td>@Intel.ClienteDaUnidade(b.ClientUnitId) — @Intel.UnitNome(b.ClientUnitId)</td>
                    <td class="nowrap">@Txt(b.Tag)</td>
                    <td class="nowrap">@Txt(b.SerialNo)</td>
                    <td class="right">@b.Quantidade</td>
                    <td>@(b.AnoInstalacao > 0 ? b.AnoInstalacao.ToString() : "—")</td>
                    <td>@Cap(b.Status)</td>
                    <td><span class="badge @CritClass(b.Criticidade)">@Cap(b.Criticidade)</span></td>
                </tr>
            }
            @if (_base.Count == 0) { <tr><td colspan="7" class="empty">Não instalado.</td></tr> }
        </tbody>
    </table>

    <div class="dash-title">Regras técnicas de troca (peças e ciclos)</div>
    <table class="grid" style="margin-bottom:20px">
        <thead><tr><th>Item / Conjunto</th><th>Frequência de troca</th><th>Origem</th><th class="right">Valor estimado</th><th>Criticidade</th></tr></thead>
        <tbody>
            @foreach (var p in _parts)
            {
                <tr>
                    <td>@p.Nome</td>
                    <td class="nowrap">@Freq(p.CicloMeses)</td>
                    <td><span class="badge st-ok">@Origem(p.Nome)</span></td>
                    <td class="right nowrap">@(p.ValorEstimado > 0 ? Fmt.Brl0(p.ValorEstimado) : "—")</td>
                    <td><span class="badge @(p.Critica ? "st-vencida" : "st-plan")">@(p.Critica ? "Crítica" : "Normal")</span></td>
                </tr>
            }
            @if (_parts.Count == 0) { <tr><td colspan="5" class="empty">Sem peças cadastradas.</td></tr> }
        </tbody>
    </table>

    <div class="dash-title">Histórico Aftermarket (deste equipamento)
        @if (_sales.Count > 0)
        {
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:#0a7d6c;background:#e6f7f3;border-radius:20px;padding:3px 10px">@_sales.Count compra(s) · @Fmt.Brl0(_sales.Sum(s => s.Valor))</span>
        }
    </div>
    <div class="toolbar tab-toolbar">
        <input class="cell busca-bom" placeholder="Buscar pedido, cliente, tag, partnumber, item…"
               @bind="_histBusca" @bind:event="oninput" />
        @if (_histBusca.Trim().Length > 0)
        {
            <span class="busca-info">
                <strong>@HistVisivel.Count</strong> de @_sales.Count registro(s)
                <button class="btn-link" @onclick='() => _histBusca = ""'>limpar</button>
            </span>
        }
        <div style="flex:1"></div>
        <button class="btn-ghost" @onclick="BaixarHistorico">⬇ Baixar Excel</button>
        <label class="btn-ghost file-btn">
            ⬆ Subir planilha
            <InputFile OnChange="SubirHistorico" accept=".xlsx,.xlsm,.xls,.csv" />
        </label>
        <label class="chk-inline">
            <input type="checkbox" @bind="_histSubstituir" /> substituir o histórico deste equipamento
        </label>
        <button class="btn-primary" @onclick="NovaVenda">+ Adicionar registro</button>
    </div>
    @if (_histBusca.Trim().Length > 0)
    {
        <div class="busca-aviso">
            A busca só filtra o que aparece na tela — o <strong>Baixar Excel</strong> continua
            trazendo o histórico completo deste equipamento.
        </div>
    }
    @if (_histMsg is not null)
    {
        <div class="@(_histOk ? "side-ok" : "alert-error")" style="margin-bottom:10px">@_histMsg</div>
    }
    <div class="tabela-rolante">
    <table class="grid" style="margin-bottom:20px">
        <thead>
            <tr>
                <th>Data</th><th>Pedido</th><th>Cliente / Unidade</th><th>Tag</th><th>Partnumber</th>
                <th>Item vendido</th><th class="right">Quantidade</th>
                <th class="right">Valor unitário</th><th class="right">Valor total</th>
                <th>Importação</th><th>Prazo de entrega</th>
                <th>Obs</th><th class="right">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in HistVisivel)
            {
                @if (_editVendaId == s.Id)
                {
                    <tr class="row-edit">
                        <td colspan="13">
                            <div class="form3 form-edit">
                                <label>Data <input class="cell" type="date" @bind="DataDaVenda" /></label>
                                <label>Pedido <input class="cell" @bind="_fv.Pedido" placeholder="nº do pedido" /></label>
                                <label>Cliente / Unidade
                                        <select class="cell" @bind="_fv.ClientUnitId">
                                        <option value="">— selecione —</option>
                                        @foreach (var u in _unidades)
                                        {
                                            <option value="@u.Id">@Intel.ClienteDaUnidade(u.Id) — @u.NomeUnidade</option>
                                        }
                                    </select></label>
                                <label>Tag <input class="cell" @bind="_fv.Tag" placeholder="ex.: FD-101A" /></label>
                                <label>Partnumber <input class="cell" list="bom-pns" @bind="_fv.PartNumber"
                                                        @bind:after="PartnumberMudou" /></label>
                                <label>Item vendido <input class="cell" @bind="_fv.ItemVendido" /></label>
                                <label>Quantidade <input class="cell" type="number" min="0"
                                                         @bind="_fv.Quantidade" @bind:after="RecalcularTotal" /></label>
                                <label>Valor unitário (R$) <input class="cell" type="number" step="0.01" min="0"
                                                                  @bind="_fv.ValorUnitario" @bind:after="RecalcularTotal" /></label>
                                <label>Valor total (R$)
                                    <input class="cell" type="number" step="0.01" min="0" @bind="_fv.Valor" />
                                    <span style="font-size:11px;color:var(--muted)">quantidade × unitário; dá para ajustar</span>
                                </label>
                                <label>Importação
                                    <select class="cell" @bind="_fv.TipoImportacao">
                                        <option value="">— não definido —</option>
                                        <option value="total">Por total</option>
                                        <option value="item">Por item</option>
                                    </select>
                                    <span style="font-size:11px;color:var(--muted)">muda o custo da importação</span>
                                </label>
                                <label>Prazo de entrega
                                    <input class="cell" @bind="_fv.PrazoEntrega" placeholder="ex.: 45 dias" />
                                </label>
                                <label>Obs <input class="cell" @bind="_fv.Observacao" /></label>
                                <label>Vendedor
                                        <select class="cell" @bind="_fv.VendedorId">
                                        <option value="">— sem vendedor —</option>
                                        @foreach (var v in _vendedores)
                                        {
                                            <option value="@v.Id">@v.Nome</option>
                                        }
                                    </select></label>
                            </div>
                            <div class="toolbar" style="margin-top:10px">
                                <button class="btn-primary" @onclick="SalvarVenda">Salvar</button>
                                <button class="btn-ghost" @onclick="CancelarVenda">Cancelar</button>
                                @if (_vendaErro is not null) { <span class="alert-error" style="padding:6px 10px">@_vendaErro</span> }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td class="nowrap">@Fmt.Date(s.DataVenda)</td>
                        <td>@Txt(s.Pedido)</td>
                        <td>@Intel.ClienteDaUnidade(s.ClientUnitId) — @Intel.UnitNome(s.ClientUnitId)</td>
                        <td class="nowrap">@Txt(s.Tag)</td>
                        <td class="nowrap">@Txt(s.PartNumber)</td>
                        <td>@s.ItemVendido</td>
                        <td class="right">@s.Quantidade</td>
                        <td class="right nowrap">@Fmt.Brl(s.ValorUnitario)</td>
                        <td class="right nowrap"><strong>@Fmt.Brl0(s.Valor)</strong></td>
                        <td class="nowrap">
                            @if (s.TipoImportacao == "total")
                            {
                                <span class="imp imp-total">Por total</span>
                            }
                            else if (s.TipoImportacao == "item")
                            {
                                <span class="imp imp-item">Por item</span>
                            }
                            else
                            {
                                <span style="color:var(--muted)">—</span>
                            }
                        </td>
                        <td class="nowrap">@Txt(s.PrazoEntrega)</td>
                        <td>@Txt(s.Observacao)</td>
                        <td class="right nowrap">
                            <button class="btn-link" @onclick="() => EditarVenda(s)">editar</button>
                            @if (_confirmVendaId == s.Id)
                            {
                                <button class="btn-link" style="color:#b91c1c;font-weight:700" @onclick="() => ExcluirVenda(s)">confirmar</button>
                                <button class="btn-link" style="color:var(--muted)" @onclick="() => _confirmVendaId = null">não</button>
                            }
                            else
                            {
                                <button class="btn-link" style="color:#b91c1c" @onclick="() => _confirmVendaId = s.Id">excluir</button>
                            }
                        </td>
                    </tr>
                }
            }
            @if (HistVisivel.Count == 0)
            {
                <tr>
                    <td colspan="13" class="empty">
                        @if (_sales.Count == 0)
                        {
                            <text>Sem histórico de vendas AFM para este equipamento.</text>
                        }
                        else
                        {
                            <text>Nenhum registro corresponde a "@_histBusca".</text>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @* Partnumbers do BOM deste equipamento, sugeridos ao lançar uma venda. *@
    <datalist id="bom-pns">
        @foreach (var pn in _bom.Where(b => !string.IsNullOrWhiteSpace(b.PartNumber))
                                .Select(b => b.PartNumber).Distinct())
        {
            <option value="@pn" />
        }
    </datalist>

    @* Ventilador centrífugo continua com os dados construtivos (peso, dimensões,
       material). Todo outro tipo trabalha com a lista de materiais — o BOM. *@
    @if (EhVentiladorCentrifugo)
    {
        <div class="dash-title">Dados construtivos</div>
        <table class="grid">
            <thead><tr><th>Item</th><th class="right">Peso (kg)</th><th>Dimensões</th><th>Material</th><th>Parte do equipamento</th><th>Modelo</th></tr></thead>
            <tbody>
                @foreach (var c in _constr)
                {
                    <tr>
                        <td>@c.ItemName</td>
                        <td class="right">@(string.IsNullOrEmpty(c.WeightKg) ? "—" : c.WeightKg)</td>
                        <td>@(string.IsNullOrEmpty(c.Dimensions) ? "—" : c.Dimensions)</td>
                        <td>@(string.IsNullOrEmpty(c.Material) ? "—" : c.Material)</td>
                        <td>@c.EquipmentPart</td>
                        <td>@(string.IsNullOrEmpty(c.ItemModel) ? "—" : c.ItemModel)</td>
                    </tr>
                }
                @if (_constr.Count == 0) { <tr><td colspan="6" class="empty">Nenhum dado construtivo cadastrado.</td></tr> }
            </tbody>
        </table>
    }
    else
    {
        <div class="dash-title">Dados - BOM
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                lista de materiais de @(string.IsNullOrWhiteSpace(_e.Tipo) ? "equipamento" : _e.Tipo)
            </span>
        </div>
        <div class="toolbar tab-toolbar">
            <input class="cell busca-bom" placeholder="Buscar item, partnumber, descrição, material…"
                   @bind="_bomBusca" @bind:event="oninput" />
            @if (_bomBusca.Trim().Length > 0)
            {
                <span class="busca-info">
                    <strong>@BomVisivel.Count</strong> de @_bom.Count item(ns)
                    <button class="btn-link" @onclick='() => _bomBusca = ""'>limpar</button>
                </span>
            }
            <div style="flex:1"></div>
            <button class="btn-ghost" @onclick="BaixarBom">⬇ Baixar Excel</button>
            <label class="btn-ghost file-btn">
                ⬆ Subir planilha
                <InputFile OnChange="SubirBom" accept=".xlsx,.xlsm,.xls,.csv" />
            </label>
            <label class="chk-inline">
                <input type="checkbox" @bind="_bomSubstituir" /> substituir o BOM deste equipamento
            </label>
            <button class="btn-primary" @onclick="NovoItemBom">+ Adicionar item</button>
        </div>
        @if (_bomBusca.Trim().Length > 0)
        {
            <div class="busca-aviso">
                A busca só filtra o que aparece na tela — o <strong>Baixar Excel</strong> continua
                trazendo o BOM completo deste equipamento.
            </div>
        }
        @if (_bomMsg is not null)
        {
            <div class="@(_bomOk ? "side-ok" : "alert-error")" style="margin-bottom:10px">@_bomMsg</div>
        }
        <table class="grid">
            <thead>
                <tr>
                    <th>Item</th><th class="right">Quantidade</th><th>Partnumber</th>
                    <th>Descrição em inglês</th><th>Descrição em português</th><th>Material</th>
                    <th class="right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in BomVisivel)
                {
                    @if (_editBomId == b.Id)
                    {
                        <tr class="row-edit">
                            <td colspan="7">
                                <div class="form3 form-edit">
                                    <label>Item <input class="cell" @bind="_fb.Item" placeholder="ex.: 10" /></label>
                                    <label>Quantidade <input class="cell" @bind="_fb.Quantidade" placeholder="ex.: 2 ou 1 jogo" /></label>
                                    <label>Partnumber <input class="cell" @bind="_fb.PartNumber" /></label>
                                    <label>Descrição em inglês <input class="cell" @bind="_fb.DescricaoEn" /></label>
                                    <label>Descrição em português <input class="cell" @bind="_fb.DescricaoPt" /></label>
                                    <label>Material <input class="cell" @bind="_fb.Material" /></label>
                                </div>
                                <div class="toolbar" style="margin-top:10px">
                                    <button class="btn-primary" @onclick="SalvarBom">Salvar</button>
                                    <button class="btn-ghost" @onclick="CancelarBom">Cancelar</button>
                                    @if (_bomErro is not null) { <span class="alert-error" style="padding:6px 10px">@_bomErro</span> }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="nowrap">@Txt(b.Item)</td>
                            <td class="right">@Txt(b.Quantidade)</td>
                            <td class="nowrap">@Txt(b.PartNumber)</td>
                            <td>@Txt(b.DescricaoEn)</td>
                            <td>@Txt(b.DescricaoPt)</td>
                            <td>@Txt(b.Material)</td>
                            <td class="right nowrap">
                                <button class="btn-link" @onclick="() => EditarBom(b)">editar</button>
                                @if (_confirmBomId == b.Id)
                                {
                                    <button class="btn-link" style="color:#b91c1c;font-weight:700" @onclick="() => ExcluirBom(b)">confirmar</button>
                                    <button class="btn-link" style="color:var(--muted)" @onclick="() => _confirmBomId = null">não</button>
                                }
                                else
                                {
                                    <button class="btn-link" style="color:#b91c1c" @onclick="() => _confirmBomId = b.Id">excluir</button>
                                }
                            </td>
                        </tr>
                    }
                }
                @if (BomVisivel.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty">
                            @if (_bom.Count == 0)
                            {
                                <text>Nenhum item de BOM cadastrado para este equipamento.</text>
                            }
                            else
                            {
                                <text>Nenhum item do BOM corresponde a "@_bomBusca".</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public string? Id { get; set; }
    private Equipment? _e;
    private List<Part> _parts = new();
    private List<InstalledBase> _base = new();
    private List<ConstructionItem> _constr = new();
    private List<BomItem> _bom = new();
    private List<SalesRecord> _sales = new();
    private List<ClientUnit> _unidades = new();
    private List<Salesperson> _vendedores = new();
    private int _qtd, _pecasCriticas;
    private decimal _pot24;

    // --- estado das edições / importações ---------------------------------
    private string? _editBomId, _confirmBomId, _bomMsg, _bomErro;
    private string _bomBusca = "";
    private bool _bomOk, _bomSubstituir;
    private BomItem _fb = new();

    private string? _editVendaId, _confirmVendaId, _histMsg, _vendaErro;
    private string _histBusca = "";
    private bool _histOk, _histSubstituir;
    private SalesRecord _fv = new();

    protected override void OnInitialized() => Carregar();

    private void Carregar()
    {
        _e = Equipamentos.All().FirstOrDefault(e => e.Id == Id);
        if (_e is null) return;
        _parts = Pecas.All().Where(p => p.EquipmentId == _e.Id).OrderBy(p => p.Nome).ToList();
        _base = Base.All().Where(b => b.EquipmentId == _e.Id)
            .OrderBy(b => Intel.ClienteDaUnidade(b.ClientUnitId), StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => Intel.UnitNome(b.ClientUnitId), StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => b.Tag, StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => b.SerialNo, StringComparer.OrdinalIgnoreCase).ToList();
        _constr = Construcao.ForEquip(_e.Id);
        _bom = Bom.ForEquip(_e.Id)
            .OrderBy(b => OrdemItem(b.Item))
            .ThenBy(b => b.Item, StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => b.PartNumber, StringComparer.OrdinalIgnoreCase).ToList();
        _sales = Vendas.ForEquip(_e.Id).OrderByDescending(s => s.DataVenda).ToList();
        _unidades = Unidades.All().OrderBy(u => u.NomeUnidade, StringComparer.OrdinalIgnoreCase).ToList();
        _vendedores = Vendedores.All().Where(v => v.Ativo)
            .OrderBy(v => v.Nome, StringComparer.OrdinalIgnoreCase).ToList();
        _qtd = _base.Sum(b => b.Quantidade);
        _pecasCriticas = _parts.Count(p => p.Critica);
        _pot24 = Intel.OpenOpportunities()
            .Where(o => o.EquipmentId == _e.Id && o.DiasAteJanela <= 730)
            .Sum(o => o.ValorEstimado);
    }

    // =================== BOM ==============================================

    /// <summary>
    /// Itens do BOM exibidos. A linha em edição fica sempre visível, mesmo que
    /// não case com a busca — senão um item recém-criado sumiria da tela.
    /// </summary>
    private List<BomItem> BomVisivel
    {
        get
        {
            var s = _bomBusca.Trim();
            if (s.Length == 0) return _bom;
            var alvo = s.ToLowerInvariant();
            return _bom.Where(b => b.Id == _editBomId || string.Join(' ',
                    b.Item, b.Quantidade, b.PartNumber, b.DescricaoEn, b.DescricaoPt, b.Material)
                .ToLowerInvariant().Contains(alvo)).ToList();
        }
    }

    private void NovoItemBom()
    {
        _fb = new BomItem { Id = "bom-" + Guid.NewGuid().ToString("N")[..8], EquipmentId = _e!.Id };
        _editBomId = _fb.Id; _bomErro = null; _bomMsg = null;
        _bom.Insert(0, _fb);   // linha nova aparece no topo já em edição
    }

    private void EditarBom(BomItem b)
    {
        _editBomId = b.Id; _bomErro = null; _bomMsg = null;
        _fb = new BomItem
        {
            Id = b.Id, EquipmentId = b.EquipmentId, Item = b.Item, Quantidade = b.Quantidade,
            PartNumber = b.PartNumber, DescricaoEn = b.DescricaoEn, DescricaoPt = b.DescricaoPt,
            Material = b.Material,
        };
    }

    private void SalvarBom()
    {
        if (string.IsNullOrWhiteSpace(_fb.PartNumber) && string.IsNullOrWhiteSpace(_fb.Item)
            && string.IsNullOrWhiteSpace(_fb.DescricaoEn) && string.IsNullOrWhiteSpace(_fb.DescricaoPt))
        {
            _bomErro = "Preencha ao menos o item, o partnumber ou uma das descrições.";
            return;
        }
        _fb.EquipmentId = _e!.Id;
        Bom.Save(_fb);
        _editBomId = null; _bomErro = null;
        _bomMsg = "Item salvo."; _bomOk = true;
        Carregar();
    }

    private void ExcluirBom(BomItem b)
    {
        Bom.Delete(b);
        _confirmBomId = null; _editBomId = null;
        _bomMsg = "Item excluído."; _bomOk = true;
        Carregar();
    }

    private static readonly string[] BomHeader =
        { "item", "quantidade", "partnumber", "descricao_em_ingles", "descricao_portugues", "material" };

    private async Task BaixarBom()
    {
        // a linha em branco de um item ainda não salvo não vai para a planilha
        var linhas = _bom
            .Where(b => !string.IsNullOrWhiteSpace(b.PartNumber) || !string.IsNullOrWhiteSpace(b.Item)
                     || !string.IsNullOrWhiteSpace(b.DescricaoEn) || !string.IsNullOrWhiteSpace(b.DescricaoPt))
            .Select(b => new[] { b.Item, b.Quantidade, b.PartNumber, b.DescricaoEn, b.DescricaoPt, b.Material })
            .ToList();
        var bytes = Planilha.Xlsx("BOM", BomHeader, linhas);
        await Baixar($"BOM_{Arquivo(_e!)}.xlsx", bytes);
    }

    private async Task SubirBom(InputFileChangeEventArgs e)
    {
        var bytes = await LerArquivo(e);
        if (bytes is null) { _bomMsg = "Arquivo muito grande (limite de 25 MB)."; _bomOk = false; return; }
        var res = Importer.ImportBomDoEquipamento(_e!.Id, bytes, e.File.Name, _bomSubstituir);
        _bomMsg = res.Message; _bomOk = res.Ok;
        if (res.Ok) { _editBomId = null; Intel.Invalidate(); Carregar(); }
    }

    // =================== Histórico Aftermarket ============================

    /// <summary>
    /// Registros exibidos. O que está em edição fica sempre visível, mesmo fora
    /// da busca — senão um lançamento novo sumiria ao ser digitado.
    /// </summary>
    private List<SalesRecord> HistVisivel
    {
        get
        {
            var s = _histBusca.Trim();
            if (s.Length == 0) return _sales;
            var alvo = s.ToLowerInvariant();
            return _sales.Where(v => v.Id == _editVendaId || string.Join(' ',
                    Fmt.Date(v.DataVenda), v.Pedido, Intel.ClienteDaUnidade(v.ClientUnitId),
                    Intel.UnitNome(v.ClientUnitId), v.Tag, v.PartNumber, v.ItemVendido,
                    RotuloImportacao(v.TipoImportacao), v.PrazoEntrega, v.Observacao)
                .ToLowerInvariant().Contains(alvo)).ToList();
        }
    }

    /// <summary>Texto do tipo de importação, usado na busca e na planilha.</summary>
    private static string RotuloImportacao(string tipo) => tipo switch
    {
        "total" => "Por total", "item" => "Por item", _ => "",
    };

    /// <summary>Valor total acompanha quantidade × unitário; o usuário pode ajustar depois.</summary>
    private void RecalcularTotal() => _fv.Valor = _fv.ValorUnitario * _fv.Quantidade;

    /// <summary>
    /// Ao escolher um partnumber do BOM, preenche o item vendido com a descrição
    /// cadastrada — só quando o campo ainda está vazio, para não apagar o que o
    /// usuário escreveu.
    /// </summary>
    private void PartnumberMudou()
    {
        if (string.IsNullOrWhiteSpace(_fv.PartNumber)) return;
        if (!string.IsNullOrWhiteSpace(_fv.ItemVendido)) return;
        var item = _bom.FirstOrDefault(b =>
            string.Equals(b.PartNumber, _fv.PartNumber, StringComparison.OrdinalIgnoreCase));
        if (item is null) return;
        _fv.ItemVendido = !string.IsNullOrWhiteSpace(item.DescricaoPt) ? item.DescricaoPt : item.DescricaoEn;
    }

    private void NovaVenda()
    {
        _fv = new SalesRecord
        {
            Id = "sl-" + Guid.NewGuid().ToString("N")[..8],
            EquipmentId = _e!.Id,
            DataVenda = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            Quantidade = 1,
            Origem = "Lançamento manual",
        };
        _editVendaId = _fv.Id; _vendaErro = null; _histMsg = null;
        _sales.Insert(0, _fv);
    }

    private void EditarVenda(SalesRecord s)
    {
        _editVendaId = s.Id; _vendaErro = null; _histMsg = null;
        _fv = new SalesRecord
        {
            Id = s.Id, DataVenda = s.DataVenda, Pedido = s.Pedido, ClientUnitId = s.ClientUnitId,
            EquipmentId = s.EquipmentId, ItemVendido = s.ItemVendido, Quantidade = s.Quantidade,
            Valor = s.Valor, ValorUnitario = s.ValorUnitario, VendedorId = s.VendedorId,
            Origem = s.Origem, Tag = s.Tag, SerialNo = s.SerialNo,
            PartNumber = s.PartNumber, Observacao = s.Observacao,
            TipoImportacao = s.TipoImportacao, PrazoEntrega = s.PrazoEntrega,
        };
    }

    private void SalvarVenda()
    {
        if (string.IsNullOrWhiteSpace(_fv.ItemVendido))
        {
            _vendaErro = "Informe o item vendido.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_fv.DataVenda))
        {
            _vendaErro = "Informe a data da venda.";
            return;
        }
        _fv.EquipmentId = _e!.Id;
        Vendas.Save(_fv);
        _editVendaId = null; _vendaErro = null;
        _histMsg = "Registro salvo."; _histOk = true;
        Intel.Invalidate();
        Carregar();
    }

    private void ExcluirVenda(SalesRecord s)
    {
        Vendas.Delete(s);
        _confirmVendaId = null; _editVendaId = null;
        _histMsg = "Registro excluído."; _histOk = true;
        Intel.Invalidate();
        Carregar();
    }

    private static readonly string[] HistHeader =
        { "data_venda", "pedido", "unidade", "tag", "partnumber", "item_vendido",
          "quantidade", "valor_unitario", "valor_total", "importacao", "prazo_de_entrega",
          "obs", "vendedor" };

