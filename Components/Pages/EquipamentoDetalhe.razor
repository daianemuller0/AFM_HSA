    // =================== utilidades =======================================

    /// <summary>
    /// Ponte entre o campo de data do formulário e o texto ISO gravado no Parquet:
    /// o &lt;input type="date"&gt; do Blazor só trabalha com DateOnly/DateTime.
    /// </summary>
    private DateOnly? DataDaVenda
    {
        get => DateOnly.TryParseExact(_fv.DataVenda, "yyyy-MM-dd",
            CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;
        set => _fv.DataVenda = value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
    }

    private void CancelarBom() { _editBomId = null; _bomErro = null; Carregar(); }
    private void CancelarVenda() { _editVendaId = null; _vendaErro = null; Carregar(); }

    /// <summary>Nome do vendedor para a planilha; se não achar, exporta o id —
    /// assim a planilha volta pelo import sem perder a ligação.</summary>
    private string Vendedor(string id)
    {
        if (string.IsNullOrWhiteSpace(id)) return "";
        var nome = Intel.SalespersonName(id);
        return nome == "—" ? id : nome;
    }

    private static async Task<byte[]?> LerArquivo(InputFileChangeEventArgs e)
    {
        const long limite = 25L * 1024 * 1024;
        if (e.File.Size > limite) return null;
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(limite).CopyToAsync(ms);
        return ms.ToArray();
    }

    private async Task Baixar(string nome, byte[] bytes) =>
        await JS.InvokeVoidAsync("appDownload", nome,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));

    /// <summary>Nome de arquivo seguro a partir do modelo do equipamento.</summary>
    private static string Arquivo(Equipment e)
    {
        var baseNome = string.IsNullOrWhiteSpace(e.Modelo) ? e.Nome : e.Modelo;
        var limpo = new string(baseNome.Select(c => char.IsLetterOrDigit(c) ? c : '_').ToArray());
        limpo = limpo.Trim('_');
        return limpo.Length == 0 ? "equipamento" : limpo;
    }

    /// <summary>
    /// Ventilador centrífugo é o único tipo que segue com os dados construtivos
    /// (peso, dimensões, material). Para os demais (VARIAX, axial, Air Pre Heater,
    /// soprador, exaustor…) a ficha mostra o BOM.
    /// </summary>
    private bool EhVentiladorCentrifugo
    {
        get
        {
            var t = SemAcento(_e?.Tipo ?? "");
            if (string.IsNullOrWhiteSpace(t)) t = SemAcento(_e?.Nome ?? "");
            return t.Contains("ventilador") && t.Contains("centrif");
        }
    }

    private static string SemAcento(string s)
    {
        var d = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(d.Length);
        foreach (var ch in d)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(ch) != UnicodeCategory.NonSpacingMark)
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

    /// <summary>Ordena o item do BOM pelo número (10, 20, 100) e não como texto.</summary>
    private static int OrdemItem(string item) =>
        int.TryParse(new string((item ?? "").Where(char.IsDigit).ToArray()), out var n) ? n : int.MaxValue;

    private static string Txt(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private static string Freq(int meses) =>
        $"{meses} meses (~{(meses / 12.0).ToString("0.0", CultureInfo.InvariantCulture)} anos)";

    private string Origem(string parte)
    {
        var pn = parte.ToLowerInvariant();
        var n = _sales.Count(s => { var it = s.ItemVendido.ToLowerInvariant(); return it.Contains(pn) || pn.Contains(it); });
        return n > 0 ? $"Histórico ({n} compras)" : "Regra técnica";
    }

    private static string Cap(string s) => string.IsNullOrEmpty(s) ? "—" : char.ToUpperInvariant(s[0]) + s[1..];
    private static string CritClass(string c) => c.ToLowerInvariant() switch
    {
        "crítica" => "st-vencida", "alta" => "st-critica", "média" => "st-atencao", "baixa" => "st-ok", _ => "st-plan",
    };
}
