@page "/equipamentos/{Id}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject EquipmentRepository Equipamentos
@inject PartRepository Pecas
@inject InstalledBaseRepository Base
@inject SalesRecordRepository Vendas
@inject ConstructionRepository Construcao
@inject BomRepository Bom
@inject NacionalizacaoRepository Nacionais
@inject ClientUnitRepository Unidades
@inject SalespersonRepository Vendedores
@inject ImportService Importer
@inject IntelligenceService Intel
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<PageTitle>Equipamento · AFM HSA</PageTitle>

@if (_e is null)
{
    <h1>Equipamento</h1>
    <div class="panel empty-state"><div class="empty-title">Equipamento não encontrado</div>
        <a class="btn-ghost" href="/clientes">Voltar</a></div>
}
else
{
    <div class="page-head">
        <div><h1>@_e.Nome</h1><p class="subtitle">Aplicação: @_e.Aplicacao</p></div>
        <div class="page-actions"><a class="btn-ghost" href="javascript:history.back()">Voltar</a></div>
    </div>

    <div class="kpis kpis-8">
        <div class="kpi"><div class="kpi-label">Segmento</div><div class="kpi-value" style="font-size:15px">@_e.Segmento</div></div>
        <div class="kpi"><div class="kpi-label">Fabricante</div><div class="kpi-value" style="font-size:12px">@_e.Fabricante</div></div>
        <div class="kpi"><div class="kpi-label">Qtd. instalada</div><div class="kpi-value">@_qtd</div></div>
        <div class="kpi k-venc"><div class="kpi-label">Peças críticas</div><div class="kpi-value">@_pecasCriticas</div></div>
        <div class="kpi k-ren"><div class="kpi-label">Valor completo</div><div class="kpi-value" style="font-size:14px">@Fmt.Brl0(_e.ValorCompleto)</div></div>
        <div class="kpi k-po"><div class="kpi-label">Valor potencial 24 meses</div><div class="kpi-value" style="font-size:14px">@Fmt.Brl0(_pot24)</div></div>
    </div>

    <div class="dash-title">Cliente / unidade onde está instalado</div>
    <table class="grid" style="margin-bottom:20px">
        <thead>
            <tr>
                <th>Cliente / Unidade</th><th>Tag</th><th>Nº de série</th>
                <th class="right">Qtd</th><th>Ano</th><th>Status</th><th>Criticidade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in _base)
            {
                <tr>
                    <td>@Intel.ClienteDaUnidade(b.ClientUnitId) — @Intel.UnitNome(b.ClientUnitId)</td>
                    <td class="nowrap">@Txt(b.Tag)</td>
                    <td class="nowrap">@Txt(b.SerialNo)</td>
                    <td class="right">@b.Quantidade</td>
                    <td>@(b.AnoInstalacao > 0 ? b.AnoInstalacao.ToString() : "—")</td>
                    <td>@Cap(b.Status)</td>
                    <td><span class="badge @CritClass(b.Criticidade)">@Cap(b.Criticidade)</span></td>
                </tr>
            }
            @if (_base.Count == 0) { <tr><td colspan="7" class="empty">Não instalado.</td></tr> }
        </tbody>
    </table>

    <div class="dash-title">Regras técnicas de troca (peças e ciclos)
        <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
            frequência calculada pelo histórico de compras de cada partnumber — fica mais precisa a cada venda
        </span>
    </div>
    <div class="toolbar tab-toolbar">
        <span style="font-size:12.5px;color:var(--muted)">
            A partir de <strong style="color:var(--text)">2 compras do mesmo cliente</strong> o sistema calcula a frequência e prevê a próxima compra.
            Sem histórico suficiente, vale a regra cadastrada.
        </span>
        <div style="flex:1"></div>
        <button class="btn-primary" @onclick="NovaRegra">+ Adicionar regra</button>
    </div>
    @if (_regraMsg is not null)
    {
        <div class="side-ok" style="margin-bottom:10px">@_regraMsg</div>
    }
    <div class="tabela-rolante">
    <table class="grid" style="margin-bottom:20px">
        <thead>
            <tr>
                <th>Partnumber</th><th>Peça nacionalizada</th><th>Descrição (do BOM)</th>
                <th>Frequência de troca</th><th>Compras no histórico</th><th>Próxima compra</th>
                <th class="right">Valor estimado</th><th>Criticidade</th><th class="right">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in LinhasRegras)
            {
                @if (l.Regra is not null && _editRegraId == l.Regra.Id)
                {
                    <tr class="row-edit">
                        <td colspan="9">
                            <div class="form3 form-edit">
                                <label>Partnumber *
                                    <input class="cell" list="bom-pns" @bind="_fp.Codigo" @bind:after="PnRegraMudou" />
                                    <span class="dica-bom @(DescricaoBom(_fp.Codigo).Length > 0 ? "" : "fora")">
                                        @DicaBom(_fp.Codigo)
                                    </span>
                                </label>
                                <label>Ciclo de troca (meses) *
                                    <input class="cell" type="number" min="1" @bind="_fp.CicloMeses" />
                                    <span style="font-size:11px;color:var(--muted)">usado enquanto o histórico não tiver 2 compras do mesmo cliente</span>
                                </label>
                                <label>Valor estimado (R$)
                                    <input class="cell" type="number" step="0.01" min="0" @bind="_fp.ValorEstimado" />
                                </label>
                                <label>Criticidade
                                    <select class="cell" @bind="CriticidadeRegra">
                                        <option value="normal">Normal</option>
                                        <option value="critica">Crítica</option>
                                    </select>
                                </label>
                            </div>
                            <div class="toolbar" style="margin-top:10px">
                                <button class="btn-primary" @onclick="SalvarRegra">Salvar</button>
                                <button class="btn-ghost" @onclick="CancelarRegra">Cancelar</button>
                                @if (_regraErro is not null) { <span class="alert-error" style="padding:6px 10px">@_regraErro</span> }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    <tr class="@(l.Regra is null ? "linha-historico" : "")">
                        <td class="nowrap">
                            @if (string.IsNullOrWhiteSpace(l.Pn))
                            {
                                <span class="sem-pn" title="Regra antiga, cadastrada pelo nome. Edite para informar o partnumber.">sem partnumber</span>
                            }
                            else
                            {
                                <strong>@l.Pn</strong>
                            }
                        </td>
                        <td>@SeloNacional(l.Pn)</td>
                        <td>@l.Descricao</td>
                        <td class="nowrap">
                            @if (l.MesesHistorico is int mh)
                            {
                                <strong>@Freq(mh)</strong>
                                <span class="sub-cel">pelo histórico · média de @l.Intervalos intervalo(s)</span>
                                @if (l.Regra is not null && l.Regra.CicloMeses > 0 && l.Regra.CicloMeses != mh)
                                {
                                    <span class="sub-cel">regra cadastrada: @l.Regra.CicloMeses meses</span>
                                }
                            }
                            else if (l.Meses is int mr)
                            {
                                @Freq(mr)
                                <span class="sub-cel">regra cadastrada · histórico ainda insuficiente</span>
                            }
                            else
                            {
                                <span style="color:var(--muted)">—</span>
                                <span class="sub-cel">precisa de 2 compras do mesmo cliente</span>
                            }
                        </td>
                        <td class="nowrap">
                            @if (l.Compras.Count > 0)
                            {
                                <span class="badge st-ok">@l.Compras.Count compra(s)</span>
                                <span class="sub-cel">última em @Fmt.Date(l.Compras.Max(v => v.DataVenda))</span>
                            }
                            else
                            {
                                <span style="color:var(--muted)">sem compras</span>
                            }
                        </td>
                        <td class="nowrap">
                            @if (l.Proximas.Count == 0)
                            {
                                <span style="color:var(--muted)">—</span>
                            }
                            else
                            {
                                @foreach (var px in l.Proximas.Take(3))
                                {
                                    <div class="prox">
                                        <strong>@Fmt.Date(px.Data)</strong>
                                        <span class="prox-pill @ClasseProxima(px.Dias)">@TextoProxima(px.Dias)</span>
                                        <span class="sub-cel">@Intel.ClienteDaUnidade(px.ClientUnitId) — @Intel.UnitNome(px.ClientUnitId)</span>
                                    </div>
                                }
                                @if (l.Proximas.Count > 3)
                                {
                                    <span class="sub-cel">+ @(l.Proximas.Count - 3) cliente(s)</span>
                                }
                            }
                        </td>
                        <td class="right nowrap">
                            @if (l.Regra is not null && l.Regra.ValorEstimado > 0)
                            {
                                @Fmt.Brl0(l.Regra.ValorEstimado)
                            }
                            else if (l.Compras.Count > 0 && UltimoUnitario(l.Compras) > 0)
                            {
                                @Fmt.Brl0(UltimoUnitario(l.Compras))
                                <span class="sub-cel">última compra</span>
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                        <td>
                            @if (l.Regra is not null)
                            {
                                <span class="badge @(l.Regra.Critica ? "st-vencida" : "st-plan")">@(l.Regra.Critica ? "Crítica" : "Normal")</span>
                            }
                            else
                            {
                                <span class="sem-regra" title="Calculada só pelo histórico. Crie a regra para definir criticidade e valor.">sem regra</span>
                            }
                        </td>
                        <td class="right nowrap">
                            @if (l.Regra is not null)
                            {
                                var regra = l.Regra;
                                <button class="btn-link" @onclick="() => EditarRegra(regra)">editar</button>
                                @if (_confirmRegraId == regra.Id)
                                {
                                    <button class="btn-link" style="color:#b91c1c;font-weight:700" @onclick="() => ExcluirRegra(regra)">confirmar</button>
                                    <button class="btn-link" style="color:var(--muted)" @onclick="() => _confirmRegraId = null">não</button>
                                }
                                else
                                {
                                    <button class="btn-link" style="color:#b91c1c" @onclick="() => _confirmRegraId = regra.Id">excluir</button>
                                }
                            }
                            else
                            {
                                <button class="btn-link" title="Criar a regra com a frequência calculada (dá para ajustar criticidade e valor)"
                                        @onclick="() => CriarRegraDoHistorico(l)">criar regra</button>
                            }
                        </td>
                    </tr>
                }
            }
            @if (LinhasRegras.Count == 0)
            {
                <tr><td colspan="9" class="empty">Nenhuma regra de troca e nenhuma compra com partnumber. Use "Adicionar regra" ou suba o histórico.</td></tr>
            }
        </tbody>
    </table>
    </div>

    <div class="dash-title">Histórico Aftermarket (deste equipamento)
        @if (_sales.Count > 0)
        {
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:#0a7d6c;background:#e6f7f3;border-radius:20px;padding:3px 10px">@_sales.Count compra(s) · @Fmt.Brl0(_sales.Sum(s => s.Valor))</span>
        }
    </div>
    <div class="toolbar tab-toolbar">
        <input class="cell busca-bom" placeholder="Buscar nº de venda, serial, tag, partnumber, descrição…"
               @bind="_histBusca" @bind:event="oninput" />
        @if (_histBusca.Trim().Length > 0)
        {
            <span class="busca-info">
                <strong>@HistVisivel.Count</strong> de @_sales.Count registro(s)
                <button class="btn-link" @onclick='() => _histBusca = ""'>limpar</button>
            </span>
        }
        <div style="flex:1"></div>
        <button class="btn-ghost" @onclick="BaixarHistorico">⬇ Baixar Excel</button>
        <label class="btn-ghost file-btn">
            ⬆ Subir planilha
            <InputFile OnChange="SubirHistorico" accept=".xlsx,.xlsm,.xls,.csv" />
        </label>
        <label class="chk-inline">
            <input type="checkbox" @bind="_histSubstituir" /> substituir o histórico deste equipamento
        </label>
        @if (_ehAdmin && _sales.Count > 0)
        {
            <button class="btn-ghost btn-perigo" @onclick="AbrirLimpeza">🗑 Limpar histórico</button>
        }
        <button class="btn-primary" @onclick="NovaVenda">+ Adicionar registro</button>
    </div>
    @if (_limparAberto)
    {
        <div class="painel-perigo">
            <div class="painel-perigo-titulo">Apagar todo o histórico Aftermarket deste equipamento</div>
            <p>
                Isso remove os <strong>@_sales.Count registro(s)</strong> de <strong>@_e.Modelo</strong>,
                de todas as plantas. As oportunidades calculadas a partir deles também somem.
                Se quiser guardar uma cópia, use <strong>Baixar Excel</strong> antes.
            </p>
            <div class="toolbar" style="margin:0">
                <input class="cell" type="password" style="max-width:240px" placeholder="Senha de administrador"
                       @bind="_senhaLimpeza" @bind:event="oninput" @onkeyup="TeclaSenha" />
                <button class="btn-primary btn-perigo-cheio" @onclick="LimparHistorico">Apagar histórico</button>
                <button class="btn-ghost" @onclick="FecharLimpeza">Cancelar</button>
                @if (_limpezaErro is not null) { <span class="alert-error" style="padding:6px 10px;margin:0">@_limpezaErro</span> }
            </div>
        </div>
    }
    @if (_histBusca.Trim().Length > 0)
    {
        <div class="busca-aviso">
            A busca só filtra o que aparece na tela — o <strong>Baixar Excel</strong> continua
            trazendo o histórico completo deste equipamento.
        </div>
    }
    @if (_histMsg is not null)
    {
        <div class="@(_histOk ? "side-ok" : "alert-error")" style="margin-bottom:10px">@_histMsg</div>
    }
    <div class="tabela-rolante">
    <table class="grid" style="margin-bottom:20px">
        <thead>
            <tr>
                <th>Data</th><th>N° de venda</th><th>Modelo</th><th>Serial number</th><th>TAG</th>
                <th>Partnumber</th><th>Peça nacionalizada</th><th class="right">Quantidade</th>
                <th class="right">Valor unitário</th><th class="right">Valor total</th>
                <th>Prazo de entrega</th><th>Observação</th><th class="right">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in HistVisivel)
            {
                @if (_editVendaId == s.Id)
                {
                    <tr class="row-edit">
                        <td colspan="13">
                            <div class="form3 form-edit">
                                <label>Data * <input class="cell" type="date" @bind="DataDaVenda" /></label>
                                <label>N° de venda <input class="cell" @bind="_fv.Pedido" placeholder="ex.: PV-44821" /></label>
                                <label>Equipamento instalado
                                    <select class="cell" @bind="_unidadeEscolhida" @bind:after="UnidadeEscolhida">
                                        <option value="">— escolher pela tag / serial —</option>
                                        @foreach (var b in _base)
                                        {
                                            <option value="@b.Id">@RotuloUnidade(b)</option>
                                        }
                                    </select>
                                    <span style="font-size:11px;color:var(--muted)">preenche serial, TAG e planta</span>
                                </label>
                                <label>Serial number <input class="cell" @bind="_fv.SerialNo" /></label>
                                <label>TAG <input class="cell" @bind="_fv.Tag" placeholder="ex.: FD-101A" /></label>
                                <label>Partnumber *
                                    <input class="cell" list="bom-pns" @bind="_fv.PartNumber" />
                                    <span class="dica-bom @(DescricaoBom(_fv.PartNumber).Length > 0 ? "" : "fora")">
                                        @DicaBom(_fv.PartNumber)
                                    </span>
                                </label>
                                <label>Quantidade <input class="cell" type="number" min="0"
                                                         @bind="_fv.Quantidade" @bind:after="RecalcularTotal" /></label>
                                <label>Valor unitário (R$) <input class="cell" type="number" step="0.01" min="0"
                                                                  @bind="_fv.ValorUnitario" @bind:after="RecalcularTotal" /></label>
                                <label>Valor total (R$)
                                    <input class="cell" type="number" step="0.01" min="0" @bind="_fv.Valor" />
                                    <span style="font-size:11px;color:var(--muted)">quantidade × unitário; dá para ajustar</span>
                                </label>
                                <label>Prazo de entrega
                                    <input class="cell" @bind="_fv.PrazoEntrega" placeholder="ex.: 45 dias" />
                                </label>
                                <label>Observação <input class="cell" @bind="_fv.Observacao" /></label>
                                <label>Importação
                                    <select class="cell" @bind="_fv.TipoImportacao">
                                        <option value="">— não definido —</option>
                                        <option value="total">Por total</option>
                                        <option value="item">Por item</option>
                                    </select>
                                </label>
                                <label>Vendedor
                                    <select class="cell" @bind="_fv.VendedorId">
                                        <option value="">— sem vendedor —</option>
                                        @foreach (var v in _vendedores)
                                        {
                                            <option value="@v.Id">@v.Nome</option>
                                        }
                                    </select>
                                </label>
                            </div>
                            <div class="toolbar" style="margin-top:10px">
                                <button class="btn-primary" @onclick="SalvarVenda">Salvar</button>
                                <button class="btn-ghost" @onclick="CancelarVenda">Cancelar</button>
                                @if (_vendaErro is not null) { <span class="alert-error" style="padding:6px 10px">@_vendaErro</span> }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    var desc = DescricaoBom(s.PartNumber);
                    <tr>
                        <td class="nowrap">@Fmt.Date(s.DataVenda)</td>
                        <td class="nowrap">@Txt(s.Pedido)</td>
                        <td class="nowrap">@Txt(_e.Modelo)</td>
                        <td class="nowrap">@Txt(s.SerialNo)</td>
                        <td class="nowrap">@Txt(s.Tag)</td>
                        <td>
                            <strong class="nowrap">@Txt(s.PartNumber)</strong>
                            @if (desc.Length > 0)
                            {
                                <span class="sub-cel">@desc</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(s.ItemVendido) && s.ItemVendido != s.PartNumber)
                            {
                                <span class="sub-cel fora" title="Este partnumber não está no BOM do equipamento">@s.ItemVendido</span>
                            }
                        </td>
                        <td>@SeloNacional(s.PartNumber)</td>
                        <td class="right">@s.Quantidade</td>
                        <td class="right nowrap">@Fmt.Brl(s.ValorUnitario)</td>
                        <td class="right nowrap"><strong>@Fmt.Brl0(s.Valor)</strong></td>
                        <td class="nowrap">@Txt(s.PrazoEntrega)</td>
                        <td>@Txt(s.Observacao)</td>
                        <td class="right nowrap">
                            <button class="btn-link" @onclick="() => EditarVenda(s)">editar</button>
                            @if (_confirmVendaId == s.Id)
                            {
                                <button class="btn-link" style="color:#b91c1c;font-weight:700" @onclick="() => ExcluirVenda(s)">confirmar</button>
                                <button class="btn-link" style="color:var(--muted)" @onclick="() => _confirmVendaId = null">não</button>
                            }
                            else
                            {
                                <button class="btn-link" style="color:#b91c1c" @onclick="() => _confirmVendaId = s.Id">excluir</button>
                            }
                        </td>
                    </tr>
                }
            }
            @if (HistVisivel.Count == 0)
            {
                <tr>
                    <td colspan="13" class="empty">
                        @if (_sales.Count == 0)
                        {
                            <text>Sem histórico de vendas AFM para este equipamento.</text>
                        }
                        else
                        {
                            <text>Nenhum registro corresponde a "@_histBusca".</text>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @* Partnumbers do BOM deste equipamento, sugeridos ao lançar uma venda. *@
    <datalist id="bom-pns">
        @foreach (var pn in _bom.Where(b => !string.IsNullOrWhiteSpace(b.PartNumber))
                                .Select(b => b.PartNumber).Distinct())
        {
            <option value="@pn" />
        }
    </datalist>

    @* Ventilador centrífugo continua com os dados construtivos (peso, dimensões,
       material). Todo outro tipo trabalha com a lista de materiais — o BOM. *@
    @if (EhVentiladorCentrifugo)
    {
        <div class="dash-title">Dados construtivos</div>
        <table class="grid">
            <thead><tr><th>Item</th><th class="right">Peso (kg)</th><th>Dimensões</th><th>Material</th><th>Parte do equipamento</th><th>Modelo</th></tr></thead>
            <tbody>
                @foreach (var c in _constr)
                {
                    <tr>
                        <td>@c.ItemName</td>
                        <td class="right">@(string.IsNullOrEmpty(c.WeightKg) ? "—" : c.WeightKg)</td>
                        <td>@(string.IsNullOrEmpty(c.Dimensions) ? "—" : c.Dimensions)</td>
                        <td>@(string.IsNullOrEmpty(c.Material) ? "—" : c.Material)</td>
                        <td>@c.EquipmentPart</td>
                        <td>@(string.IsNullOrEmpty(c.ItemModel) ? "—" : c.ItemModel)</td>
                    </tr>
                }
                @if (_constr.Count == 0) { <tr><td colspan="6" class="empty">Nenhum dado construtivo cadastrado.</td></tr> }
            </tbody>
        </table>
    }
    else
    {
        <div class="dash-title">Dados - BOM
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                lista de materiais de @(string.IsNullOrWhiteSpace(_e.Tipo) ? "equipamento" : _e.Tipo)
            </span>
        </div>
        <div class="toolbar tab-toolbar">
            <input class="cell busca-bom" placeholder="Buscar item, partnumber, descrição, material…"
                   @bind="_bomBusca" @bind:event="oninput" />
            @if (_bomBusca.Trim().Length > 0)
            {
                <span class="busca-info">
                    <strong>@BomVisivel.Count</strong> de @_bom.Count item(ns)
                    <button class="btn-link" @onclick='() => _bomBusca = ""'>limpar</button>
                </span>
            }
            <div style="flex:1"></div>
            <button class="btn-ghost" @onclick="BaixarBom">⬇ Baixar Excel</button>
            <label class="btn-ghost file-btn">
                ⬆ Subir planilha
                <InputFile OnChange="SubirBom" accept=".xlsx,.xlsm,.xls,.csv" />
            </label>
            <label class="chk-inline">
                <input type="checkbox" @bind="_bomSubstituir" /> substituir o BOM deste equipamento
            </label>
            <button class="btn-primary" @onclick="NovoItemBom">+ Adicionar item</button>
        </div>
        @if (_bomBusca.Trim().Length > 0)
        {
            <div class="busca-aviso">
                A busca só filtra o que aparece na tela — o <strong>Baixar Excel</strong> continua
                trazendo o BOM completo deste equipamento.
            </div>
        }
        @if (_bomMsg is not null)
        {
            <div class="@(_bomOk ? "side-ok" : "alert-error")" style="margin-bottom:10px">@_bomMsg</div>
        }
        <table class="grid">
            <thead>
                <tr>
                    <th>Item</th><th class="right">Quantidade</th><th>Partnumber</th><th>Peça nacionalizada</th>
                    <th>Descrição em inglês</th><th>Descrição em português</th><th>Material</th>
                    <th class="right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in BomVisivel)
                {
                    @if (_editBomId == b.Id)
                    {
                        <tr class="row-edit">
                            <td colspan="8">
                                <div class="form3 form-edit">
                                    <label>Item <input class="cell" @bind="_fb.Item" placeholder="ex.: 10" /></label>
                                    <label>Quantidade <input class="cell" @bind="_fb.Quantidade" placeholder="ex.: 2 ou 1 jogo" /></label>
                                    <label>Partnumber <input class="cell" @bind="_fb.PartNumber" /></label>
                                    <label>Descrição em inglês <input class="cell" @bind="_fb.DescricaoEn" /></label>
                                    <label>Descrição em português <input class="cell" @bind="_fb.DescricaoPt" /></label>
                                    <label>Material <input class="cell" @bind="_fb.Material" /></label>
                                </div>
                                <div class="toolbar" style="margin-top:10px">
                                    <button class="btn-primary" @onclick="SalvarBom">Salvar</button>
                                    <button class="btn-ghost" @onclick="CancelarBom">Cancelar</button>
                                    @if (_bomErro is not null) { <span class="alert-error" style="padding:6px 10px">@_bomErro</span> }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="nowrap">@Txt(b.Item)</td>
                            <td class="right">@Txt(b.Quantidade)</td>
                            <td class="nowrap">@Txt(b.PartNumber)</td>
                            <td>@SeloNacional(b.PartNumber)</td>
                            <td>@Txt(b.DescricaoEn)</td>
                            <td>@Txt(b.DescricaoPt)</td>
                            <td>@Txt(b.Material)</td>
                            <td class="right nowrap">
                                <button class="btn-link" @onclick="() => EditarBom(b)">editar</button>
                                @if (_confirmBomId == b.Id)
                                {
                                    <button class="btn-link" style="color:#b91c1c;font-weight:700" @onclick="() => ExcluirBom(b)">confirmar</button>
                                    <button class="btn-link" style="color:var(--muted)" @onclick="() => _confirmBomId = null">não</button>
                                }
                                else
                                {
                                    <button class="btn-link" style="color:#b91c1c" @onclick="() => _confirmBomId = b.Id">excluir</button>
                                }
                            </td>
                        </tr>
                    }
                }
                @if (BomVisivel.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="empty">
                            @if (_bom.Count == 0)
                            {
                                <text>Nenhum item de BOM cadastrado para este equipamento.</text>
                            }
                            else
                            {
                                <text>Nenhum item do BOM corresponde a "@_bomBusca".</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public string? Id { get; set; }
    private Equipment? _e;
    private List<Part> _parts = new();
    private List<InstalledBase> _base = new();
    private List<ConstructionItem> _constr = new();
    private List<BomItem> _bom = new();
    private List<SalesRecord> _sales = new();
    private HashSet<string> _nacionais = new();   // partnumbers nacionalizados (normalizados)
    private List<ClientUnit> _unidades = new();
    private List<Salesperson> _vendedores = new();
    private int _qtd, _pecasCriticas;
    private decimal _pot24;

    // --- estado das edições / importações ---------------------------------
    private string? _editBomId, _confirmBomId, _bomMsg, _bomErro;
    private string _bomBusca = "";
    private bool _bomOk, _bomSubstituir;
    private BomItem _fb = new();

    private string? _editVendaId, _confirmVendaId, _histMsg, _vendaErro;
    private string _histBusca = "";
    private bool _histOk, _histSubstituir;
    private SalesRecord _fv = new();
    private string _unidadeEscolhida = "";   // id da InstalledBase escolhida no formulário

    private string? _editRegraId, _confirmRegraId, _regraMsg, _regraErro;
    private Part _fp = new();

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Limpar o histórico é função de administrador.</summary>
    private bool _ehAdmin;
    private bool _limparAberto;
    private string _senhaLimpeza = "";
    private string? _limpezaErro;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _ehAdmin = (await AuthState).User.IsInRole("admin");
        Carregar();
    }

    private void Carregar()
    {
        _e = Equipamentos.All().FirstOrDefault(e => e.Id == Id);
        if (_e is null) return;
        // regras com partnumber primeiro; as antigas (só nome) ficam no fim, para revisar
        _parts = Pecas.All().Where(p => p.EquipmentId == _e.Id)
            .OrderBy(p => string.IsNullOrWhiteSpace(p.Codigo))
            .ThenBy(p => p.Codigo, StringComparer.OrdinalIgnoreCase)
            .ThenBy(p => p.Nome, StringComparer.OrdinalIgnoreCase).ToList();
        _base = Base.All().Where(b => b.EquipmentId == _e.Id)
            .OrderBy(b => Intel.ClienteDaUnidade(b.ClientUnitId), StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => Intel.UnitNome(b.ClientUnitId), StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => b.Tag, StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => b.SerialNo, StringComparer.OrdinalIgnoreCase).ToList();
        _constr = Construcao.ForEquip(_e.Id);
        _nacionais = Nacionais.PartNumbers();
        _bom = Bom.ForEquip(_e.Id)
            .OrderBy(b => OrdemItem(b.Item))
            .ThenBy(b => b.Item, StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => b.PartNumber, StringComparer.OrdinalIgnoreCase).ToList();
        _sales = Vendas.ForEquip(_e.Id).OrderByDescending(s => s.DataVenda).ToList();
        _unidades = Unidades.All().OrderBy(u => u.NomeUnidade, StringComparer.OrdinalIgnoreCase).ToList();
        _vendedores = Vendedores.All().Where(v => v.Ativo)
            .OrderBy(v => v.Nome, StringComparer.OrdinalIgnoreCase).ToList();
        _qtd = _base.Sum(b => b.Quantidade);
        _pecasCriticas = _parts.Count(p => p.Critica);
        _pot24 = Intel.OpenOpportunities()
            .Where(o => o.EquipmentId == _e.Id && o.DiasAteJanela <= 730)
            .Sum(o => o.ValorEstimado);
    }

    // =================== Partnumber → BOM ==================================
    // O partnumber é a chave da peça: a descrição vem sempre do BOM do
    // equipamento, nunca é digitada de novo em outro lugar.

    private string DescricaoBom(string? pn)
    {
        var alvo = IntelligenceService.NormPn(pn);
        if (alvo.Length == 0) return "";
        var item = _bom.FirstOrDefault(b => IntelligenceService.NormPn(b.PartNumber) == alvo);
        if (item is null) return "";
        return !string.IsNullOrWhiteSpace(item.DescricaoPt) ? item.DescricaoPt : item.DescricaoEn;
    }

    /// <summary>O partnumber está na lista de Nacionalização?</summary>
    private bool EhNacionalizada(string? pn) =>
        _nacionais.Contains(IntelligenceService.NormPn(pn));

    /// <summary>Selo Sim/Não da coluna "Peça nacionalizada" (texto fixo, sem dado do usuário).</summary>
    private MarkupString SeloNacional(string? pn) => new(
        string.IsNullOrWhiteSpace(pn) ? "<span style=\"color:var(--muted)\">—</span>"
        : EhNacionalizada(pn) ? "<span class=\"nac nac-sim\">Sim</span>"
        : "<span class=\"nac nac-nao\">Não</span>");

    private string DicaBom(string? pn)
    {
        if (string.IsNullOrWhiteSpace(pn)) return "escolha um partnumber do BOM";
        var d = DescricaoBom(pn);
        return d.Length > 0 ? d : "não está no BOM deste equipamento";
    }

    /// <summary>Vendas deste equipamento com o partnumber informado.</summary>
    private List<SalesRecord> ComprasDoPn(string? pn)
    {
        var alvo = IntelligenceService.NormPn(pn);
        if (alvo.Length == 0) return new List<SalesRecord>();
        return _sales.Where(v => IntelligenceService.NormPn(v.PartNumber) == alvo).ToList();
    }

    // =================== Regras técnicas de troca =========================

    /// <summary>Próxima compra prevista de um cliente (planta) para a peça.</summary>
    private record ProximaDoCliente(string ClientUnitId, string Data, int Dias);

    /// <summary>
    /// Uma linha da tabela de regras: a regra cadastrada (se houver) somada ao
    /// que o histórico mostra para o mesmo partnumber. Partnumber comprado sem
    /// regra também vira linha, com Regra = null.
    /// </summary>
    private record LinhaRegra(Part? Regra, string Pn, string Descricao, List<SalesRecord> Compras,
        int? MesesHistorico, int Intervalos, int? Meses, List<ProximaDoCliente> Proximas);

    /// <summary>
    /// Monta as linhas. Frequência: a do histórico (a partir de 2 compras do
    /// mesmo cliente) e, sem ela, a da regra. Próxima compra: para cada cliente
    /// que já comprou, a última compra dele + a frequência. Ordem: a linha em
    /// edição no topo; depois as próximas compras mais urgentes.
    /// </summary>
    private List<LinhaRegra> LinhasRegras
    {
        get
        {
            var linhas = new List<LinhaRegra>();
            var comRegra = new HashSet<string>();

            foreach (var p in _parts)
            {
                var pn = (p.Codigo ?? "").Trim();
                if (pn.Length > 0) comRegra.Add(IntelligenceService.NormPn(pn));
                var compras = ComprasDoPn(pn);
                var desc = DescricaoBom(pn) is { Length: > 0 } d ? d : p.Nome;
                linhas.Add(NovaLinha(p, pn, desc, compras));
            }

            foreach (var g in _sales.Where(v => !string.IsNullOrWhiteSpace(v.PartNumber))
                                    .GroupBy(v => IntelligenceService.NormPn(v.PartNumber))
                                    .Where(x => !comRegra.Contains(x.Key)))
            {
                var compras = g.ToList();
                var pn = compras[0].PartNumber.Trim();
                var desc = DescricaoBom(pn) is { Length: > 0 } d ? d : compras[0].ItemVendido;
                linhas.Add(NovaLinha(null, pn, desc, compras));
            }

            return linhas
                .OrderByDescending(l => l.Regra is not null && l.Regra.Id == _editRegraId)
                .ThenBy(l => l.Proximas.Count > 0 ? l.Proximas[0].Data : "9999")
                .ThenBy(l => l.Pn, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private LinhaRegra NovaLinha(Part? regra, string pn, string desc, List<SalesRecord> compras)
    {
        var (mh, intervalos) = IntelligenceService.FrequenciaDoHistorico(compras);
        int? meses = mh ?? (regra is not null && regra.CicloMeses > 0 ? regra.CicloMeses : null);

        var proximas = new List<ProximaDoCliente>();
        if (meses is int m)
        {
            foreach (var cliente in compras.GroupBy(v => v.ClientUnitId ?? ""))
            {
                var ultima = cliente.Max(v => v.DataVenda);
                var data = IntelligenceService.ProximaCompra(ultima, m);
                if (!DateTime.TryParse(data, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt)) continue;
                proximas.Add(new ProximaDoCliente(cliente.Key, data, (int)(dt.Date - DateTime.Today).TotalDays));
            }
        }
        return new LinhaRegra(regra, pn, desc, compras, mh, intervalos, meses,
            proximas.OrderBy(x => x.Data, StringComparer.Ordinal).ToList());
    }

    private static string ClasseProxima(int dias) =>
        dias < 0 ? "prox-atrasada" : dias <= 90 ? "prox-breve" : "prox-ok";

    private static string TextoProxima(int dias) => dias switch
    {
        < 0 => $"atrasada há {-dias} dia(s)",
        0 => "hoje",
        <= 90 => $"em {dias} dia(s)",
        _ => $"em ~{Math.Round(dias / 30.44)} meses",
    };

    private static decimal UltimoUnitario(List<SalesRecord> compras) =>
        compras.OrderByDescending(v => v.DataVenda, StringComparer.Ordinal).First().ValorUnitario;

    /// <summary>
    /// Abre uma regra já preenchida com o que o histórico mostra: frequência
    /// calculada e o último preço unitário. O usuário confere e salva.
    /// </summary>
    private void CriarRegraDoHistorico(LinhaRegra h)
    {
        _fp = new Part
        {
            Id = "pt-" + Guid.NewGuid().ToString("N")[..8],
            EquipmentId = _e!.Id, Ativo = true,
            Codigo = h.Pn,
            CicloMeses = h.MesesHistorico ?? 12,
            ValorEstimado = h.Compras.Count > 0 ? UltimoUnitario(h.Compras) : 0,
            Nome = h.Descricao,
        };
        _editRegraId = _fp.Id; _regraErro = null; _regraMsg = null;
        _parts.Insert(0, _fp);
    }

    private void NovaRegra()
    {
        _fp = new Part
        {
            Id = "pt-" + Guid.NewGuid().ToString("N")[..8],
            EquipmentId = _e!.Id, Ativo = true, CicloMeses = 12,
        };
        _editRegraId = _fp.Id; _regraErro = null; _regraMsg = null;
        _parts.Insert(0, _fp);
    }

    private void EditarRegra(Part p)
    {
        _editRegraId = p.Id; _regraErro = null; _regraMsg = null;
        _fp = new Part
        {
            Id = p.Id, EquipmentId = p.EquipmentId, Nome = p.Nome, CicloMeses = p.CicloMeses,
            Critica = p.Critica, Descritivo = p.Descritivo, Codigo = p.Codigo,
            ValorEstimado = p.ValorEstimado, VenderJunto = p.VenderJunto,
            PecaComplementar = p.PecaComplementar, Observacao = p.Observacao, Ativo = p.Ativo,
        };
    }

    /// <summary>Ponte texto ↔ bool para o select de criticidade da regra.</summary>
    private string CriticidadeRegra
    {
        get => _fp.Critica ? "critica" : "normal";
        set => _fp.Critica = value == "critica";
    }

    /// <summary>Ao escolher o partnumber, o nome da regra passa a ser a descrição do BOM.</summary>
    private void PnRegraMudou()
    {
        var d = DescricaoBom(_fp.Codigo);
        if (d.Length > 0) _fp.Nome = d;
    }

    private void SalvarRegra()
    {
        _fp.Codigo = (_fp.Codigo ?? "").Trim();
        if (_fp.Codigo.Length == 0) { _regraErro = "Informe o partnumber da peça."; return; }
        if (_fp.CicloMeses <= 0) { _regraErro = "Informe o ciclo de troca em meses."; return; }

        var alvo = IntelligenceService.NormPn(_fp.Codigo);
        if (_parts.Any(p => p.Id != _fp.Id && IntelligenceService.NormPn(p.Codigo) == alvo))
        {
            _regraErro = $"Já existe uma regra para o partnumber {_fp.Codigo} neste equipamento.";
            return;
        }

        var d = DescricaoBom(_fp.Codigo);
        if (d.Length > 0) _fp.Nome = d;
        else if (string.IsNullOrWhiteSpace(_fp.Nome)) _fp.Nome = _fp.Codigo;
        _fp.EquipmentId = _e!.Id;

        Pecas.Save(_fp);
        _editRegraId = null; _regraErro = null;
        _regraMsg = $"Regra do partnumber {_fp.Codigo} salva.";
        Intel.Invalidate();
        Carregar();
    }

    private void ExcluirRegra(Part p)
    {
        Pecas.Delete(p);
        _confirmRegraId = null; _editRegraId = null;
        _regraMsg = "Regra excluída.";
        Intel.Invalidate();
        Carregar();
    }

    private void CancelarRegra() { _editRegraId = null; _regraErro = null; Carregar(); }

    // =================== BOM ==============================================

    /// <summary>
    /// Itens do BOM exibidos. A linha em edição fica sempre visível, mesmo que
    /// não case com a busca — senão um item recém-criado sumiria da tela.
    /// </summary>
    private List<BomItem> BomVisivel
    {
        get
        {
            var s = _bomBusca.Trim();
            if (s.Length == 0) return _bom;
            var alvo = s.ToLowerInvariant();
            return _bom.Where(b => b.Id == _editBomId || string.Join(' ',
                    b.Item, b.Quantidade, b.PartNumber, b.DescricaoEn, b.DescricaoPt, b.Material)
                .ToLowerInvariant().Contains(alvo)).ToList();
        }
    }

    private void NovoItemBom()
    {
        _fb = new BomItem { Id = "bom-" + Guid.NewGuid().ToString("N")[..8], EquipmentId = _e!.Id };
        _editBomId = _fb.Id; _bomErro = null; _bomMsg = null;
        _bom.Insert(0, _fb);   // linha nova aparece no topo já em edição
    }

    private void EditarBom(BomItem b)
    {
        _editBomId = b.Id; _bomErro = null; _bomMsg = null;
        _fb = new BomItem
        {
            Id = b.Id, EquipmentId = b.EquipmentId, Item = b.Item, Quantidade = b.Quantidade,
            PartNumber = b.PartNumber, DescricaoEn = b.DescricaoEn, DescricaoPt = b.DescricaoPt,
            Material = b.Material,
        };
    }

    private void SalvarBom()
    {
        if (string.IsNullOrWhiteSpace(_fb.PartNumber) && string.IsNullOrWhiteSpace(_fb.Item)
            && string.IsNullOrWhiteSpace(_fb.DescricaoEn) && string.IsNullOrWhiteSpace(_fb.DescricaoPt))
        {
            _bomErro = "Preencha ao menos o item, o partnumber ou uma das descrições.";
            return;
        }
        _fb.EquipmentId = _e!.Id;
        Bom.Save(_fb);
        _editBomId = null; _bomErro = null;
        _bomMsg = "Item salvo."; _bomOk = true;
        Carregar();
    }

    private void ExcluirBom(BomItem b)
    {
        Bom.Delete(b);
        _confirmBomId = null; _editBomId = null;
        _bomMsg = "Item excluído."; _bomOk = true;
        Carregar();
    }

    private static readonly string[] BomHeader =
        { "item", "quantidade", "partnumber", "peca_nacionalizada", "descricao_em_ingles", "descricao_portugues", "material" };

    private async Task BaixarBom()
    {
        // a linha em branco de um item ainda não salvo não vai para a planilha
        var linhas = _bom
            .Where(b => !string.IsNullOrWhiteSpace(b.PartNumber) || !string.IsNullOrWhiteSpace(b.Item)
                     || !string.IsNullOrWhiteSpace(b.DescricaoEn) || !string.IsNullOrWhiteSpace(b.DescricaoPt))
            .Select(b => new[] { b.Item, b.Quantidade, b.PartNumber, SimNao(b.PartNumber), b.DescricaoEn, b.DescricaoPt, b.Material })
            .ToList();
        var bytes = Planilha.Xlsx("BOM", BomHeader, linhas);
        await Baixar($"BOM_{Arquivo(_e!)}.xlsx", bytes);
    }

    private async Task SubirBom(InputFileChangeEventArgs e)
    {
        var bytes = await LerArquivo(e);
        if (bytes is null) { _bomMsg = "Arquivo muito grande (limite de 25 MB)."; _bomOk = false; return; }
        var res = Importer.ImportBomDoEquipamento(_e!.Id, bytes, e.File.Name, _bomSubstituir);
        _bomMsg = res.Message; _bomOk = res.Ok;
        if (res.Ok) { _editBomId = null; Intel.Invalidate(); Carregar(); }
    }

    // =================== Histórico Aftermarket ============================

    /// <summary>
    /// Registros exibidos. O que está em edição fica sempre visível, mesmo fora
    /// da busca — senão um lançamento novo sumiria ao ser digitado.
    /// </summary>
    private List<SalesRecord> HistVisivel
    {
        get
        {
            var s = _histBusca.Trim();
            if (s.Length == 0) return _sales;
            var alvo = s.ToLowerInvariant();
            return _sales.Where(v => v.Id == _editVendaId || string.Join(' ',
                    Fmt.Date(v.DataVenda), v.Pedido, v.SerialNo, v.Tag, v.PartNumber,
                    DescricaoBom(v.PartNumber), v.ItemVendido, v.PrazoEntrega, v.Observacao,
                    Intel.ClienteDaUnidade(v.ClientUnitId), Intel.UnitNome(v.ClientUnitId))
                .ToLowerInvariant().Contains(alvo)).ToList();
        }
    }

    /// <summary>Texto do tipo de importação, usado na busca e na planilha.</summary>
    private static string RotuloImportacao(string tipo) => tipo switch
    {
        "total" => "Por total", "item" => "Por item", _ => "",
    };

    /// <summary>Valor total acompanha quantidade × unitário; o usuário pode ajustar depois.</summary>
    private void RecalcularTotal() => _fv.Valor = _fv.ValorUnitario * _fv.Quantidade;

    /// <summary>Texto da opção no seletor de equipamento instalado.</summary>
    private string RotuloUnidade(InstalledBase b)
    {
        var tag = string.IsNullOrWhiteSpace(b.Tag) ? "sem tag" : b.Tag;
        var serie = string.IsNullOrWhiteSpace(b.SerialNo) ? "sem serial" : b.SerialNo;
        return $"{tag} · {serie} — {Intel.ClienteDaUnidade(b.ClientUnitId)} / {Intel.UnitNome(b.ClientUnitId)}";
    }

    /// <summary>
    /// Escolher a unidade instalada preenche serial, TAG e a planta da venda —
    /// a planta não aparece como coluna, mas continua alimentando dashboards
    /// e a carteira por cliente.
    /// </summary>
    private void UnidadeEscolhida()
    {
        var b = _base.FirstOrDefault(x => x.Id == _unidadeEscolhida);
        if (b is null) return;
        _fv.SerialNo = b.SerialNo;
        _fv.Tag = b.Tag;
        _fv.ClientUnitId = b.ClientUnitId;
    }

    /// <summary>Unidade instalada que corresponde ao serial (ou, sem ele, à TAG).</summary>
    private InstalledBase? UnidadeDaVenda(SalesRecord v)
    {
        if (!string.IsNullOrWhiteSpace(v.SerialNo))
        {
            var porSerie = _base.FirstOrDefault(b =>
                string.Equals(b.SerialNo, v.SerialNo.Trim(), StringComparison.OrdinalIgnoreCase));
            if (porSerie is not null) return porSerie;
        }
        if (!string.IsNullOrWhiteSpace(v.Tag))
        {
            var porTag = _base.Where(b =>
                string.Equals(b.Tag, v.Tag.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
            // a mesma TAG pode existir em plantas diferentes: só usa se for única
            if (porTag.Count == 1) return porTag[0];
            var naPlanta = porTag.FirstOrDefault(b => b.ClientUnitId == v.ClientUnitId);
            if (naPlanta is not null) return naPlanta;
        }
        return null;
    }

    private void NovaVenda()
    {
        _fv = new SalesRecord
        {
            Id = "sl-" + Guid.NewGuid().ToString("N")[..8],
            EquipmentId = _e!.Id,
            DataVenda = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            Quantidade = 1,
            Origem = "Lançamento manual",
        };
        _unidadeEscolhida = "";
        _editVendaId = _fv.Id; _vendaErro = null; _histMsg = null;
        _sales.Insert(0, _fv);
    }

    private void EditarVenda(SalesRecord s)
    {
        _editVendaId = s.Id; _vendaErro = null; _histMsg = null;
        _fv = new SalesRecord
        {
            Id = s.Id, DataVenda = s.DataVenda, Pedido = s.Pedido, ClientUnitId = s.ClientUnitId,
            EquipmentId = s.EquipmentId, ItemVendido = s.ItemVendido, Quantidade = s.Quantidade,
            Valor = s.Valor, ValorUnitario = s.ValorUnitario, VendedorId = s.VendedorId,
            Origem = s.Origem, Tag = s.Tag, SerialNo = s.SerialNo,
            PartNumber = s.PartNumber, Observacao = s.Observacao,
            TipoImportacao = s.TipoImportacao, PrazoEntrega = s.PrazoEntrega,
        };
        _unidadeEscolhida = UnidadeDaVenda(_fv)?.Id ?? "";
    }

    private void SalvarVenda()
    {
        _fv.PartNumber = (_fv.PartNumber ?? "").Trim();
        if (string.IsNullOrWhiteSpace(_fv.DataVenda))
        {
            _vendaErro = "Informe a data da venda.";
            return;
        }
        if (_fv.PartNumber.Length == 0)
        {
            _vendaErro = "Informe o partnumber — é por ele que a venda entra no controle de recompra.";
            return;
        }

        // descrição sempre a do BOM; fora do BOM, mantém o que havia ou o próprio partnumber
        var desc = DescricaoBom(_fv.PartNumber);
        if (desc.Length > 0) _fv.ItemVendido = desc;
        else if (string.IsNullOrWhiteSpace(_fv.ItemVendido)) _fv.ItemVendido = _fv.PartNumber;

        // planta da venda: a da unidade instalada com esse serial / TAG
        var unidade = UnidadeDaVenda(_fv);
        if (unidade is not null) _fv.ClientUnitId = unidade.ClientUnitId;

        _fv.EquipmentId = _e!.Id;
        Vendas.Save(_fv);
        _editVendaId = null; _vendaErro = null;
        _histMsg = "Registro salvo."; _histOk = true;
        Intel.Invalidate();
        Carregar();
    }

    private void ExcluirVenda(SalesRecord s)
    {
        Vendas.Delete(s);
        _confirmVendaId = null; _editVendaId = null;
        _histMsg = "Registro excluído."; _histOk = true;
        Intel.Invalidate();
        Carregar();
    }

    // As colunas da tela primeiro; depois as que não aparecem na tabela mas
    // precisam voltar intactas quando a planilha for importada de novo.
    private static readonly string[] HistHeader =
        { "data_venda", "numero_de_venda", "modelo", "serial_number", "tag", "partnumber",
          "peca_nacionalizada", "descricao", "quantidade", "valor_unitario", "valor_total", "prazo_de_entrega",
          "observacao", "importacao", "unidade", "vendedor" };

    private async Task BaixarHistorico()
    {
        var linhas = _sales.Select(s => new[]
        {
            s.DataVenda,
            s.Pedido,
            _e!.Modelo,
            s.SerialNo,
            s.Tag,
            s.PartNumber,
            SimNao(s.PartNumber),
            DescricaoBom(s.PartNumber) is { Length: > 0 } d ? d : s.ItemVendido,
            s.Quantidade.ToString(CultureInfo.InvariantCulture),
            s.ValorUnitario.ToString("0.##", CultureInfo.InvariantCulture),
            s.Valor.ToString("0.##", CultureInfo.InvariantCulture),
            s.PrazoEntrega,
            s.Observacao,
            RotuloImportacao(s.TipoImportacao),
            Intel.UnitNome(s.ClientUnitId),
            Vendedor(s.VendedorId),
        }).ToList();
        var bytes = Planilha.Xlsx("Historico", HistHeader, linhas);
        await Baixar($"Historico_{Arquivo(_e!)}.xlsx", bytes);
    }

    private void AbrirLimpeza()
    {
        _limparAberto = true; _senhaLimpeza = ""; _limpezaErro = null; _histMsg = null;
    }

    private void FecharLimpeza()
    {
        _limparAberto = false; _senhaLimpeza = ""; _limpezaErro = null;
    }

    private void TeclaSenha(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") LimparHistorico();
    }

    /// <summary>
    /// Apaga o histórico deste equipamento. Exige perfil admin e a senha de
    /// limpeza (Admin:SenhaLimpeza no appsettings) — a checagem é feita aqui no
    /// servidor, não só escondendo o botão.
    /// </summary>
    private void LimparHistorico()
    {
        if (!_ehAdmin) { _limpezaErro = "Só o administrador pode limpar o histórico."; return; }
        var senha = Config["Admin:SenhaLimpeza"] ?? "howden2026";
        if (_senhaLimpeza != senha)
        {
            _limpezaErro = "Senha incorreta.";
            _senhaLimpeza = "";
            return;
        }

        var n = Vendas.DeleteByEquip(_e!.Id);
        FecharLimpeza();
        _editVendaId = null; _confirmVendaId = null; _histBusca = "";
        _histMsg = $"Histórico apagado: {n} registro(s) removido(s)."; _histOk = true;
        Intel.Invalidate();
        Carregar();
    }

    private async Task SubirHistorico(InputFileChangeEventArgs e)
    {
        var bytes = await LerArquivo(e);
        if (bytes is null) { _histMsg = "Arquivo muito grande (limite de 25 MB)."; _histOk = false; return; }
        var res = Importer.ImportHistoricoDoEquipamento(_e!.Id, bytes, e.File.Name, _histSubstituir);
        _histMsg = res.Message; _histOk = res.Ok;
        if (res.Ok) { _editVendaId = null; Intel.Invalidate(); Carregar(); }
    }

    // =================== utilidades =======================================

    /// <summary>
    /// Ponte entre o campo de data do formulário e o texto ISO gravado no Parquet:
    /// o &lt;input type="date"&gt; do Blazor só trabalha com DateOnly/DateTime.
    /// </summary>
    private DateOnly? DataDaVenda
    {
        get => DateOnly.TryParseExact(_fv.DataVenda, "yyyy-MM-dd",
            CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;
        set => _fv.DataVenda = value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
    }

    private void CancelarBom() { _editBomId = null; _bomErro = null; Carregar(); }
    private void CancelarVenda() { _editVendaId = null; _vendaErro = null; Carregar(); }

    /// <summary>Nome do vendedor para a planilha; se não achar, exporta o id —
    /// assim a planilha volta pelo import sem perder a ligação.</summary>
    private string Vendedor(string id)
    {
        if (string.IsNullOrWhiteSpace(id)) return "";
        var nome = Intel.SalespersonName(id);
        return nome == "—" ? id : nome;
    }

    private static async Task<byte[]?> LerArquivo(InputFileChangeEventArgs e)
    {
        const long limite = 25L * 1024 * 1024;
        if (e.File.Size > limite) return null;
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(limite).CopyToAsync(ms);
        return ms.ToArray();
    }

    private async Task Baixar(string nome, byte[] bytes) =>
        await JS.InvokeVoidAsync("appDownload", nome,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));

    /// <summary>Nome de arquivo seguro a partir do modelo do equipamento.</summary>
    private static string Arquivo(Equipment e)
    {
        var baseNome = string.IsNullOrWhiteSpace(e.Modelo) ? e.Nome : e.Modelo;
        var limpo = new string(baseNome.Select(c => char.IsLetterOrDigit(c) ? c : '_').ToArray());
        limpo = limpo.Trim('_');
        return limpo.Length == 0 ? "equipamento" : limpo;
    }

    /// <summary>
    /// Ventilador centrífugo é o único tipo que segue com os dados construtivos
    /// (peso, dimensões, material). Para os demais (VARIAX, axial, Air Pre Heater,
    /// soprador, exaustor…) a ficha mostra o BOM.
    /// </summary>
    private bool EhVentiladorCentrifugo
    {
        get
        {
            var t = SemAcento(_e?.Tipo ?? "");
            if (string.IsNullOrWhiteSpace(t)) t = SemAcento(_e?.Nome ?? "");
            return t.Contains("ventilador") && t.Contains("centrif");
        }
    }

    private static string SemAcento(string s)
    {
        var d = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(d.Length);
        foreach (var ch in d)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(ch) != UnicodeCategory.NonSpacingMark)
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

    /// <summary>Ordena o item do BOM pelo número (10, 20, 100) e não como texto.</summary>
    private static int OrdemItem(string item) =>
        int.TryParse(new string((item ?? "").Where(char.IsDigit).ToArray()), out var n) ? n : int.MaxValue;

    /// <summary>"Sim"/"Não" da peça nacionalizada para as planilhas exportadas.</summary>
    private string SimNao(string? pn) =>
        string.IsNullOrWhiteSpace(pn) ? "" : EhNacionalizada(pn) ? "Sim" : "Não";

    private static string Txt(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private static string Freq(int meses) =>
        $"{meses} meses (~{(meses / 12.0).ToString("0.0", CultureInfo.InvariantCulture)} anos)";

    private static string Cap(string s) => string.IsNullOrEmpty(s) ? "—" : char.ToUpperInvariant(s[0]) + s[1..];
    private static string CritClass(string c) => c.ToLowerInvariant() switch
    {
        "crítica" => "st-vencida", "alta" => "st-critica", "média" => "st-atencao", "baixa" => "st-ok", _ => "st-plan",
    };
}
