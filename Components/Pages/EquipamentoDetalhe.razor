@page "/equipamentos/{Id}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject EquipmentRepository Equipamentos
@inject PartRepository Pecas
@inject InstalledBaseRepository Base
@inject SalesRecordRepository Vendas
@inject ConstructionRepository Construcao
@inject IntelligenceService Intel

<PageTitle>Equipamento · AFM HSA</PageTitle>

@if (_e is null)
{
    <h1>Equipamento</h1>
    <div class="panel empty-state"><div class="empty-title">Equipamento não encontrado</div>
        <a class="btn-ghost" href="/clientes">Voltar</a></div>
}
else
{
    <div class="page-head">
        <div><h1>@_e.Nome</h1><p class="subtitle">Aplicação: @_e.Aplicacao</p></div>
        <div class="page-actions"><a class="btn-ghost" href="javascript:history.back()">Voltar</a></div>
    </div>

    <div class="kpis kpis-8">
        <div class="kpi"><div class="kpi-label">Segmento</div><div class="kpi-value" style="font-size:15px">@_e.Segmento</div></div>
        <div class="kpi"><div class="kpi-label">Fabricante</div><div class="kpi-value" style="font-size:12px">@_e.Fabricante</div></div>
        <div class="kpi"><div class="kpi-label">Qtd. instalada</div><div class="kpi-value">@_qtd</div></div>
        <div class="kpi k-venc"><div class="kpi-label">Peças críticas</div><div class="kpi-value">@_pecasCriticas</div></div>
        <div class="kpi k-ren"><div class="kpi-label">Valor completo</div><div class="kpi-value" style="font-size:14px">@Fmt.Brl0(_e.ValorCompleto)</div></div>
        <div class="kpi k-po"><div class="kpi-label">Valor potencial 24 meses</div><div class="kpi-value" style="font-size:14px">@Fmt.Brl0(_pot24)</div></div>
    </div>

    <div class="dash-title">Cliente / unidade onde está instalado</div>
    <table class="grid" style="margin-bottom:20px">
        <thead><tr><th>Cliente / Unidade</th><th class="right">Qtd</th><th>Ano</th><th>Status</th><th>Criticidade</th></tr></thead>
        <tbody>
            @foreach (var b in _base)
            {
                <tr>
                    <td>@Intel.ClienteDaUnidade(b.ClientUnitId) — @Intel.UnitNome(b.ClientUnitId)</td>
                    <td class="right">@b.Quantidade</td>
                    <td>@(b.AnoInstalacao > 0 ? b.AnoInstalacao.ToString() : "—")</td>
                    <td>@Cap(b.Status)</td>
                    <td><span class="badge @CritClass(b.Criticidade)">@Cap(b.Criticidade)</span></td>
                </tr>
            }
            @if (_base.Count == 0) { <tr><td colspan="5" class="empty">Não instalado.</td></tr> }
        </tbody>
    </table>

    <div class="dash-title">Regras técnicas de troca (peças e ciclos)</div>
    <table class="grid" style="margin-bottom:20px">
        <thead><tr><th>Item / Conjunto</th><th>Frequência de troca</th><th>Origem</th><th class="right">Valor estimado</th><th>Criticidade</th></tr></thead>
        <tbody>
            @foreach (var p in _parts)
            {
                <tr>
                    <td>@p.Nome</td>
                    <td class="nowrap">@Freq(p.CicloMeses)</td>
                    <td><span class="badge st-ok">@Origem(p.Nome)</span></td>
                    <td class="right nowrap">@(p.ValorEstimado > 0 ? Fmt.Brl0(p.ValorEstimado) : "—")</td>
                    <td><span class="badge @(p.Critica ? "st-vencida" : "st-plan")">@(p.Critica ? "Crítica" : "Normal")</span></td>
                </tr>
            }
            @if (_parts.Count == 0) { <tr><td colspan="5" class="empty">Sem peças cadastradas.</td></tr> }
        </tbody>
    </table>

    <div class="dash-title">Dados construtivos</div>
    <table class="grid">
        <thead><tr><th>Item</th><th class="right">Peso (kg)</th><th>Dimensões</th><th>Material</th><th>Parte do equipamento</th><th>Modelo</th></tr></thead>
        <tbody>
            @foreach (var c in _constr)
            {
                <tr>
                    <td>@c.ItemName</td>
                    <td class="right">@(string.IsNullOrEmpty(c.WeightKg) ? "—" : c.WeightKg)</td>
                    <td>@(string.IsNullOrEmpty(c.Dimensions) ? "—" : c.Dimensions)</td>
                    <td>@(string.IsNullOrEmpty(c.Material) ? "—" : c.Material)</td>
                    <td>@c.EquipmentPart</td>
                    <td>@(string.IsNullOrEmpty(c.ItemModel) ? "—" : c.ItemModel)</td>
                </tr>
            }
            @if (_constr.Count == 0) { <tr><td colspan="6" class="empty">Nenhum dado construtivo cadastrado.</td></tr> }
        </tbody>
    </table>
}

@code {
    [Parameter] public string? Id { get; set; }
    private Equipment? _e;
    private List<Part> _parts = new();
    private List<InstalledBase> _base = new();
    private List<ConstructionItem> _constr = new();
    private List<SalesRecord> _sales = new();
    private int _qtd, _pecasCriticas;
    private decimal _pot24;

    protected override void OnInitialized()
    {
        _e = Equipamentos.All().FirstOrDefault(e => e.Id == Id);
        if (_e is null) return;
        _parts = Pecas.All().Where(p => p.EquipmentId == _e.Id).OrderBy(p => p.Nome).ToList();
        _base = Base.All().Where(b => b.EquipmentId == _e.Id).ToList();
        _constr = Construcao.ForEquip(_e.Id);
        _sales = Vendas.All().Where(s => s.EquipmentId == _e.Id).ToList();
        _qtd = _base.Sum(b => b.Quantidade);
        _pecasCriticas = _parts.Count(p => p.Critica);
        _pot24 = Intel.OpenOpportunities()
            .Where(o => o.EquipmentId == _e.Id && o.DiasAteJanela <= 730)
            .Sum(o => o.ValorEstimado);
    }

    private static string Freq(int meses) =>
        $"{meses} meses (~{(meses / 12.0).ToString("0.0", CultureInfo.InvariantCulture)} anos)";

    private string Origem(string parte)
    {
        var pn = parte.ToLowerInvariant();
        var n = _sales.Count(s => { var it = s.ItemVendido.ToLowerInvariant(); return it.Contains(pn) || pn.Contains(it); });
        return n > 0 ? $"Histórico ({n} compras)" : "Regra técnica";
    }

    private static string Cap(string s) => string.IsNullOrEmpty(s) ? "—" : char.ToUpperInvariant(s[0]) + s[1..];
    private static string CritClass(string c) => c.ToLowerInvariant() switch
    {
        "crítica" => "st-vencida", "alta" => "st-critica", "média" => "st-atencao", "baixa" => "st-ok", _ => "st-plan",
    };
}
