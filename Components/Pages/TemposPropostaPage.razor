@page "/tempos-proposta"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject TempoRepository Tempos
@inject RelatorioSemanalRepository RelatorioRepo
@inject RelatorioSemanalService RelatorioServico
@inject OutlookLocal Outlook
@inject ParquetStore Store
@inject IWebHostEnvironment Ambiente
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS

<PageTitle>Tempo das propostas · AFM HSA</PageTitle>

<div class="page-head">
    <div>
        <h1>Tempo das propostas</h1>
        <p class="subtitle">
            Medido pela própria Gerar Proposta (o cronômetro da barra de etapas): tempo de trabalho até o primeiro Word
            de cada número e revisão — pausas de mais de 3 minutos não contam. A meta é metade do tempo de antes.
        </p>
    </div>
    <div class="page-actions">
        <button class="btn-ghost" disabled="@_gerando" @onclick="BaixarRelatorio">@(_gerando ? "Gerando…" : "📄 Gerar relatório")</button>
        @if (_podeConfigurar)
        {
            <button class="btn-primary" disabled="@_gerando" title="Abre o e-mail do relatório desta semana no Outlook, pronto para enviar" @onclick="AbrirEmail">✉ E-mail do relatório</button>
        }
    </div>
</div>

@if (_msg is not null) { <div class="@(_msgOk ? "alert-ok" : "alert-error")" style="margin-bottom:12px">@_msg</div> }

@{
    var medidas = _primeiras.Where(t => _origem == "" || t.Origem == _origem).ToList();
    var mediana = TempoRepository.Mediana(medidas.Select(t => (double)t.SegundosAtivos));
    var ultimos30 = medidas.Where(t => t.FimComoData is { } d && d >= DateTime.Now.AddDays(-30)).ToList();
    var mediana30 = TempoRepository.Mediana(ultimos30.Select(t => (double)t.SegundosAtivos));
    var metaSeg = _referencia * 60 * (double)TempoRepository.Meta;
}

<div class="toolbar" style="margin-bottom:14px; gap:10px; flex-wrap:wrap">
    <label class="nota">Origem
        <select class="cell" @bind="_origem">
            <option value="">todas</option>
            <option value="nova">nova (do zero)</option>
            <option value="copia">copiada de outra</option>
            <option value="revisao">nova revisão</option>
            <option value="aberta">aberta para corrigir</option>
        </select>
    </label>
    <span class="nota">A meta vale para a proposta <strong>nova</strong>: cópia e revisão são mais rápidas e puxam a mediana para baixo.</span>
</div>

<div class="kpis" style="margin-bottom:16px">
    <div class="kpi">
        <div class="kpi-label">Propostas medidas</div>
        <div class="kpi-value">@medidas.Count</div>
        <div class="kpi-sub">primeiro Word de cada número e revisão</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Mediana</div>
        <div class="kpi-value">@(medidas.Count > 0 ? Minutos(mediana) : "—")</div>
        <div class="kpi-sub">metade das propostas leva menos que isso</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Últimos 30 dias</div>
        <div class="kpi-value">@(ultimos30.Count > 0 ? Minutos(mediana30) : "—")</div>
        <div class="kpi-sub">mediana de @ultimos30.Count proposta(s)</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Meta (50% de antes)</div>
        <div class="kpi-value">@(_referencia > 0 ? Minutos(metaSeg) : "—")</div>
        <div class="kpi-sub">
            @if (_referencia <= 0)
            {
                <span>informe o tempo de antes, abaixo</span>
            }
            else if (medidas.Count < MinimoParaComparar)
            {
                <span>poucos dados: @medidas.Count de @MinimoParaComparar propostas</span>
            }
            else if (mediana <= metaSeg)
            {
                <span style="color:#166534;font-weight:600">atingida: @Reducao(mediana) menos que antes</span>
            }
            else
            {
                <span style="color:#92400e;font-weight:600">faltam @Minutos(mediana - metaSeg) · hoje @Reducao(mediana) menos</span>
            }
        </div>
    </div>
</div>

@if (_podeConfigurar)
{
    <div class="panel rs-painel" style="margin-bottom:16px">
        <div class="dash-title">Relatório semanal por e-mail <span class="dash-sub">sai toda sexta-feira, a partir da hora escolhida, pelo Outlook do computador em que o sistema estiver aberto</span></div>
        <div class="rs-grade">
            <label class="rs-campo">Para <small>separe com ;</small>
                <input class="cell" value="@_cfg.Para" placeholder="e-mail da Thais; e-mail do Rafael" @onchange='e => _cfg.Para = e.Value?.ToString() ?? ""' />
            </label>
            <label class="rs-campo">Cópia
                <input class="cell" value="@_cfg.Cc" @onchange='e => _cfg.Cc = e.Value?.ToString() ?? ""' />
            </label>
            <label class="rs-campo rs-hora">Sexta, a partir das
                <select class="cell" value="@_cfg.Hora" @onchange="e => _cfg.Hora = int.TryParse(e.Value?.ToString(), out var h) ? h : 16">
                    @for (var h = 6; h <= 20; h++) { <option value="@h">@h:00</option> }
                </select>
            </label>
            <label class="rs-check"><input type="checkbox" checked="@_cfg.Ativo" @onchange="e => _cfg.Ativo = e.Value is true" /> envio automático ligado</label>
            <button class="btn-primary" @onclick="SalvarConfig">Salvar</button>
        </div>
        <p class="nota" style="margin:8px 0 0">
            @if (_envios.FirstOrDefault() is { } ult)
            {
                <span>Último envio: semana da sexta @Fmt.Date(ult.Semana) · @ult.EnviadoEm @(ult.Por.Length > 0 ? $"({ult.Por})" : "") · @(ult.Ok ? "✓ enviado para " + ult.Para : "✕ " + ult.Resultado)</span>
            }
            else
            {
                <span>Nenhum envio ainda.</span>
            }
            @if (!Outlook.Disponivel)
            {
                <span> · Este computador não envia (o sistema não está rodando nele com o Outlook): o envio sai de um computador onde o sistema esteja aberto na sexta.</span>
            }
        </p>
    </div>
}

<div class="panel" style="margin-bottom:16px">
    <div class="dash-title">Tempo de antes <span class="dash-sub">a tela antiga não era medida: informe quanto uma proposta nova levava</span></div>
    <div class="toolbar" style="gap:10px; margin:0">
        <input class="cell num" style="width:110px" type="number" min="0" step="1" placeholder="minutos" @bind="_referenciaDigitada" />
        <span class="nota">minutos por proposta nova</span>
        <button class="btn-primary" @onclick="SalvarReferencia">Salvar</button>
        @if (_salvo) { <span class="saved-flag">salvo</span> }
    </div>
</div>

<div class="panel" style="margin-bottom:16px">
    <div class="dash-title">Onde a proposta demora <span class="dash-sub">mediana do tempo em cada etapa</span></div>
    @if (medidas.Count == 0)
    {
        <div class="empty" style="padding:8px 0">Nenhuma proposta medida ainda: o tempo é gravado quando a Gerar Proposta gera o Word.</div>
    }
    else
    {
        var porEtapa = Etapas.Select(e => (e.Numero, e.Nome, Mediana: TempoRepository.Mediana(medidas.Select(t => (double)t.PorEtapaComoMapa.GetValueOrDefault(e.Numero.ToString(CultureInfo.InvariantCulture)))))).ToList();
        var soma = porEtapa.Sum(x => x.Mediana);
        <table class="grid">
            <thead><tr><th>Etapa</th><th class="right">Mediana</th><th style="width:45%">Parte do tempo</th></tr></thead>
            <tbody>
                @foreach (var (numero, nome, med) in porEtapa)
                {
                    var parte = soma > 0 ? med / soma : 0;
                    <tr>
                        <td>@numero · @nome</td>
                        <td class="right nowrap">@Segundos(med)</td>
                        <td><div class="barra-tempo"><span style="width:@((parte * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></span></div></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="panel">
    <div class="dash-title">Medições <span class="dash-sub">@medidas.Count proposta(s)@(_adm ? " · marque as de teste para excluir" : "")</span></div>
    @if (_adm && _marcadas.Count > 0)
    {
        <div class="excluir-barra" style="margin-bottom:10px">
            @if (!_confirmar)
            {
                <span><strong>@_marcadas.Count</strong> medição(ões) selecionada(s)</span>
                <button class="btn-ghost perigo" @onclick="() => _confirmar = true">🗑 Excluir selecionadas</button>
                <button class="btn-link" @onclick="() => _marcadas.Clear()">desmarcar</button>
            }
            else
            {
                <span class="custo-indisp">Excluir as medições de @string.Join(", ", _marcadas.Take(5).Select(k => $"{k.Numero} rev {k.Revisao}"))@(_marcadas.Count > 5 ? "…" : "")?
                    Todas as gerações do Word desses números e revisões saem das contas. A proposta em si não é apagada.</span>
                <button class="btn-primary perigo" @onclick="ExcluirMarcadas">Sim, excluir</button>
                <button class="btn-link" @onclick="() => _confirmar = false">cancelar</button>
            }
        </div>
    }
    <div class="tabela-rolante" style="max-height:520px">
        <table class="grid">
            <thead><tr>
                @if (_adm) { <th style="width:28px"><input type="checkbox" title="Selecionar todas" checked="@(medidas.Count > 0 && medidas.All(t => _marcadas.Contains(Chave(t))))" @onchange="e => MarcarTodas(medidas, e)" /></th> }
                <th>Quando</th><th>Proposta</th><th>Quem</th><th>Origem</th><th class="right">Itens</th><th class="right">Tempo</th><th class="right">Interações</th><th>Por etapa</th>
                @if (_adm) { <th></th> }
            </tr></thead>
            <tbody>
                @foreach (var t in medidas)
                {
                    var chave = Chave(t);
                    <tr class="@(_marcadas.Contains(chave) ? "linha-marcada" : "")">
                        @if (_adm) { <td><input type="checkbox" checked="@_marcadas.Contains(chave)" @onchange="e => Marcar(chave, e)" /></td> }
                        <td class="nowrap">@(t.FimComoData?.ToString("dd/MM/yyyy HH:mm") ?? t.Fim)</td>
                        <td class="nowrap">@t.Numero rev @t.Revisao</td>
                        <td>@t.Usuario</td>
                        <td>@t.Origem</td>
                        <td class="right">@t.Itens</td>
                        <td class="right nowrap"><strong>@Minutos(t.SegundosAtivos)</strong></td>
                        <td class="right">@t.Interacoes</td>
                        <td class="nota">@string.Join(" · ", t.PorEtapaComoMapa.OrderBy(p => p.Key).Select(p => $"{p.Key}: {Segundos(p.Value)}"))</td>
                        @if (_adm) { <td><button class="btn-link perigo" title="Excluir esta medição (teste)" @onclick="() => ExcluirUma(chave)">excluir</button></td> }
                    </tr>
                }
                @if (medidas.Count == 0)
                {
                    <tr><td colspan="@(_adm ? 10 : 8)" class="empty">Nenhuma medição.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private static readonly (int Numero, string Nome)[] Etapas =
        { (1, "Começar"), (2, "Cliente e condições"), (3, "Itens"), (4, "Preço"), (5, "Documentos") };

    /// <summary>Abaixo disto a mediana ainda é sorte: a tela diz "poucos dados".</summary>
    private const int MinimoParaComparar = 5;

    private List<TempoProposta> _primeiras = new();
    private int _referencia;
    private int? _referenciaDigitada;
    private string _origem = "nova";
    private bool _salvo;

    private bool _adm, _podeConfigurar, _confirmar, _gerando, _msgOk;
    private string? _msg;
    private readonly HashSet<(string Numero, string Revisao)> _marcadas = new();
    private ConfigDoRelatorioSemanal _cfg = new();
    private List<EnvioDoRelatorio> _envios = new();

    private static (string Numero, string Revisao) Chave(TempoProposta t) => (t.Numero, t.Revisao.Trim());

    private void Marcar((string, string) chave, ChangeEventArgs e)
    {
        if (e.Value is true) _marcadas.Add(chave); else _marcadas.Remove(chave);
        _confirmar = false;
    }

    private void MarcarTodas(List<TempoProposta> medidas, ChangeEventArgs e)
    {
        _marcadas.Clear();
        if (e.Value is true) foreach (var t in medidas) _marcadas.Add(Chave(t));
        _confirmar = false;
    }

    private void ExcluirMarcadas()
    {
        var n = Tempos.Excluir(_marcadas);
        _msgOk = true;
        _msg = $"{_marcadas.Count} medição(ões) excluída(s) ({n} registro(s) de Word gerado).";
        _marcadas.Clear();
        _confirmar = false;
        _primeiras = TempoRepository.PrimeiraDeCada(Tempos.Todos());
    }

    private void ExcluirUma((string Numero, string Revisao) chave)
    {
        _marcadas.Clear();
        _marcadas.Add(chave);
        _confirmar = true;
    }

    private void SalvarConfig()
    {
        RelatorioRepo.GravarConfig(_cfg);
        _msgOk = true;
        _msg = _cfg.Ativo && _cfg.Para.Trim().Length > 0
            ? $"Relatório semanal: sai toda sexta a partir das {_cfg.Hora}:00 para {_cfg.Para}."
            : "Configuração salva. O envio automático está desligado (ou sem destinatário).";
    }

    private string Modelo => Path.Combine(Ambiente.ContentRootPath, PropostaWord.CaminhoDoModelo);

    private async Task BaixarRelatorio()
    {
        _gerando = true; _msg = null;
        StateHasChanged();
        try
        {
            var (_, _, anexo) = await Task.Run(() => RelatorioSemanal.Gerar(Store, Modelo, DateTime.Now));
            await JS.InvokeVoidAsync("appDownload", anexo.Nome, anexo.TipoMime, Convert.ToBase64String(anexo.Conteudo));
            if (!anexo.Nome.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            { _msgOk = true; _msg = "Relatório gerado em Word: para o PDF, o computador precisa do Microsoft Word ou do LibreOffice."; }
        }
        catch (Exception ex) { _msgOk = false; _msg = "Não deu para gerar o relatório: " + ex.Message; }
        finally { _gerando = false; }
    }

    /// <summary>O e-mail desta semana aberto no Outlook (com o PDF anexo), para enviar na hora.</summary>
    private async Task AbrirEmail()
    {
        _gerando = true; _msg = null;
        StateHasChanged();
        try
        {
            var (_, email, anexo) = await Task.Run(() => RelatorioSemanal.Gerar(Store, Modelo, DateTime.Now));
            if (email.Para.Trim().Length == 0) { _msgOk = false; _msg = "Informe os destinatários do relatório (Para) e salve."; return; }
            var erro = Outlook.Abrir(email, new[] { anexo });
            if (erro is null) { _msgOk = true; _msg = "E-mail do relatório aberto no Outlook."; }
            else
            {
                await JS.InvokeVoidAsync("appDownload", "relatorio-semanal.eml", "message/rfc822", Convert.ToBase64String(EmailsDaProposta.Eml(email, new[] { anexo })));
                _msgOk = true; _msg = "O Outlook não abriu daqui: baixei o e-mail (.eml) com o relatório anexo.";
            }
        }
        catch (Exception ex) { _msgOk = false; _msg = "Não deu para gerar o relatório: " + ex.Message; }
        finally { _gerando = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        var u = (await Auth.GetAuthenticationStateAsync()).User;
        _adm = Acessos.EhAdm(u);
        var perfil = Acessos.NormalizarPerfil(u.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value);
        _podeConfigurar = perfil is Acessos.Adm or Acessos.Gestao;
        _cfg = RelatorioRepo.Config();
        _envios = RelatorioRepo.Envios();
        _primeiras = TempoRepository.PrimeiraDeCada(Tempos.Todos());
        _referencia = Tempos.MinutosDeReferencia();
        _referenciaDigitada = _referencia > 0 ? _referencia : null;
    }

    private void SalvarReferencia()
    {
        _referencia = Math.Max(0, _referenciaDigitada ?? 0);
        Tempos.SalvarReferencia(_referencia);
        _salvo = true;
    }

    private string Reducao(double medianaSeg) =>
        _referencia <= 0 ? "" : (1 - medianaSeg / (_referencia * 60.0)).ToString("P0", new CultureInfo("pt-BR"));

    private static string Minutos(double segundos)
    {
        var m = (int)Math.Round(segundos / 60);
        return m < 1 ? "< 1 min" : m >= 60 ? $"{m / 60} h {m % 60:D2} min" : $"{m} min";
    }

    private static string Segundos(double s)
    {
        var t = TimeSpan.FromSeconds(Math.Round(s));
        return t.TotalMinutes >= 1 ? $"{(int)t.TotalMinutes} min {t.Seconds:D2} s" : $"{t.Seconds} s";
    }
}
