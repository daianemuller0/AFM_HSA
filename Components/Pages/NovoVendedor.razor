@page "/vendedores/novo"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SalespersonRepository Salespeople
@inject SegmentRepository Segmentos
@inject NavigationManager Nav

<PageTitle>Novo Vendedor · AFM HSA</PageTitle>

<div class="page-head">
    <div><h1>Novo Vendedor</h1><p class="subtitle">Cadastrar membro da equipe comercial.</p></div>
    <div class="page-actions"><a class="btn-ghost" href="/dados-marca">← Dados e Importação</a></div>
</div>

<div class="panel" style="max-width:640px">
    <div class="form-grid">
        <label>Nome * <input @bind="_v.Nome" /></label>
        <label>Segmentos de atuação *
            <div class="panel" style="padding:10px 12px;display:flex;flex-wrap:wrap;gap:10px 18px">
                @foreach (var g in _segs)
                {
                    <label style="flex-direction:row;align-items:center;gap:6px;font-weight:500;color:var(--text)">
                        <input type="checkbox" checked="@_sel.Contains(g.Nome)"
                               @onchange="e => Alternar(g.Nome, e.Value is bool b && b)" />
                        @g.Nome
                    </label>
                }
                @if (_segs.Count == 0)
                {
                    <span style="font-size:12.5px;color:var(--muted)">Nenhum segmento cadastrado.</span>
                }
            </div>
        </label>
        <label>E-mail <input @bind="_v.Email" /></label>
        <label>Telefone <input @bind="_v.Telefone" /></label>
        <label>Cargo <input @bind="_v.Cargo" /></label>
        <label>Perfil
            <select @bind="_v.Perfil">
                <option value="vendedor">Vendedor</option>
                <option value="gestor">Gestor</option>
                <option value="diretor">Diretor</option>
                <option value="tecnico">Técnico</option>
                <option value="admin">Administrador</option>
            </select>
        </label>
    </div>
    @if (_segs.Count == 0)
    {
        <div class="alert-warn" style="margin-top:12px">
            Nenhum segmento cadastrado ainda. Cadastre os segmentos na aba
            <strong>Segmentos</strong> de Dados e Importação antes de criar o vendedor.
        </div>
    }
    @if (_erro is not null) { <div class="alert-error" style="margin-top:12px">@_erro</div> }
    <div class="modal-actions">
        <a class="btn-ghost" href="/dados-marca">Cancelar</a>
        <button class="btn-primary" @onclick="Salvar">Salvar</button>
    </div>
</div>

@code {
    private Salesperson _v = new() { Perfil = "vendedor", Ativo = true, Cargo = "Vendedor" };
    private List<Segment> _segs = new();
    private readonly HashSet<string> _sel = new(StringComparer.OrdinalIgnoreCase);
    private string? _erro;

    protected override void OnInitialized() => _segs = Segmentos.All();

    private void Alternar(string nome, bool marcado)
    {
        if (marcado) _sel.Add(nome);
        else _sel.Remove(nome);
    }

    private void Salvar()
    {
        if (string.IsNullOrWhiteSpace(_v.Nome)) { _erro = "Informe o nome."; return; }
        if (_sel.Count == 0) { _erro = "Marque pelo menos um segmento de atuação."; return; }
        _v.Id = "sp-" + Guid.NewGuid().ToString("N")[..10];
        _v.Ativo = true;
        _v.Segmentos = _sel.ToList();
        Salespeople.Save(_v);
        Nav.NavigateTo("/dados-marca");
    }
}
