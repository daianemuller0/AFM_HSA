@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject BrandingRepository Brand

<div class="login-wrap">
    <div class="login-card">
        @if (!string.IsNullOrEmpty(_logo))
        {
            <div class="brand center"><img src="@_logo" style="max-height:64px;max-width:260px" alt="logo" /></div>
        }
        else
        {
            <div class="brand center">
                <div class="brand-mark big">H</div>
                <div>
                    <div class="brand-name">Howden</div>
                    <div class="brand-sub">Aftermarket · AFM HSA</div>
                </div>
            </div>
        }

        <h1 class="login-title">Entrar</h1>

        @if (Error)
        {
            <div class="alert-error">Usuário ou senha inválidos.</div>
        }

        <form method="post" action="/auth/login" class="login-form">
            <label>
                E-mail
                <input type="text" name="usuario" autocomplete="username" required />
            </label>
            <label>
                Senha
                <input type="password" name="senha" autocomplete="current-password" required />
            </label>
            <button type="submit" class="btn-primary">Entrar</button>
        </form>

        <div class="login-hint">
            Entre com seu e-mail e senha. Ex.: <b>admin@howden.com</b> / admin123<br />
            Login geral da equipe: howden / howden2026
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorFlag { get; set; }

    private bool Error => ErrorFlag == "1";

    private string _logo = "";
    protected override void OnInitialized() => _logo = Brand.Get().LogoLogin;
}
