@page "/dados-marca"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject SalespersonRepository Salespeople
@inject SegmentRepository Segmentos
@inject ClientUnitRepository Units
@inject IntelligenceService Intel
@inject ImportService Importer
@inject BrandingRepository Brand
@inject IJSRuntime JS

<PageTitle>Dados e Importação · AFM HSA</PageTitle>

<h1>Dados e Importação</h1>
<p class="subtitle">Segmentos, equipe comercial, importação de dados e logo / marca em um só lugar.</p>

<div class="views">
    <button class="view @(_tab == "segmentos" ? "active" : "")" @onclick='() => _tab = "segmentos"'>Segmentos</button>
    <button class="view @(_tab == "equipe" ? "active" : "")" @onclick='() => _tab = "equipe"'>Equipe Comercial</button>
    <button class="view @(_tab == "import" ? "active" : "")" @onclick='() => _tab = "import"'>Importação de Dados</button>
    <button class="view @(_tab == "logo" ? "active" : "")" @onclick='() => _tab = "logo"'>Logo / Marca</button>
</div>

@if (_tab == "segmentos")
{
    <p class="subtitle">O segmento é o eixo da divisão comercial: cada vendedor atua num segmento, e a planta puxa o vendedor pelo segmento dela.</p>

    <div class="panel" style="margin-bottom:16px;max-width:680px">
        <div class="dash-title">Cadastrar segmento</div>
        <div class="toolbar" style="margin-bottom:0">
            <input class="cell" style="max-width:320px" placeholder="Ex.: Cimento, Mineração, Siderurgia…"
                   @bind="_novoSegmento" @bind:event="oninput" />
            <button class="btn-primary" @onclick="AdicionarSegmento">+ Adicionar</button>
        </div>
        @if (_segErro is not null) { <div class="alert-error" style="margin-top:12px">@_segErro</div> }
        @if (_segMsg is not null) { <div class="side-ok" style="margin-top:12px">@_segMsg</div> }
    </div>

    <table class="grid">
        <thead><tr><th>Segmento</th><th>Vendedor(es) responsável(is)</th>
            <th class="right">Plantas</th><th style="width:120px">Ações</th></tr></thead>
        <tbody>
            @foreach (var g in _segs)
            {
                <tr>
                    <td><strong>@g.Nome</strong></td>
                    <td>@VendedoresDoSegmento(g.Nome)</td>
                    <td class="right">@PlantasDoSegmento(g.Nome)</td>
                    <td class="nowrap">
                        @if (_segConfirmar == g.Id)
                        {
                            <button class="btn-link" style="color:#b91c1c;font-weight:600"
                                    @onclick="() => ExcluirSegmento(g)">excluir?</button>
                            <button class="btn-link" style="color:var(--muted)"
                                    @onclick="() => _segConfirmar = null">não</button>
                        }
                        else
                        {
                            <button class="btn-link" style="color:#b91c1c"
                                    @onclick="() => _segConfirmar = g.Id">excluir</button>
                        }
                    </td>
                </tr>
            }
            @if (_segs.Count == 0)
            {
                <tr><td colspan="4" class="empty">Nenhum segmento cadastrado. Adicione o primeiro acima.</td></tr>
            }
        </tbody>
    </table>

    @if (_segConfirmar is not null)
    {
        <div class="alert-warn">
            Excluir o segmento <strong>não</strong> altera os vendedores nem as plantas que já usam esse nome —
            ele apenas deixa de aparecer nas listas de seleção.
        </div>
    }
}
else if (_tab == "equipe")
{
    <p class="subtitle">@_sps.Count(s => s.Ativo) ativos · @_sps.Count(s => !s.Ativo) inativos · @_sps.Count no total</p>
    <div class="toolbar">
        <a class="btn-primary" href="/vendedores/novo">+ Cadastrar vendedor</a>
        <select class="cell" style="max-width:160px" @bind="_filtro">
            <option value="ativos">Ativos</option><option value="inativos">Inativos</option><option value="todos">Todos</option>
        </select>
    </div>
    <div style="overflow-x:auto">
    <table class="grid">
        <thead><tr><th>Vendedor</th><th>Cargo</th><th>Segmento</th><th class="right">Clientes</th>
            <th class="right">Oport. abertas</th><th class="right">Valor potencial</th><th>Telefone</th><th>Ações</th></tr></thead>
        <tbody>
            @foreach (var v in EquipeFiltrada)
            {
                <tr>
                    <td><a class="btn-link" href="@($"/vendedores/{v.Id}")">@v.Nome</a>@(v.Ativo ? "" : " (inativo)")</td>
                    <td>@v.Cargo</td>
                    <td>@(string.IsNullOrWhiteSpace(v.Segmento) ? "—" : v.Segmento)</td>
                    <td class="right">@_clientes.GetValueOrDefault(v.Id)</td>
                    <td class="right">@_oport.GetValueOrDefault(v.Id)</td>
                    <td class="right nowrap">@Fmt.Brl0(_valor.GetValueOrDefault(v.Id))</td>
                    <td class="nowrap">@v.Telefone</td>
                    <td class="nowrap">
                        <button class="btn-link" @onclick="() => Alternar(v)">@(v.Ativo ? "Inativar" : "Ativar")</button>
                        <button class="btn-link" style="color:#b91c1c" @onclick="() => Excluir(v)">Excluir</button>
                    </td>
                </tr>
            }
            @if (EquipeFiltrada.Count == 0) { <tr><td colspan="8" class="empty">Nenhum vendedor.</td></tr> }
        </tbody>
    </table>
    </div>
}
else if (_tab == "import")
{
    <div class="panel">
        <div style="font-size:12.5px;color:var(--muted);margin-bottom:8px">Tipo de dado a importar</div>
        <div class="tabs">
            @foreach (var t in _tipos)
            {
                <button class="tab @(_impTipo == t.Key ? "active" : "")" @onclick="() => _impTipo = t.Key">@t.Label</button>
            }
        </div>
        <div class="alert-warn" style="background:#eef6ff;color:#0c4a6e;border:1px solid #cfe3f7">
            Colunas esperadas: <strong>@Colunas(_impTipo)</strong>
        </div>
        <div class="toolbar" style="margin-top:12px">
            <button class="btn-ghost" @onclick="BaixarModelo">⬇ Baixar modelo de Excel (CSV)</button>
            <label style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted)">
                <input type="checkbox" @bind="_substituir" /> Substituir base existente
            </label>
        </div>
        <div class="logo-preview" style="flex-direction:column;gap:8px;margin-top:12px">
            <div style="font-weight:600;color:var(--secondary)">Selecione um arquivo Excel ou CSV</div>
            <div style="font-size:12px;color:var(--muted)">Formatos aceitos: <strong>.xlsx</strong>, <strong>.xls</strong> e <strong>.csv</strong> (separado por ; ou ,)</div>
            <InputFile OnChange="OnArquivo" accept=".xlsx,.xlsm,.xls,.csv" />
        </div>
        @if (_impMsg is not null)
        {
            <div class="@(_impOk ? "side-ok" : "alert-error")" style="margin-top:12px">@_impMsg</div>
        }
    </div>
}
else
{
    <div class="panel">
        <div class="summary-bar">O logo enviado fica salvo na base. Há um logo para o <strong>menu interno</strong> e outro para a <strong>capa de login</strong> — envie cada um separadamente. Use "Voltar ao padrão" para remover ambos.</div>

        <div class="dash-grid" style="margin-top:14px">
            <div>
                <div class="dash-title">Logo do programa (menu lateral)</div>
                <div class="logo-preview" style="flex-direction:column;gap:8px"><InputFile OnChange="OnLogoMenu" accept="image/*" /></div>
                <div style="font-size:12.5px;color:var(--muted);margin:12px 0 6px">Fundo atrás do logo (menu)</div>
                <div class="chips">
                    <button class="chip @(_brand.LogoBg == "transparent" ? "active" : "")" @onclick='() => SetBg("transparent")'>Sem fundo (direto no azul)</button>
                    <button class="chip @(_brand.LogoBg == "white" ? "active" : "")" @onclick='() => SetBg("white")'>Bloco branco</button>
                </div>
                <div style="font-size:12px;color:var(--muted);margin:12px 0 6px">Prévia sobre o azul do menu</div>
                <div style="background:var(--sidebar-top);border-radius:12px;padding:22px;display:grid;place-items:center">@Preview(_brand.LogoMenu, true)</div>
            </div>
            <div>
                <div class="dash-title">Logo da capa de login</div>
                <div class="logo-preview" style="flex-direction:column;gap:8px"><InputFile OnChange="OnLogoLogin" accept="image/*" /></div>
                <div style="font-size:12px;color:var(--muted);margin:12px 0 6px">Prévia sobre fundo claro (login)</div>
                <div style="background:#fff;border:1px solid var(--border);border-radius:12px;padding:22px;display:grid;place-items:center">@Preview(_brand.LogoLogin, false)</div>
            </div>
        </div>

        <button class="btn-ghost" style="margin-top:14px" @onclick="ResetLogo">↺ Voltar ao logo padrão (ambos)</button>
        @if (_logoMsg is not null) { <div class="side-ok" style="margin-top:10px">@_logoMsg</div> }
    </div>
}

@code {
    private string _tab = "segmentos";
    private List<Salesperson> _sps = new();
    private List<Segment> _segs = new();
    private List<ClientUnit> _units = new();
    private Dictionary<string, int> _clientes = new(), _oport = new();
    private Dictionary<string, decimal> _valor = new();
    private string _filtro = "ativos";

    private string _novoSegmento = "";
    private string? _segMsg, _segErro, _segConfirmar;

    private record Tipo(string Key, string Label);
    private readonly Tipo[] _tipos =
    {
        new("base", "Base instalada"), new("historico", "Histórico de vendas"),
        new("vendedores", "Vendedores"), new("construtivos", "Dados Construtivos"),
    };
    private string _impTipo = "base";
    private bool _substituir;
    private string? _impMsg;
    private bool _impOk;

    private Branding _brand = new();
    private string? _logoMsg;

    protected override void OnInitialized() => Carregar();

    private void Carregar()
    {
        _sps = Salespeople.All();
        _segs = Segmentos.All();
        _units = Units.All();
        var open = Intel.OpenOpportunities();
        _clientes = _units.GroupBy(u => u.VendedorId).ToDictionary(g => g.Key, g => g.Select(u => u.CompanyId).Distinct().Count());
        _oport = open.GroupBy(o => o.VendedorId).ToDictionary(g => g.Key, g => g.Count());
        _valor = open.GroupBy(o => o.VendedorId).ToDictionary(g => g.Key, g => g.Sum(o => o.ValorEstimado));
        _brand = Brand.Get();
    }

    // ---- segmentos -------------------------------------------------------
    private string VendedoresDoSegmento(string nome)
    {
        var nomes = _sps
            .Where(s => s.Ativo && string.Equals(s.Segmento, nome, StringComparison.OrdinalIgnoreCase))
            .Select(s => s.Nome)
            .ToList();
        return nomes.Count == 0 ? "— sem vendedor definido —" : string.Join(", ", nomes);
    }

    private int PlantasDoSegmento(string nome) =>
        _units.Count(u => string.Equals(u.Segmento, nome, StringComparison.OrdinalIgnoreCase));

    private void AdicionarSegmento()
    {
        _segErro = null; _segMsg = null;
        var nome = (_novoSegmento ?? "").Trim();
        if (nome.Length == 0) { _segErro = "Informe o nome do segmento."; return; }
        if (_segs.Any(g => string.Equals(g.Nome, nome, StringComparison.OrdinalIgnoreCase)))
        { _segErro = $"O segmento \"{nome}\" já está cadastrado."; return; }

        Segmentos.Save(new Segment { Id = "sg-" + Guid.NewGuid().ToString("N")[..8], Nome = nome });
        _novoSegmento = "";
        Intel.Invalidate();
        Carregar();
        _segMsg = $"Segmento \"{nome}\" cadastrado.";
    }

    private void ExcluirSegmento(Segment g)
    {
        Segmentos.Delete(g.Id);
        _segConfirmar = null;
        _segErro = null;
        Intel.Invalidate();
        Carregar();
        _segMsg = $"Segmento \"{g.Nome}\" excluído da lista.";
    }

    private List<Salesperson> EquipeFiltrada => _filtro switch
    {
        "ativos" => _sps.Where(s => s.Ativo).ToList(),
        "inativos" => _sps.Where(s => !s.Ativo).ToList(),
        _ => _sps,
    };

    private void Alternar(Salesperson v) { v.Ativo = !v.Ativo; Salespeople.Save(v); Intel.Invalidate(); Carregar(); }
    private void Excluir(Salesperson v) { Salespeople.Delete(v.Id); Intel.Invalidate(); Carregar(); }

    private string Colunas(string tipo) => tipo switch
    {
        "base" => "Hpfanreferencesid, Plant Name, City, State, Country, Industry, Process, Site Loc./Unit, Product Type, Brand, Model (Family), Designation, Contract No, Serial No, ClientRefNo, Ga drawing no, Applicationtype, Fansperboiler, Product Company, Install Year, Operating Status, Endcustomer, Client, Client Country, Projectname, RefNo, Agent",
        "historico" => "data_venda, pedido, cliente, unidade, tag_equipamento, equipamento, codigo_peca, item_vendido, tipo_movimento, quantidade, valor, vendedor",
        "vendedores" => "nome, email, telefone, cargo, regiao, segmento, perfil",
        "construtivos" => "cliente, modelo_do_equipamento, tipo_do_equipamento, item, peso_kg, dimensoes, material, parte_do_equipamento, modelo_do_item",
        _ => "",
    };

    private async Task BaixarModelo()
    {
        var header = Colunas(_impTipo).Replace(", ", ";");
        var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(header + "\n"));
        await JS.InvokeVoidAsync("appDownload", $"modelo_{_impTipo}.csv", "text/csv", b64);
    }

    private async Task OnArquivo(InputFileChangeEventArgs e)
    {
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(15 * 1024 * 1024).CopyToAsync(ms);
            var res = Importer.Import(_impTipo, ms.ToArray(), _substituir, e.File.Name);
            _impOk = res.Ok;
            _impMsg = res.Message;
        }
        catch (Exception ex) { _impOk = false; _impMsg = "Falha: " + ex.Message; }
    }

    private async Task<string> LerImagem(InputFileChangeEventArgs e)
    {
        var f = e.File;
        using var ms = new MemoryStream();
        await f.OpenReadStream(3 * 1024 * 1024).CopyToAsync(ms);
        var ct = string.IsNullOrEmpty(f.ContentType) ? "image/png" : f.ContentType;
        return $"data:{ct};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task OnLogoMenu(InputFileChangeEventArgs e)
    {
        try { _brand.LogoMenu = await LerImagem(e); Brand.Save(_brand); _logoMsg = "Logo do menu atualizado. Recarregue para ver no menu."; }
        catch (Exception ex) { _logoMsg = "Falha: " + ex.Message; }
    }

    private async Task OnLogoLogin(InputFileChangeEventArgs e)
    {
        try { _brand.LogoLogin = await LerImagem(e); Brand.Save(_brand); _logoMsg = "Logo da capa de login atualizado."; }
        catch (Exception ex) { _logoMsg = "Falha: " + ex.Message; }
    }

    private void SetBg(string bg) { _brand.LogoBg = bg; Brand.Save(_brand); }
    private void ResetLogo() { Brand.Reset(); _brand = Brand.Get(); _logoMsg = "Logos padrão restaurados."; }

    private RenderFragment Preview(string uri, bool dark) => builder =>
    {
        if (!string.IsNullOrEmpty(uri))
        {
            var wrap = (dark && _brand.LogoBg == "white") ? "background:#fff;padding:8px;border-radius:8px;" : "";
            builder.AddMarkupContent(0, $"<div style=\"{wrap}\"><img src=\"{uri}\" style=\"max-height:44px;max-width:220px\" /></div>");
        }
        else
        {
            var color = dark ? "#fff" : "var(--primary)";
            builder.AddMarkupContent(1, $"<div style=\"font-weight:700;font-size:18px;color:{color}\">Aftermarket <span style=\"color:var(--accent)\">Intelligence</span></div>");
        }
    };
}
