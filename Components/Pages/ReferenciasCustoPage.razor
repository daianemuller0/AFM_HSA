@page "/referencias-custo"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ReferenciaDeCustoRepository Refs
@inject IJSRuntime JS
@inject AuthenticationStateProvider Auth

<PageTitle>Referências de preço · AFM HSA</PageTitle>

<div class="page-head">
    <div>
        <h1>Referências de preço e custo</h1>
        <p class="subtitle">
            O que já enviamos ao cliente para cada part number — vendido ou não, é referência. Com o Nº da AF, a linha fica como vendida
            (por item ou no pacote); a base do custo diz se temos cotação ou se foi estimado. Nascem ao salvar uma proposta
            (um registro por item) ou de uma planilha. Na Gerar Proposta, ao digitar o part number, o último preço enviado
            aparece no item, com "meta = este preço".
        </p>
    </div>
</div>

<div class="ref-topo">
    <div class="toolbar" style="gap:10px; flex-wrap:wrap; margin:0">
        <input class="cell" style="min-width:260px; flex:1" placeholder="Buscar por proposta, cliente, planta, part number, descrição…"
               value="@_busca" @oninput="e => _busca = e.Value?.ToString() ?? string.Empty" />
        <span class="chips">
            @foreach (var (cod, nome) in new[] { ("", "Todas"), ("vendidas", "Vendidas (com AF)"), ("nao", "Não vendidas"), ("cotacao", "Custo de cotação"), ("estimado", "Custo estimado") })
            {
                <button class="chip @(_filtro == cod ? "active" : "")" @onclick="() => _filtro = cod">@nome</button>
            }
        </span>
        <span class="nota">@Filtradas.Count() de @_todas.Count referência(s)</span>
        <button class="btn-ghost" @onclick="BaixarModelo">⬇ Modelo da planilha</button>
        <button class="btn-ghost" @onclick="Exportar">⬇ Exportar a lista</button>
    </div>
    <label class="dropzone @(_arrastando ? "arrastando" : "")" @ondragenter="() => _arrastando = true" @ondragleave="() => _arrastando = false"
           @ondrop="() => _arrastando = false">
        <InputFile OnChange="Importar" accept=".xlsx,.xlsm,.xls,.csv" />
        <span class="dz-ico">⇪</span>
        <span><strong>Arraste a planilha aqui</strong> ou clique para escolher<br />
            <small>.xlsx, .xls ou .csv · as colunas do modelo; a mesma proposta, revisão, cliente e part number atualiza em vez de duplicar</small></span>
    </label>
</div>
@if (_msg is not null)
{
    <div class="@(_msgOk ? "alert-ok" : "alert-error")" style="margin-bottom:10px">@_msg
        @if (_avisos.Count > 0) { <ul style="margin:6px 0 0 18px">@foreach (var a in _avisos.Take(8)) { <li>@a</li> }</ul> }
    </div>
}

<div class="tabela-rolante">
    <table class="grid grid-ordenavel">
        <thead>
            <tr>
                @foreach (var c in Colunas)
                {
                    <th class="@(c.Direita ? "right" : "") nowrap" @onclick="() => Ordenar(c.Nome)" title="Ordenar por @c.Nome">
                        @c.Nome <span class="seta">@(_ordem == c.Nome ? (_crescente ? "▲" : "▼") : "↕")</span>
                    </th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Filtradas.Take(_limite))
            {
                <tr>
                    <td class="nowrap">
                        @if (r.PropostaId.Length > 0) { <a class="btn-link" href="@($"/gerar-proposta/{r.PropostaId}")">@Traco(r.Proposta)</a> }
                        else { @Traco(r.Proposta) }
                    </td>
                    <td>@Traco(r.Revisao)</td>
                    <td>@Traco(r.Cliente)</td>
                    <td>@Traco(r.Plantas)</td>
                    <td>@Traco(r.Estado)</td>
                    <td class="nowrap">@Traco(r.Intercompany)</td>
                    <td class="nowrap"><strong>@r.PartNumber</strong></td>
                    <td class="right">@(r.Quantidade > 0 ? r.Quantidade.ToString("0.##") : "—")</td>
                    <td class="right nowrap">@(r.PrecoUnitLiquido > 0 ? Moedas.Dinheiro(r.MoedaDoPreco, r.PrecoUnitLiquido) : "—")</td>
                    <td class="right nowrap">@(r.PrecoTotalLiquido > 0 ? Moedas.Dinheiro(r.MoedaDoPreco, r.PrecoTotalLiquido) : "—")</td>
                    <td class="nowrap">@(r.Data.Length > 0 ? Fmt.Date(r.Data) : "—")</td>
                    <td class="right nowrap">@(r.Valor > 0 ? Fmt.Brl(r.Valor) : "—")</td>
                    <td class="right nowrap">@(r.Ta > 0 ? Fmt.Brl(r.Ta) : "—")</td>
                    <td title="@Detalhe(r)">@Traco(r.Descricao)</td>
                    <td><input class="cell ref-af" value="@r.NumeroAf" placeholder="—" title="Número da AF: preenchido = vendido"
                               @onchange="e => MudarAf(r, e)" /></td>
                    <td>
                        <select class="cell ref-sel" value="@r.VendaPor" disabled="@(!r.Vendido)" @onchange="e => MudarVendaPor(r, e)">
                            <option value="">—</option><option value="item">por item</option><option value="pacote">no pacote (total)</option>
                        </select>
                    </td>
                    <td class="right">
                        @if (r.VendaPor == "pacote")
                        {
                            <input class="cell ref-af num" type="number" min="0" step="0.01" value="@(r.ValorPacote > 0 ? r.ValorPacote.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                   placeholder="@r.MoedaDoPreco.Rotulo()" @onchange="e => MudarPacote(r, e)" />
                        }
                        else { <span>—</span> }
                    </td>
                    <td>
                        <select class="cell ref-sel" value="@r.BaseDoCusto" @onchange="e => MudarBase(r, e)">
                            <option value="">—</option><option value="@ReferenciaDeCustoRepository.Cotacao">cotação</option><option value="@ReferenciaDeCustoRepository.Estimado">estimado</option>
                        </select>
                    </td>
                    <td class="nowrap">
                        @if (r.Origem == ReferenciaDeCustoRepository.OrigemPlanilha)
                        {
                            <button class="btn-link" title="Apagar esta referência importada" @onclick="() => Apagar(r)">✕</button>
                        }
                    </td>
                </tr>
            }
            @if (!Filtradas.Any())
            {
                <tr><td colspan="19" class="empty">@(_todas.Count == 0 ? "Nenhuma referência ainda: salve uma proposta com itens ou arraste uma planilha aqui em cima." : "Nenhuma referência com esse texto.")</td></tr>
            }
        </tbody>
    </table>
</div>
@if (Filtradas.Count() > _limite)
{
    <button class="btn-ghost" style="margin-top:10px" @onclick="() => _limite += 500">Mostrar mais (@(Filtradas.Count() - _limite) restantes)</button>
}

@code {
    private List<ReferenciaDeCusto> _todas = new();
    private string _busca = "";
    private string _ordem = "Data";
    private bool _crescente;
    private int _limite = 500;
    private bool _arrastando;
    private string? _msg;
    private bool _msgOk;
    private List<string> _avisos = new();
    private string _usuario = "";

    private sealed record Coluna(string Nome, Func<ReferenciaDeCusto, IComparable> Chave, bool Direita = false);

    /// <summary>As colunas da tela, na ordem pedida pela equipe; clicar no título ordena.</summary>
    private static readonly Coluna[] Colunas =
    {
        new("Proposta", r => r.Proposta),
        new("Revisão", r => int.TryParse(r.Revisao, out var n) ? n : -1),
        new("Cliente", r => Textos.Simples(r.Cliente)),
        new("Plantas", r => Textos.Simples(r.Plantas)),
        new("Estado", r => r.Estado),
        new("Intercompany", r => r.Intercompany),
        new("Part Number", r => IntelligenceService.NormPn(r.PartNumber)),
        new("Quantidade", r => r.Quantidade, true),
        new("Valor unit. líquido", r => r.PrecoUnitLiquido, true),
        new("Valor total líquido", r => r.PrecoTotalLiquido, true),
        new("Data", r => r.Data),
        new("Custo unit. (R$)", r => r.Valor, true),
        new("TA (R$)", r => r.Ta, true),
        new("Descrição", r => Textos.Simples(r.Descricao)),
        new("Nº AF", r => r.NumeroAf),
        new("Vendido por", r => r.VendaPor),
        new("Valor do pacote", r => r.ValorPacote, true),
        new("Base do custo", r => r.BaseDoCusto),
    };

    private string _filtro = "";

    // ---- a venda e a base do custo, editadas na própria lista (a AF chega depois da proposta) ----
    private void Gravar(ReferenciaDeCusto r) { Refs.Gravar(r); _msg = null; }

    private void MudarAf(ReferenciaDeCusto r, ChangeEventArgs e)
    {
        r.NumeroAf = (e.Value?.ToString() ?? "").Trim();
        if (r.NumeroAf.Length == 0) { r.VendaPor = ""; r.ValorPacote = 0m; }
        else if (r.VendaPor.Length == 0) r.VendaPor = "item";
        Gravar(r);
    }

    private void MudarVendaPor(ReferenciaDeCusto r, ChangeEventArgs e)
    {
        r.VendaPor = e.Value?.ToString() ?? "";
        if (r.VendaPor != "pacote") r.ValorPacote = 0m;
        Gravar(r);
    }

    private void MudarPacote(ReferenciaDeCusto r, ChangeEventArgs e)
    {
        r.ValorPacote = ReferenciaDeCustoRepository.Numero(e.Value?.ToString()) ?? 0m;
        Gravar(r);
    }

    private void MudarBase(ReferenciaDeCusto r, ChangeEventArgs e)
    {
        r.BaseDoCusto = e.Value?.ToString() ?? "";
        Gravar(r);
    }

    protected override async Task OnInitializedAsync()
    {
        _todas = Refs.Todas();
        var u = (await Auth.GetAuthenticationStateAsync()).User;
        _usuario = u.Identity?.Name ?? "";
    }

    private IEnumerable<ReferenciaDeCusto> Filtradas
    {
        get
        {
            var termos = Textos.Simples(_busca).Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var lista = _todas.Where(r => _filtro switch
            {
                "vendidas" => r.Vendido,
                "nao" => !r.Vendido,
                "cotacao" => r.BaseDoCusto == ReferenciaDeCustoRepository.Cotacao,
                "estimado" => r.BaseDoCusto == ReferenciaDeCustoRepository.Estimado,
                _ => true,
            }).Where(r => termos.All(t => Textos.Simples(
                $"{r.NumeroAf} {r.Proposta} {r.Revisao} {r.Cliente} {r.Plantas} {r.Estado} {r.Intercompany} {r.PartNumber} {r.Descricao} {r.Modelo} {r.SerialNumber} {r.Usuario}").Contains(t)));
            var col = Colunas.FirstOrDefault(c => c.Nome == _ordem) ?? Colunas[10];
            // vazio (sem valor, sem texto) fica sempre no fim, nos dois sentidos
            var comVazio = lista.OrderBy(r => Vazio(col.Chave(r)));
            return _crescente ? comVazio.ThenBy(col.Chave) : comVazio.ThenByDescending(col.Chave);
        }
    }

    private static bool Vazio(IComparable v) => v switch
    {
        string t => t.Length == 0,
        decimal d => d == 0m,
        int n => n < 0,
        _ => false,
    };

    private void Ordenar(string coluna)
    {
        if (_ordem == coluna) _crescente = !_crescente;
        else { _ordem = coluna; _crescente = coluna is not ("Data" or "Valor unit. líquido" or "Valor total líquido" or "Quantidade"); }
    }

    private static string Traco(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private static string Detalhe(ReferenciaDeCusto r) => string.Join(" · ", new[]
    {
        r.Modelo.Length > 0 ? "Modelo " + r.Modelo : "", r.SerialNumber.Length > 0 ? "SN " + r.SerialNumber : "",
        r.Origem.Length > 0 ? "custo: " + r.Origem : "", r.Usuario,
    }.Where(t => t.Length > 0));

    private async Task Importar(InputFileChangeEventArgs e)
    {
        _arrastando = false;
        _avisos = new();
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(30 * 1024 * 1024).CopyToAsync(ms);
            var (gravadas, avisos) = Refs.Importar(ms.ToArray(), e.File.Name, _usuario);
            _avisos = avisos;
            _msgOk = gravadas > 0;
            _msg = gravadas > 0 ? $"{gravadas} referência(s) importada(s) de {e.File.Name}." : $"Nenhuma linha importada de {e.File.Name}.";
            _todas = Refs.Todas();
        }
        catch (Exception ex)
        {
            _msgOk = false;
            _msg = "Não foi possível ler a planilha: " + ex.Message;
        }
    }

    private void Apagar(ReferenciaDeCusto r)
    {
        Refs.Apagar(r.Id);
        _todas.Remove(r);
    }

    private async Task BaixarModelo() =>
        await JS.InvokeVoidAsync("appDownload", "modelo_referencias_de_preco.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(ReferenciaDeCustoRepository.Modelo()));

    private async Task Exportar()
    {
        var linhas = Filtradas.Select(r => (IReadOnlyList<string>)new[]
        {
            r.Proposta, r.Revisao, r.Cliente, r.Plantas, r.Estado, r.Intercompany, r.PartNumber, r.Quantidade.ToString("0.##"),
            r.PrecoUnitLiquido.ToString("0.00"), r.PrecoTotalLiquido.ToString("0.00"), r.DataComoData?.ToString("dd/MM/yyyy") ?? "",
            r.Valor.ToString("0.00"), r.Ta.ToString("0.00"), r.Descricao, r.NumeroAf, r.VendaPor,
            r.ValorPacote > 0 ? r.ValorPacote.ToString("0.00") : "", r.BaseDoCusto, r.MoedaDoPreco.Codigo(),
        });
        var bytes = Planilha.Xlsx("Referências", ReferenciaDeCustoRepository.Colunas.Select(c => c.Nome).ToList(), linhas);
        await JS.InvokeVoidAsync("appDownload", "referencias_de_preco.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }
}
