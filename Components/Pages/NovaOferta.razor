@page "/ofertas/nova"
@page "/gerar-proposta"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject ClientUnitRepository Units
@inject EquipmentRepository Equipamentos
@inject InstalledBaseRepository Base
@inject PartRepository Pecas
@inject BomRepository Bom
@inject NacionalizacaoRepository Nacionais
@inject SalesRecordRepository Vendas
@inject OfferRepository OffersRepo
@inject SegmentRepository Segmentos
@inject SalespersonRepository Vendedores
@inject IntelligenceService Intel
@inject ParametrosImportacao ParamImportacao
@inject ConversaoRepository Conversao
@inject NavigationManager Nav

<PageTitle>Gerar Proposta · AFM HSA</PageTitle>

<div class="page-head">
    <div><h1>Gerar Proposta</h1><p class="subtitle">Proposta comercial no template Howden / Chart — cliente, itens e condições.</p></div>
    <div class="page-actions"><a class="btn-ghost" href="/ofertas">← Ofertas</a></div>
</div>

<div class="prop-grid">
  <div>
    <div class="panel" style="margin-bottom:16px">
        <div class="dash-title">Cabeçalho
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                os mesmos campos e listas do cabeçalho da planilha de pricing · escolha o cliente da base para trazer nome, estado e mercado
            </span>
        </div>
        <div class="cab-topo">
            <label>Cliente / Unidade (da base)
                <select class="cell" @bind="_unitId" @bind:after="UnidadeMudou">
                    <option value="">Selecione…</option>
                    @foreach (var u in _units) { <option value="@u.Id">@Intel.UnitLabel(u.Id)</option> }
                </select>
            </label>
            <label>Data do Pricing <input class="cell" type="date" @bind="DataProposta" /></label>
        </div>
        <div class="cab-pricing">
            <div class="cab-col">
                <label>Nome do Cliente * <input class="cell" @bind="_o.ClientName" /></label>
                <label>PV <input class="cell" @bind="_o.Pv" /></label>
                <label>Ano <input class="cell" type="number" min="2000" max="2100" @bind="_o.Ano" /></label>
                <label>Número da Proposta * <input class="cell" @bind="_o.OfferCode" /></label>
                <label>Revisão <input class="cell" @bind="_o.Revisao" list="dl-revisao" /></label>
                <label>BU
                    <select class="cell" @bind="_o.Bu">
                        <option value="">preencher</option>
                        @foreach (var (cod, rot) in ListasDoPricing.Bus) { <option value="@cod">@rot</option> }
                        @ForaDaLista(_o.Bu, ListasDoPricing.Bus.Select(b => b.Codigo))
                    </select>
                </label>
                <label>Elaborado por <input class="cell" @bind="_o.PreparedBy" /></label>
                <label>NCM c/redução base ICMS
                    <select class="cell" @bind="_o.NcmReducaoIcms">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.SimNao) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.NcmReducaoIcms, ListasDoPricing.SimNao)
                    </select>
                </label>
            </div>
            <div class="cab-col">
                <label>Segmento (margem)
                    <select class="cell" @bind="_o.SegmentoMargem" @bind:after="SegmentoOuProdutoMudou">
                        <option value="">preencher</option>
                        @foreach (var (nome, margem) in ListasDoPricing.Segmentos) { <option value="@nome">@nome (margem padrão @Pct(margem))</option> }
                        @ForaDaLista(_o.SegmentoMargem, ListasDoPricing.Segmentos.Select(x => x.Nome))
                    </select>
                </label>
                <label>Venda para
                    <select class="cell" @bind="_o.VendaPara">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.VendaPara) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.VendaPara, ListasDoPricing.VendaPara)
                    </select>
                </label>
                <label>Destino
                    <select class="cell" @bind="_o.Destino" @bind:after="DestinoMudou">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.Destinos) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.Destino, ListasDoPricing.Destinos)
                    </select>
                </label>
                <label>Estado
                    <select class="cell" @bind="_o.Estado">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.EstadosDo(_o.Destino)) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.Estado, ListasDoPricing.EstadosDo(_o.Destino))
                    </select>
                </label>
                <label>Reforma
                    <select class="cell" @bind="_o.Reforma">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.SimNao) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.Reforma, ListasDoPricing.SimNao)
                    </select>
                </label>
                <label>Prazo de Entrega
                    <span class="com-sufixo">
                        <input class="cell num" type="number" min="0" step="1" placeholder="0"
                               value="@(PricingDaProposta.PrazoEmDias(_o.PrazoEntrega) is > 0 and var dias ? dias.ToString() : "")"
                               @onchange="MudarPrazo" />
                        <span>dias</span>
                    </span>
                </label>
                <label>Cliente com
                    <select class="cell" @bind="_o.ClienteCom">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.RegimeCliente) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.ClienteCom, ListasDoPricing.RegimeCliente)
                    </select>
                </label>
                <label>Contém produto IC?
                    <select class="cell" @bind="_o.ContemProdutoIc">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.SimNao) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.ContemProdutoIc, ListasDoPricing.SimNao)
                    </select>
                </label>
            </div>
            <div class="cab-col">
                <label>Fiança/Seguro Garantia
                    <select class="cell" @bind="_o.FiancaSeguro">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.SimNao) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.FiancaSeguro, ListasDoPricing.SimNao)
                    </select>
                </label>
                <label>Portal
                    <select class="cell" @bind="_o.Portal">
                        <option value="">preencher</option>
                        @foreach (var v in ListasDoPricing.Portais) { <option value="@v.Nome">@RotuloPortal(v)</option> }
                        @ForaDaLista(_o.Portal, ListasDoPricing.Portais.Select(x => x.Nome))
                    </select>
                </label>
                <label>Rep 1
                    <select class="cell" @bind="_o.Rep1">
                        @foreach (var r in ListasDoPricing.Representantes) { <option value="@r.Nome">@r.Nome</option> }
                        @ForaDaLista(_o.Rep1, ListasDoPricing.Representantes.Select(x => x.Nome))
                    </select>
                    @SeloComissao(_o.Rep1)
                </label>
                <label>Rep 2
                    <select class="cell" @bind="_o.Rep2">
                        @foreach (var r in ListasDoPricing.Representantes) { <option value="@r.Nome">@r.Nome</option> }
                        @ForaDaLista(_o.Rep2, ListasDoPricing.Representantes.Select(x => x.Nome))
                    </select>
                    @SeloComissao(_o.Rep2)
                </label>
                <label>Categories
                    <select class="cell" @bind="_o.Categories" @bind:after="CategoriaMudou">
                        <option value="">—</option>
                        @foreach (var (cat, _) in ListasDoPricing.Categorias) { <option value="@cat">@cat</option> }
                        @ForaDaLista(_o.Categories, ListasDoPricing.Categorias.Select(x => x.Categoria))
                    </select>
                </label>
                <label>Product
                    <select class="cell" @bind="_o.Product" @bind:after="SegmentoOuProdutoMudou" disabled="@(ListasDoPricing.ProdutosDa(_o.Categories).Length == 0)">
                        <option value="">@(_o.Categories.Length == 0 ? "escolha a categoria" : "—")</option>
                        @foreach (var v in ListasDoPricing.ProdutosDa(_o.Categories)) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.Product, ListasDoPricing.ProdutosDa(_o.Categories))
                    </select>
                </label>
                <label>Market Segments
                    <select class="cell" @bind="_o.MarketSegments">
                        <option value="">—</option>
                        @foreach (var v in ListasDoPricing.MarketSegments) { <option value="@v">@v</option> }
                        @ForaDaLista(_o.MarketSegments, ListasDoPricing.MarketSegments)
                    </select>
                </label>
            </div>
        </div>

        @if (_items.Any(i => i.Importado))
        {
            var imp = Importacoes;
            <div class="bloco-importacao">
                <div class="bloco-importacao-titulo">Importação
                    <span>@_items.Count(i => i.Importado) item(ns) importado(s) · planilha de custos de importação de @ParamImportacao.VersaoPlanilha</span>
                </div>
                <div class="imp-linha">
                    <div class="imp-modo">
                        <span class="imp-rot">Importar por *</span>
                        <label class="imp-opcao @(_o.ImportacaoModo == "total" ? "on" : "")">
                            <input type="radio" name="impmodo" checked="@(_o.ImportacaoModo == "total")"
                                   @onchange='() => _o.ImportacaoModo = "total"' />
                            <span><strong>Total</strong><small>soma tudo numa importação só</small></span>
                        </label>
                        <label class="imp-opcao @(_o.ImportacaoModo == "item" ? "on" : "")">
                            <input type="radio" name="impmodo" checked="@(_o.ImportacaoModo == "item")"
                                   @onchange='() => _o.ImportacaoModo = "item"' />
                            <span><strong>Item</strong><small>uma importação para cada item</small></span>
                        </label>
                    </div>
                    <label class="imp-campo">Moeda
                        <select class="cell" @bind="_o.Moeda">
                            @foreach (var m in MoedasImportacao) { <option value="@m">@m</option> }
                        </select>
                    </label>
                    <label class="imp-campo">Taxa cambial (R$ por @_o.Moeda) *
                        <input class="cell num" type="number" min="0" step="0.0001" placeholder="ex.: 6,5"
                               value="@(_o.TaxaCambio > 0 ? _o.TaxaCambio.ToString(CultureInfo.InvariantCulture) : "")"
                               @onchange="MudarTaxa" />
                    </label>
                </div>

                @if (imp.Pendencias.Count > 0)
                {
                    <div class="imp-pendencia">Para calcular: @string.Join(" · ", imp.Pendencias)</div>
                }
                else
                {
                    <div class="imp-resumo">
                        <div class="@(_o.ImportacaoModo == "total" ? "escolhido" : "")">
                            <span>Por total</span>
                            <strong>@Fmt.Brl(imp.TotalPorTotal)</strong>
                            <small>1 importação de @Me(imp.ValorMoedaTotal)</small>
                        </div>
                        <div class="@(_o.ImportacaoModo == "item" ? "escolhido" : "")">
                            <span>Por item</span>
                            <strong>@Fmt.Brl(imp.TotalPorItem)</strong>
                            <small>@imp.PorItem.Count importação(ões) individual(is)</small>
                        </div>
                        <div>
                            <span>Diferença</span>
                            <strong>@Fmt.Brl(Math.Abs(imp.TotalPorItem - imp.TotalPorTotal))</strong>
                            <small>@(imp.TotalPorItem >= imp.TotalPorTotal ? "por total sai mais barato" : "por item sai mais barato")</small>
                        </div>
                    </div>
                    @if (string.IsNullOrEmpty(_o.ImportacaoModo))
                    {
                        <div class="imp-pendencia">Escolha <strong>Total</strong> ou <strong>Item</strong> para levar o custo aos itens.</div>
                    }
                    <button class="btn-link" style="margin-top:6px" @onclick="() => _verMemoria = !_verMemoria">
                        @(_verMemoria ? "esconder memória de cálculo" : "ver memória de cálculo (como na planilha)")
                    </button>
                    @if (_verMemoria)
                    {
                        var calculos = _o.ImportacaoModo == "item" ? imp.PorItem : new List<(string, CalculoImportacao)> { ("Importação total", imp.PorTotal!) };
                        <div class="tabela-rolante">
                        <table class="grid memoria-imp">
                            <thead>
                                <tr><th>Despesa (R$)</th>@foreach (var (rot, _) in calculos) { <th class="right">@rot</th> }</tr>
                            </thead>
                            <tbody>
                                @foreach (var desc in calculos[0].Item2.Linhas.Select(l => l.Descricao))
                                {
                                    <tr>
                                        <td>@desc</td>
                                        @foreach (var (_, c) in calculos)
                                        {
                                            <td class="right nowrap">@Fmt.Brl(c.Linhas.FirstOrDefault(l => l.Descricao == desc)?.Valor ?? 0)</td>
                                        }
                                    </tr>
                                }
                                <tr class="memoria-total">
                                    <td>Custo total da operação já deduzidos os créditos tributários</td>
                                    @foreach (var (_, c) in calculos) { <td class="right nowrap">@Fmt.Brl(c.CustoTotal)</td> }
                                </tr>
                                <tr>
                                    <td>% de custo sobre o produto</td>
                                    @foreach (var (_, c) in calculos) { <td class="right nowrap">@c.PercentualSobreProduto.ToString("P2", PtBr)</td> }
                                </tr>
                            </tbody>
                        </table>
                        </div>
                        <div class="sub-cel" style="display:block">IPI, PIS, COFINS e ICMS são créditos tributários: entram e saem na planilha, por isso não somam no custo.</div>
                    }
                }
            </div>
        }

        @* revisão: valores já usados em propostas anteriores + opções usuais *@
        <datalist id="dl-revisao">@foreach (var v in Sugestoes(o => o.Revisao, "0", "1", "2")) { <option value="@v" /> }</datalist>
    </div>

    <div class="panel" style="margin-bottom:16px">
        <div class="dash-title">Contato e equipamentos</div>
        <div class="form3">
            <label>A/C (contato) <input class="cell" @bind="_o.AttentionTo" /></label>
            <label>E-mail do contato <input class="cell" type="email" placeholder="contato@@empresa.com" @bind="_o.ContatoEmail" /></label>
            <label>Telefone do contato <input class="cell" placeholder="+55 …" @bind="_o.ContatoTelefone" /></label>
            <label>Cidade <input class="cell" @bind="_o.City" /></label>
            <label>Nossa referência <input class="cell" @bind="_o.OurReference" /></label>
            <label>Sua referência (do cliente) <input class="cell" placeholder="o número que o cliente deu" @bind="_o.SuaReferencia" /></label>
            <label>Projeto <input class="cell" @bind="_o.Project" /></label>
        </div>

        @if (!string.IsNullOrEmpty(_unitId))
        {
            <div class="dash-title" style="margin-top:16px">Equipamentos da unidade
                <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">marque um ou mais</span>
            </div>
            @if (EquipsDaUnidade.Count == 0)
            {
                <div class="empty" style="padding:8px 0">Nenhum equipamento instalado nesta unidade.</div>
            }
            else
            {
                <div class="equip-chips">
                    @foreach (var e in EquipsDaUnidade)
                    {
                        var marcado = _equipIds.Contains(e.Id);
                        <label class="equip-chip @(marcado ? "on" : "")">
                            <input type="checkbox" checked="@marcado" @onchange="() => AlternarEquip(e.Id)" />
                            <span><strong>@e.Modelo</strong><small>@e.Tipo</small></span>
                        </label>
                    }
                </div>
            }
        }
    </div>

    @if (_equipIds.Count > 0)
    {
        <div class="panel" style="margin-bottom:16px">
            <div class="dash-title">Itens da BOM dos equipamentos selecionados
                <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                    a situação de nacionalização e as referências são verificadas automaticamente
                </span>
            </div>
            <div class="toolbar tab-toolbar">
                <input class="cell busca-bom" placeholder="Buscar partnumber, descrição, item…"
                       @bind="_bomBusca" @bind:event="oninput" />
                <div style="flex:1"></div>
                <button class="btn-ghost" @onclick="MarcarVisiveis">Marcar todos visíveis</button>
                <button class="btn-primary" disabled="@(_bomMarcados.Count == 0)" @onclick="AdicionarBomMarcados">
                    + Adicionar @(_bomMarcados.Count) item(ns) à proposta
                </button>
            </div>
            <div class="tabela-rolante" style="max-height:340px;overflow-y:auto">
            <table class="grid tabela-bom-proposta">
                <thead>
                    <tr>
                        <th style="width:34px"></th><th>Equipamento</th><th>Item</th><th>Partnumber</th><th>Descrição</th>
                        <th class="right">Qtd BOM</th><th>Nacionalizado</th><th class="right">Referência de custo</th><th class="right">Última venda</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in BomVisivel)
                    {
                        var r = Ref(b.PartNumber);
                        var naProposta = _items.Any(i => i.EquipmentId == b.EquipmentId &&
                            IntelligenceService.NormPn(i.PartNumber) == IntelligenceService.NormPn(b.PartNumber) && i.PartNumber.Length > 0);
                        <tr class="@(naProposta ? "linha-na-proposta" : "")">
                            <td>
                                @if (naProposta)
                                {
                                    <span class="sub-cel" title="Já está na proposta">✓</span>
                                }
                                else
                                {
                                    <input type="checkbox" checked="@_bomMarcados.Contains(b.Id)" @onchange="() => AlternarBom(b.Id)" />
                                }
                            </td>
                            <td class="nowrap">@ModeloDe(b.EquipmentId)</td>
                            <td class="nowrap">@Txt(b.Item)</td>
                            <td class="nowrap"><strong>@Txt(b.PartNumber)</strong></td>
                            <td>@DescricaoBom(b)</td>
                            <td class="right">@Txt(b.Quantidade)</td>
                            <td>@SeloNac(r)</td>
                            <td class="right nowrap">@CelulaCusto(r)</td>
                            <td class="right nowrap">@CelulaUltimaVenda(r)</td>
                        </tr>
                    }
                    @if (BomVisivel.Count == 0)
                    {
                        <tr><td colspan="9" class="empty">
                            @(_bomBusca.Trim().Length > 0 ? $"Nenhum item da BOM corresponde a \"{_bomBusca}\"."
                                                           : "Os equipamentos selecionados não têm BOM cadastrada.")
                        </td></tr>
                    }
                </tbody>
            </table>
            </div>
            <div style="margin-top:10px">
                <button class="btn-ghost" @onclick="AdicionarPecas">+ Adicionar peças das regras de troca</button>
            </div>
        </div>
    }

    <div class="panel" style="margin-bottom:16px">
        <div class="dash-title">Itens da proposta
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                referência de custo e última venda são só para apoio — o preço é sempre o que você definir
            </span>
        </div>
        <div class="tabela-rolante">
        <table class="grid tabela-proposta" style="margin-bottom:12px">
            <thead>
                <tr>
                    <th>Descrição</th><th>Nacionalizado</th><th>Importado</th><th class="right">Referência de custo (R$)</th>
                    <th class="right">Última venda (R$)</th><th class="right">Qtd</th>
                    <th class="right">Preço unitário da proposta (@Cambio.MoedaDoPreco(_o).Rotulo())</th><th class="right">Total</th><th></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _items.Count; i++)
                {
                    var it = _items[i];
                    var idx = i;
                    var r = RefDoItem(it);
                    <tr class="@(it.UnitPrice <= 0 ? "sem-preco" : "")">
                        <td>
                            @it.Description
                            @if (it.EquipmentId.Length > 0)
                            {
                                <span class="sub-cel">@ModeloDe(it.EquipmentId)</span>
                            }
                            @if (it != _itemDemais)
                            {
                                <select class="cell ncm-sel" title="NCM do item na proposta em Word" value="@it.Ncm" @onchange="e => it.Ncm = e.Value?.ToString() ?? string.Empty">
                                    <option value="">NCM: a definir</option>
                                    @foreach (var n in ListasDaProposta.Ncms) { <option value="@n.Codigo">NCM @n.Texto</option> }
                                </select>
                            }
                        </td>
                        <td>@(it.PartNumber.Length > 0 ? SeloNac(r) : Traco)</td>
                        <td class="nowrap">
                            <label class="chk-inline" style="color:var(--text)">
                                <input type="checkbox" checked="@it.Importado" @onchange="e => MarcarImportado(idx, e)" /> importado
                            </label>
                            @if (it.Importado)
                            {
                                <div class="imp-preco">
                                    <input class="cell num" type="number" min="0" step="0.01" placeholder="preço unit."
                                           value="@(it.ValorMoeda > 0 ? it.ValorMoeda.ToString(CultureInfo.InvariantCulture) : "")"
                                           @onchange="e => MudarValorMoeda(idx, e)" />
                                    <span>@_o.Moeda</span>
                                </div>
                            }
                        </td>
                        <td class="right nowrap">
                            @if (it.Importado)
                            {
                                var ci = CustoImportadoDo(it);
                                @if (ci is decimal cu)
                                {
                                    <strong>@Fmt.Brl(cu)</strong>
                                    <span class="sub-cel">importação @(_o.ImportacaoModo == "item" ? "por item" : "por total (rateio)")</span>
                                    @if (it.Quantity > 1)
                                    {
                                        <span class="sub-cel">@Fmt.Brl(cu * it.Quantity) na linha</span>
                                    }
                                }
                                else
                                {
                                    <span class="custo-indisp">@(it.ValorMoeda <= 0 ? $"informe o preço em {_o.Moeda}" : "complete a importação no topo")</span>
                                }
                            }
                            else if (it.PartNumber.Length > 0)
                            {
                                @CelulaCusto(r)
                            }
                            else
                            {
                                @Traco
                            }
                        </td>
                        <td class="right nowrap">
                            @if (it.PartNumber.Length > 0)
                            {
                                @CelulaUltimaVenda(r)
                                @if (r.UltimaVenda is decimal uv && Math.Round(Cambio.ParaVenda(_o, uv), 2) != it.UnitPrice)
                                {
                                    <button class="btn-link usar-preco" title="Copiar o valor da última venda para o preço da proposta"
                                            @onclick="() => UsarPreco(idx, uv)">usar</button>
                                }
                            }
                            else
                            {
                                @Traco
                            }
                        </td>
                        <td class="right">
                            <input class="cell num qtd-cel" type="number" min="1" value="@it.Quantity"
                                   @onchange="e => MudarQtd(idx, e)" />
                        </td>
                        <td class="right">
                            <input class="cell num preco-cel" type="number" min="0" step="0.01" placeholder="definir"
                                   value="@(it.UnitPrice > 0 ? it.UnitPrice.ToString(CultureInfo.InvariantCulture) : "")"
                                   @onchange="e => MudarPreco(idx, e)" />
                        </td>
                        <td class="right nowrap"><strong>@Venda(it.TotalPrice)</strong></td>
                        <td><button class="btn-link" style="color:#b91c1c" @onclick="() => Remover(idx)">remover</button></td>
                    </tr>
                }
                @if (_items.Count == 0) { <tr><td colspan="9" class="empty">Nenhum item. Selecione equipamentos e itens da BOM acima, ou adicione um item manual.</td></tr> }
            </tbody>
        </table>
        </div>
        <div class="item-row" style="grid-template-columns:2fr 80px 120px auto">
            <label>Descrição (item manual) <input class="cell" @bind="_desc" /></label>
            <label>Qtd <input class="cell num" type="number" @bind="_qtd" /></label>
            <label>Unitário (@Cambio.MoedaDoPreco(_o).Rotulo()) <input class="cell num" type="number" step="0.01" @bind="_preco" /></label>
            <label>&nbsp;<button class="btn-primary" @onclick="AdicionarItem">Adicionar</button></label>
        </div>
    </div>

    @{
        var custos = Custos;
        var entrada = PricingDaProposta.EntradaDe(_o, custos.Nacionais, custos.Importados);
        var pr = PricingAtual(custos);
        var margemPrecos = MargemDosPrecos(custos);
        var pendencias = PricingDaProposta.Pendencias(_o);
        var riscoPadrao = CalculoPricing.RiscoPadraoDo(_o.SegmentoMargem, _o.Product);
        var margemPadrao = ListasDoPricing.MargemPadraoDo(_o.SegmentoMargem);
        var moedaVenda = Cambio.MoedaDoPreco(_o);
        var converte = Cambio.Converte(_o);
        var comFianca = Textos.Igual(_o.FiancaSeguro, "Sim");
        var demais = DemaisCustos(custos, pr);
    }
    <div class="panel pricing" style="margin-bottom:16px">
        <div class="dash-title">Pricing
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                a mesma conta da aba PRICING da planilha R_HSAXYZ0000-0 · usa os campos do cabeçalho acima · custo em R$
            </span>
        </div>
        <div class="pricing-campos">
            <label>Risco adicional (%)
                <input class="cell num" type="number" min="0" step="0.01" value="@Pct100(_o.RiscoAdicional)"
                       @onchange="e => _o.RiscoAdicional = Fracao(e, _o.RiscoAdicional)" />
                <small class="pricing-dica">padrão @Pct(riscoPadrao)@(riscoPadrao == CalculoPricing.RiscoReduzido ? " (NB com este produto)" : "")</small>
            </label>
            <label>Margem de negociação (%)
                <input class="cell num" type="number" min="0" step="0.01" value="@Pct100(_o.MargemNegociacao)"
                       @onchange="e => _o.MargemNegociacao = Fracao(e, _o.MargemNegociacao)" />
                <small class="pricing-dica">padrão @Pct(CalculoPricing.MargemNegociacaoPadrao)</small>
            </label>
            <div class="pricing-modo-campo">
                <span>Montar preço</span>
                <div class="pricing-modo">
                    <button class="@(PelaMargem ? "btn-primary" : "btn-ghost")" @onclick='() => _o.PricingModo = "margem"'>a partir da margem</button>
                    <button class="@(PelaMargem ? "btn-ghost" : "btn-primary")" @onclick='() => _o.PricingModo = "preco"'>a partir do preço</button>
                </div>
            </div>
            @if (PelaMargem)
            {
                <label>Margem pedida (%)
                    <input class="cell num" type="number" min="0" max="99" step="0.1" value="@Pct100(_o.MargemAlvo)"
                           @onchange="e => _o.MargemAlvo = Fracao(e, _o.MargemAlvo)" />
                    <small class="pricing-dica">padrão do segmento @(_o.SegmentoMargem.Length > 0 ? _o.SegmentoMargem : "(preencher)"): @Pct(margemPadrao)</small>
                </label>
            }
            else
            {
                <label>Preço de venda: venda líquida (R$)
                    <input class="cell num" type="number" min="0" step="0.01" placeholder="quanto o cliente aceita"
                           value="@(_o.PrecoMeta > 0 ? _o.PrecoMeta.ToString(CultureInfo.InvariantCulture) : "")"
                           @onchange="e => _o.PrecoMeta = Numero(e) is decimal v && v > 0 ? v : 0" />
                    <small class="pricing-dica">sem impostos, em R$ (a moeda do custo)</small>
                </label>
            }
        </div>

        @* moeda do preço ao cliente: a mesma regra do axiaisvent (Data/Cambio.cs) *@
        <div class="pricing-moeda">
            <div class="pricing-moeda-linha">
                <strong>Preço ao cliente em</strong>
                <div class="seg" role="group" aria-label="Moeda do preço ao cliente">
                    @foreach (var m in Moedas.DePreco)
                    {
                        var moeda = m;
                        <button class="@(moedaVenda == moeda ? "on" : "")" @onclick="() => EscolherMoedaVenda(moeda)">@moeda.Rotulo()</button>
                    }
                </div>
                @if (converte)
                {
                    <span class="pricing-par">
                        <span class="pricing-rot">Taxa</span>
                        <select class="cell" value="@_o.CambioDirecao" aria-label="Sentido da taxa"
                                @onchange='e => _o.CambioDirecao = e.Value?.ToString() ?? "VendaEmCusto"'>
                            <option value="VendaEmCusto">1 @moedaVenda.Rotulo() em R$</option>
                            <option value="CustoEmVenda">1 R$ em @moedaVenda.Rotulo()</option>
                        </select>
                        <span>=</span>
                        <input class="cell num pricing-taxa" type="number" min="0" step="0.0001" placeholder="0,00"
                               value="@(_o.CambioTaxa > 0 ? Num(_o.CambioTaxa, "0.######") : "")" @onchange="MudarCambioTaxa" />
                    </span>
                    <span class="pricing-par">
                        <span class="pricing-rot" title="tirada da taxa: se a moeda cair até este tanto, o valor em R$ não perde">Segurança</span>
                        <input class="cell num pricing-seguranca" type="number" min="0" max="99" step="0.5" placeholder="0"
                               value="@(_o.CambioSeguranca > 0 ? Num(_o.CambioSeguranca) : "")"
                               @onchange="e => _o.CambioSeguranca = Numero(e) is decimal v ? Math.Clamp(v, 0m, 99m) : 0m" />
                        <span>%</span>
                    </span>
                }
                else
                {
                    <span class="pricing-dica">custo e preço em R$: sem conversão</span>
                }
            </div>
            @if (converte)
            {
                @if (_taxaDoDia)
                {
                    @* é a última taxa gravada na aba Conversão, não a do dia: a data diz de quando *@
                    <div class="@(TaxaVelha ? "taxa-origem velha" : "taxa-origem")">
                        taxa da aba Conversão@(TaxaAtualizadaEm is { } atualizada ? $", atualizada em {atualizada:dd/MM/yyyy}" : "")@(TaxaVelha ? " — confira se ainda vale" : "")
                    </div>
                }
                @if (Cambio.Normalizada(_o) > 0m)
                {
                    var taxaBase = Cambio.Normalizada(_o);
                    <div class="pricing-confira">
                        Confira: <strong>1 @moedaVenda.Rotulo() = R$ @taxaBase.ToString("N4", PtBr)</strong>
                        · 1 R$ = @moedaVenda.Rotulo() @((1m / taxaBase).ToString("N6", PtBr))
                    </div>
                    @if (Cambio.Seguranca(_o) > 0m)
                    {
                        <div class="pricing-dica">
                            convertendo por R$ @Cambio.Efetivo(_o).ToString("N4", PtBr) por @moedaVenda.Rotulo() —
                            se a moeda cair até @Cambio.Seguranca(_o).ToString("0.##", PtBr)%, o valor em R$ não perde
                        </div>
                    }
                }
                else
                {
                    <div class="imp-pendencia" style="margin-top:6px">
                        Informe a taxa de conversão — sem ela o preço sai como se já estivesse em @moedaVenda.Rotulo().
                        A taxa do dia pode ficar gravada na <a href="/conversao">aba Conversão</a>.
                    </div>
                }
                @if (OfertaDaTaxa() is { } oferta)
                {
                    <div class="preco-oferta">
                        <span>@oferta.Texto</span>
                        <button class="btn-link" @onclick="UsarTaxaDaConversao">usar esta</button>
                    </div>
                }
            }
        </div>

        @* CÁLCULO DE CUSTO (E14:I34) *@
        <details class="pricing-secao" open>
            <summary>Cálculo de custo <span>@Fmt.Brl(pr.CustoTotal) · com variação @Fmt.Brl(pr.CustoComVariacao)</span></summary>
            <div class="tabela-rolante">
            <table class="grid custo-tabela">
                <thead>
                    <tr><th>Descrição</th><th class="right">Itens da proposta (R$)</th><th class="right">Valores (R$)</th>
                        <th class="right">Risco (%)</th><th class="right">Custo com variação (R$)</th><th class="right">Partic.</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in CalculoPricing.LinhasDeCusto)
                    {
                        var cod = l.Codigo;
                        var manual = CustoManual(cod);
                        decimal? itens = cod == "COMPRADOS" ? custos.Nacionais : cod == "IMPORTADOS" ? custos.Importados : null;
                        var valor = (manual?.Valor ?? 0m) + (itens ?? 0m);
                        var comVar = valor * (1m + (manual?.Variacao ?? 0m));
                        <tr class="@(valor != 0m ? "custo-com-valor" : "")">
                            <td>@l.Nome
                                @if (l.MaoDeObra) { <span class="selo-mo" title="entra na parte MO de Reforma/Service">MO</span> }
                                @if (cod == "COMPRADOS") { <span class="sub-cel">recebe os itens nacionalizados</span> }
                                @if (cod == "IMPORTADOS") { <span class="sub-cel">recebe os itens importados (custo da importação)</span> }
                            </td>
                            <td class="right nowrap">@(itens is decimal iv ? Fmt.Brl(iv) : "")</td>
                            <td class="right"><input class="cell num custo-cel" type="number" step="0.01" placeholder="@(itens is null ? "0" : "+ adicional")"
                                       value="@(manual is { Valor: not 0m } ? Num(manual.Valor) : "")" @onchange="e => MudarCusto(cod, e, false)" /></td>
                            <td class="right"><input class="cell num risco-cel" type="number" step="0.1" placeholder="0"
                                       value="@(manual is { Variacao: not 0m } ? Num(manual.Variacao * 100m) : "")" @onchange="e => MudarCusto(cod, e, true)" /></td>
                            <td class="right nowrap">@(valor != 0m ? Fmt.Brl(comVar) : "")</td>
                            <td class="right">@(pr.CustoTotal > 0 && valor != 0m ? Pct(valor / pr.CustoTotal) : "")</td>
                        </tr>
                    }
                    <tr class="memoria-total"><td>TOTAL</td><td></td><td class="right nowrap">@Fmt.Brl(pr.CustoTotal)</td>
                        <td class="right">@(pr.CustoTotal > 0 ? Pct(1m - pr.CustoTotal / (pr.CustoComVariacao == 0 ? 1 : pr.CustoComVariacao)) : "")</td>
                        <td class="right nowrap">@Fmt.Brl(pr.CustoComVariacao)</td><td class="right">@(pr.CustoTotal > 0 ? "100%" : "")</td></tr>
                </tbody>
            </table>
            </div>
            @if (custos.SemCusto.Count > 0)
            {
                <div class="imp-pendencia">
                    Itens sem custo, fora da conta: @string.Join(" · ", custos.SemCusto.Where(i => i != _itemDemais).Select(NomeCurto)).
                    Marque como importado (com o preço na moeda) ou cadastre o Valor BR na Nacionalização.
                </div>
            }
        </details>

        @if (comFianca)
        {
            var vlF = pr.VendaLiquida;
            var prazo = PricingDaProposta.PrazoEmDias(_o.PrazoEntrega);
            var taxaG = ListasDoPricing.TaxaDaGarantia(_o.TipoGarantia);
            var taxaO = ListasDoPricing.TaxaDaGarantia(_o.TipoOutrasGarantias);
            <details class="pricing-secao" open>
                <summary>Seguro garantia ou carta fiança <span>@Fmt.Brl(pr.Fianca) (E43) · cobertura até o prazo de entrega: @prazo dias</span></summary>
                <div class="pricing-campos pricing-fianca">
                    <label>Tipo (seguro garantia ou carta fiança)
                        <select class="cell" @bind="_o.TipoGarantia">
                            <option value="">preencher (5% a.a.)</option>
                            @foreach (var (nome, taxa) in ListasDoPricing.TiposGarantia) { <option value="@nome">@nome (@Pct(taxa) a.a.)</option> }
                        </select>
                    </label>
                    <label>Outras garantias (tipo)
                        <select class="cell" @bind="_o.TipoOutrasGarantias">
                            <option value="">preencher (5% a.a.)</option>
                            @foreach (var (nome, taxa) in ListasDoPricing.TiposGarantia) { <option value="@nome">@nome (@Pct(taxa) a.a.)</option> }
                        </select>
                    </label>
                </div>
                <div class="garantias">
                    <div class="tabela-rolante">
                    <table class="grid garantia-tabela">
                        <thead><tr><th>Evento nº</th><th class="right">Cond. pagto (%)</th><th class="right">Prazo eventos (dias)</th>
                            <th class="right">Aproximado (R$)</th><th class="right">Dias cobert.</th><th class="right">Porc. anual</th><th class="right">Custo (R$)</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < 10; i++)
                            {
                                var k = i;
                                var ev = k < _o.EventosFianca.Count ? _o.EventosFianca[k] : new CalculoPricing.EventoDePagamento(0m, CalculoPricing.PrazosPadraoDosEventos[k]);
                                var aprox = vlF * ev.Percentual;
                                var diasCob = Math.Max(prazo - ev.PrazoDias, 0);
                                <tr>
                                    <td>@(k + 1)</td>
                                    <td class="right"><input class="cell num risco-cel" type="number" min="0" max="100" step="1" value="@Num(ev.Percentual * 100m)" @onchange="e => MudarEvento(k, e, false)" /></td>
                                    <td class="right"><input class="cell num risco-cel" type="number" min="0" step="1" value="@ev.PrazoDias" @onchange="e => MudarEvento(k, e, true)" /></td>
                                    <td class="right nowrap">@Fmt.Brl(aprox)</td><td class="right">@diasCob</td><td class="right">@Pct(taxaG)</td>
                                    <td class="right nowrap">@Fmt.Brl(aprox * diasCob * taxaG / 365m)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <div class="tabela-rolante">
                    <table class="grid garantia-tabela">
                        <thead><tr><th>Outras garantias</th><th class="right">Porc. da garantia (%)</th><th class="right">Dias cobert.</th>
                            <th class="right">Aproximado (R$)</th><th class="right">Porc. anual</th><th class="right">Custo (R$)</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _o.OutrasGarantias.Count; i++)
                            {
                                var k = i;
                                var g = _o.OutrasGarantias[k];
                                var aprox = vlF * g.Percentual;
                                <tr>
                                    <td>@g.Tipo</td>
                                    <td class="right"><input class="cell num risco-cel" type="number" min="0" max="100" step="1" value="@Num(g.Percentual * 100m)" @onchange="e => MudarOutraGarantia(k, e, false)" /></td>
                                    <td class="right"><input class="cell num risco-cel" type="number" min="0" step="1" value="@g.DiasCobertura" @onchange="e => MudarOutraGarantia(k, e, true)" /></td>
                                    <td class="right nowrap">@Fmt.Brl(aprox)</td><td class="right">@Pct(taxaO)</td>
                                    <td class="right nowrap">@Fmt.Brl(aprox * g.DiasCobertura * taxaO / 365m)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </details>
        }

        @if (pendencias.Count > 0)
        {
            <div class="imp-pendencia">
                Ainda está "preencher": @string.Join(" · ", pendencias).
                A conta já sai, com o que a planilha faz nesse caso.
            </div>
        }

        @if (pr.CustoTotal <= 0)
        {
            <div class="empty" style="padding:12px 0 2px">
                O pricing aparece quando há custo: itens importados ou nacionalizados com referência de custo, ou valores na tabela de custo.
            </div>
        }
        else if (pr.VendaLiquida <= 0)
        {
            <div class="alert-error" style="margin-top:10px">
                @if (PelaMargem)
                {
                    <span>Margem pedida alta demais: com @Pct(pr.PercentuaisDeVenda) de comissões e percentuais de venda
                    e @Pct(CalculoPricing.FatorFianca(entrada)) de fiança/garantias, a margem tem de ficar abaixo de
                    @Pct(1 - pr.PercentuaisDeVenda - CalculoPricing.FatorFianca(entrada)).</span>
                }
                else
                {
                    <span>Informe o preço de venda (venda líquida, sem impostos) para ver a margem.</span>
                }
            </div>
        }
        else
        {
            @foreach (var aviso in pr.Avisos)
            {
                <div class="pricing-aviso">@aviso</div>
            }
            <div class="imp-resumo">
                <div class="escolhido">
                    <span>Venda líquida (sem impostos)</span>
                    <strong>@Fmt.Brl(pr.VendaLiquida)</strong>
                    <small>markup @pr.Markup.ToString("N4", PtBr)@(converte ? " · " + VendaDe(pr.VendaLiquida) : "")</small>
                </div>
                <div>
                    <span>Project Margin</span>
                    <strong>@Pct(pr.Margem)</strong>
                    <small>@Fmt.Brl(pr.VendaLiquida * pr.Margem) · padrão do segmento @Pct(pr.MargemPadrao)</small>
                </div>
                <div>
                    <span>Preço ao cliente (@moedaVenda.Rotulo())</span>
                    @if (pr.PrecoAoCliente is decimal pac)
                    {
                        <strong>@VendaDe(pac)</strong>
                        <small>@(pr.ExportacaoComBackToBack || pr.BackToBack100 ? "Back to Back, com PIS/COFINS do B2B" : pr.SemImpostos ? "exportação: sem impostos" : pr.ServicoOuReforma ? "MP com PIS, COFINS, ICMS e IPI + MO com ISS" : "com PIS, COFINS, ICMS e IPI")</small>
                    }
                    else
                    {
                        <strong>—</strong>
                        <small>@(pr.ProcurarFinanceiro ? "procurar Financeiro" : "informe o Estado")</small>
                    }
                </div>
            </div>

            @* quadro PREÇO DE VENDA (K12:T24), na moeda do preço *@
            <div class="quadro-venda">
                <div class="quadro-venda-titulo">@pr.TituloDoQuadro <span>@pr.ImpostosDoQuadro · valores em @moedaVenda.Rotulo()</span></div>
                <table class="grid">
                    <thead><tr><th></th><th class="right">%</th><th class="right">Valor (@moedaVenda.Rotulo())</th><th class="right">fator</th></tr></thead>
                    <tbody>
                        @foreach (var lq in pr.Quadro)
                        {
                            var rotuloLq = lq.Rotulo == "Valores na moeda do cliente (sem impostos)" ? $"Valores em {moedaVenda.Rotulo()} (sem impostos)" : lq.Rotulo;
                            <tr class="@(lq.Celula is "K16" or "K23" ? "memoria-total" : "")">
                                <td>@rotuloLq <span class="cel-ref">@lq.Celula</span></td>
                                <td class="right">@(lq.AliquotaTexto ?? (lq.Aliquota is decimal al ? Pct(al) : ""))</td>
                                <td class="right nowrap">@(lq.Valor is decimal lv ? VendaDe(lv) : lq.Texto ?? "—")</td>
                                <td class="right">@(lq.Fator is decimal fa ? fa.ToString("N4", PtBr) : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button class="btn-link" style="margin-top:6px" @onclick="() => _verPricing = !_verPricing">
                @(_verPricing ? "esconder linhas do pricing" : "ver todas as linhas do pricing (em R$)")
            </button>
            @if (_verPricing)
            {
                var vl = pr.VendaLiquida;
                <div class="tabela-rolante">
                <table class="grid pricing-tabela">
                    <thead><tr><th>Linha do pricing</th><th>Célula</th><th class="right">Valor (R$)</th><th class="right">%</th></tr></thead>
                    <tbody>
                        <tr><td><strong>Custo total</strong></td><td class="cel-ref">E34</td><td class="right nowrap">@Fmt.Brl(pr.CustoTotal)</td><td class="right">—</td></tr>
                        <tr><td>Risco de variação de preços</td><td class="cel-ref">E36</td><td class="right nowrap">@Fmt.Brl(pr.RiscoDeVariacao)</td><td class="right">—</td></tr>
                        <tr><td>Risco adicional</td><td class="cel-ref">D37 · E37</td><td class="right nowrap">@Fmt.Brl(pr.RiscoAdicional)</td><td class="right">@Pct(_o.RiscoAdicional)</td></tr>
                        <tr><td>Total de risco</td><td class="cel-ref">E38</td><td class="right nowrap">@Fmt.Brl(pr.Risco)</td><td class="right">@(pr.CustoComVariacao > 0 ? Pct(pr.Risco / pr.CustoComVariacao) : "—")</td></tr>
                        <tr><td><strong>Custo total com riscos</strong></td><td class="cel-ref">E39</td><td class="right nowrap">@Fmt.Brl(pr.CustoComRiscos)</td><td class="right">—</td></tr>
                        <tr><td>Markup</td><td class="cel-ref">E41</td><td class="right nowrap">@pr.Markup.ToString("N4", PtBr)</td><td class="right">—</td></tr>
                        <tr><td>Venda pura</td><td class="cel-ref">E42</td><td class="right nowrap">@Fmt.Brl(pr.VendaPura)</td><td class="right">—</td></tr>
                        <tr><td>Seguro garantia ou fiança</td><td class="cel-ref">E43</td><td class="right nowrap">@Fmt.Brl(pr.Fianca)</td><td class="right">@(vl > 0 ? Pct(pr.Fianca / vl) : "—")</td></tr>
                        <tr>
                            <td>Comissões
                                <span class="sub-cel">PPR @Pct(CalculoPricing.Ppr) · ELG @Pct(CalculoPricing.Elg) · DSR @Pct(CalculoPricing.Dsr * CalculoPricing.Elg)
                                    · Rep 1 @Pct(PricingDaProposta.ComissaoDe(_o.Rep1, _o.SegmentoMargem)) · Rep 2 @Pct(PricingDaProposta.ComissaoDe(_o.Rep2, _o.SegmentoMargem))</span>
                            </td>
                            <td class="cel-ref">D46</td><td class="right nowrap">@Fmt.Brl(vl * pr.Comissoes)</td><td class="right">@Pct(pr.Comissoes)</td>
                        </tr>
                        <tr><td>Margem negoc.</td><td class="cel-ref">D47</td><td class="right nowrap">@Fmt.Brl(vl * _o.MargemNegociacao)</td><td class="right">@Pct(_o.MargemNegociacao)</td></tr>
                        <tr><td>PM + SACH</td><td class="cel-ref">D48</td><td class="right nowrap">@Fmt.Brl(vl * CalculoPricing.PmSach)</td><td class="right">@Pct(CalculoPricing.PmSach)</td></tr>
                        <tr><td>Garantia do projeto</td><td class="cel-ref">D49</td><td class="right nowrap">@Fmt.Brl(vl * CalculoPricing.GarantiaDoProjeto)</td><td class="right">@Pct(CalculoPricing.GarantiaDoProjeto)</td></tr>
                        <tr><td>Portal <span class="sub-cel">@(_o.Portal.Length > 0 ? _o.Portal : "preencher")</span></td><td class="cel-ref">D50</td><td class="right nowrap">@Fmt.Brl(vl * pr.Portal)</td><td class="right">@Pct(pr.Portal)</td></tr>
                        <tr class="memoria-total"><td>Venda líquida (sem impostos)</td><td class="cel-ref">E52</td><td class="right nowrap">@Fmt.Brl(vl)</td><td class="right">—</td></tr>
                        <tr><td>Std Project Margin <span class="sub-cel">padrão do segmento</span></td><td class="cel-ref">D54</td><td class="right">—</td><td class="right">@Pct(pr.MargemPadrao)</td></tr>
                        <tr><td><strong>Project Margin [PM]</strong></td><td class="cel-ref">D55</td><td class="right nowrap">@Fmt.Brl(vl * pr.Margem)</td><td class="right"><strong>@Pct(pr.Margem)</strong></td></tr>
                        <tr><td>Protected PM</td><td class="cel-ref">D56</td><td class="right nowrap">@Fmt.Brl(vl * pr.MargemProtegida)</td><td class="right">@Pct(pr.MargemProtegida)</td></tr>
                        <tr><td>Total Project Margin</td><td class="cel-ref">D57</td><td class="right nowrap">@Fmt.Brl(vl * pr.MargemTotal)</td><td class="right">@Pct(pr.MargemTotal)</td></tr>
                        <tr><td>Contribution Margin [CM]</td><td class="cel-ref">D58</td><td class="right nowrap">@Fmt.Brl(vl * pr.MargemDeContribuicao)</td><td class="right">@Pct(pr.MargemDeContribuicao)</td></tr>
                        <tr><td>Net Cost Basis (Salesforce)</td><td class="cel-ref">Q28</td><td class="right nowrap">@Fmt.Brl(pr.NetCostBasis)</td><td class="right">—</td></tr>
                        <tr><td>PIS</td><td class="cel-ref">D61 · E61</td><td class="right nowrap">@Fmt.Brl(pr.ValorPis)</td><td class="right">@Pct(pr.AliqPis)</td></tr>
                        <tr><td>COFINS</td><td class="cel-ref">D62 · E62</td><td class="right nowrap">@Fmt.Brl(pr.ValorCofins)</td><td class="right">@Pct(pr.AliqCofins)</td></tr>
                        <tr><td>ICMS <span class="sub-cel">@(_o.Estado.Length > 0 ? _o.Estado : "estado?"), coluna @(Textos.Igual(_o.Bu, "HSA-SP") ? "HSA-SP" : "HSA-ES")@(Textos.Igual(_o.NcmReducaoIcms, "Sim") ? ", base reduzida" : "")</span></td>
                            <td class="cel-ref">D63 · E63</td><td class="right nowrap">@(pr.ValorIcms is decimal vi ? Fmt.Brl(vi) : "—")</td><td class="right">@(pr.AliqIcms is decimal ai ? Pct(ai) : "—")</td></tr>
                        <tr><td>IPI</td><td class="cel-ref">D64 · E64</td><td class="right nowrap">@(pr.ValorIpi is decimal vp ? Fmt.Brl(vp) : "—")</td><td class="right">@Pct(pr.AliqIpi)</td></tr>
                        @if (pr.ValorBackToBack is decimal vb)
                        {
                            <tr><td>Back to Back</td><td class="cel-ref">D65 · E65</td><td class="right nowrap">@Fmt.Brl(vb)</td><td class="right">@Pct(CalculoPricing.ImpostoBackToBack)</td></tr>
                        }
                        @if (pr.ServicoOuReforma)
                        {
                            <tr><td>@(Textos.Igual(_o.Bu, "HSA-SP") ? "ISS - Itatiba" : "ISS - Serra")</td><td class="cel-ref">D66 · E66</td><td class="right nowrap">@(pr.ValorIss is decimal vis ? Fmt.Brl(vis) : "—")</td><td class="right">@Pct(pr.AliqIss)</td></tr>
                            <tr><td>ISS - Outro Munic.</td><td class="cel-ref">D67 · E67</td><td class="right nowrap">@(pr.ValorIssOutro is decimal vio ? Fmt.Brl(vio) : "—")</td><td class="right">@Pct(pr.AliqIssOutro)</td></tr>
                        }
                        @if (pr.Retencao is decimal ret)
                        {
                            <tr><td>Retenção</td><td class="cel-ref">D68 · E68</td><td class="right nowrap">@(pr.ValorRetencao is decimal vr ? Fmt.Brl(vr) : "consultar Financeiro")</td><td class="right">@Pct(ret)</td></tr>
                        }
                        @if (pr.ProdutoBackToBackFinanceiro is decimal s84)
                        {
                            <tr><td>Prod. B2B (s/ impostos) <span class="sub-cel">só vale para o Financeiro: o B2B precisa incluir PIS e COFINS</span></td><td class="cel-ref">S84</td><td class="right nowrap">@Fmt.Brl(s84)</td><td class="right">—</td></tr>
                        }
                    </tbody>
                </table>
                </div>
            }

            <div class="pricing-acoes">
                <button class="btn-primary" @onclick="AplicarPricing">Aplicar preços do pricing nos @custos.ComCusto.Count item(ns) com custo</button>
                <span>
                    Preço unitário sem impostos (como diz a proposta), em @moedaVenda.Rotulo(), proporcional ao custo de cada item
                    (fator @PricingDaProposta.Fator(pr).ToString("N4", PtBr)). Só muda quando você clica; depois dá para ajustar à mão.
                    @if (margemPrecos is decimal mp)
                    {
                        <br /><span>Com os preços que estão hoje nesses itens, a margem fica em <strong>@Pct(mp)</strong>.</span>
                    }
                </span>
            </div>
            @if (demais > 0.005m)
            {
                <div class="pricing-acoes">
                    <button class="btn-ghost" @onclick="AdicionarDemais">@(_itemDemais is not null && _items.Contains(_itemDemais) ? "Atualizar" : "Incluir") item "Serviços e demais custos"</button>
                    <span>A tabela de custo tem @Fmt.Brl(demais) além dos itens (@NomesDosDemais()) — no preço, @VendaDe(demais * PricingDaProposta.Fator(pr)).
                        Inclua como item da proposta para cobrar à parte.</span>
                </div>
            }
        }
    </div>

    <div class="panel">
        <div class="dash-title">Condições comerciais</div>
        <div class="form-grid">
            <label>Introdução <textarea class="cell" @bind="_o.IntroText"></textarea></label>
            <label>Condição de pagamento
                <select class="cell" @bind="_o.PaymentTerms">
                    @foreach (var p in OfferDefaults.PaymentOptions) { <option value="@p">@p</option> }
                </select>
            </label>
            <label>Prazo de entrega (texto da proposta) <textarea class="cell" @bind="_o.DeliveryTime"></textarea></label>
            <label>Local de entrega (Incoterms)
                <select class="cell" @bind="_o.Incoterm">
                    @foreach (var i in ListasDaProposta.Incoterms) { <option value="@i.Codigo">@i.Rotulo</option> }
                </select>
            </label>
            @if (ListasDaProposta.Incoterms.FirstOrDefault(x => x.Codigo == _o.Incoterm) is { PedeLocal: true } inc)
            {
                <label>Local de entrega (@(inc.Codigo == "FCA-AEROPORTO" ? "aeroporto" : "destino e país"))
                    <input class="cell" placeholder="@(inc.Codigo == "FCA-AEROPORTO" ? "ex.: de Guarulhos – SP" : "ex.: Callao (Peru)")" @bind="_o.IncotermLocal" />
                    <small class="pricing-dica">na proposta: @ListasDaProposta.LinhaDoIncoterm(_o.Incoterm, _o.IncotermLocal)</small>
                </label>
            }
            <label>Validade <input class="cell" @bind="_o.ValidityText" /></label>
            <label>Observações <textarea class="cell" style="min-height:90px" @bind="_o.Observations"></textarea></label>
            <label>Termos e condições <textarea class="cell" @bind="_o.TermsText"></textarea></label>
        </div>
    </div>
  </div>

  <div class="prop-side">
    <div class="side-total">
        <div>Total da oferta@(Cambio.Converte(_o) ? $" ({Cambio.MoedaDoPreco(_o).Rotulo()})" : "")</div>
        <div class="side-total-value">@Venda(Total)</div>
    </div>
    @if (_items.Count > 0)
    {
        <div class="side-note">
            @_items.Count item(ns)
            @if (_items.Count(i => i.UnitPrice <= 0) is > 0 and var semPreco)
            {
                <br /><span style="color:#b45309;font-weight:600">@semPreco sem preço definido</span>
            }
            @if (MargemDosPrecos(Custos) is decimal mLateral)
            {
                <br /><span>Margem (itens com custo): <strong>@Pct(mLateral)</strong></span>
            }
        </div>
    }
    <div class="side-note">O documento imprimível é gerado após salvar. Custo de referência e última venda não aparecem para o cliente.</div>
    @if (_erro is not null) { <div class="alert-error">@_erro</div> }
    <button class="btn-accent btn-block" @onclick="Salvar">Salvar oferta</button>
    <a class="btn-ghost btn-block" href="/ofertas">Cancelar</a>
  </div>
</div>

@code {
    private List<ClientUnit> _units = new();
    private List<InstalledBase> _base = new();
    private List<Part> _parts = new();
    private List<Equipment> _equipamentos = new();
    private List<BomItem> _bom = new();
    private List<Nacionalizacao> _nacionais = new();
    private List<SalesRecord> _vendas = new();

    private CommercialOffer _o = new()
    {
        Status = "Rascunho",
        IntroText = OfferDefaults.Intro, TaxText = OfferDefaults.Tax, PaymentTerms = OfferDefaults.Payment,
        DeliveryTime = OfferDefaults.DeliveryTime, DeliveryConditions = OfferDefaults.DeliveryConditions,
        ValidityText = OfferDefaults.Validity, Observations = OfferDefaults.Observations,
        SgiText = OfferDefaults.Sgi, TermsText = OfferDefaults.Terms,
    };
    private List<CommercialOfferItem> _items = new();
    private string _unitId = "";
    private readonly List<string> _equipIds = new();          // equipamentos marcados, na ordem em que foram marcados
    private readonly HashSet<string> _bomMarcados = new();    // ids de BomItem marcados para adicionar
    private string _bomBusca = "";
    private string _desc = "";
    private int _qtd = 1;
    private decimal _preco;
    private string? _erro;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private List<CommercialOffer> _anteriores = new();
    // último valor preenchido automaticamente: só é trocado se o usuário não mexeu nele
    private string _autoUf = "", _autoMercado = "", _autoAno = "";
    private decimal _autoRisco = CalculoPricing.RiscoPadrao, _autoMargem = ListasDoPricing.MargemPadraoDo("AFM");

    private bool _verMemoria, _verPricing;
    private static readonly string[] MoedasImportacao = { "EUR", "USD", "GBP", "OUTRA" };
    private static readonly CultureInfo PtBr = new("pt-BR");

    // ---- pricing (planilha R_HSAXYZ0000-0, ligada em Data/PricingDaProposta.cs) ----

    private bool PelaMargem => _o.PricingModo != "preco";

    /// <summary>Valor gravado que não está na lista da planilha (proposta antiga): continua visível no select.</summary>
    private static RenderFragment ForaDaLista(string? atual, IEnumerable<string> lista) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(atual) && !lista.Contains(atual))
        {
            <option value="@atual">@atual (fora da lista do pricing)</option>
        }
    };

    private static string RotuloPortal(ListasDoPricing.OpcaoPortal p) =>
        p.Teto is decimal t ? $"{p.Nome} (teto {t.ToString("N0", PtBr)})"
        : p.Percentual == 0 ? p.Nome : $"{p.Nome} ({Pct(p.Percentual)})";

    private void MudarPrazo(ChangeEventArgs e) =>
        _o.PrazoEntrega = Numero(e) is decimal d && d > 0 ? ((int)Math.Round(d)).ToString(CultureInfo.InvariantCulture) : "";

    /// <summary>Destino define a lista de Estado (J6 = INDIRECT(J5&"_")): o que não serve mais sai.</summary>
    private void DestinoMudou()
    {
        var opcoes = ListasDoPricing.EstadosDo(_o.Destino);
        if (!opcoes.Contains(_o.Estado)) _o.Estado = opcoes.Length == 1 ? opcoes[0] : "";
    }

    /// <summary>Categories define a lista de Product (P8 = INDIRECT(P7&"_")).</summary>
    private void CategoriaMudou()
    {
        if (!ListasDoPricing.ProdutosDa(_o.Categories).Contains(_o.Product)) _o.Product = "";
        SegmentoOuProdutoMudou();
    }

    /// <summary>Risco (D37) e margem pedida seguem o padrão do segmento/produto, se ninguém mexeu neles.</summary>
    private void SegmentoOuProdutoMudou()
    {
        _o.RiscoAdicional = AutoDec(_o.RiscoAdicional, ref _autoRisco, CalculoPricing.RiscoPadraoDo(_o.SegmentoMargem, _o.Product));
        _o.MargemAlvo = AutoDec(_o.MargemAlvo, ref _autoMargem, ListasDoPricing.MargemPadraoDo(_o.SegmentoMargem));
    }

    private static decimal AutoDec(decimal atual, ref decimal ultimoAuto, decimal novo)
    {
        var podeTrocar = atual == ultimoAuto;
        ultimoAuto = novo;
        return podeTrocar ? novo : atual;
    }

    /// <summary>52% → "52%"; 0,014 → "1,4%".</summary>
    private static string Pct(decimal fracao) => (fracao * 100).ToString("0.##", PtBr) + "%";
    /// <summary>Valor do campo em %, para o input (0,52 → "52").</summary>
    private static string Pct100(decimal fracao) => (fracao * 100).ToString("0.####", CultureInfo.InvariantCulture);
    /// <summary>O que foi digitado em % vira fração; vazio ou inválido mantém o valor anterior.</summary>
    private static decimal Fracao(ChangeEventArgs e, decimal atual) =>
        Numero(e) is decimal v && v >= 0 && v < 100 ? v / 100m : atual;

    /// <summary>Custo dos itens que entram no pricing: importação (unitário no modo escolhido) ou Valor BR do nacionalizado.</summary>
    private record CustoDosItens(decimal Total, decimal Importados, decimal Nacionais,
        List<(CommercialOfferItem It, decimal Unit)> ComCusto, List<CommercialOfferItem> SemCusto);

    private CustoDosItens Custos
    {
        get
        {
            Dictionary<CommercialOfferItem, decimal>? imp = null;
            if (_items.Any(i => i.Importado) && !string.IsNullOrEmpty(_o.ImportacaoModo))
            {
                var calc = Importacoes;
                imp = _o.ImportacaoModo == "item" ? calc.UnitarioPorItem : calc.UnitarioPorTotal;
            }
            var com = new List<(CommercialOfferItem, decimal)>();
            var sem = new List<CommercialOfferItem>();
            decimal importados = 0, nacionais = 0;
            foreach (var it in _items)
            {
                decimal? unit = null;
                if (it.Importado)
                {
                    if (imp is not null && imp.TryGetValue(it, out var u)) unit = u;
                }
                else if (it.PartNumber.Length > 0)
                {
                    var r = RefDoItem(it);
                    if (r.Nacionalizado) unit = r.Custo;
                }
                if (unit is decimal c && c > 0)
                {
                    com.Add((it, c));
                    if (it.Importado) importados += c * it.Quantity; else nacionais += c * it.Quantity;
                }
                else sem.Add(it);
            }
            return new CustoDosItens(importados + nacionais, importados, nacionais, com, sem);
        }
    }

    /// <summary>O pricing da proposta como está na tela (custos dos itens + tabela de custo).</summary>
    private CalculoPricing.Resultado PricingAtual(CustoDosItens c) => PricingDaProposta.Da(_o, c.Nacionais, c.Importados);

    /// <summary>
    /// Margem com os preços digitados nos itens com custo: só quando todo item
    /// com custo tem preço, a tabela de custo não tem linha digitada à parte e o
    /// destino não é Back to Back (aí o preço não é a venda líquida).
    /// </summary>
    private decimal? MargemDosPrecos(CustoDosItens c)
    {
        if (c.Total <= 0 || c.ComCusto.Any(x => x.It.UnitPrice <= 0) || _o.CustosPricing.Any(x => x.Valor != 0m)) return null;
        if (Textos.Simples(_o.Destino).Contains("back to back")) return null;
        var venda = Cambio.ParaReais(_o, c.ComCusto.Sum(x => x.It.UnitPrice * x.It.Quantity));
        return CalculoPricing.PeloPreco(PricingDaProposta.EntradaDe(_o, c.Nacionais, c.Importados), venda).Margem;
    }

    /// <summary>Só por clique: leva o preço do pricing (sem impostos, na moeda do preço) aos itens com custo.</summary>
    private void AplicarPricing()
    {
        var c = Custos;
        var r = PricingAtual(c);
        if (r.CustoTotal <= 0 || r.VendaLiquida <= 0) return;
        foreach (var (it, unit) in c.ComCusto)
        {
            it.UnitPrice = PricingDaProposta.PrecoUnitario(_o, unit, r);
            it.TotalPrice = it.Quantity * it.UnitPrice;
        }
        if (_itemDemais is not null && _items.Contains(_itemDemais)) AtualizarDemais(r, c);
        _erro = null;
    }

    // item "Serviços e demais custos": o que a tabela de custo tem além dos itens
    private CommercialOfferItem? _itemDemais;

    private decimal DemaisCustos(CustoDosItens c, CalculoPricing.Resultado r) => r.CustoTotal - c.Total;

    private string NomesDosDemais() => string.Join(", ", _o.CustosPricing.Where(x => x.Valor != 0m)
        .Select(x => CalculoPricing.LinhasDeCusto.First(l => l.Codigo == x.Codigo).Nome));

    /// <summary>
    /// O nome do item que vai para o CLIENTE: só as linhas que são serviço
    /// (MO, engenharia, assessoria). Imprevistos e protected margin são termos
    /// internos do pricing e não saem na proposta.
    /// </summary>
    private string DescricaoDosDemais()
    {
        var internos = new[] { "PROTECTED", "IMPREVISTOS", "COMPRADOS", "IMPORTADOS", "BACK_TO_BACK" };
        var nomes = _o.CustosPricing.Where(x => x.Valor != 0m && !internos.Contains(x.Codigo))
            .Select(x => CalculoPricing.LinhasDeCusto.First(l => l.Codigo == x.Codigo).Nome).ToList();
        return nomes.Count > 0 ? $"Serviços ({string.Join(", ", nomes)})" : "Serviços e demais custos";
    }

    private void AdicionarDemais()
    {
        var c = Custos;
        var r = PricingAtual(c);
        if (_itemDemais is null || !_items.Contains(_itemDemais))
        {
            _itemDemais = new CommercialOfferItem { Quantity = 1 };
            _items.Add(_itemDemais);
        }
        AtualizarDemais(r, c);
    }

    private void AtualizarDemais(CalculoPricing.Resultado r, CustoDosItens c)
    {
        if (_itemDemais is null) return;
        _itemDemais.Description = DescricaoDosDemais();
        _itemDemais.Quantity = 1;
        _itemDemais.UnitPrice = PricingDaProposta.PrecoUnitario(_o, DemaisCustos(c, r), r);
        _itemDemais.TotalPrice = _itemDemais.UnitPrice;
    }

    // ---- tabela de custo, fiança e outras garantias (entradas do pricing) ----

    private CalculoPricing.Custo? CustoManual(string codigo) => _o.CustosPricing.FirstOrDefault(x => x.Codigo == codigo);

    private void MudarCusto(string codigo, ChangeEventArgs e, bool variacao)
    {
        var atual = CustoManual(codigo) ?? new CalculoPricing.Custo(codigo, 0m, 0m);
        var v = Numero(e) ?? 0m;
        var novo = variacao ? atual with { Variacao = v / 100m } : atual with { Valor = v };
        _o.CustosPricing.RemoveAll(x => x.Codigo == codigo);
        if (novo.Valor != 0m || novo.Variacao != 0m) _o.CustosPricing.Add(novo);
    }

    private void MudarEvento(int i, ChangeEventArgs e, bool prazo)
    {
        while (_o.EventosFianca.Count < 10) _o.EventosFianca.Add(new CalculoPricing.EventoDePagamento(0m, CalculoPricing.PrazosPadraoDosEventos[_o.EventosFianca.Count]));
        var ev = _o.EventosFianca[i];
        var v = Numero(e) ?? 0m;
        _o.EventosFianca[i] = prazo ? ev with { PrazoDias = (int)Math.Max(0, Math.Round(v)) } : ev with { Percentual = Math.Clamp(v, 0m, 100m) / 100m };
    }

    private void MudarOutraGarantia(int i, ChangeEventArgs e, bool dias)
    {
        var g = _o.OutrasGarantias[i];
        var v = Numero(e) ?? 0m;
        _o.OutrasGarantias[i] = dias ? g with { DiasCobertura = (int)Math.Max(0, Math.Round(v)) } : g with { Percentual = Math.Clamp(v, 0m, 100m) / 100m };
    }

    // ---- moeda do preço (como no axiaisvent, branch "Proposta v2") ----

    // a taxa veio da aba Conversão, e de quando ela é
    private bool _taxaDoDia;
    private string _taxaAtualizadaEm = "";
    private (DateTime Lida, TaxasDeConversao Taxas)? _conversaoLida;

    /// <summary>As taxas da aba Conversão, lidas no máximo a cada 30 s (a oferta é conferida a cada desenho).</summary>
    private TaxasDeConversao TaxasDaConversao()
    {
        if (_conversaoLida is { } lida && (DateTime.Now - lida.Lida).TotalSeconds < 30) return lida.Taxas;
        var taxas = Conversao.Ler();
        _conversaoLida = (DateTime.Now, taxas);
        return taxas;
    }

    private void EscolherMoedaVenda(Moeda m)
    {
        // a taxa digitada é do par anterior: trocar de moeda começa de novo
        if (Cambio.MoedaDoPreco(_o) != m) { _o.CambioTaxa = 0; _taxaDoDia = false; }
        _o.MoedaVenda = m.Codigo();
        // o sentido em que a equipe fala: "1 USD = 5,40 R$", mas "1 R$ = 175 CLP"
        _o.CambioDirecao = m == Moeda.Clp ? "CustoEmVenda" : "VendaEmCusto";
        PreencherTaxaDoDia();
    }

    /// <summary>
    /// Preço em outra moeda sem taxa digitada: usa a taxa da aba Conversão,
    /// que a equipe atualiza. Sem taxa lá, a tela continua pedindo.
    /// </summary>
    private void PreencherTaxaDoDia()
    {
        if (!Cambio.Converte(_o) || _o.CambioTaxa > 0m) return;
        var taxas = TaxasDaConversao();
        if (taxas.Para(Cambio.MoedaDoPreco(_o)) is not { } t) return;
        _o.CambioTaxa = t.Valor;
        _o.CambioDirecao = t.Direcao;
        _taxaDoDia = true;
        _taxaAtualizadaEm = taxas.AtualizadaEm;
    }

    /// <param name="Texto">O que a tela mostra antes do "usar esta".</param>
    private sealed record OfertaDeTaxa(string Texto, decimal Valor, string Direcao);

    /// <summary>
    /// A oferta da taxa da aba Conversão, quando ela é diferente da desta
    /// proposta: "taxa desta proposta: 5,30 · aba Conversão (28/10): 5,40".
    /// Nada muda sem o clique em "usar esta".
    /// </summary>
    private OfertaDeTaxa? OfertaDaTaxa()
    {
        if (!Cambio.Converte(_o)) return null;
        var taxas = TaxasDaConversao();
        if (taxas.Para(Cambio.MoedaDoPreco(_o)) is not { } daConversao) return null;
        var desta = TaxaNoSentidoDaConversao(daConversao.Direcao);
        if (desta is { } d && Math.Abs(d - daConversao.Valor) < 0.00005m) return null;
        var quando = taxas.Data is { } data ? $" ({data:dd/MM})" : "";
        var texto = $"aba Conversão{quando}: {daConversao.Valor.ToString("#,##0.####", PtBr)}";
        return new OfertaDeTaxa(desta is { } atual ? $"taxa desta proposta: {atual.ToString("#,##0.####", PtBr)} · {texto}" : texto,
            daConversao.Valor, daConversao.Direcao);
    }

    /// <summary>A taxa desta proposta escrita no sentido da aba Conversão; nula sem taxa.</summary>
    private decimal? TaxaNoSentidoDaConversao(string direcao)
    {
        var normalizada = Cambio.Normalizada(_o);    // 1 moeda do preço = X R$
        if (normalizada <= 0m) return null;
        return Math.Round(direcao == "CustoEmVenda" ? 1m / normalizada : normalizada, 4);
    }

    private void UsarTaxaDaConversao()
    {
        if (OfertaDaTaxa() is not { } oferta) return;
        _o.CambioTaxa = oferta.Valor;
        _o.CambioDirecao = oferta.Direcao;
        _taxaDoDia = true;
        _taxaAtualizadaEm = TaxasDaConversao().AtualizadaEm;
    }

    private void MudarCambioTaxa(ChangeEventArgs e)
    {
        _o.CambioTaxa = Numero(e) is decimal v && v > 0 ? v : 0;
        _taxaDoDia = false;
    }

    private DateTime? TaxaAtualizadaEm =>
        DateTime.TryParse(_taxaAtualizadaEm, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;

    /// <summary>A taxa trazida tem mais de 7 dias: o câmbio pode ter andado desde então.</summary>
    private bool TaxaVelha => TaxaAtualizadaEm is { } d && (DateTime.Now - d).TotalDays > ConversaoRepository.DiasDaTaxa;

    private static string Num(decimal v, string formato = "0.##") => v.ToString(formato, CultureInfo.InvariantCulture);

    /// <summary>Valor na moeda do preço ("USD 1.234,56").</summary>
    private string Venda(decimal valorNaVenda) => Cambio.Dinheiro(_o, valorNaVenda);

    /// <summary>Valor em R$ levado para a moeda do preço.</summary>
