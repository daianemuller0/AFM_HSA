                <tr class="memoria-total"><td colspan="4">Valor da proposta · @nivelEfetivo.Rotulo.ToLowerInvariant()</td><td class="right nowrap">@Venda(Total)</td></tr>
            }
        </tbody>
    </table>
    </div>
</div>
