        : it.Description.Length > 40 ? it.Description[..40] + "…" : it.Description;

    /// <summary>Comissão do representante na tabela do pricing (coluna NB ou AFM), embaixo do campo Rep.</summary>
    private MarkupString SeloComissao(string nome)
