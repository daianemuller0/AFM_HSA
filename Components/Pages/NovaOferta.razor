    /// <summary>Valor na moeda estrangeira, para a tela (ex.: "EUR 5.000,00").</summary>
    private string Me(decimal v) => $"{_o.Moeda} {v.ToString("N2", PtBr)}";

    /// <summary>
    /// Resultado das importações da proposta. Calcula os dois modos sempre, para
    /// a tela mostrar qual sai mais barato; o modo escolhido é o que vai para os itens.
    /// </summary>
    private record ResultadoImportacao(
        List<string> Pendencias,
        CalculoImportacao? PorTotal, decimal ValorMoedaTotal,
        List<(string Rotulo, CalculoImportacao Calc)> PorItem,
        Dictionary<CommercialOfferItem, decimal> UnitarioPorTotal,
        Dictionary<CommercialOfferItem, decimal> UnitarioPorItem)
    {
        public decimal TotalPorTotal => PorTotal?.CustoTotal ?? 0;
        public decimal TotalPorItem => PorItem.Sum(x => x.Calc.CustoTotal);
    }

    private ResultadoImportacao Importacoes
    {
        get
        {
            var importados = _items.Where(i => i.Importado).ToList();
            var pend = new List<string>();
            if (_o.TaxaCambio <= 0) pend.Add("informe a taxa cambial");
            var semPreco = importados.Count(i => i.ValorMoeda <= 0);
            if (semPreco > 0) pend.Add($"preço em {_o.Moeda} em {semPreco} item(ns)");
            var vazio = new ResultadoImportacao(pend, null, 0, new(), new(), new());
            if (pend.Count > 0) return vazio;

            // por total: uma importação com a soma (preço × qtd) e rateio pelo valor de cada item
            var totalMoeda = importados.Sum(i => i.ValorMoeda * i.Quantity);
            var total = CustoImportacao.Calcular(totalMoeda, _o.TaxaCambio, ParamImportacao);
            var unitTotal = importados.ToDictionary(i => i, i => Math.Round(total.CustoTotal * i.ValorMoeda / totalMoeda, 2));

            // por item: uma importação por linha (preço × qtd)
            var porItem = new List<(string, CalculoImportacao)>();
            var unitItem = new Dictionary<CommercialOfferItem, decimal>();
            foreach (var i in importados)
            {
                var c = CustoImportacao.Calcular(i.ValorMoeda * i.Quantity, _o.TaxaCambio, ParamImportacao);
                porItem.Add((i.PartNumber.Length > 0 ? i.PartNumber : i.Description, c));
                unitItem[i] = Math.Round(c.CustoTotal / i.Quantity, 2);
            }
            return new ResultadoImportacao(pend, total, totalMoeda, porItem, unitTotal, unitItem);
        }
    }

    /// <summary>Custo unitário de importação do item no modo escolhido (null enquanto falta dado).</summary>
    private decimal? CustoImportadoDo(CommercialOfferItem it)
    {
        if (!it.Importado || string.IsNullOrEmpty(_o.ImportacaoModo)) return null;
        var imp = Importacoes;
        var mapa = _o.ImportacaoModo == "item" ? imp.UnitarioPorItem : imp.UnitarioPorTotal;
        return mapa.TryGetValue(it, out var v) ? v : null;
    }

    private void MarcarImportado(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _items.Count) return;
        _items[idx].Importado = e.Value is bool b && b;
    }

    private void MudarValorMoeda(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _items.Count) return;
        _items[idx].ValorMoeda = Numero(e) is decimal v && v > 0 ? v : 0;
    }

    private void MudarTaxa(ChangeEventArgs e) => _o.TaxaCambio = Numero(e) is decimal v && v > 0 ? v : 0;

    private static decimal? Numero(ChangeEventArgs e) =>
        decimal.TryParse((e.Value?.ToString() ?? "").Replace(",", "."), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)
            ? v : null;

    // referências por partnumber, calculadas uma vez por cliente (a base não muda enquanto a tela está aberta)
    private readonly Dictionary<string, ReferenciaPreco> _refs = new();

    private static readonly MarkupString Traco = new("<span style=\"color:var(--muted)\">—</span>");

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var nome = (await AuthState).User.Identity?.Name;
            if (!string.IsNullOrWhiteSpace(nome)) _o.PreparedBy = nome;
        }
        _o.OfferDate = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _anteriores = OffersRepo.All();
        _o.OfferCode = NumeroSugerido();
        _o.Revisao = "0";
        _o.Ano = _autoAno = DateTime.Today.Year.ToString(CultureInfo.InvariantCulture);
        // padrões do cabeçalho do pricing para o AFM (o resto fica "preencher")
        _o.SegmentoMargem = "AFM"; _o.Destino = "Nacional"; _o.Reforma = "Não"; _o.NcmReducaoIcms = "Não";
        _o.FiancaSeguro = "Não"; _o.ClienteCom = "Sem benefício"; _o.ContemProdutoIc = "Não";
        _o.Rep1 = "-"; _o.Rep2 = "-";
        _o.RiscoAdicional = _autoRisco; _o.MargemAlvo = _autoMargem;
        _units = Units.All();
        _base = Base.All();
        _parts = Pecas.All();
        _equipamentos = Equipamentos.All();
        _bom = Bom.All();
        _nacionais = Nacionais.All();
        _vendas = Vendas.All();
    }

    // ---- cliente e equipamentos ------------------------------------------

    private List<Equipment> EquipsDaUnidade
    {
        get
        {
            if (string.IsNullOrEmpty(_unitId)) return new();
            var ids = _base.Where(b => b.ClientUnitId == _unitId).Select(b => b.EquipmentId).Distinct().ToHashSet();
            return _equipamentos.Where(e => ids.Contains(e.Id)).OrderBy(e => e.Modelo).ToList();
        }
    }

    private void UnidadeMudou()
    {
        _equipIds.Clear(); _bomMarcados.Clear(); _refs.Clear(); _bomBusca = "";
        var u = _units.FirstOrDefault(x => x.Id == _unitId);
        if (u != null)
        {
            _o.ClientName = Intel.CompanyName(u.CompanyId);
            _o.City = u.Cidade;
            _o.ClientUnitId = u.Id;
            var uf = (u.Estado ?? "").Trim().ToUpperInvariant();
            if (ListasDoPricing.EstadosDo(_o.Destino).Contains(uf)) _o.Estado = Auto(_o.Estado, ref _autoUf, uf);
            _o.MarketSegments = Auto(_o.MarketSegments, ref _autoMercado, PricingDaProposta.MarketSegmentDo(u.Segmento));
        }
    }

    /// <summary>Número novo que ainda não existe em nenhuma proposta (data e hora + sufixo se preciso).</summary>
    private string NumeroSugerido()
    {
        var baseNum = "OF-" + DateTime.Now.ToString("yyyyMMdd-HHmmss", CultureInfo.InvariantCulture);
        var usados = _anteriores.Select(a => a.OfferCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var numero = baseNum;
        for (var i = 2; usados.Contains(numero); i++) numero = $"{baseNum}-{i}";
        return numero;
    }

    /// <summary>Preenche com o valor da base, sem atropelar o que o usuário já digitou.</summary>
    private static string Auto(string atual, ref string ultimoAuto, string novo)
    {
        var podeTrocar = string.IsNullOrWhiteSpace(atual) || atual == ultimoAuto;
        ultimoAuto = novo ?? "";
        return podeTrocar ? ultimoAuto : atual;
    }

    /// <summary>Data da proposta: hoje por padrão; o campo de data do Blazor pede DateOnly.</summary>
    private DateOnly? DataProposta
    {
        get => DateOnly.TryParseExact(_o.OfferDate, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var d) ? d : null;
        set
        {
            _o.OfferDate = value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
            if (value is DateOnly d) _o.Ano = Auto(_o.Ano, ref _autoAno, d.Year.ToString(CultureInfo.InvariantCulture));
        }
    }

    /// <summary>Opções usuais + valores já usados nas propostas anteriores (sem repetir).</summary>
    private IEnumerable<string> Sugestoes(Func<CommercialOffer, string> campo, params string[] padrao) =>
        Sugestoes(campo, (IEnumerable<string>)padrao);

    private IEnumerable<string> Sugestoes(Func<CommercialOffer, string> campo, IEnumerable<string> padrao) =>
        padrao.Concat(_anteriores.Select(campo))
              .Where(v => !string.IsNullOrWhiteSpace(v))
              .Select(v => v.Trim())
              .Distinct(StringComparer.OrdinalIgnoreCase);

    private void AlternarEquip(string id)
    {
        if (!_equipIds.Remove(id)) _equipIds.Add(id);
        // itens marcados de um equipamento desmarcado deixam de valer
        var validos = _bom.Where(b => _equipIds.Contains(b.EquipmentId)).Select(b => b.Id).ToHashSet();
        _bomMarcados.RemoveWhere(x => !validos.Contains(x));
    }

    private string ModeloDe(string equipmentId) =>
        _equipamentos.FirstOrDefault(e => e.Id == equipmentId)?.Modelo ?? equipmentId;

    // ---- BOM ----------------------------------------------------------------

    private List<BomItem> BomVisivel
    {
        get
        {
            var q = _bom.Where(b => _equipIds.Contains(b.EquipmentId));
            var s = _bomBusca.Trim().ToLowerInvariant();
            if (s.Length > 0)
                q = q.Where(b => string.Join(' ', b.Item, b.PartNumber, b.DescricaoPt, b.DescricaoEn, b.Material,
                                             ModeloDe(b.EquipmentId)).ToLowerInvariant().Contains(s));
            return q.OrderBy(b => _equipIds.IndexOf(b.EquipmentId))
                    .ThenBy(b => OrdemItem(b.Item)).ThenBy(b => b.PartNumber).ToList();
        }
    }

    private static int OrdemItem(string item) =>
        int.TryParse(new string((item ?? "").Where(char.IsDigit).ToArray()), out var n) ? n : int.MaxValue;

    private static string DescricaoBom(BomItem b) =>
        !string.IsNullOrWhiteSpace(b.DescricaoPt) ? b.DescricaoPt : b.DescricaoEn;

    private void AlternarBom(string id)
    {
        if (!_bomMarcados.Remove(id)) _bomMarcados.Add(id);
    }

    private void MarcarVisiveis()
    {
        foreach (var b in BomVisivel)
        {
            var naProposta = _items.Any(i => i.EquipmentId == b.EquipmentId && i.PartNumber.Length > 0 &&
                IntelligenceService.NormPn(i.PartNumber) == IntelligenceService.NormPn(b.PartNumber));
            if (!naProposta) _bomMarcados.Add(b.Id);
        }
    }

    /// <summary>
    /// Leva os itens marcados para a proposta. O preço fica em branco: a
    /// referência de custo e a última venda aparecem ao lado, mas quem define o
    /// preço é o usuário (o botão "usar" copia a última venda, se ele quiser).
    /// </summary>
    private void AdicionarBomMarcados()
    {
        foreach (var b in _bom.Where(b => _bomMarcados.Contains(b.Id))
                              .OrderBy(b => _equipIds.IndexOf(b.EquipmentId)).ThenBy(b => OrdemItem(b.Item)))
        {
            var r = Ref(b.PartNumber);
            var desc = DescricaoBom(b);
            _items.Add(new CommercialOfferItem
            {
                Description = string.IsNullOrWhiteSpace(b.PartNumber) ? desc
                              : string.IsNullOrWhiteSpace(desc) ? b.PartNumber : $"{b.PartNumber} — {desc}",
                Quantity = QtdDaBom(b.Quantidade),
                UnitPrice = 0,
                TotalPrice = 0,
                EquipmentId = b.EquipmentId,
                PartNumber = b.PartNumber.Trim(),
                Ncm = ListasDaProposta.NcmPadrao(_equipamentos.FirstOrDefault(e => e.Id == b.EquipmentId)?.Tipo),
                Nacionalizado = r.Nacionalizado,
                CustoReferencia = r.Custo, CustoData = r.CustoData,
                UltimaVenda = r.UltimaVenda, UltimaVendaData = r.UltimaVendaData,
            });
        }
        _bomMarcados.Clear();
        _erro = null;
    }

    /// <summary>"2" → 2; "1 jogo" → 1; "3,5 kg" → 3; vazio → 1.</summary>
    private static int QtdDaBom(string q)
    {
        var digitos = new string((q ?? "").Trim().TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digitos, out var n) && n > 0 ? n : 1;
    }

    // ---- referências de preço -----------------------------------------------

    private ReferenciaPreco Ref(string? pn)
    {
        var chave = IntelligenceService.NormPn(pn);
        if (chave.Length == 0) return ReferenciaPreco.Vazia;
        if (!_refs.TryGetValue(chave, out var r))
            _refs[chave] = r = ReferenciaPreco.Para(pn, _unitId, _nacionais, _vendas);
        return r;
    }

    private ReferenciaPreco RefDoItem(CommercialOfferItem it) => Ref(it.PartNumber);

    private static MarkupString SeloNac(ReferenciaPreco r) => new(r.Nacionalizado
        ? "<span class=\"nac nac-sim\">Sim</span>"
        : "<span class=\"nac nac-nao\">Não</span>");

    /// <summary>Não nacionalizado: nada de custo. Nacionalizado sem valor: "Custo não disponível".</summary>
    private RenderFragment CelulaCusto(ReferenciaPreco r) => __builder =>
    {
        if (!r.Nacionalizado)
        {
            <span style="color:var(--muted)">—</span>
        }
        else if (r.Custo is decimal c)
        {
            <strong>@Fmt.Brl(c)</strong>
            @if (r.CustoData.Length > 0)
            {
                <span class="sub-cel">atualizado em @Fmt.Date(r.CustoData)</span>
            }
        }
        else
        {
            <span class="custo-indisp">Custo não disponível</span>
        }
    };

    private RenderFragment CelulaUltimaVenda(ReferenciaPreco r) => __builder =>
    {
        if (r.UltimaVenda is decimal v)
        {
            @Fmt.Brl(v)
            <span class="sub-cel">@Fmt.Date(r.UltimaVendaData) · @(r.UltimaVendaDoCliente ? "este cliente" : "outro cliente")</span>
        }
        else
        {
            <span style="color:var(--muted)">sem venda</span>
        }
    };

    // ---- itens da proposta ----------------------------------------------------

    /// <summary>Peças cadastradas nas regras de troca dos equipamentos marcados (como antes).</summary>
    private void AdicionarPecas()
    {
        foreach (var p in _parts.Where(p => _equipIds.Contains(p.EquipmentId)))
        {
            var r = Ref(p.Codigo);
            _items.Add(new CommercialOfferItem
            {
                Description = string.IsNullOrEmpty(p.Descritivo) ? p.Nome : $"{p.Nome} — {p.Descritivo}",
                Quantity = 1,
                UnitPrice = p.ValorEstimado,
                TotalPrice = p.ValorEstimado,
                EquipmentId = p.EquipmentId,
                PartNumber = (p.Codigo ?? "").Trim(),
                Ncm = ListasDaProposta.NcmPadrao(_equipamentos.FirstOrDefault(e => e.Id == p.EquipmentId)?.Tipo),
                Nacionalizado = r.Nacionalizado,
                CustoReferencia = r.Custo, CustoData = r.CustoData,
                UltimaVenda = r.UltimaVenda, UltimaVendaData = r.UltimaVendaData,
            });
        }
    }

    private void AdicionarItem()
    {
        if (string.IsNullOrWhiteSpace(_desc)) return;
        var q = _qtd <= 0 ? 1 : _qtd;
        _items.Add(new CommercialOfferItem { Description = _desc.Trim(), Quantity = q, UnitPrice = _preco, TotalPrice = q * _preco });
        _desc = ""; _qtd = 1; _preco = 0;
    }

    private void MudarQtd(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _items.Count) return;
        var it = _items[idx];
        it.Quantity = int.TryParse(e.Value?.ToString(), out var q) && q > 0 ? q : 1;
        it.TotalPrice = it.Quantity * it.UnitPrice;
    }

    private void MudarPreco(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _items.Count) return;
        var it = _items[idx];
        var texto = (e.Value?.ToString() ?? "").Replace(",", ".");
        it.UnitPrice = decimal.TryParse(texto, NumberStyles.Any, CultureInfo.InvariantCulture, out var p) && p > 0 ? p : 0;
        it.TotalPrice = it.Quantity * it.UnitPrice;
    }

    /// <summary>Só por ação do usuário: copia a última venda (R$) para o preço da proposta, na moeda do preço.</summary>
    private void UsarPreco(int idx, decimal valorEmReais)
    {
        if (idx < 0 || idx >= _items.Count) return;
        var it = _items[idx];
        it.UnitPrice = Math.Round(Cambio.ParaVenda(_o, valorEmReais), 2);
        it.TotalPrice = it.Quantity * it.UnitPrice;
    }

    private void Remover(int idx)
    {
        if (idx >= 0 && idx < _items.Count) _items.RemoveAt(idx);
    }

    private decimal Total => _items.Sum(i => i.TotalPrice);

    private static string Txt(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private void Salvar()
    {
        if (string.IsNullOrWhiteSpace(_o.ClientName)) { _erro = "Informe o nome do cliente."; return; }
        _o.OfferCode = (_o.OfferCode ?? "").Trim();
        _o.Revisao = string.IsNullOrWhiteSpace(_o.Revisao) ? "0" : _o.Revisao.Trim();
        if (_o.OfferCode.Length == 0) { _erro = "Informe o número da proposta."; return; }
        if (_anteriores.Any(a => string.Equals(a.OfferCode, _o.OfferCode, StringComparison.OrdinalIgnoreCase)
                              && string.Equals(a.Revisao, _o.Revisao, StringComparison.OrdinalIgnoreCase)))
        {
            _erro = $"Já existe a proposta {_o.OfferCode} revisão {_o.Revisao}. Mude o número ou a revisão.";
            return;
        }
        if (_items.Any(i => i.Importado))
        {
            if (string.IsNullOrEmpty(_o.ImportacaoModo))
            { _erro = "Há item importado: marque no topo se a importação é por total ou por item."; return; }
            var pend = Importacoes.Pendencias;
            if (pend.Count > 0) { _erro = "Importação incompleta: " + string.Join(" · ", pend) + "."; return; }
            foreach (var it in _items) it.CustoImportacao = it.Importado ? CustoImportadoDo(it) : null;
        }
        else
        {
            _o.ImportacaoModo = ""; _o.TaxaCambio = 0;
        }
        var semPreco = _items.Count(i => i.UnitPrice <= 0);
        if (semPreco > 0)
        {
            _erro = $"Defina o preço unitário da proposta em {semPreco} item(ns) — estão destacados na tabela.";
            return;
        }
        if (Cambio.FaltaTaxa(_o))
        {
            _erro = $"Informe a taxa de câmbio do {Cambio.MoedaDoPreco(_o).Rotulo()} no pricing (ou escolha o preço em R$).";
            return;
        }
        // retrato do pricing no momento de salvar (consulta na tela da oferta), em R$
        var custos = Custos;
        var pr = PricingAtual(custos);
        var temPricing = pr.CustoTotal > 0 && pr.VendaLiquida > 0;
        _o.PricingCusto = temPricing ? Math.Round(pr.CustoTotal, 2) : 0;
        _o.PricingMarkup = temPricing ? Math.Round(pr.Markup, 6) : 0;
        _o.PricingVendaLiquida = temPricing ? Math.Round(pr.VendaLiquida, 2) : 0;
        _o.PricingMargem = temPricing ? Math.Round(pr.Margem, 6) : 0;
        _o.PricingPrecoImpostos = temPricing && pr.PrecoAoCliente is decimal pci ? Math.Round(pci, 2) : 0;
        if (!Textos.Igual(_o.FiancaSeguro, "Sim")) _o.TipoGarantia = "";
        if (!Cambio.Converte(_o)) { _o.CambioTaxa = 0; _o.CambioSeguranca = 0; }
        var now = DateTime.Now;
        _o.Id = Guid.NewGuid().ToString("N");
        _o.EquipmentId = string.Join(";", _equipIds);
        if (string.IsNullOrWhiteSpace(_o.OfferDate)) _o.OfferDate = now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _o.CreatedAt = now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _o.OurReference = string.IsNullOrWhiteSpace(_o.OurReference) ? _o.OfferCode : _o.OurReference;
        _o.TotalAmount = Total;
        _o.TotalReais = Math.Round(Cambio.ParaReais(_o, Total), 2);
        OffersRepo.Save(_o);
        for (var n = 0; n < _items.Count; n++)
        {
            var it = _items[n];
            it.Id = Guid.NewGuid().ToString("N");
            it.OfferId = _o.Id;
            it.Ordem = n + 1;
            OffersRepo.SaveItem(it);
        }
        Nav.NavigateTo($"/ofertas/{_o.Id}");
    }
