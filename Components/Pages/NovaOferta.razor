                    </td>
                    <td class="right">@it.Quantity</td>
                    <td class="right nowrap">@(it == _itemDemais ? Fmt.Brl(DemaisCustos(custosLado, prLado)) : custoIt is decimal cu ? Fmt.Brl(cu) : "sem custo")</td>
                    <td class="right nowrap"><strong>@(it.UnitPrice > 0 ? Venda(it.UnitPrice) : "—")</strong></td>
                    <td class="right nowrap"><strong>@Venda(it.TotalPrice)</strong></td>
