@page "/ofertas/nova"
@page "/gerar-proposta"
@page "/gerar-proposta/{Id}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject ClientUnitRepository Units
@inject EquipmentRepository Equipamentos
@inject InstalledBaseRepository Base
@inject PartRepository Pecas
@inject BomRepository Bom
@inject NacionalizacaoRepository Nacionais
@inject SalesRecordRepository Vendas
@inject OfferRepository OffersRepo
@inject SegmentRepository Segmentos
@inject SalespersonRepository Vendedores
@inject IntelligenceService Intel
@inject ParametrosImportacao ParamImportacao
@inject ConversaoRepository Conversao
@inject NavigationManager Nav

<PageTitle>Gerar Proposta · AFM HSA</PageTitle>
@{
    // o preço de cada item é o custo × pricing, sempre atualizado
    AtualizarPrecos();
    // calculadas uma vez por desenho: a barra de etapas, o painel do lado e a
    // etapa Documentos olham as mesmas listas (como no axiaisvent)
    var pendTodas = Pendencias();
    var pendLista = pendTodas.Where(p => !p.SoAviso).ToList();
    var avisosLado = pendTodas.Where(p => p.SoAviso).ToList();
    var custosLado = Custos;
    var prLado = PricingAtual(custosLado);
}
<div class="proposta">

@* o topo diz QUAL proposta é e em que pé está *@
<div class="page-head prop-head">
    <div class="prop-titulo">
        <div class="prop-titulo-linha">
            <h1>@(_o.Id.Length > 0 ? _o.OfferCode : "Proposta nova")</h1>
            @if (_o.Id.Length > 0)
            {
                <span class="prop-chip">rev @PropostaWord.Revisao2(_o.Revisao)</span>
                <span class="prop-chip @(_o.Status == "Enviada" ? "chip-enviada" : "chip-elaboracao")">@(_o.Status == "Enviada" ? "Enviada" : "Em elaboração")</span>
            }
            else
            {
                <span class="nota">nº @_o.OfferCode rev @PropostaWord.Revisao2(_o.Revisao) ao salvar</span>
            }
        </div>
        <p class="subtitle prop-sub" title="@ClienteEProjeto">@ClienteEProjeto</p>
    </div>
    <div class="page-actions">
        <button class="btn-ghost" @onclick="IrParaPropostas">☰ Propostas</button>
        <button class="btn-ghost" @onclick="NovaEmBranco">+ Nova</button>
        @if (_o.Id.Length > 0)
        {
            <button class="btn-ghost" title="Uma proposta nova com o cliente, as condições, os itens e os preços desta" @onclick="() => CopiarGravada(_o.Id)">⧉ Copiar</button>
            <button class="btn-ghost" title="A próxima revisão desta proposta; a atual fica como o cliente recebeu" @onclick="NovaRevisao">Nova revisão (rev @PropostaWord.Revisao2(ProximaRevisao(_o.OfferCode)))</button>
        }
    </div>
</div>

@if (_depoisDeConfirmar is not null)
{
    <div class="aviso-alerta guarda-barra" role="alertdialog" aria-label="Alterações não salvas">
        <span>Há alterações não salvas nesta proposta.</span>
        <span style="flex:1"></span>
        <button class="btn-primary" @onclick="GuardaSalvar">Salvar</button>
        <button class="btn-ghost" @onclick="GuardaDescartar">Descartar</button>
        <button class="btn-link" @onclick="() => _depoisDeConfirmar = null">Cancelar</button>
    </div>
}

@* o selo de cada etapa diz a verdade: o visto só com conteúdo e nada pendente;
   uma etapa ainda não começada fica sem selo *@
<nav class="etapas-barra" aria-label="Etapas da proposta">
    @foreach (var (numero, nome) in Etapas)
    {
        var n = numero;
        var faltam = pendLista.Count(p => p.Etapa == n);
        var selo = SeloDaEtapa(n, faltam, pendLista.Count);
        <button class="etapa-btn @(_etapa == n ? "ativa" : "")" aria-current="@(_etapa == n ? "step" : null)"
                @onclick="() => IrParaEtapa(n)">
            <span class="etapa-num">@n</span>
            <span>@nome</span>
            @if (selo == Selo.Pendente)
            {
                <span class="tab-badge warn" title="@Plural(faltam, "pendência nesta etapa", "pendências nesta etapa")">@faltam</span>
            }
            else if (selo == Selo.Ok)
            {
                <span class="etapa-ok" title="nada pendente">✓</span>
            }
        </button>
    }
    <span style="flex:1"></span>
    <span class="etapa-cron" title="Tempo de trabalho nesta proposta — pausas de mais de 3 minutos não contam">⏱ @TempoNaTela</span>
</nav>

<div class="prop-etapas">
<div class="etapa-corpo">
@if (_etapa == 1)
{
@* dois jeitos de começar: pelo cliente (o mais comum) ou a partir de uma proposta gravada *@
<div class="panel comecar" style="margin-bottom:14px">
    <div class="comecar-grid">
        <div class="comecar-box">
            <strong>Começar pelo cliente</strong>
            <span class="nota">Nome, cidade, estado e mercado vêm da base; os equipamentos da unidade ficam prontos na etapa Itens.</span>
            <select class="cell" value="" @onchange="ComecarPeloCliente" aria-label="Cliente / unidade">
                <option value="">Escolha o cliente / unidade…</option>
                @foreach (var u in _units) { <option value="@u.Id">@Intel.UnitLabel(u.Id)</option> }
            </select>
            <div class="comecar-branco">
                ou <button class="btn-link" @onclick="ComecarEmBranco">começar em branco</button>
                <span class="nota">· já com os seus padrões</span>
            </div>
            @if (_padroesDe is not null && _o.Id.Length == 0)
            {
                <span class="nota">Padrões trazidos da sua última proposta (@_padroesDe): BU, segmento, venda para, condição de pagamento, validade, incoterm e textos.</span>
            }
        </div>
        <div class="comecar-box">
            <strong>Abrir ou copiar uma proposta</strong>
            <input class="cell" placeholder="Buscar por cliente, número, projeto ou referência"
                   value="@_buscaGravadas" @oninput="e => _buscaGravadas = e.Value?.ToString() ?? string.Empty" />
            <div class="lista-gravadas">
                @foreach (var g in GravadasDaBusca())
                {
                    var gid = g.Id;
                    <div class="linha @(g.Id == _o.Id ? "aberta" : "")">
                        <button class="linha-abrir" title="@($"Abrir a {g.OfferCode} rev {g.Revisao} para continuar ou corrigir")" @onclick="() => AbrirGravada(gid)">
                            <span class="numero">@g.OfferCode</span>
                            <span class="prop-chip">rev @PropostaWord.Revisao2(g.Revisao)</span>
                            @if (g.Status == "Enviada") { <span class="prop-chip chip-enviada">enviada</span> }
                            <span class="data">@Fmt.Date(g.OfferDate)</span>
                            <span class="cliente">@(g.ClientName.Length > 0 ? g.ClientName : "sem cliente")@(g.Project.Length > 0 ? " · " + g.Project : "")</span>
                            <span class="valor">@(Cambio.Converte(g) ? Cambio.Dinheiro(g, g.TotalAmount) : Fmt.Brl0(g.TotalAmount))</span>
                        </button>
                        <button class="btn-link linha-copiar" title="Copiar como nova: cliente, condições, itens e preços desta" @onclick="() => CopiarGravada(gid)">⧉ copiar</button>
                    </div>
                }
                @if (_anteriores.Count == 0)
                {
                    <span class="subtitle" style="margin:0">Nenhuma proposta gravada ainda.</span>
                }
                else if (!GravadasDaBusca().Any())
                {
                    <span class="subtitle" style="margin:0">Nenhuma proposta com esse texto.</span>
                }
            </div>
        </div>
    </div>
</div>
}
@if (_etapa == 2)
{
@* a etapa em três cartões: o cliente (o que se digita), as condições que
   saem no documento e o cabeçalho do pricing (que quase sempre vem pronto) *@
<div class="panel" style="margin-bottom:14px">
    <div class="dash-title">Cliente</div>
    <div class="form3">
        <label id="f-cliente">Nome do cliente *
            <input class="cell" list="dl-clientes" placeholder="da base ou digitado" @bind="_o.ClientName" />
        </label>
        <label id="f-cidade">Cidade (na capa)
            <input class="cell" placeholder="vem das plantas" @bind="_o.City" />
        </label>
        <label id="f-ac">A/C (contato) <input class="cell" @bind="_o.AttentionTo" /></label>
        <label id="f-email">E-mail do contato <input class="cell" type="email" placeholder="contato@@empresa.com" @bind="_o.ContatoEmail" /></label>
        <label id="f-telefone">Telefone do contato <input class="cell" placeholder="+55 …" @bind="_o.ContatoTelefone" /></label>
        <label id="f-suaref">Sua referência (do cliente) <input class="cell" placeholder="o número que o cliente deu" @bind="_o.SuaReferencia" /></label>
        <label id="f-projeto">Projeto <input class="cell" @bind="_o.Project" /></label>
    </div>
    <datalist id="dl-clientes">@foreach (var c in NomesDeClientes) { <option value="@c" /> }</datalist>
    @if (UltimaDoCliente() is { } ult && ult.Id != _lembrancaUsada)
    {
        @* o que se repete de uma proposta para outra do mesmo cliente: um clique traz *@
        <div class="lembranca-cliente">
            <span>Última proposta para este cliente: <strong>@ult.OfferCode</strong> rev @PropostaWord.Revisao2(ult.Revisao), de @Fmt.Date(ult.OfferDate)
                @(ult.AttentionTo.Length > 0 ? $"· A/C {ult.AttentionTo}" : "")</span>
            <button class="btn-ghost" @onclick="() => UsarDaUltima(ult)">Usar contato e condições dela</button>
            <button class="btn-link" @onclick="() => CopiarGravada(ult.Id)">ou copiar a proposta inteira</button>
        </div>
    }
</div>

<div class="panel" id="f-plantas" style="margin-bottom:14px">
    <div class="dash-title">Plantas
        <span class="dash-sub">da base ou digitadas — a proposta pode atender mais de uma; com várias, cada item diz a sua no Word</span>
    </div>
    @if (_o.Plantas.Count == 0)
    {
        <div class="empty" style="padding:4px 0 10px">Nenhuma planta. A proposta sai assim mesmo, com a cidade da capa.</div>
    }
    else
    {
        var doCliente = UnidadesDoCliente();
        <div class="tabela-rolante">
        <table class="grid plantas-tabela">
            <colgroup><col style="width:30%" /><col style="width:28%" /><col style="width:19%" /><col style="width:11%" /><col style="width:8%" /><col style="width:4%" /></colgroup>
            <thead><tr><th>Da base</th><th>Planta</th><th>Cidade</th><th>UF</th><th class="right">Equip.</th><th></th></tr></thead>
            <tbody>
                @foreach (var pl in _o.Plantas)
                {
                    var planta = pl;
                    <tr>
                        <td>
                            <select class="cell" value="@planta.UnitId" @onchange="e => TrocarUnidadeDaPlanta(planta, e)" aria-label="Planta da base">
                                <option value="">não cadastrada (digitar)</option>
                                @if (doCliente.Count > 0)
                                {
                                    <optgroup label="deste cliente">
                                        @foreach (var u in doCliente) { <option value="@u.Id">@Intel.UnitLabel(u.Id)</option> }
                                    </optgroup>
                                }
                                <optgroup label="@(doCliente.Count > 0 ? "outros clientes" : "plantas da base")">
                                    @foreach (var u in _units.Where(u => !doCliente.Contains(u))) { <option value="@u.Id">@Intel.UnitLabel(u.Id)</option> }
                                </optgroup>
                            </select>
                        </td>
                        @if (planta.Cadastrada)
                        {
                            <td>@OuTraco(planta.Nome) <span class="selo-base">base</span></td>
                            <td>@OuTraco(planta.Cidade)</td>
                            <td>@OuTraco(planta.Estado)</td>
                        }
                        else
                        {
                            <td><input class="cell" placeholder="ex.: Usina Tubarão" value="@planta.Nome" @onchange="e => MudarPlanta(planta, e, nameof(PlantaDaProposta.Nome))" /></td>
                            <td><input class="cell" placeholder="cidade" value="@planta.Cidade" @onchange="e => MudarPlanta(planta, e, nameof(PlantaDaProposta.Cidade))" /></td>
                            <td><input class="cell" placeholder="UF" maxlength="3" list="dl-ufs" value="@planta.Estado" @onchange="e => MudarPlanta(planta, e, nameof(PlantaDaProposta.Estado))" /></td>
                        }
                        <td class="right">@_o.EquipamentosDaProposta.Count(x => x.PlantaId == planta.Id)</td>
                        <td><button class="btn-link" style="color:#b91c1c" title="Tirar a planta da proposta (os equipamentos dela ficam, sem planta)" aria-label="Tirar a planta" @onclick="() => RemoverPlanta(planta)">✕</button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    <div class="plantas-acoes">
        <button class="btn-ghost" @onclick="AdicionarPlanta">+ Adicionar planta</button>
        <span class="nota">escolha na base ou deixe "não cadastrada" e digite nome, cidade e UF</span>
    </div>
    <datalist id="dl-ufs">@foreach (var uf in ListasDoPricing.EstadosNacional) { <option value="@uf" /> }</datalist>
</div>

<div class="panel" style="margin-bottom:14px">
    <div class="dash-title">Condições comerciais <span class="dash-sub">saem no documento</span></div>
    <div class="form3">
        <div class="campo" id="f-pagamento">Condição de pagamento
            <span class="com-mais">
                <select class="cell" @bind="_o.PaymentTerms">
                    @foreach (var p in OpcoesDePagamento) { <option value="@p">@p</option> }
                    @if (!string.IsNullOrWhiteSpace(_o.PaymentTerms) && !OpcoesDePagamento.Contains(_o.PaymentTerms))
                    {
                        <option value="@_o.PaymentTerms">@_o.PaymentTerms</option>
                    }
                </select>
                <button class="btn-mais" title="Escrever uma condição que não está na lista e incluir na base" @onclick="() => AbrirNovaCondicao(CondicoesComerciaisRepository.Pagamento)">+</button>
            </span>
            @if (_novaCondicao == CondicoesComerciaisRepository.Pagamento)
            {
                <span class="nova-condicao">
                    <input class="cell" placeholder="ex.: 30% no pedido e 70% na entrega" value="@_textoNovaCondicao" @oninput="e => _textoNovaCondicao = e.Value?.ToString() ?? string.Empty" />
                    <button class="btn-primary" @onclick="IncluirCondicao">Incluir na base</button>
                    <button class="btn-link" @onclick="() => _novaCondicao = null">cancelar</button>
                </span>
            }
        </div>
        <label id="f-prazo">Prazo de entrega
            <span class="com-sufixo">
                <input class="cell num" type="number" min="0" step="1" placeholder="a confirmar"
                       value="@(PricingDaProposta.PrazoEmDias(_o.PrazoEntrega) is > 0 and var dias ? dias.ToString() : "")"
                       @onchange="MudarPrazo" />
                <span>dias</span>
            </span>
        </label>
        <label id="f-validade">Validade <input class="cell" @bind="_o.ValidityText" /></label>
        <div class="campo" id="f-incoterm">Local de entrega (Incoterms)
            <span class="com-mais">
                <select class="cell" value="@ValorDoIncoterm" @onchange="EscolherIncoterm">
                    @foreach (var i in ListasDaProposta.Incoterms) { <option value="@i.Codigo">@i.Rotulo</option> }
                    @if (_entregasDaBase.Count > 0)
                    {
                        <optgroup label="incluídos pela equipe">
                            @foreach (var c in _entregasDaBase) { <option value="@("extra:" + c.Id)">@c.Texto</option> }
                        </optgroup>
                    }
                    @if (_o.Incoterm == ListasDaProposta.Livre && ValorDoIncoterm == ListasDaProposta.Livre)
                    {
                        <option value="@ListasDaProposta.Livre">@_o.IncotermLocal</option>
                    }
                </select>
                <button class="btn-mais" title="Escrever um local de entrega que não está na lista e incluir na base" @onclick="() => AbrirNovaCondicao(CondicoesComerciaisRepository.Entrega)">+</button>
            </span>
            @if (_novaCondicao == CondicoesComerciaisRepository.Entrega)
            {
                <span class="nova-condicao">
                    <input class="cell" placeholder="o texto como sai na proposta, ex.: FOB – Porto de Vitória (ES)." value="@_textoNovaCondicao" @oninput="e => _textoNovaCondicao = e.Value?.ToString() ?? string.Empty" />
                    <button class="btn-primary" @onclick="IncluirCondicao">Incluir na base</button>
                    <button class="btn-link" @onclick="() => _novaCondicao = null">cancelar</button>
                </span>
            }
        </div>
        @if (ListasDaProposta.Incoterms.FirstOrDefault(x => x.Codigo == _o.Incoterm) is { PedeLocal: true } inc)
        {
            <label id="f-incoterm-local">Local (@(inc.Codigo == "FCA-AEROPORTO" ? "aeroporto" : "destino e país"))
                <input class="cell" placeholder="@(inc.Codigo == "FCA-AEROPORTO" ? "ex.: de Guarulhos – SP" : "ex.: Callao (Peru)")" @bind="_o.IncotermLocal" />
                <small class="pricing-dica">na proposta: @ListasDaProposta.LinhaDoIncoterm(_o.Incoterm, _o.IncotermLocal)</small>
            </label>
        }
    </div>
</div>

<div class="panel" style="margin-bottom:14px">
    <div class="dash-title">Cabeçalho do pricing
        <span class="dash-sub">os mesmos campos e listas da planilha R_HSAXYZ0000-0</span>
    </div>
    <div class="form3">
        <label id="f-margem-cab">Segmento (margem)
            <span class="com-sufixo">
                <input class="cell num" type="number" min="0" max="99" step="0.1" value="@Pct100(_o.MargemAlvo)"
                       @onchange="MudarMargemDoCabecalho" />
                <span>%</span>
            </span>
            <small class="pricing-dica">a margem pedida no pricing · padrão @Pct(ListasDoPricing.MargemPadraoDo(_o.SegmentoMargem))</small>
        </label>
        <label id="f-bu">BU
            <select class="cell" @bind="_o.Bu">
                <option value="">preencher</option>
                @foreach (var (cod, rot) in ListasDoPricing.Bus) { <option value="@cod">@rot</option> }
                @ForaDaLista(_o.Bu, ListasDoPricing.Bus.Select(b => b.Codigo))
            </select>
        </label>
        <label id="f-vendapara">Venda para
            <select class="cell" @bind="_o.VendaPara">
                <option value="">preencher</option>
                @foreach (var v in ListasDoPricing.VendaPara) { <option value="@v">@v</option> }
                @ForaDaLista(_o.VendaPara, ListasDoPricing.VendaPara)
            </select>
        </label>
        <label id="f-destino">Destino
            <select class="cell" @bind="_o.Destino" @bind:after="DestinoMudou">
                <option value="">preencher</option>
                @foreach (var v in ListasDoPricing.Destinos) { <option value="@v">@v</option> }
                @ForaDaLista(_o.Destino, ListasDoPricing.Destinos)
            </select>
        </label>
        <label id="f-uf">Estado
            <select class="cell" @bind="_o.Estado">
                <option value="">preencher</option>
                @foreach (var v in ListasDoPricing.EstadosDo(_o.Destino)) { <option value="@v">@v</option> }
                @ForaDaLista(_o.Estado, ListasDoPricing.EstadosDo(_o.Destino))
            </select>
        </label>
        <label id="f-reforma">Reforma
            <select class="cell" @bind="_o.Reforma">
                <option value="">preencher</option>
                @foreach (var v in ListasDoPricing.SimNao) { <option value="@v">@v</option> }
                @ForaDaLista(_o.Reforma, ListasDoPricing.SimNao)
            </select>
        </label>
        <label id="f-clientecom">Cliente com
            <select class="cell" @bind="_o.ClienteCom">
                <option value="">preencher</option>
                @foreach (var v in ListasDoPricing.RegimeCliente) { <option value="@v">@v</option> }
                @ForaDaLista(_o.ClienteCom, ListasDoPricing.RegimeCliente)
            </select>
        </label>
        <label id="f-fianca">Fiança/Seguro Garantia
            <select class="cell" @bind="_o.FiancaSeguro">
                <option value="">preencher</option>
                @foreach (var v in ListasDoPricing.SimNao) { <option value="@v">@v</option> }
                @ForaDaLista(_o.FiancaSeguro, ListasDoPricing.SimNao)
            </select>
        </label>
        <label id="f-portal">Portal
            <select class="cell" @bind="_o.Portal">
                <option value="">preencher</option>
                @foreach (var v in ListasDoPricing.Portais) { <option value="@v.Nome">@RotuloPortal(v)</option> }
                @ForaDaLista(_o.Portal, ListasDoPricing.Portais.Select(x => x.Nome))
            </select>
        </label>
        <label id="f-rep1">Rep 1
            <select class="cell" @bind="_o.Rep1">
                @foreach (var r in ListasDoPricing.Representantes) { <option value="@r.Nome">@r.Nome</option> }
                @ForaDaLista(_o.Rep1, ListasDoPricing.Representantes.Select(x => x.Nome))
            </select>
            @SeloComissao(_o.Rep1)
        </label>
        <label id="f-rep2">Rep 2
            <select class="cell" @bind="_o.Rep2">
                @foreach (var r in ListasDoPricing.Representantes) { <option value="@r.Nome">@r.Nome</option> }
                @ForaDaLista(_o.Rep2, ListasDoPricing.Representantes.Select(x => x.Nome))
            </select>
            @SeloComissao(_o.Rep2)
        </label>
    </div>

    @* os campos que quase nunca mudam: recolhidos, com o que está valendo à vista *@
    <button class="btn-link mais-campos" @onclick="() => _maisCampos = !_maisCampos" aria-expanded="@(_maisCampos ? "true" : "false")">
        @(_maisCampos ? "▾" : "▸") Mais campos
        <span class="nota">nº @_o.OfferCode · rev @_o.Revisao · segmento @OuTraco(_o.SegmentoMargem) · @Fmt.Date(_o.OfferDate) · ano @_o.Ano · NCM c/red. @OuTraco(_o.NcmReducaoIcms) · IC @OuTraco(_o.ContemProdutoIc) · @OuTraco(_o.Categories) / @OuTraco(_o.Product) · @OuTraco(_o.MarketSegments)</span>
    </button>
    @if (_maisCampos)
    {
        <div class="form3" style="margin-top:12px">
            <label id="f-numero">Número da proposta * <input class="cell" @bind="_o.OfferCode" /></label>
            <label id="f-segmento">Segmento (tabela do pricing)
                <select class="cell" @bind="_o.SegmentoMargem" @bind:after="SegmentoOuProdutoMudou">
                    <option value="">preencher</option>
                    @foreach (var (nome, margem) in ListasDoPricing.Segmentos) { <option value="@nome">@nome (margem padrão @Pct(margem))</option> }
                    @ForaDaLista(_o.SegmentoMargem, ListasDoPricing.Segmentos.Select(x => x.Nome))
                </select>
            </label>
            <label>Revisão <input class="cell" @bind="_o.Revisao" list="dl-revisao" /></label>
            <label>Data do Pricing <input class="cell" type="date" @bind="DataProposta" /></label>
            <label>Elaborado por <input class="cell" @bind="_o.PreparedBy" /></label>
            <label>Nossa referência <input class="cell" placeholder="= número da proposta" @bind="_o.OurReference" /></label>
