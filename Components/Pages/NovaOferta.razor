                    {
                        <strong class="valor-campo">@Fmt.Brl(cu)</strong>
                        <small>importação @(_o.ImportacaoModo == "item" ? "por item" : "por total (rateio)")</small>
                    }
                    else
                    {
                        <small class="custo-indisp">@(novo ? "calculado ao incluir" : it.ValorMoeda <= 0 ? $"informe o preço em {_o.Moeda}" : "complete a importação abaixo")</small>
                    }
                }
                else
                {
                    <input class="cell num" type="number" min="0" step="0.01" placeholder="digite o custo"
                           value="@(CustoNacionalDe(it) is decimal cn ? cn.ToString(CultureInfo.InvariantCulture) : "")"
                           @onchange="e => MudarCustoDoItem(it, e)" />
                    <small>
                        @if (it.CustoManual is not null)
                        {
                            <span>digitado</span>
                            @if (r.Nacionalizado && r.Custo is decimal rc)
                            {
                                <span> · Nacionalização @Fmt.Brl(rc) </span>
                                <button class="btn-link" title="Voltar ao custo da Nacionalização" @onclick="() => it.CustoManual = null">↺</button>
                            }
                        }
                        else if (r.Nacionalizado && r.Custo is not null)
                        {
                            <span>Nacionalização@(r.CustoData.Length > 0 ? $" · {Fmt.Date(r.CustoData)}" : "")</span>
                        }
                        else
                        {
                            <span class="custo-indisp">sem referência: digite</span>
                        }
                    </small>
                }
                @if (refCusto is not null && refCusto.Valor != custoBase)
                {
                    <small class="ref-custo" title="@($"{refCusto.Proposta} · {refCusto.Cliente} · {refCusto.Origem} · {refCusto.Usuario}")">
                        ref.: @Fmt.Brl(refCusto.Valor) em @Fmt.Date(refCusto.Data)@(refCusto.Modelo.Length > 0 ? $" · {refCusto.Modelo}" : "")@(refCusto.SerialNumber.Length > 0 ? $" · SN {refCusto.SerialNumber}" : "") · @refCusto.Proposta
                        @if (!it.Importado)
                        {
                            <button class="btn-link" @onclick="() => it.CustoManual = refCusto.Valor">usar</button>
                        }
                    </small>
                }
            </div>
            <div class="campo">Última venda (R$)
                @if (r.UltimaVenda is decimal uv)
                {
                    <strong class="valor-campo">@Fmt.Brl(uv)</strong>
                    <small>@Fmt.Date(r.UltimaVendaData) · @(r.UltimaVendaDoCliente ? "este cliente" : "outro cliente")</small>
                }
                else
                {
                    <small>@(it.PartNumber.Length > 0 ? "sem venda" : "—")</small>
                }
            </div>
            <label>Prazo (dias)
                <input class="cell num" type="number" min="0" step="1" @key="@($"prazo-{Versao(it)}")"
                       placeholder="@(PricingDaProposta.PrazoEmDias(_o.PrazoEntrega) is > 0 and var pp ? pp.ToString() : "—")"
                       title="Vazio = o prazo da proposta"
                       value="@(it.PrazoEntregaDias > 0 ? it.PrazoEntregaDias.ToString() : "")" @onchange="e => MudarPrazoDoItem(it, e)" />
            </label>
            <label>Quantidade
                <input class="cell num" type="number" min="1" step="1" @key="@($"qtd-{Versao(it)}")"
                       value="@it.Quantity" @onchange="e => MudarQtdDe(it, e)" />
            </label>
            <div class="campo">Preço meta (@Cambio.MoedaDoPreco(_o).Rotulo())
                <input class="cell num" type="number" min="0" step="0.01" placeholder="sem meta"
                       value="@(it.PrecoMeta > 0 ? it.PrecoMeta.ToString(CultureInfo.InvariantCulture) : "")" @onchange="e => MudarMeta(it, e)" />
                <small>
                    @if (it.PrecoMeta > 0 && it.CustoTa > 0)
                    {
                        <span class="ta">TA @Fmt.Brl(Math.Round(it.CustoTa, 2)) no custo</span>
                    }
                    else if (it.PrecoMeta > 0 && !novo && it.UnitPrice > it.PrecoMeta + 0.01m)
                    {
                        <span class="custo-indisp">preço já acima da meta</span>
                    }
                    @if (r.UltimaVenda is decimal uvm && it.PrecoMeta != Math.Round(Cambio.ParaVenda(_o, uvm), 2))
                    {
                        <button class="btn-link" title="Usar a última venda como meta" @onclick="() => it.PrecoMeta = Math.Round(Cambio.ParaVenda(_o, uvm), 2)">meta = última venda</button>
                    }
                </small>
            </div>
        </div>
    };

}
