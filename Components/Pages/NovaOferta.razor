@page "/ofertas/nova"
@page "/gerar-proposta"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject ClientUnitRepository Units
@inject EquipmentRepository Equipamentos
@inject InstalledBaseRepository Base
@inject PartRepository Pecas
@inject BomRepository Bom
@inject NacionalizacaoRepository Nacionais
@inject SalesRecordRepository Vendas
@inject OfferRepository OffersRepo
@inject SegmentRepository Segmentos
@inject SalespersonRepository Vendedores
@inject IntelligenceService Intel
@inject ParametrosImportacao ParamImportacao
@inject NavigationManager Nav

<PageTitle>Gerar Proposta · AFM HSA</PageTitle>

<div class="page-head">
    <div><h1>Gerar Proposta</h1><p class="subtitle">Proposta comercial no template Howden / Chart — cliente, itens e condições.</p></div>
    <div class="page-actions"><a class="btn-ghost" href="/ofertas">← Ofertas</a></div>
</div>

<div class="prop-grid">
  <div>
    <div class="panel" style="margin-bottom:16px">
        <div class="dash-title">Cabeçalho
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                escolha o cliente da base: nome, segmento, estado e representante vêm preenchidos (dá para alterar)
            </span>
        </div>
        <div class="form3 cabecalho">
            <label>Cliente / Unidade (da base)
                <select class="cell" @bind="_unitId" @bind:after="UnidadeMudou">
                    <option value="">Selecione…</option>
                    @foreach (var u in _units) { <option value="@u.Id">@Intel.UnitLabel(u.Id)</option> }
                </select>
            </label>
            <label>Nome do Cliente * <input class="cell" @bind="_o.ClientName" /></label>
            <label>PV <input class="cell" @bind="_o.Pv" /></label>

            <label>Data <input class="cell" type="date" @bind="DataProposta" /></label>
            <label>Número da proposta * <input class="cell" @bind="_o.OfferCode" /></label>
            <label>Revisão <input class="cell" @bind="_o.Revisao" list="dl-revisao" /></label>

            <label>BU <input class="cell" @bind="_o.Bu" list="dl-bu" /></label>
            <label>Elaborado por <input class="cell" @bind="_o.PreparedBy" /></label>
            <label>NCM c/ redução base ICMS <input class="cell" @bind="_o.NcmReducaoIcms" list="dl-simnao" /></label>

            <label>Segmento (Margem) <input class="cell" @bind="_o.SegmentoMargem" list="dl-segmento" /></label>
            <label>Venda para <input class="cell" @bind="_o.VendaPara" list="dl-vendapara" /></label>
            <label>Destino <input class="cell" @bind="_o.Destino" list="dl-destino" /></label>

            <label>País
                <select class="cell" @bind="_o.Pais">
                    @foreach (var p in ListasDoPricing.Paises) { <option value="@p">@p</option> }
                </select>
            </label>
            <label>Estado
                <select class="cell" @bind="_o.Estado" disabled="@(!NoBrasil)">
                    <option value="">—</option>
                    @foreach (var uf in Ufs) { <option value="@uf">@uf</option> }
                </select>
            </label>
            <label>Benefício
                <select class="cell" @bind="_o.Beneficio" disabled="@(!NoBrasil)">
                    @foreach (var b in ListasDoPricing.Beneficios) { <option value="@b">@b</option> }
                </select>
            </label>

            <label>Reforma <input class="cell" @bind="_o.Reforma" list="dl-simnao" /></label>
            <label>Prazo de Entrega <input class="cell" @bind="_o.PrazoEntrega" placeholder="ex.: 90 dias" list="dl-prazo" /></label>

            <label>Cliente com <input class="cell" @bind="_o.ClienteCom" list="dl-clientecom" /></label>
            <label>Fiança/Seguro Garantia <input class="cell" @bind="_o.FiancaSeguro" list="dl-fianca" /></label>
            <label>Portal <input class="cell" @bind="_o.Portal" list="dl-portal" /></label>

            <label>Rep 1 <input class="cell" @bind="_o.Rep1" list="dl-rep" />@SeloComissao(_o.Rep1)</label>
            <label>Rep 2 <input class="cell" @bind="_o.Rep2" list="dl-rep" />@SeloComissao(_o.Rep2)</label>
            <label>Categories <input class="cell" @bind="_o.Categories" list="dl-categories" /></label>

            <label>Product <input class="cell" @bind="_o.Product" list="dl-product" /></label>
            <label>Market Segments <input class="cell" @bind="_o.MarketSegments" list="dl-market" /></label>
        </div>

        @if (_items.Any(i => i.Importado))
        {
            var imp = Importacoes;
            <div class="bloco-importacao">
                <div class="bloco-importacao-titulo">Importação
                    <span>@_items.Count(i => i.Importado) item(ns) importado(s) · planilha de custos de importação de @ParamImportacao.VersaoPlanilha</span>
                </div>
                <div class="imp-linha">
                    <div class="imp-modo">
                        <span class="imp-rot">Importar por *</span>
                        <label class="imp-opcao @(_o.ImportacaoModo == "total" ? "on" : "")">
                            <input type="radio" name="impmodo" checked="@(_o.ImportacaoModo == "total")"
                                   @onchange='() => _o.ImportacaoModo = "total"' />
                            <span><strong>Total</strong><small>soma tudo numa importação só</small></span>
                        </label>
                        <label class="imp-opcao @(_o.ImportacaoModo == "item" ? "on" : "")">
                            <input type="radio" name="impmodo" checked="@(_o.ImportacaoModo == "item")"
                                   @onchange='() => _o.ImportacaoModo = "item"' />
                            <span><strong>Item</strong><small>uma importação para cada item</small></span>
                        </label>
                    </div>
                    <label class="imp-campo">Moeda
                        <select class="cell" @bind="_o.Moeda">
                            @foreach (var m in Moedas) { <option value="@m">@m</option> }
                        </select>
                    </label>
                    <label class="imp-campo">Taxa cambial (R$ por @_o.Moeda) *
                        <input class="cell num" type="number" min="0" step="0.0001" placeholder="ex.: 6,5"
                               value="@(_o.TaxaCambio > 0 ? _o.TaxaCambio.ToString(CultureInfo.InvariantCulture) : "")"
                               @onchange="MudarTaxa" />
                    </label>
                </div>

                @if (imp.Pendencias.Count > 0)
                {
                    <div class="imp-pendencia">Para calcular: @string.Join(" · ", imp.Pendencias)</div>
                }
                else
                {
                    <div class="imp-resumo">
                        <div class="@(_o.ImportacaoModo == "total" ? "escolhido" : "")">
                            <span>Por total</span>
                            <strong>@Fmt.Brl(imp.TotalPorTotal)</strong>
                            <small>1 importação de @Me(imp.ValorMoedaTotal)</small>
                        </div>
                        <div class="@(_o.ImportacaoModo == "item" ? "escolhido" : "")">
                            <span>Por item</span>
                            <strong>@Fmt.Brl(imp.TotalPorItem)</strong>
                            <small>@imp.PorItem.Count importação(ões) individual(is)</small>
                        </div>
                        <div>
                            <span>Diferença</span>
                            <strong>@Fmt.Brl(Math.Abs(imp.TotalPorItem - imp.TotalPorTotal))</strong>
                            <small>@(imp.TotalPorItem >= imp.TotalPorTotal ? "por total sai mais barato" : "por item sai mais barato")</small>
                        </div>
                    </div>
                    @if (string.IsNullOrEmpty(_o.ImportacaoModo))
                    {
                        <div class="imp-pendencia">Escolha <strong>Total</strong> ou <strong>Item</strong> para levar o custo aos itens.</div>
                    }
                    <button class="btn-link" style="margin-top:6px" @onclick="() => _verMemoria = !_verMemoria">
                        @(_verMemoria ? "esconder memória de cálculo" : "ver memória de cálculo (como na planilha)")
                    </button>
                    @if (_verMemoria)
                    {
                        var calculos = _o.ImportacaoModo == "item" ? imp.PorItem : new List<(string, CalculoImportacao)> { ("Importação total", imp.PorTotal!) };
                        <div class="tabela-rolante">
                        <table class="grid memoria-imp">
                            <thead>
                                <tr><th>Despesa (R$)</th>@foreach (var (rot, _) in calculos) { <th class="right">@rot</th> }</tr>
                            </thead>
                            <tbody>
                                @foreach (var desc in calculos[0].Item2.Linhas.Select(l => l.Descricao))
                                {
                                    <tr>
                                        <td>@desc</td>
                                        @foreach (var (_, c) in calculos)
                                        {
                                            <td class="right nowrap">@Fmt.Brl(c.Linhas.FirstOrDefault(l => l.Descricao == desc)?.Valor ?? 0)</td>
                                        }
                                    </tr>
                                }
                                <tr class="memoria-total">
                                    <td>Custo total da operação já deduzidos os créditos tributários</td>
                                    @foreach (var (_, c) in calculos) { <td class="right nowrap">@Fmt.Brl(c.CustoTotal)</td> }
                                </tr>
                                <tr>
                                    <td>% de custo sobre o produto</td>
                                    @foreach (var (_, c) in calculos) { <td class="right nowrap">@c.PercentualSobreProduto.ToString("P2", PtBr)</td> }
                                </tr>
                            </tbody>
                        </table>
                        </div>
                        <div class="sub-cel" style="display:block">IPI, PIS, COFINS e ICMS são créditos tributários: entram e saem na planilha, por isso não somam no custo.</div>
                    }
                }
            </div>
        }

        @* sugestões: valores já usados em propostas anteriores + opções usuais *@
        <datalist id="dl-simnao"><option value="Sim" /><option value="Não" /></datalist>
        <datalist id="dl-revisao">@foreach (var v in Sugestoes(o => o.Revisao, "0", "1", "2")) { <option value="@v" /> }</datalist>
        <datalist id="dl-bu">@foreach (var v in Sugestoes(o => o.Bu)) { <option value="@v" /> }</datalist>
        <datalist id="dl-segmento">@foreach (var v in Sugestoes(o => o.SegmentoMargem, _segs)) { <option value="@v" /> }</datalist>
        <datalist id="dl-vendapara">@foreach (var v in Sugestoes(o => o.VendaPara, "Consumidor final", "Industrialização", "Revenda")) { <option value="@v" /> }</datalist>
        <datalist id="dl-destino">@foreach (var v in Sugestoes(o => o.Destino)) { <option value="@v" /> }</datalist>
        <datalist id="dl-prazo">@foreach (var v in Sugestoes(o => o.PrazoEntrega)) { <option value="@v" /> }</datalist>
        <datalist id="dl-clientecom">@foreach (var v in Sugestoes(o => o.ClienteCom)) { <option value="@v" /> }</datalist>
        <datalist id="dl-fianca">@foreach (var v in Sugestoes(o => o.FiancaSeguro, "Não", "Fiança", "Seguro Garantia")) { <option value="@v" /> }</datalist>
        <datalist id="dl-portal">@foreach (var v in Sugestoes(o => o.Portal)) { <option value="@v" /> }</datalist>
        @* representantes com comissão (tabela do pricing) + vendedores + nomes já usados *@
        <datalist id="dl-rep">@foreach (var v in Sugestoes(o => o.Rep1, ListasDoPricing.Representantes.Select(r => r.Nome).Concat(_nomesVendedores)).Concat(Sugestoes(o => o.Rep2)).Distinct()) { <option value="@v" /> }</datalist>
        <datalist id="dl-categories">@foreach (var v in Sugestoes(o => o.Categories)) { <option value="@v" /> }</datalist>
        <datalist id="dl-product">@foreach (var v in Sugestoes(o => o.Product)) { <option value="@v" /> }</datalist>
        <datalist id="dl-market">@foreach (var v in Sugestoes(o => o.MarketSegments)) { <option value="@v" /> }</datalist>
    </div>

    <div class="panel" style="margin-bottom:16px">
        <div class="dash-title">Contato e equipamentos</div>
        <div class="form3">
            <label>A/C (contato) <input class="cell" @bind="_o.AttentionTo" /></label>
            <label>Cidade <input class="cell" @bind="_o.City" /></label>
            <label>Nossa referência <input class="cell" @bind="_o.OurReference" /></label>
            <label>Projeto <input class="cell" @bind="_o.Project" /></label>
        </div>

        @if (!string.IsNullOrEmpty(_unitId))
        {
            <div class="dash-title" style="margin-top:16px">Equipamentos da unidade
                <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">marque um ou mais</span>
            </div>
            @if (EquipsDaUnidade.Count == 0)
            {
                <div class="empty" style="padding:8px 0">Nenhum equipamento instalado nesta unidade.</div>
            }
            else
            {
                <div class="equip-chips">
                    @foreach (var e in EquipsDaUnidade)
                    {
                        var marcado = _equipIds.Contains(e.Id);
                        <label class="equip-chip @(marcado ? "on" : "")">
                            <input type="checkbox" checked="@marcado" @onchange="() => AlternarEquip(e.Id)" />
                            <span><strong>@e.Modelo</strong><small>@e.Tipo</small></span>
                        </label>
                    }
                </div>
            }
        }
    </div>

    @if (_equipIds.Count > 0)
    {
        <div class="panel" style="margin-bottom:16px">
            <div class="dash-title">Itens da BOM dos equipamentos selecionados
                <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                    a situação de nacionalização e as referências são verificadas automaticamente
                </span>
            </div>
            <div class="toolbar tab-toolbar">
                <input class="cell busca-bom" placeholder="Buscar partnumber, descrição, item…"
                       @bind="_bomBusca" @bind:event="oninput" />
                <div style="flex:1"></div>
                <button class="btn-ghost" @onclick="MarcarVisiveis">Marcar todos visíveis</button>
                <button class="btn-primary" disabled="@(_bomMarcados.Count == 0)" @onclick="AdicionarBomMarcados">
                    + Adicionar @(_bomMarcados.Count) item(ns) à proposta
                </button>
            </div>
            <div class="tabela-rolante" style="max-height:340px;overflow-y:auto">
            <table class="grid tabela-bom-proposta">
                <thead>
                    <tr>
                        <th style="width:34px"></th><th>Equipamento</th><th>Item</th><th>Partnumber</th><th>Descrição</th>
                        <th class="right">Qtd BOM</th><th>Nacionalizado</th><th class="right">Referência de custo</th><th class="right">Última venda</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in BomVisivel)
                    {
                        var r = Ref(b.PartNumber);
                        var naProposta = _items.Any(i => i.EquipmentId == b.EquipmentId &&
                            IntelligenceService.NormPn(i.PartNumber) == IntelligenceService.NormPn(b.PartNumber) && i.PartNumber.Length > 0);
                        <tr class="@(naProposta ? "linha-na-proposta" : "")">
                            <td>
                                @if (naProposta)
                                {
                                    <span class="sub-cel" title="Já está na proposta">✓</span>
                                }
                                else
                                {
                                    <input type="checkbox" checked="@_bomMarcados.Contains(b.Id)" @onchange="() => AlternarBom(b.Id)" />
                                }
                            </td>
                            <td class="nowrap">@ModeloDe(b.EquipmentId)</td>
                            <td class="nowrap">@Txt(b.Item)</td>
                            <td class="nowrap"><strong>@Txt(b.PartNumber)</strong></td>
                            <td>@DescricaoBom(b)</td>
                            <td class="right">@Txt(b.Quantidade)</td>
                            <td>@SeloNac(r)</td>
                            <td class="right nowrap">@CelulaCusto(r)</td>
                            <td class="right nowrap">@CelulaUltimaVenda(r)</td>
                        </tr>
                    }
                    @if (BomVisivel.Count == 0)
                    {
                        <tr><td colspan="9" class="empty">
                            @(_bomBusca.Trim().Length > 0 ? $"Nenhum item da BOM corresponde a \"{_bomBusca}\"."
                                                           : "Os equipamentos selecionados não têm BOM cadastrada.")
                        </td></tr>
                    }
                </tbody>
            </table>
            </div>
            <div style="margin-top:10px">
                <button class="btn-ghost" @onclick="AdicionarPecas">+ Adicionar peças das regras de troca</button>
            </div>
        </div>
    }

    <div class="panel" style="margin-bottom:16px">
        <div class="dash-title">Itens da proposta
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                referência de custo e última venda são só para apoio — o preço é sempre o que você definir
            </span>
        </div>
        <div class="tabela-rolante">
        <table class="grid tabela-proposta" style="margin-bottom:12px">
            <thead>
                <tr>
                    <th>Descrição</th><th>Nacionalizado</th><th>Importado</th><th class="right">Referência de custo (R$)</th>
                    <th class="right">Última venda (R$)</th><th class="right">Qtd</th>
                    <th class="right">Preço unitário da proposta (R$)</th><th class="right">Total</th><th></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _items.Count; i++)
                {
                    var it = _items[i];
                    var idx = i;
                    var r = RefDoItem(it);
                    <tr class="@(it.UnitPrice <= 0 ? "sem-preco" : "")">
                        <td>
                            @it.Description
                            @if (it.EquipmentId.Length > 0)
                            {
                                <span class="sub-cel">@ModeloDe(it.EquipmentId)</span>
                            }
                        </td>
                        <td>@(it.PartNumber.Length > 0 ? SeloNac(r) : Traco)</td>
                        <td class="nowrap">
                            <label class="chk-inline" style="color:var(--text)">
                                <input type="checkbox" checked="@it.Importado" @onchange="e => MarcarImportado(idx, e)" /> importado
                            </label>
                            @if (it.Importado)
                            {
                                <div class="imp-preco">
                                    <input class="cell num" type="number" min="0" step="0.01" placeholder="preço unit."
                                           value="@(it.ValorMoeda > 0 ? it.ValorMoeda.ToString(CultureInfo.InvariantCulture) : "")"
                                           @onchange="e => MudarValorMoeda(idx, e)" />
                                    <span>@_o.Moeda</span>
                                </div>
                            }
                        </td>
                        <td class="right nowrap">
                            @if (it.Importado)
                            {
                                var ci = CustoImportadoDo(it);
                                @if (ci is decimal cu)
                                {
                                    <strong>@Fmt.Brl(cu)</strong>
                                    <span class="sub-cel">importação @(_o.ImportacaoModo == "item" ? "por item" : "por total (rateio)")</span>
                                    @if (it.Quantity > 1)
                                    {
                                        <span class="sub-cel">@Fmt.Brl(cu * it.Quantity) na linha</span>
                                    }
                                }
                                else
                                {
                                    <span class="custo-indisp">@(it.ValorMoeda <= 0 ? $"informe o preço em {_o.Moeda}" : "complete a importação no topo")</span>
                                }
                            }
                            else if (it.PartNumber.Length > 0)
                            {
                                @CelulaCusto(r)
                            }
                            else
                            {
                                @Traco
                            }
                        </td>
                        <td class="right nowrap">
                            @if (it.PartNumber.Length > 0)
                            {
                                @CelulaUltimaVenda(r)
                                @if (r.UltimaVenda is decimal uv && uv != it.UnitPrice)
                                {
                                    <button class="btn-link usar-preco" title="Copiar o valor da última venda para o preço da proposta"
                                            @onclick="() => UsarPreco(idx, uv)">usar</button>
                                }
                            }
                            else
                            {
                                @Traco
                            }
                        </td>
                        <td class="right">
                            <input class="cell num qtd-cel" type="number" min="1" value="@it.Quantity"
                                   @onchange="e => MudarQtd(idx, e)" />
                        </td>
                        <td class="right">
                            <input class="cell num preco-cel" type="number" min="0" step="0.01" placeholder="definir"
                                   value="@(it.UnitPrice > 0 ? it.UnitPrice.ToString(CultureInfo.InvariantCulture) : "")"
                                   @onchange="e => MudarPreco(idx, e)" />
                        </td>
                        <td class="right nowrap"><strong>@Fmt.Brl(it.TotalPrice)</strong></td>
                        <td><button class="btn-link" style="color:#b91c1c" @onclick="() => Remover(idx)">remover</button></td>
                    </tr>
                }
                @if (_items.Count == 0) { <tr><td colspan="9" class="empty">Nenhum item. Selecione equipamentos e itens da BOM acima, ou adicione um item manual.</td></tr> }
            </tbody>
        </table>
        </div>
        <div class="item-row" style="grid-template-columns:2fr 80px 120px auto">
            <label>Descrição (item manual) <input class="cell" @bind="_desc" /></label>
            <label>Qtd <input class="cell num" type="number" @bind="_qtd" /></label>
            <label>Unitário (R$) <input class="cell num" type="number" step="0.01" @bind="_preco" /></label>
            <label>&nbsp;<button class="btn-primary" @onclick="AdicionarItem">Adicionar</button></label>
        </div>
    </div>

    @{
        var custos = Custos;
        var entrada = PricingDaProposta.EntradaDe(_o, custos.Total);
        var pr = PricingDaProposta.Da(_o, custos.Total);
        var margemPrecos = MargemDosPrecos(custos);
    }
    <div class="panel pricing" style="margin-bottom:16px">
        <div class="dash-title">Pricing
            <span style="margin-left:8px;font-size:12px;font-weight:600;color:var(--muted)">
                custo dos itens → risco → markup → comissões e percentuais → venda líquida → impostos · fórmula do pricing do axiaisvent
            </span>
        </div>
        <div class="pricing-campos">
            <label>Risco adicional (%)
                <input class="cell num" type="number" min="0" step="0.01" value="@Pct100(_o.RiscoAdicional)"
                       @onchange="e => _o.RiscoAdicional = Fracao(e, _o.RiscoAdicional)" />
            </label>
            <label>Margem de negociação (%)
                <input class="cell num" type="number" min="0" step="0.01" value="@Pct100(_o.MargemNegociacao)"
                       @onchange="e => _o.MargemNegociacao = Fracao(e, _o.MargemNegociacao)" />
            </label>
            <div class="pricing-modo-campo">
                <span>Calcular o preço</span>
                <div class="pricing-modo">
                    <button class="@(PelaMargem ? "btn-primary" : "btn-ghost")" @onclick='() => _o.PricingModo = "margem"'>pela margem</button>
                    <button class="@(PelaMargem ? "btn-ghost" : "btn-primary")" @onclick='() => _o.PricingModo = "preco"'>pelo preço-meta</button>
                </div>
            </div>
            @if (PelaMargem)
            {
                <label>Margem alvo (%)
                    <input class="cell num" type="number" min="0" max="99" step="0.1" value="@Pct100(_o.MargemAlvo)"
                           @onchange="e => _o.MargemAlvo = Fracao(e, _o.MargemAlvo)" />
                    <small class="pricing-dica">padrão @Pct(PricingDaProposta.MargemAlvoPadrao)</small>
                </label>
            }
            else
            {
                <label>Preço-meta: venda líquida (R$)
                    <input class="cell num" type="number" min="0" step="0.01" placeholder="quanto o cliente aceita"
                           value="@(_o.PrecoMeta > 0 ? _o.PrecoMeta.ToString(CultureInfo.InvariantCulture) : "")"
                           @onchange="e => _o.PrecoMeta = Numero(e) is decimal v && v > 0 ? v : 0" />
                    <small class="pricing-dica">sem impostos, para os itens com custo</small>
                </label>
            }
        </div>

        <div class="pricing-custo">
            <span>Custo total dos itens</span>
            <strong>@Fmt.Brl(custos.Total)</strong>
            <small>
                @custos.ComCusto.Count de @_items.Count item(ns) com custo
                · importados @Fmt.Brl(custos.Importados) · nacionalizados @Fmt.Brl(custos.Nacionais)
            </small>
        </div>
        @if (custos.SemCusto.Count > 0)
        {
            <div class="imp-pendencia">
                Sem custo, fora da conta: @string.Join(" · ", custos.SemCusto.Select(NomeCurto)).
                Marque como importado (com o preço na moeda) ou cadastre o Valor BR na Nacionalização.
            </div>
        }

        @if (custos.Total <= 0)
        {
            <div class="empty" style="padding:12px 0 2px">
                O pricing aparece quando algum item tem custo: item importado (custo da importação) ou nacionalizado com referência de custo.
            </div>
        }
        else if (PelaMargem && pr.Markup <= 0)
        {
            <div class="alert-error" style="margin-top:10px">
                Margem alvo alta demais: com @Pct(pr.PercentuaisDeVenda) de comissões e percentuais de venda,
                a margem tem de ficar abaixo de @Pct(1 - pr.PercentuaisDeVenda).
            </div>
        }
        else if (!PelaMargem && _o.PrecoMeta <= 0)
        {
            <div class="imp-pendencia">Informe o preço-meta (venda líquida, sem impostos) para ver a margem.</div>
        }
        else
        {
            @foreach (var aviso in PricingDaProposta.Avisos(pr, _o))
            {
                <div class="pricing-aviso">@aviso</div>
            }
            <div class="imp-resumo">
                <div class="escolhido">
                    <span>Venda líquida (sem impostos)</span>
                    <strong>@Fmt.Brl(pr.VendaLiquida)</strong>
                    <small>markup @pr.Markup.ToString("N4", PtBr) sobre o custo com riscos</small>
                </div>
                <div>
                    <span>Margem</span>
                    <strong>@Pct(pr.Margem)</strong>
                    <small>@Fmt.Brl(pr.VendaLiquida * pr.Margem)@(PelaMargem ? "" : " · saiu do preço-meta")</small>
                </div>
                <div>
                    <span>Preço com impostos</span>
                    <strong>@Fmt.Brl(pr.PrecoComImpostos)</strong>
                    <small>@(pr.PrecoComImpostos == pr.VendaLiquida ? "sem impostos brasileiros" : "PIS, COFINS e ICMS por dentro")</small>
                </div>
            </div>

            <button class="btn-link" style="margin-top:6px" @onclick="() => _verPricing = !_verPricing">
                @(_verPricing ? "esconder linhas do pricing" : "ver todas as linhas do pricing")
            </button>
            @if (_verPricing)
            {
                var pmSach = Textos.Igual(entrada.Destino, "Nacional") ? CalculoPricing.PmSachNacional : CalculoPricing.PmSachExterior;
                <div class="tabela-rolante">
                <table class="grid pricing-tabela">
                    <thead><tr><th>Linha do pricing</th><th class="right">Valor (R$)</th><th class="right">%</th></tr></thead>
                    <tbody>
                        <tr><td><strong>Custo total</strong></td><td class="right nowrap">@Fmt.Brl(pr.CustoTotal)</td><td class="right">—</td></tr>
                        <tr><td>Risco adicional</td><td class="right nowrap">@Fmt.Brl(pr.Risco)</td><td class="right">@Pct(_o.RiscoAdicional)</td></tr>
                        <tr><td><strong>Custo com riscos</strong></td><td class="right nowrap">@Fmt.Brl(pr.CustoComRiscos)</td><td class="right">—</td></tr>
                        <tr><td>Markup</td><td class="right nowrap">@pr.Markup.ToString("N4", PtBr)</td><td class="right">—</td></tr>
                        <tr><td>Venda pura</td><td class="right nowrap">@Fmt.Brl(pr.VendaPura)</td><td class="right">—</td></tr>
                        <tr>
                            <td>Comissões
                                <span class="sub-cel">PPR @Pct(CalculoPricing.Ppr) · Sales Director @Pct(CalculoPricing.SalesDirector) · DSR
                                    · Rep 1 @Pct(PricingDaProposta.ComissaoDe(_o.Rep1)) · Rep 2 @Pct(PricingDaProposta.ComissaoDe(_o.Rep2))</span>
                            </td>
                            <td class="right nowrap">@Fmt.Brl(pr.VendaLiquida * pr.Comissoes)</td><td class="right">@Pct(pr.Comissoes)</td>
                        </tr>
                        <tr>
                            <td>Negociação, PM/SACH, garantia e portal
                                <span class="sub-cel">negociação @Pct(_o.MargemNegociacao) · PM/SACH @Pct(pmSach) · garantia @Pct(CalculoPricing.GarantiaDoProjeto)
                                    · portal @(entrada.ComPortal ? Pct(CalculoPricing.Portal) : "não")</span>
                            </td>
                            <td class="right nowrap">@Fmt.Brl(pr.VendaLiquida * (pr.PercentuaisDeVenda - pr.Comissoes))</td>
                            <td class="right">@Pct(pr.PercentuaisDeVenda - pr.Comissoes)</td>
                        </tr>
                        <tr class="memoria-total"><td>Venda líquida (sem impostos)</td><td class="right nowrap">@Fmt.Brl(pr.VendaLiquida)</td><td class="right">—</td></tr>
                        <tr><td>Margem</td><td class="right nowrap">@Fmt.Brl(pr.VendaLiquida * pr.Margem)</td><td class="right"><strong>@Pct(pr.Margem)</strong></td></tr>
                        @if (pr.PrecoComImpostos != pr.VendaLiquida)
                        {
                            <tr><td>PIS</td><td class="right nowrap">@Fmt.Brl(pr.ValorPis)</td><td class="right">@Pct(pr.ValorPis == 0 ? 0 : CalculoPricing.Pis)</td></tr>
                            <tr><td>COFINS</td><td class="right nowrap">@Fmt.Brl(pr.ValorCofins)</td><td class="right">@Pct(pr.ValorCofins == 0 ? 0 : CalculoPricing.Cofins)</td></tr>
                            <tr><td>ICMS <span class="sub-cel">@entrada.Estado, pela coluna @entrada.Bu</span></td>
                                <td class="right nowrap">@Fmt.Brl(pr.ValorIcms)</td>
                                <td class="right">@Pct(CalculoPricing.IcmsDoEstado(entrada.Estado, entrada.Bu) ?? 0)</td></tr>
                            <tr><td>IPI <span class="sub-cel">zero na fórmula do axiaisvent (segmento NB)</span></td>
                                <td class="right nowrap">@Fmt.Brl(pr.ValorIpi)</td><td class="right">@Pct(0)</td></tr>
                        }
                        else
                        {
                            <tr><td>Impostos <span class="sub-cel">exportação ou venda fora do Brasil: sem PIS, COFINS, ICMS e IPI</span></td>
                                <td class="right">—</td><td class="right">—</td></tr>
                        }
                        <tr class="memoria-total"><td>Preço com impostos</td><td class="right nowrap">@Fmt.Brl(pr.PrecoComImpostos)</td><td class="right">—</td></tr>
                    </tbody>
                </table>
                </div>
            }

            <div class="pricing-entrada">
                Entrou na conta: destino <strong>@entrada.Destino</strong>
                · estado <strong>@(entrada.Estado.Length > 0 ? entrada.Estado : "—")</strong>
                · ICMS pela coluna <strong>@entrada.Bu</strong> (campo BU)
                · venda para <strong>@(entrada.VendaPara.Length > 0 ? entrada.VendaPara : "—")</strong>
                · benefício <strong>@entrada.Beneficio</strong>
                · portal <strong>@(entrada.ComPortal ? "sim" : "não")</strong>
            </div>

            <div class="pricing-acoes">
                <button class="btn-primary" @onclick="AplicarPricing">Aplicar preços do pricing nos @custos.ComCusto.Count item(ns) com custo</button>
                <span>
                    Preço unitário sem impostos (como diz a proposta), proporcional ao custo de cada item.
                    Só muda quando você clica; depois dá para ajustar à mão.
                    @if (margemPrecos is decimal mp)
                    {
                        <br /><span>Com os preços que estão hoje nesses itens, a margem fica em <strong>@Pct(mp)</strong>.</span>
                    }
                </span>
            </div>
        }
    </div>

    <div class="panel">
        <div class="dash-title">Condições comerciais</div>
        <div class="form-grid">
            <label>Introdução <textarea class="cell" @bind="_o.IntroText"></textarea></label>
            <label>Condição de pagamento
                <select class="cell" @bind="_o.PaymentTerms">
                    @foreach (var p in OfferDefaults.PaymentOptions) { <option value="@p">@p</option> }
                </select>
            </label>
            <label>Prazo de entrega (texto da proposta) <textarea class="cell" @bind="_o.DeliveryTime"></textarea></label>
            <label>Validade <input class="cell" @bind="_o.ValidityText" /></label>
            <label>Observações <textarea class="cell" style="min-height:90px" @bind="_o.Observations"></textarea></label>
            <label>Termos e condições <textarea class="cell" @bind="_o.TermsText"></textarea></label>
        </div>
    </div>
  </div>

  <div class="prop-side">
    <div class="side-total">
        <div>Total da oferta</div>
        <div class="side-total-value">@Fmt.Brl(Total)</div>
    </div>
    @if (_items.Count > 0)
    {
        <div class="side-note">
            @_items.Count item(ns)
            @if (_items.Count(i => i.UnitPrice <= 0) is > 0 and var semPreco)
            {
                <br /><span style="color:#b45309;font-weight:600">@semPreco sem preço definido</span>
            }
            @if (MargemDosPrecos(Custos) is decimal mLateral)
            {
                <br /><span>Margem (itens com custo): <strong>@Pct(mLateral)</strong></span>
            }
        </div>
    }
    <div class="side-note">O documento imprimível é gerado após salvar. Custo de referência e última venda não aparecem para o cliente.</div>
    @if (_erro is not null) { <div class="alert-error">@_erro</div> }
    <button class="btn-accent btn-block" @onclick="Salvar">Salvar oferta</button>
    <a class="btn-ghost btn-block" href="/ofertas">Cancelar</a>
  </div>
</div>

@code {
    private List<ClientUnit> _units = new();
    private List<InstalledBase> _base = new();
    private List<Part> _parts = new();
    private List<Equipment> _equipamentos = new();
    private List<BomItem> _bom = new();
    private List<Nacionalizacao> _nacionais = new();
    private List<SalesRecord> _vendas = new();

    private CommercialOffer _o = new()
    {
        Status = "Rascunho",
        IntroText = OfferDefaults.Intro, TaxText = OfferDefaults.Tax, PaymentTerms = OfferDefaults.Payment,
        DeliveryTime = OfferDefaults.DeliveryTime, DeliveryConditions = OfferDefaults.DeliveryConditions,
        ValidityText = OfferDefaults.Validity, Observations = OfferDefaults.Observations,
        SgiText = OfferDefaults.Sgi, TermsText = OfferDefaults.Terms,
    };
    private List<CommercialOfferItem> _items = new();
    private string _unitId = "";
    private readonly List<string> _equipIds = new();          // equipamentos marcados, na ordem em que foram marcados
    private readonly HashSet<string> _bomMarcados = new();    // ids de BomItem marcados para adicionar
    private string _bomBusca = "";
    private string _desc = "";
    private int _qtd = 1;
    private decimal _preco;
    private string? _erro;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private List<CommercialOffer> _anteriores = new();
    private List<string> _segs = new(), _nomesVendedores = new();
    // último valor preenchido automaticamente: só é trocado se o usuário não mexeu nele
    private string _autoSeg = "", _autoUf = "", _autoRep = "";

    private bool _verMemoria, _verPricing;
    private static readonly string[] Moedas = { "EUR", "USD", "GBP", "OUTRA" };
    private static readonly CultureInfo PtBr = new("pt-BR");

    // ---- pricing (fórmula do axiaisvent, ligada em Data/PricingDaProposta.cs) ----

    private bool PelaMargem => _o.PricingModo != "preco";
    private bool NoBrasil => ListasDoPricing.TemImpostosBrasileiros(PricingDaProposta.PaisOuBrasil(_o.Pais));

    /// <summary>52% → "52%"; 0,014 → "1,4%".</summary>
    private static string Pct(decimal fracao) => (fracao * 100).ToString("0.##", PtBr) + "%";
    /// <summary>Valor do campo em %, para o input (0,52 → "52").</summary>
    private static string Pct100(decimal fracao) => (fracao * 100).ToString("0.####", CultureInfo.InvariantCulture);
    /// <summary>O que foi digitado em % vira fração; vazio ou inválido mantém o valor anterior.</summary>
    private static decimal Fracao(ChangeEventArgs e, decimal atual) =>
        Numero(e) is decimal v && v >= 0 && v < 100 ? v / 100m : atual;

    /// <summary>Custo dos itens que entram no pricing: importação (unitário no modo escolhido) ou Valor BR do nacionalizado.</summary>
    private record CustoDosItens(decimal Total, decimal Importados, decimal Nacionais,
        List<(CommercialOfferItem It, decimal Unit)> ComCusto, List<CommercialOfferItem> SemCusto);

    private CustoDosItens Custos
    {
        get
        {
            Dictionary<CommercialOfferItem, decimal>? imp = null;
            if (_items.Any(i => i.Importado) && !string.IsNullOrEmpty(_o.ImportacaoModo))
            {
                var calc = Importacoes;
                imp = _o.ImportacaoModo == "item" ? calc.UnitarioPorItem : calc.UnitarioPorTotal;
            }
            var com = new List<(CommercialOfferItem, decimal)>();
            var sem = new List<CommercialOfferItem>();
            decimal importados = 0, nacionais = 0;
            foreach (var it in _items)
            {
                decimal? unit = null;
                if (it.Importado)
                {
                    if (imp is not null && imp.TryGetValue(it, out var u)) unit = u;
                }
                else if (it.PartNumber.Length > 0)
                {
                    var r = RefDoItem(it);
                    if (r.Nacionalizado) unit = r.Custo;
                }
                if (unit is decimal c && c > 0)
                {
                    com.Add((it, c));
                    if (it.Importado) importados += c * it.Quantity; else nacionais += c * it.Quantity;
                }
                else sem.Add(it);
            }
            return new CustoDosItens(importados + nacionais, importados, nacionais, com, sem);
        }
    }

    /// <summary>Margem com os preços digitados nos itens com custo (só quando todos têm preço).</summary>
    private decimal? MargemDosPrecos(CustoDosItens c)
    {
        if (c.Total <= 0 || c.ComCusto.Any(x => x.It.UnitPrice <= 0)) return null;
        var venda = c.ComCusto.Sum(x => x.It.UnitPrice * x.It.Quantity);
        return CalculoPricing.PeloPreco(PricingDaProposta.EntradaDe(_o, c.Total), venda).Margem;
    }

    /// <summary>Só por clique: leva o preço do pricing (sem impostos) aos itens com custo.</summary>
    private void AplicarPricing()
    {
        var c = Custos;
        if (c.Total <= 0) return;
        var r = PricingDaProposta.Da(_o, c.Total);
        if (r.VendaLiquida <= 0) return;
        foreach (var (it, unit) in c.ComCusto)
        {
            it.UnitPrice = PricingDaProposta.PrecoUnitario(unit, r);
            it.TotalPrice = it.Quantity * it.UnitPrice;
        }
        _erro = null;
    }

    private static string NomeCurto(CommercialOfferItem it) =>
        it.PartNumber.Length > 0 ? it.PartNumber
        : it.Description.Length > 40 ? it.Description[..40] + "…" : it.Description;

    /// <summary>Comissão do representante na tabela do pricing, embaixo do campo Rep.</summary>
    private static MarkupString SeloComissao(string nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return new("");
        var c = PricingDaProposta.ComissaoDe(nome);
        return new(c > 0
            ? $"<small class=\"pricing-dica ok\">comissão {Pct(c)} no pricing</small>"
            : "<small class=\"pricing-dica\">sem comissão no pricing</small>");
    }

    /// <summary>Valor na moeda estrangeira, para a tela (ex.: "EUR 5.000,00").</summary>
    private string Me(decimal v) => $"{_o.Moeda} {v.ToString("N2", PtBr)}";

    /// <summary>
    /// Resultado das importações da proposta. Calcula os dois modos sempre, para
    /// a tela mostrar qual sai mais barato; o modo escolhido é o que vai para os itens.
    /// </summary>
    private record ResultadoImportacao(
        List<string> Pendencias,
        CalculoImportacao? PorTotal, decimal ValorMoedaTotal,
        List<(string Rotulo, CalculoImportacao Calc)> PorItem,
        Dictionary<CommercialOfferItem, decimal> UnitarioPorTotal,
        Dictionary<CommercialOfferItem, decimal> UnitarioPorItem)
    {
        public decimal TotalPorTotal => PorTotal?.CustoTotal ?? 0;
        public decimal TotalPorItem => PorItem.Sum(x => x.Calc.CustoTotal);
    }

    private ResultadoImportacao Importacoes
    {
        get
        {
            var importados = _items.Where(i => i.Importado).ToList();
            var pend = new List<string>();
            if (_o.TaxaCambio <= 0) pend.Add("informe a taxa cambial");
            var semPreco = importados.Count(i => i.ValorMoeda <= 0);
            if (semPreco > 0) pend.Add($"preço em {_o.Moeda} em {semPreco} item(ns)");
            var vazio = new ResultadoImportacao(pend, null, 0, new(), new(), new());
            if (pend.Count > 0) return vazio;

            // por total: uma importação com a soma (preço × qtd) e rateio pelo valor de cada item
            var totalMoeda = importados.Sum(i => i.ValorMoeda * i.Quantity);
            var total = CustoImportacao.Calcular(totalMoeda, _o.TaxaCambio, ParamImportacao);
            var unitTotal = importados.ToDictionary(i => i, i => Math.Round(total.CustoTotal * i.ValorMoeda / totalMoeda, 2));

            // por item: uma importação por linha (preço × qtd)
            var porItem = new List<(string, CalculoImportacao)>();
            var unitItem = new Dictionary<CommercialOfferItem, decimal>();
            foreach (var i in importados)
            {
                var c = CustoImportacao.Calcular(i.ValorMoeda * i.Quantity, _o.TaxaCambio, ParamImportacao);
                porItem.Add((i.PartNumber.Length > 0 ? i.PartNumber : i.Description, c));
                unitItem[i] = Math.Round(c.CustoTotal / i.Quantity, 2);
            }
            return new ResultadoImportacao(pend, total, totalMoeda, porItem, unitTotal, unitItem);
        }
    }

    /// <summary>Custo unitário de importação do item no modo escolhido (null enquanto falta dado).</summary>
    private decimal? CustoImportadoDo(CommercialOfferItem it)
    {
        if (!it.Importado || string.IsNullOrEmpty(_o.ImportacaoModo)) return null;
        var imp = Importacoes;
        var mapa = _o.ImportacaoModo == "item" ? imp.UnitarioPorItem : imp.UnitarioPorTotal;
        return mapa.TryGetValue(it, out var v) ? v : null;
    }

    private void MarcarImportado(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _items.Count) return;
        _items[idx].Importado = e.Value is bool b && b;
    }

    private void MudarValorMoeda(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _items.Count) return;
        _items[idx].ValorMoeda = Numero(e) is decimal v && v > 0 ? v : 0;
    }

    private void MudarTaxa(ChangeEventArgs e) => _o.TaxaCambio = Numero(e) is decimal v && v > 0 ? v : 0;

    private static decimal? Numero(ChangeEventArgs e) =>
        decimal.TryParse((e.Value?.ToString() ?? "").Replace(",", "."), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)
            ? v : null;

    private static readonly string[] Ufs =
    {
        "AC","AL","AP","AM","BA","CE","DF","ES","GO","MA","MT","MS","MG","PA","PB","PR",
        "PE","PI","RJ","RN","RS","RO","RR","SC","SP","SE","TO",
    };

    // referências por partnumber, calculadas uma vez por cliente (a base não muda enquanto a tela está aberta)
    private readonly Dictionary<string, ReferenciaPreco> _refs = new();

    private static readonly MarkupString Traco = new("<span style=\"color:var(--muted)\">—</span>");

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var nome = (await AuthState).User.Identity?.Name;
            if (!string.IsNullOrWhiteSpace(nome)) _o.PreparedBy = nome;
        }
        _o.OfferDate = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _anteriores = OffersRepo.All();
        _o.OfferCode = NumeroSugerido();
        _o.Revisao = "0";
        _segs = Segmentos.All().Select(g => g.Nome).ToList();
        _nomesVendedores = Vendedores.All().Where(v => v.Ativo).Select(v => v.Nome).ToList();
        _units = Units.All();
        _base = Base.All();
        _parts = Pecas.All();
        _equipamentos = Equipamentos.All();
        _bom = Bom.All();
        _nacionais = Nacionais.All();
        _vendas = Vendas.All();
    }

    // ---- cliente e equipamentos ------------------------------------------

    private List<Equipment> EquipsDaUnidade
    {
        get
        {
            if (string.IsNullOrEmpty(_unitId)) return new();
            var ids = _base.Where(b => b.ClientUnitId == _unitId).Select(b => b.EquipmentId).Distinct().ToHashSet();
            return _equipamentos.Where(e => ids.Contains(e.Id)).OrderBy(e => e.Modelo).ToList();
        }
    }

    private void UnidadeMudou()
    {
        _equipIds.Clear(); _bomMarcados.Clear(); _refs.Clear(); _bomBusca = "";
        var u = _units.FirstOrDefault(x => x.Id == _unitId);
        if (u != null)
        {
            _o.ClientName = Intel.CompanyName(u.CompanyId);
            _o.City = u.Cidade;
            _o.ClientUnitId = u.Id;
            _o.SegmentoMargem = Auto(_o.SegmentoMargem, ref _autoSeg, u.Segmento);
            _o.Estado = Auto(_o.Estado, ref _autoUf, (u.Estado ?? "").Trim().ToUpperInvariant());
            var rep = Intel.SalespersonName(u.VendedorId);
            _o.Rep1 = Auto(_o.Rep1, ref _autoRep, rep == "—" ? "" : rep);
        }
    }

    /// <summary>Número novo que ainda não existe em nenhuma proposta (data e hora + sufixo se preciso).</summary>
    private string NumeroSugerido()
    {
        var baseNum = "OF-" + DateTime.Now.ToString("yyyyMMdd-HHmmss", CultureInfo.InvariantCulture);
        var usados = _anteriores.Select(a => a.OfferCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var numero = baseNum;
        for (var i = 2; usados.Contains(numero); i++) numero = $"{baseNum}-{i}";
        return numero;
    }

    /// <summary>Preenche com o valor da base, sem atropelar o que o usuário já digitou.</summary>
    private static string Auto(string atual, ref string ultimoAuto, string novo)
    {
        var podeTrocar = string.IsNullOrWhiteSpace(atual) || atual == ultimoAuto;
        ultimoAuto = novo ?? "";
        return podeTrocar ? ultimoAuto : atual;
    }

    /// <summary>Data da proposta: hoje por padrão; o campo de data do Blazor pede DateOnly.</summary>
    private DateOnly? DataProposta
    {
        get => DateOnly.TryParseExact(_o.OfferDate, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var d) ? d : null;
        set => _o.OfferDate = value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
    }

    /// <summary>Opções usuais + valores já usados nas propostas anteriores (sem repetir).</summary>
    private IEnumerable<string> Sugestoes(Func<CommercialOffer, string> campo, params string[] padrao) =>
        Sugestoes(campo, (IEnumerable<string>)padrao);

    private IEnumerable<string> Sugestoes(Func<CommercialOffer, string> campo, IEnumerable<string> padrao) =>
        padrao.Concat(_anteriores.Select(campo))
              .Where(v => !string.IsNullOrWhiteSpace(v))
              .Select(v => v.Trim())
              .Distinct(StringComparer.OrdinalIgnoreCase);

    private void AlternarEquip(string id)
    {
        if (!_equipIds.Remove(id)) _equipIds.Add(id);
        // itens marcados de um equipamento desmarcado deixam de valer
        var validos = _bom.Where(b => _equipIds.Contains(b.EquipmentId)).Select(b => b.Id).ToHashSet();
        _bomMarcados.RemoveWhere(x => !validos.Contains(x));
    }

    private string ModeloDe(string equipmentId) =>
        _equipamentos.FirstOrDefault(e => e.Id == equipmentId)?.Modelo ?? equipmentId;

    // ---- BOM ----------------------------------------------------------------

    private List<BomItem> BomVisivel
    {
        get
        {
            var q = _bom.Where(b => _equipIds.Contains(b.EquipmentId));
            var s = _bomBusca.Trim().ToLowerInvariant();
            if (s.Length > 0)
                q = q.Where(b => string.Join(' ', b.Item, b.PartNumber, b.DescricaoPt, b.DescricaoEn, b.Material,
                                             ModeloDe(b.EquipmentId)).ToLowerInvariant().Contains(s));
            return q.OrderBy(b => _equipIds.IndexOf(b.EquipmentId))
                    .ThenBy(b => OrdemItem(b.Item)).ThenBy(b => b.PartNumber).ToList();
        }
    }

    private static int OrdemItem(string item) =>
        int.TryParse(new string((item ?? "").Where(char.IsDigit).ToArray()), out var n) ? n : int.MaxValue;

    private static string DescricaoBom(BomItem b) =>
        !string.IsNullOrWhiteSpace(b.DescricaoPt) ? b.DescricaoPt : b.DescricaoEn;

    private void AlternarBom(string id)
    {
        if (!_bomMarcados.Remove(id)) _bomMarcados.Add(id);
    }

    private void MarcarVisiveis()
    {
        foreach (var b in BomVisivel)
        {
            var naProposta = _items.Any(i => i.EquipmentId == b.EquipmentId && i.PartNumber.Length > 0 &&
                IntelligenceService.NormPn(i.PartNumber) == IntelligenceService.NormPn(b.PartNumber));
            if (!naProposta) _bomMarcados.Add(b.Id);
        }
    }

    /// <summary>
    /// Leva os itens marcados para a proposta. O preço fica em branco: a
    /// referência de custo e a última venda aparecem ao lado, mas quem define o
    /// preço é o usuário (o botão "usar" copia a última venda, se ele quiser).
    /// </summary>
    private void AdicionarBomMarcados()
    {
        foreach (var b in _bom.Where(b => _bomMarcados.Contains(b.Id))
                              .OrderBy(b => _equipIds.IndexOf(b.EquipmentId)).ThenBy(b => OrdemItem(b.Item)))
        {
            var r = Ref(b.PartNumber);
            var desc = DescricaoBom(b);
            _items.Add(new CommercialOfferItem
            {
                Description = string.IsNullOrWhiteSpace(b.PartNumber) ? desc
                              : string.IsNullOrWhiteSpace(desc) ? b.PartNumber : $"{b.PartNumber} — {desc}",
                Quantity = QtdDaBom(b.Quantidade),
                UnitPrice = 0,
                TotalPrice = 0,
                EquipmentId = b.EquipmentId,
                PartNumber = b.PartNumber.Trim(),
                Nacionalizado = r.Nacionalizado,
                CustoReferencia = r.Custo, CustoData = r.CustoData,
                UltimaVenda = r.UltimaVenda, UltimaVendaData = r.UltimaVendaData,
            });
        }
        _bomMarcados.Clear();
        _erro = null;
    }

    /// <summary>"2" → 2; "1 jogo" → 1; "3,5 kg" → 3; vazio → 1.</summary>
    private static int QtdDaBom(string q)
    {
        var digitos = new string((q ?? "").Trim().TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digitos, out var n) && n > 0 ? n : 1;
    }

    // ---- referências de preço -----------------------------------------------

    private ReferenciaPreco Ref(string? pn)
    {
        var chave = IntelligenceService.NormPn(pn);
        if (chave.Length == 0) return ReferenciaPreco.Vazia;
        if (!_refs.TryGetValue(chave, out var r))
            _refs[chave] = r = ReferenciaPreco.Para(pn, _unitId, _nacionais, _vendas);
        return r;
    }

    private ReferenciaPreco RefDoItem(CommercialOfferItem it) => Ref(it.PartNumber);

    private static MarkupString SeloNac(ReferenciaPreco r) => new(r.Nacionalizado
        ? "<span class=\"nac nac-sim\">Sim</span>"
        : "<span class=\"nac nac-nao\">Não</span>");

    /// <summary>Não nacionalizado: nada de custo. Nacionalizado sem valor: "Custo não disponível".</summary>
    private RenderFragment CelulaCusto(ReferenciaPreco r) => __builder =>
    {
        if (!r.Nacionalizado)
        {
            <span style="color:var(--muted)">—</span>
        }
        else if (r.Custo is decimal c)
        {
            <strong>@Fmt.Brl(c)</strong>
            @if (r.CustoData.Length > 0)
            {
                <span class="sub-cel">atualizado em @Fmt.Date(r.CustoData)</span>
            }
        }
        else
        {
            <span class="custo-indisp">Custo não disponível</span>
        }
    };

    private RenderFragment CelulaUltimaVenda(ReferenciaPreco r) => __builder =>
    {
        if (r.UltimaVenda is decimal v)
        {
            @Fmt.Brl(v)
            <span class="sub-cel">@Fmt.Date(r.UltimaVendaData) · @(r.UltimaVendaDoCliente ? "este cliente" : "outro cliente")</span>
        }
        else
        {
            <span style="color:var(--muted)">sem venda</span>
        }
    };

    // ---- itens da proposta ----------------------------------------------------

    /// <summary>Peças cadastradas nas regras de troca dos equipamentos marcados (como antes).</summary>
    private void AdicionarPecas()
    {
        foreach (var p in _parts.Where(p => _equipIds.Contains(p.EquipmentId)))
        {
            var r = Ref(p.Codigo);
            _items.Add(new CommercialOfferItem
            {
                Description = string.IsNullOrEmpty(p.Descritivo) ? p.Nome : $"{p.Nome} — {p.Descritivo}",
                Quantity = 1,
                UnitPrice = p.ValorEstimado,
                TotalPrice = p.ValorEstimado,
                EquipmentId = p.EquipmentId,
                PartNumber = (p.Codigo ?? "").Trim(),
                Nacionalizado = r.Nacionalizado,
                CustoReferencia = r.Custo, CustoData = r.CustoData,
                UltimaVenda = r.UltimaVenda, UltimaVendaData = r.UltimaVendaData,
            });
        }
    }

    private void AdicionarItem()
    {
        if (string.IsNullOrWhiteSpace(_desc)) return;
        var q = _qtd <= 0 ? 1 : _qtd;
        _items.Add(new CommercialOfferItem { Description = _desc.Trim(), Quantity = q, UnitPrice = _preco, TotalPrice = q * _preco });
        _desc = ""; _qtd = 1; _preco = 0;
    }

    private void MudarQtd(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _items.Count) return;
        var it = _items[idx];
        it.Quantity = int.TryParse(e.Value?.ToString(), out var q) && q > 0 ? q : 1;
        it.TotalPrice = it.Quantity * it.UnitPrice;
    }

    private void MudarPreco(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _items.Count) return;
        var it = _items[idx];
        var texto = (e.Value?.ToString() ?? "").Replace(",", ".");
        it.UnitPrice = decimal.TryParse(texto, NumberStyles.Any, CultureInfo.InvariantCulture, out var p) && p > 0 ? p : 0;
        it.TotalPrice = it.Quantity * it.UnitPrice;
    }

    /// <summary>Só por ação do usuário: copia a última venda para o preço da proposta.</summary>
    private void UsarPreco(int idx, decimal valor)
    {
        if (idx < 0 || idx >= _items.Count) return;
        var it = _items[idx];
        it.UnitPrice = valor;
        it.TotalPrice = it.Quantity * valor;
    }

    private void Remover(int idx)
    {
        if (idx >= 0 && idx < _items.Count) _items.RemoveAt(idx);
    }

    private decimal Total => _items.Sum(i => i.TotalPrice);

    private static string Txt(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private void Salvar()
    {
        if (string.IsNullOrWhiteSpace(_o.ClientName)) { _erro = "Informe o nome do cliente."; return; }
        _o.OfferCode = (_o.OfferCode ?? "").Trim();
        _o.Revisao = string.IsNullOrWhiteSpace(_o.Revisao) ? "0" : _o.Revisao.Trim();
        if (_o.OfferCode.Length == 0) { _erro = "Informe o número da proposta."; return; }
        if (_anteriores.Any(a => string.Equals(a.OfferCode, _o.OfferCode, StringComparison.OrdinalIgnoreCase)
                              && string.Equals(a.Revisao, _o.Revisao, StringComparison.OrdinalIgnoreCase)))
        {
            _erro = $"Já existe a proposta {_o.OfferCode} revisão {_o.Revisao}. Mude o número ou a revisão.";
            return;
        }
        if (_items.Any(i => i.Importado))
        {
            if (string.IsNullOrEmpty(_o.ImportacaoModo))
            { _erro = "Há item importado: marque no topo se a importação é por total ou por item."; return; }
            var pend = Importacoes.Pendencias;
            if (pend.Count > 0) { _erro = "Importação incompleta: " + string.Join(" · ", pend) + "."; return; }
            foreach (var it in _items) it.CustoImportacao = it.Importado ? CustoImportadoDo(it) : null;
        }
        else
        {
            _o.ImportacaoModo = ""; _o.TaxaCambio = 0;
        }
        var semPreco = _items.Count(i => i.UnitPrice <= 0);
        if (semPreco > 0)
        {
            _erro = $"Defina o preço unitário da proposta em {semPreco} item(ns) — estão destacados na tabela.";
            return;
        }
        // retrato do pricing no momento de salvar (consulta na tela da oferta)
        var custos = Custos;
        var pr = PricingDaProposta.Da(_o, custos.Total);
        var temPricing = custos.Total > 0 && pr.VendaLiquida > 0;
        _o.PricingCusto = temPricing ? Math.Round(custos.Total, 2) : 0;
        _o.PricingMarkup = temPricing ? Math.Round(pr.Markup, 6) : 0;
        _o.PricingVendaLiquida = temPricing ? Math.Round(pr.VendaLiquida, 2) : 0;
        _o.PricingMargem = temPricing ? Math.Round(pr.Margem, 6) : 0;
        _o.PricingPrecoImpostos = temPricing ? Math.Round(pr.PrecoComImpostos, 2) : 0;
        _o.Pais = PricingDaProposta.PaisOuBrasil(_o.Pais);
        if (!NoBrasil) _o.Beneficio = "Sem benefício";
        var now = DateTime.Now;
        _o.Id = Guid.NewGuid().ToString("N");
        _o.EquipmentId = string.Join(";", _equipIds);
        if (string.IsNullOrWhiteSpace(_o.OfferDate)) _o.OfferDate = now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _o.CreatedAt = now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _o.OurReference = string.IsNullOrWhiteSpace(_o.OurReference) ? _o.OfferCode : _o.OurReference;
        _o.TotalAmount = Total;
        OffersRepo.Save(_o);
        for (var n = 0; n < _items.Count; n++)
        {
            var it = _items[n];
            it.Id = Guid.NewGuid().ToString("N");
            it.OfferId = _o.Id;
            it.Ordem = n + 1;
            OffersRepo.SaveItem(it);
        }
        Nav.NavigateTo($"/ofertas/{_o.Id}");
    }
}
