    @if (nivelEfetivo.Codigo != _o.ImpostosNoPreco)
    {
        <div class="imp-pendencia">Esta proposta não tem esse nível de imposto (exportação, Back to Back, sem Estado ou procurar o Financeiro): os preços saem sem impostos.</div>
