    <div class="tabela-rolante" style="margin-top:12px">
    <table class="grid tabela-precos">
        <thead>
            <tr><th>Item</th><th class="right">Qtd</th><th class="right">Custo unitário (R$)</th><th class="right">Preço unitário (@Cambio.MoedaDoPreco(_o).Rotulo())</th><th class="right">Total</th></tr>
        </thead>
