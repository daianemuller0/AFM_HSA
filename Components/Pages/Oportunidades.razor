@page "/oportunidades"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntelligenceService Intel
@inject NavigationManager Nav

<PageTitle>Oportunidades · AFM HSA</PageTitle>

<h1>Oportunidades</h1>
<p class="subtitle">@Filtradas.Count oportunidade(s) · Potencial técnico @Fmt.Brl0(Total)</p>

<div class="toolbar">
    <input class="cell" style="max-width:300px" placeholder="Buscar cliente, equipamento, item…"
           @bind="_busca" @bind:event="oninput" />
    <select class="cell" style="max-width:180px" @bind="_urg">
        <option value="">Toda urgência</option>
        <option value="Crítica">Crítica</option>
        <option value="Alta">Alta</option>
        <option value="Média">Média</option>
        <option value="Baixa">Baixa</option>
    </select>
</div>

<div style="overflow-x:auto">
<table class="grid">
    <thead>
        <tr>
            <th>Cliente / Unidade</th><th>Equipamento</th><th>Item</th>
            <th>Última venda</th><th>Janela prevista</th><th>Prazo</th>
            <th>Urgência</th><th class="right">Potencial</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Filtradas)
        {
            <tr style="cursor:pointer" @onclick="() => Go(o.Id)">
                <td>@Intel.UnitLabel(o.ClientUnitId)</td>
                <td>@Intel.EquipmentModel(o.EquipmentId)</td>
                <td>@o.Item</td>
                <td class="nowrap">@Fmt.Date(o.DataUltimaVenda)</td>
                <td class="nowrap">@Fmt.Date(o.DataPrevista)</td>
                <td class="nowrap @(o.DiasAteJanela < 0 ? "dias-vencida" : "")">@Prazo(o)</td>
                <td><span class="badge @IntelligenceService.UrgClass(o.Urgencia)">@o.Urgencia</span></td>
                <td class="right nowrap">@Fmt.Brl0(o.ValorEstimado)</td>
            </tr>
        }
        @if (Filtradas.Count == 0)
        {
            <tr><td colspan="8" class="empty">Nenhuma oportunidade encontrada.</td></tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<Opportunity> _all = new();
    private string _busca = "", _urg = "";

    protected override void OnInitialized() => _all = Intel.Opportunities();

    private void Go(string id) => Nav.NavigateTo($"/oportunidades/{id}");

    private List<Opportunity> Filtradas
    {
        get
        {
            IEnumerable<Opportunity> q = _all;
            if (!string.IsNullOrWhiteSpace(_urg))
                q = q.Where(o => o.Urgencia == _urg);
            if (!string.IsNullOrWhiteSpace(_busca))
            {
                var b = _busca.Trim().ToLowerInvariant();
                q = q.Where(o => (Intel.UnitLabel(o.ClientUnitId) + Intel.EquipmentModel(o.EquipmentId) + o.Item)
                    .ToLowerInvariant().Contains(b));
            }
            return q.ToList();
        }
    }

    private decimal Total => Filtradas.Sum(o => o.ValorEstimado);

    private static string Prazo(Opportunity o) =>
        o.DiasAteJanela < 0 ? $"vencida há {o.DiasAtraso} d" : $"em {o.DiasAteJanela} d";
}
