@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager Nav
@inject LocState Loc
@inject BrandingRepository Brand
@inject AuthenticationStateProvider Auth
@inject AppUserRepository Usuarios

<aside class="sidebar no-print">
    <div class="brand">
        @if (!string.IsNullOrEmpty(_logo))
        {
            <div style="width:100%;text-align:center;@(_logoBg == "white" ? "background:#fff;padding:12px;border-radius:12px;" : "padding:4px 0;")">
                <img src="@_logo" style="max-height:88px;max-width:100%;width:auto;object-fit:contain" alt="logo" />
            </div>
        }
        else
        {
            <div class="brand-mark">H</div>
            <div>
                <div class="brand-name">Howden</div>
                <div class="brand-sub">Aftermarket · AFM HSA</div>
            </div>
        }
    </div>

    <nav class="nav">
        @foreach (var sec in Sections.Select(Visivel).Where(x => x.Items.Length > 0))
        {
            var open = !_collapsed.Contains(sec.Name);
            <button class="nav-section nav-section-btn" @onclick="() => Toggle(sec.Name)" aria-expanded="@open">
                <span>@Loc.T(sec.Name)</span>
                <svg class="nav-chevron @(open ? "" : "closed")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            @if (open)
            {
                @foreach (var it in sec.Items)
                {
                    <NavLink class="nav-item" href="@it.Href" Match="NavLinkMatch.All">
                        @((MarkupString)Icons.Svg(it.Icon, "nav-ico"))
                        <span>@Loc.T(it.Label)</span>
                    </NavLink>
                }
            }
        }
    </nav>

    <div class="sidebar-footer">
        <div class="version">Aftermarket Intelligence · migração AFM HSA · beta</div>
    </div>
</aside>

@code {
    private record Item(string Href, string Label, string Icon);
    private record Section(string Name, Item[] Items);

    // Espelha os módulos do app original (Leonardo). Cada item leva a uma tela
    // de estrutura pronta para receber os dados da base em Parquet.
    private static readonly Section[] Sections =
    {
        new("Gestão de Vendas", new[]
        {
            new Item("/dashboard", "Central de Inteligência", "dashboard"),
            new Item("/carteira", "Plano de Ação Comercial", "briefcase"),
            new Item("/diretoria", "Painel Executivo", "gauge"),
            new Item("/visitas", "Ações em Campo", "map-pin"),
            new Item("/alertas", "Alertas Preditivos", "bell"),
        }),
        new("Comercial", new[]
        {
            new Item("/gerar-proposta", "Gerar Proposta", "file-plus"),
            new Item("/ofertas", "Propostas", "file-text"),
            new Item("/referencias-custo", "Referências de preço", "tags"),
            new Item("/cotacao-intercompany", "Cotação Intercompany", "refresh"),
            new Item("/tempos-proposta", "Tempo das propostas", "clock"),
            new Item("/historico", "Histórico Aftermarket", "receipt"),
        }),
        new("Controle", new[]
        {
            new Item("/clientes", "Clientes e Unidades", "building"),
            new Item("/nacionalizacao", "Nacionalização", "flag"),
            new Item("/dados-marca", "Dados e Importação", "upload"),
        }),
    };

    private HashSet<string>? _paginas;

    /// <summary>
    /// A seção só com os itens que o login pode abrir (Acessos). Itens que o
    /// menu repete em duas seções (Clientes e Unidades, Nacionalização) só
    /// aparecem numa seção que o login vê por um item que é só dela — o
    /// aplicador, por exemplo, não vê a Gestão de Vendas.
    /// </summary>
    private Section Visivel(Section s)
    {
        if (_paginas is null) return s with { Items = Array.Empty<Item>() };
        var itens = s.Items.Where(i => Acessos.PodeAbrir(_paginas, i.Href)).ToArray();
        var temProprio = itens.Any(i => !Sections.Any(o => o != s && o.Items.Any(x => x.Href == i.Href)));
        var dono = Acessos.PaginaDoCaminho(itens.FirstOrDefault()?.Href ?? "")?.Grupo;
        return temProprio || s.Name == dono ? s with { Items = itens } : s with { Items = Array.Empty<Item>() };
    }

    private string _logo = "";
    private string _logoBg = "transparent";
    private readonly HashSet<string> _collapsed = new();

    private void Toggle(string name)
    {
        if (!_collapsed.Add(name)) _collapsed.Remove(name);
    }

    protected override async Task OnInitializedAsync()
    {
        _paginas = Acessos.PaginasDe((await Auth.GetAuthenticationStateAsync()).User, Usuarios);
        Nav.LocationChanged += OnChanged;
        Loc.Changed += StateHasChanged;
        var b = Brand.Get();
        _logo = b.LogoMenu;
        _logoBg = b.LogoBg;
    }
    private void OnChanged(object? s, LocationChangedEventArgs e) => StateHasChanged();
    public void Dispose()
    {
        Nav.LocationChanged -= OnChanged;
        Loc.Changed -= StateHasChanged;
    }
}
